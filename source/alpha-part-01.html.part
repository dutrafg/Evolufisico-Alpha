<!-- ABA 3: COMPARAR AVALIAÇÕES & EXPORTAÇÃO PDF COMPARATIVO        -->
<!-- ============================================================== -->
<section class="tab-panel" id="tab-comparison">
<!-- Barra Superior de Controle de Comparação -->
<div class="comparison-selector-grid no-print">
<div class="input-group" style="margin-bottom:0;">
<label for="compare-client-select"><strong>Filtrar Aluno / Paciente:</strong></label>
<select id="compare-client-select" onchange="aoMudarClienteComparacao()">
<!-- Populado via JS -->
</select>
</div>
<div class="input-group" style="margin-bottom:0;">
<label for="compare-baseline-select"><strong>Avaliação 1 (Base / Anterior):</strong></label>
<select id="compare-baseline-select" onchange="renderizarComparacao()">
<!-- Populado via JS -->
</select>
</div>
<div class="input-group" style="margin-bottom:0;">
<label for="compare-current-select"><strong>Avaliação 2 (Atual / Recente):</strong></label>
<select id="compare-current-select" onchange="renderizarComparacao()">
<!-- Populado via JS -->
</select>
</div>
<div style="display: flex; gap: 0.5rem; align-items: flex-end;">
<button class="btn btn-primary" onclick="imprimirComparativoPDF()" title="Imprimir Relatório Comparativo em PDF">
                        🖨️ Imprimir Comparativo PDF
                    </button>
</div>
</div>
<!-- RELATÓRIO COMPARATIVO COMPLETO -->
<div id="comparison-report-area">
<!-- Cabeçalho de Impressão com Nome do Profissional e CREF -->
<div class="print-header hidden">
<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2.5px solid #0071e3; padding-bottom: 8px; margin-bottom: 12px;">
<div>
<h1 class="print-title" style="font-size: 1.35rem; margin: 0 0 3px 0; color: #0f172a;">Relatório Comparativo de Evolução Física</h1>
<p class="print-subtitle" style="font-size: 0.84rem; color: #475569; margin: 0;">Protocolo Pollock 1984 – 7 Dobras &amp; Bioimpedância Elétrica</p>
</div>
<div style="text-align: right; font-size: 0.9rem; line-height: 1.4;">
<div style="font-size: 1.02rem; font-weight: 800; color: #0f172a;"><strong id="print-comp-pro-nome">Profissional Responsável</strong></div>
<div style="font-size: 0.88rem; font-weight: 700; color: #0071e3;"><span id="print-comp-pro-cref">CREF</span></div>
<div style="font-size: 0.75rem; color: #64748b; margin-top: 2px;">Emissão: <strong id="print-data-emissao"></strong></div>
</div>
</div>
</div>
<!-- 1. Perfil Geral do Aluno e do Avaliador -->
<div class="card" id="comparison-profile-card">
<div class="card-header">
<div class="card-title">
<span>👤</span> <span id="comp-client-name">Selecione as avaliações</span>
</div>
<div id="comp-period-badge" style="font-size: 0.85rem; font-weight: 600; color: var(--primary-color); background: var(--primary-light); padding: 0.35rem 0.75rem; border-radius: 999px;">
                            Período: -
                        </div>
</div>
<!-- Cards Rápidos de Destaque -->
<div class="stats-grid" id="comp-highlights-grid">
<div class="stat-card weight">
<span class="stat-label">Peso Corporal</span>
<span class="stat-value" id="comp-stat-peso">-</span>
<span class="stat-diff" id="comp-diff-peso">-</span>
</div>
<div class="stat-card muscle">
<span class="stat-label">Massa Muscular</span>
<span class="stat-value" id="comp-stat-mme">-</span>
<span class="stat-diff" id="comp-diff-mme">-</span>
</div>
<div class="stat-card fat">
<span class="stat-label">% Gordura BIA</span>
<span class="stat-value" id="comp-stat-gordura-bia">-</span>
<span class="stat-diff" id="comp-diff-gordura-bia">-</span>
</div>
<div class="stat-card age">
<span class="stat-label">Idade Corporal</span>
<span class="stat-value" id="comp-stat-idade-corp">-</span>
<span class="stat-diff" id="comp-diff-idade-corp">-</span>
</div>
</div>
<div id="comp-contact-meta" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; font-size: 0.85rem; color: var(--text-muted); background: #f9fafb; padding: 0.75rem 1rem; border-radius: var(--radius-md);">
<div><strong>E-mail:</strong> <span id="comp-email">-</span></div>
<div><strong>WhatsApp:</strong> <span id="comp-whatsapp">-</span></div>
<div><strong>Fases:</strong> <span id="comp-fases">-</span></div>
<div><strong>Avaliador:</strong> <span id="comp-avaliador">-</span></div>
</div>
</div>
<!-- 1.1 DIAGNÓSTICO DE RECOMPOSIÇÃO CORPORAL (INDICADORES DE RECOMPOSIÇÃO CORPORAL) -->
<div class="card" id="comp-recomposicao-diag-card" style="margin-top: 1rem; border-left: 4px solid #007aff; background: linear-gradient(135deg, rgba(0, 122, 255, 0.04) 0%, rgba(16, 185, 129, 0.04) 100%);">
<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
<div style="font-size: 0.95rem; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 0.5rem;">
<span>🔬</span> Diagnóstico de Recomposição Corporal 
                            </div>
<div class="tag" id="comp-recomposicao-badge" style="font-size: 0.82rem; font-weight: 700; padding: 0.35rem 0.75rem; border-radius: 999px;">
                                Aguardando dados
                            </div>
</div>
<!-- Grid de Métricas de Recomposição -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.65rem; margin-bottom: 0.85rem;">
<div class="stat-card" style="padding: 0.65rem; background: var(--bg-card, #fff); border: 1px solid var(--border-color, #e2e8f0); border-radius: 10px;">
<span style="font-size: 0.72rem; color: var(--text-muted, #64748b); font-weight: 700; text-transform: uppercase;">Δ Massa Magra</span>
<span id="comp-recomposicao-delta-mm" style="font-size: 1.15rem; font-weight: 800; color: #059669; font-variant-numeric: tabular-nums; display: block; margin-top: 2px;">-- kg</span>
</div>
<div class="stat-card" style="padding: 0.65rem; background: var(--bg-card, #fff); border: 1px solid var(--border-color, #e2e8f0); border-radius: 10px;">
<span style="font-size: 0.72rem; color: var(--text-muted, #64748b); font-weight: 700; text-transform: uppercase;">Δ Massa Gorda</span>
<span id="comp-recomposicao-delta-mg" style="font-size: 1.15rem; font-weight: 800; color: #dc2626; font-variant-numeric: tabular-nums; display: block; margin-top: 2px;">-- kg</span>
</div>
<div class="stat-card" style="padding: 0.65rem; background: var(--bg-card, #fff); border: 1px solid var(--border-color, #e2e8f0); border-radius: 10px;">
<span style="font-size: 0.72rem; color: var(--text-muted, #64748b); font-weight: 700; text-transform: uppercase;">Δ % Gordura</span>
<span id="comp-recomposicao-delta-pg" style="font-size: 1.15rem; font-weight: 800; color: #0284c7; font-variant-numeric: tabular-nums; display: block; margin-top: 2px;">-- %</span>
</div>
<div class="stat-card" style="padding: 0.65rem; background: var(--bg-card, #fff); border: 1px solid var(--border-color, #e2e8f0); border-radius: 10px;">
<span style="font-size: 0.72rem; color: var(--text-muted, #64748b); font-weight: 700; text-transform: uppercase;">Taxa Semanal</span>
<span id="comp-recomposicao-taxa-semanal" style="font-size: 1.15rem; font-weight: 800; color: var(--text-main, #475569); font-variant-numeric: tabular-nums; display: block; margin-top: 2px;">-- kg/sem</span>
</div>
</div>
<!-- Síntese Descritiva -->
<div id="comp-recomposicao-sintese" style="font-size: 0.88rem; line-height: 1.5; color: var(--text-main, #334155); background: var(--bg-card, #ffffff); border: 1px solid var(--border-color, #e2e8f0); border-radius: 10px; padding: 0.75rem 1rem;">
                            Selecione duas avaliações para visualizar o diagnóstico morfológico.
                        </div>
<div style="margin-top: 0.65rem; display: flex; justify-content: flex-end;">
<button class="btn btn-outline btn-sm" id="btn-inserir-parecer-recomposicao" onclick="inserirSinteseRecomposicaoNoParecer()" style="font-size: 0.78rem; font-weight: 700; color: #007aff; border-color: #007aff;" type="button">
                                ⚡ Inserir Síntese de Recomposição Corporal no Parecer Técnico
                            </button>
</div>
</div>
