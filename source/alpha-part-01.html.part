/* 5. Stepper Responsivo em Mobile e Contraste em Modo Escuro */
@media (max-width: 680px) {
    .form-header h1 {
        font-size: 1.45rem !important;
        line-height: 1.25 !important;
        letter-spacing: -0.02em !important;
