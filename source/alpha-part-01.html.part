<!-- MODAL DE VISUALIZAÇÃO DETALHADA DE UMA AVALIAÇÃO INDIVIDUAL -->
<div class="modal-overlay hidden" id="view-modal" onclick="if(event.target===this)fecharModalDetalhes()">
<div class="modal-content">
<div class="modal-header ef-details-header">
<div>
<h2 id="modal-client-name" style="font-size:1.3rem; font-weight:800; color:var(--text-main);">Mariana Duarte</h2>
<span id="modal-assessment-date" style="font-size:0.85rem; color:var(--text-muted);">Semana 1 - 03/09/2026</span>
</div>
<div class="ef-details-actions">
<button class="btn btn-primary btn-sm" id="btn-modal-aluno" onclick="abrirVisualizacaoPacienteWeb(window.avaliacaoEmVisualizacaoId || avaliacaoEmVisualizacaoId)">👁️ Visão do Aluno</button>
<button class="btn btn-success btn-sm" id="btn-modal-pdf" onclick="imprimirAvaliacaoDaModal()" title="Imprimir avaliação em PDF com fotos">🖨️ PDF com fotos</button>
<button class="btn btn-primary btn-sm" id="btn-modal-edit" onclick="editarDaModal()">✏️ Editar</button>
</div>
<button class="modal-close-btn" aria-label="Fechar detalhes" onclick="fecharModalDetalhes()">✕</button>
</div>
<div id="modal-body-content">
<!-- Conteúdo detalhado injetado via JS -->
</div>
</div>
</div>
<!-- MODAL DE LAUDO WEB E COMPARTILHAMENTO WHATSAPP -->
<div class="modal-overlay hidden" id="web-report-modal">
<div class="modal-content" style="max-width: 600px;">
<div class="modal-header">
<div>
<h2 style="font-size:1.25rem; font-weight:700; color:var(--text-main);">🌐 Laudo Web Interativo</h2>
<span id="web-report-subtitle" style="font-size:0.8rem; color:var(--text-muted);">Link direto responsivo para visualização no smartphone do aluno</span>