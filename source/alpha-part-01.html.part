<div class="card visual-charts-card" id="comp-visual-charts-card">
<div class="card-header">
<div class="card-title">
<span>📊</span> Gráficos de Composição Corporal (Avaliação Mais Recente)
                        </div>
</div>
<div class="charts-row-duo">
<div class="chart-box" id="box-donut-chart">
<h4>% de Gordura x % Massa Magra</h4>
<div id="donut-chart-container"></div>
<div class="chart-legend">
<div class="legend-item"><span class="legend-color" style="background:#0ea5e9;"></span> Massa Magra</div>
<div class="legend-item"><span class="legend-color" style="background:#0284c7;"></span> Gordura</div>
</div>
</div>
<div class="chart-box" id="box-bar-chart">
<h4>Massa Magra x Massa Gorda (kg)</h4>
<div id="bar-chart-container"></div>
<div class="chart-legend">
<div class="legend-item"><span class="legend-color" style="background:#0284c7;"></span> Massa Magra (kg)</div>
<div class="legend-item"><span class="legend-color" style="background:#0ea5e9;"></span> Massa Gorda (kg)</div>
</div>
</div>
</div>
</div>
<!-- 6. FOTOS LADO A LADO -->
<div class="card" id="card-before-after" style="margin-bottom:1.5rem;">
<div class="card-header">
<div class="card-title">
<span>✨</span> Comparação Antes &amp; Depois (Slider Interativo)
                        </div>
<div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
<div class="ba-segmented-tabs">
<button class="ba-tab-btn active" id="btn-mode-slider" onclick="alternarModoVisualizacaoFotos('slider')" type="button">↔️ Slider Interativo</button>
<button class="ba-tab-btn" id="btn-mode-side" onclick="alternarModoVisualizacaoFotos('side')" type="button">⏹️ Lado a Lado</button>
</div>
<div class="ba-segmented-tabs">
<button class="ba-tab-btn active" id="pose-btn-frente" onclick="mudarPoseSlider('frente')" type="button">Frente</button>
<button class="ba-tab-btn" id="pose-btn-lado" onclick="mudarPoseSlider('lado')" type="button">Lado</button>
<button class="ba-tab-btn" id="pose-btn-costas" onclick="mudarPoseSlider('costas')" type="button">Costas</button>
</div>
</div>
</div>
<div id="ba-stage-wrapper">
<div class="before-after-stage" id="ba-stage">
<div class="ba-layer ba-layer-before">
<img alt="Foto Antes" decoding="async" id="ba-img-before" loading="lazy" src=""/>
<span class="ba-tag before" id="ba-tag-before">Antes</span>
</div>
<div class="ba-layer ba-layer-after" id="ba-layer-after" style="width: 50%;">
<img alt="Foto Depois" decoding="async" id="ba-img-after" loading="lazy" src=""/>
<span class="ba-tag after" id="ba-tag-after">Depois</span>
</div>
<div class="ba-handle" id="ba-handle" style="left: 50%;">
<div class="ba-handle-thumb">↔</div>
</div>
</div>
<p style="text-align:center; font-size:0.8rem; color:var(--text-muted); margin-top:0.75rem;">
                            👆 <strong>Arraste o divisor central ou deslize o dedo</strong> para comparar a evolução das fotos em tempo real.
                        </p>
</div>
</div>
<div class="hidden" id="ba-side-wrapper">
<div class="card" id="comparison-photos-card">
<div class="card-header">
<div class="card-title">
<span>📷</span> Comparação Fotográfica Lado a Lado
                            </div>
</div>
<div class="photo-comparison-container" id="photo-comparison-grid">
<div class="photo-pose-card">
<div class="photo-pose-title">Frente</div>
<div class="photo-duo">
<div class="photo-item"><span id="label-foto-frente-base">Base</span><div class="photo-frame" id="box-foto-frente-base"></div></div>
<div class="photo-item"><span id="label-foto-frente-curr">Atual</span><div class="photo-frame" id="box-foto-frente-curr"></div></div>
</div>
</div>
<div class="photo-pose-card">
<div class="photo-pose-title">Lado / Perfil</div>
<div class="photo-duo">
<div class="photo-item"><span id="label-foto-lado-base">Base</span><div class="photo-frame" id="box-foto-lado-base"></div></div>
<div class="photo-item"><span id="label-foto-lado-curr">Atual</span><div class="photo-frame" id="box-foto-lado-curr"></div></div>
</div>
</div>
<div class="photo-pose-card">
<div class="photo-pose-title">Costas</div>
<div class="photo-duo">
<div class="photo-item"><span id="label-foto-costas-base">Base</span><div class="photo-frame" id="box-foto-costas-base"></div></div>
<div class="photo-item"><span id="label-foto-costas-curr">Atual</span><div class="photo-frame" id="box-foto-costas-curr"></div></div>
</div>
</div>
</div>
</div>
</div>
<!-- 7. PARECER DO AVALIADOR -->
<div class="card" id="comparison-pro-notes-card">
<div class="professional-notes-box">
<div class="pro-notes-title">✍️ Parecer Técnico &amp; Observações do Profissional Avaliador</div>
<div class="no-print ef781-editor">
<textarea aria-label="Parecer técnico do comparativo (editável)" id="ef781-parecer" maxlength="4000" placeholder="Escreva ou ajuste o parecer técnico desta comparação. Por padrão ele vem do parecer das avaliações." rows="7"></textarea>
<div class="ef781-bar">
<span id="ef781-status" role="status"></span>
<div class="ef781-btns">
<button class="btn btn-secondary btn-sm" id="ef781-restore" title="Descartar a edição e voltar ao texto automático" type="button">↺ Texto automático</button>
<button class="btn btn-primary btn-sm" id="ef781-save" type="button">💾 Salvar parecer</button>
</div>
</div>
</div>
<div class="pro-notes-content ef781-print-text" id="comp-pro-notes-display">-</div>
</div>
</div>
<!-- Assinaturas -->
<div class="print-signature-area hidden">
<div style="text-align: center; width: 45%;">
<div style="border-top: 1px solid #000; margin-bottom: 0.3rem;"></div>
<strong id="print-assinatura-avaliador">Profissional Responsável</strong>
<div id="print-assinatura-registro" style="font-size:0.75rem; color:#475569;">CREF/CRN</div>
</div>
<div style="text-align: center; width: 45%;">
<div style="border-top: 1px solid #000; margin-bottom: 0.3rem;"></div>
<strong id="print-assinatura-aluno">Assinatura do Aluno / Paciente</strong>
<div style="font-size:0.75rem; color:#475569;">Ciente dos resultados e orientações</div>
</div>
</div>
</div>
</section>
<!-- ============================================================== -->
<!-- ABA COBRANÇA & PRECIFICAÇÃO (POSICIONADA APÓS DIAGNÓSTICO)    -->
<!-- ============================================================== -->
<section class="tab-panel" id="tab-cobranca">
<div class="cob-container">
<!-- Cabeçalho do Módulo de Cobrança -->
<header class="cob-head">
<div>
<div class="cob-kicker">Módulo Financeiro &amp; Precificação</div>
<h2>Cobranças</h2>
<p>Simule valores e descontos de avaliações físicas (individual ou em dupla) e controle o histórico de pagamentos com detalhamento do valor total e por aluno.</p>
</div>
<div class="cob-head-actions">
<button class="btn btn-secondary btn-sm" onclick="EFCobranca.resetarFormulario()" title="Limpar calculadora e iniciar novo orçamento" type="button">
                            ↺ Nova Cobrança / Limpar
                        </button>
</div>
</header>
<!-- Grid Principal da Calculadora (2 Colunas Responsivas) -->
<div class="cob-workspace-grid">
<!-- COLUNA 1: Parâmetros, Alunos, Serviços e Descontos -->
<div>
<!-- Card 1: Modalidade & Identificação dos Alunos -->
<div class="cob-card">
<div class="cob-card-title">
<span>1. Modalidade &amp; Aluno(s)</span>
<span class="tag" id="cob-badge-modalidade">Individual</span>
</div>
<!-- Segmented Control Estilo Apple: 1 ou 2 Pessoas -->
<div aria-label="Número de Pessoas" class="cob-segmented" role="radiogroup">
<button class="cob-seg-btn active" id="cob-btn-pessoa-1" onclick="EFCobranca.setModalidade('1')" type="button">
<span>👤</span> 1 Pessoa (Individual)
                                </button>
<button class="cob-seg-btn" id="cob-btn-pessoa-2" onclick="EFCobranca.setModalidade('2')" type="button">
<span>👥</span> 2 Pessoas (Dupla / Casal)
                                </button>
</div>
<!-- Banner Informativo quando Dupla -->
<div class="cob-duo-banner hidden" id="cob-duo-alert">
<div>
<strong>👥 Modalidade em Dupla / Casal:</strong>
<div style="font-size:0.78rem; opacity:0.85; margin-top:2px;">O valor total soma as avaliações e exibe o rateio exato por aluno (50% cada).</div>
</div>
<button class="btn btn-outline btn-sm" onclick="EFCobranca.aplicarDescontoDuplaPadrao()" style="background:#fff; border-color:#007aff; font-size:0.75rem; white-space:nowrap;" type="button">
                                    ⚡ Aplicar Combo Dupla (15% OFF)
                                </button>
</div>
<!-- Aluno 1 -->
<div class="input-group" style="margin-bottom:0.75rem;">
<label for="cob_select_aluno1">
<span>Aluno Principal / Responsável *</span>
<span style="font-size:0.72rem; color:var(--text-muted);">Puxar do cadastro ou digitar</span>
</label>
<select id="cob_select_aluno1" onchange="EFCobranca.aoSelecionarAluno(1, this.value)">
<!-- Populado via JS -->
</select>
</div>
<div class="input-row" style="margin-bottom:0.75rem;">
<div class="input-group" style="flex:1;">
<label for="cob_nome1">Nome do Aluno 1 *</label>
<input id="cob_nome1" oninput="EFCobranca.recalcular()" placeholder="Ex: Carlos Mendes" type="text"/>
</div>
</div>
<!-- Bloco Aluno 2 (Exibido somente quando 2 Pessoas) -->
<div class="hidden" id="cob-aluno2-wrapper" style="margin-top:0.85rem; padding-top:0.85rem; border-top:1px dashed var(--border-color, #e2e8f0);">
<div class="input-group" style="margin-bottom:0.75rem;">
<label for="cob_select_aluno2">
<span>2º Aluno (Parceiro / Dupla) *</span>
<span style="font-size:0.72rem; color:var(--text-muted);">Puxar do cadastro ou digitar</span>
</label>
<select id="cob_select_aluno2" onchange="EFCobranca.aoSelecionarAluno(2, this.value)">
<!-- Populado via JS -->
</select>
</div>
<div class="input-row" style="margin-bottom:0;">
<div class="input-group" style="flex:1;">
<label for="cob_nome2">Nome do Aluno 2 *</label>
<input id="cob_nome2" oninput="EFCobranca.recalcular()" placeholder="Ex: Mariana Duarte" type="text"/>
</div>
</div>
</div>
</div>
<!-- Card 2: Serviço e Valor Base -->
<div class="cob-card">
<div class="cob-card-title">
<span>2. Serviço &amp; Valor Base</span>
</div>
<div class="input-group" style="margin-bottom:0.85rem;">
<label for="cob_servico_select">Tipo de Serviço / Pacote</label>
<select id="cob_servico_select" onchange="EFCobranca.aoMudarServico(this.value)">
<option value="completa">Avaliação Física Completa (Pollock 7D + BIA + Fotos)</option>
<option value="reavaliacao">Reavaliação Periódica / Check-in de Evolução</option>
<option value="bioimpedancia">Bioimpedância Elétrica Isolada (BIA)</option>
<option value="treino_consultoria">Avaliação Física + Prescrição de Treino / Consultoria</option>
<option value="trimestral">Pacote Trimestral (3 Avaliações Periódicas)</option>
<option value="semestral">Pacote Semestral (6 Avaliações Periódicas)</option>
<option value="personalizado">Serviço Personalizado (Digitar Descrição e Preço)</option>
</select>
</div>
<div class="input-group hidden" id="cob-servico-custom-box" style="margin-bottom:0.85rem;">
<label for="cob_servico_nome_custom">Descrição do Serviço Personalizado</label>
<input id="cob_servico_nome_custom" oninput="EFCobranca.recalcular()" placeholder="Ex: Avaliação Física + Orientação Nutricional" type="text"/>
</div>
<div class="input-row">
<div class="input-group">
<label for="cob_valor_base">Valor Unitário por Pessoa (R$) *</label>
<div style="display:flex; gap:0.4rem; align-items:center;">
<input id="cob_valor_base" min="0" oninput="EFCobranca.recalcular()" placeholder="Ex: 150.00" step="0.01" style="font-weight:700;" type="number"/>
<button class="btn btn-secondary btn-sm" onclick="EFCobranca.ajustarValorBase(10)" title="Aumentar R$ 10" type="button">+10</button>
<button class="btn btn-secondary btn-sm" onclick="EFCobranca.ajustarValorBase(50)" title="Aumentar R$ 50" type="button">+50</button>
</div>
</div>
<div class="input-group">
<label for="cob_data">Data da Avaliação</label>
<input id="cob_data" oninput="EFCobranca.recalcular()" type="date"/>
</div>
</div>
</div>
<!-- Card 3: Descontos Comerciais -->
<div class="cob-card" style="margin-bottom:0;">
<div class="cob-card-title">
<span>3. Política de Descontos</span>
<span class="tag" id="cob-badge-desconto-aplicado">0% off</span>
</div>
<div class="input-row">
<div class="input-group">
<label>Modalidade do Desconto</label>
<div class="cob-segmented" style="margin-bottom:0;">
<button class="cob-seg-btn active" id="cob-btn-desc-pct" onclick="EFCobranca.setTipoDesconto('porcentagem')" type="button">
                                            % Porcentagem
                                        </button>
<button class="cob-seg-btn" id="cob-btn-desc-val" onclick="EFCobranca.setTipoDesconto('valor')" type="button">
                                            R$ Fixo
                                        </button>
</div>
</div>
<div class="input-group">
<label for="cob_desconto_input" id="cob-label-desconto-input">Desconto (%)</label>
<input id="cob_desconto_input" min="0" oninput="EFCobranca.recalcular()" placeholder="0" step="0.01" style="font-weight:700;" type="number"/>
</div>
</div>
<!-- Chips de Desconto Rápido -->
<label style="font-size:0.74rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; margin-top:0.75rem; margin-bottom:0.25rem; display:block;">
                                Atalhos de Desconto de Mercado:
                            </label>
<div class="cob-chips-group">
<button class="cob-chip active" id="cob-chip-0" onclick="EFCobranca.aplicarChipDesconto(0, 'porcentagem', 'Sem desconto')" type="button">0% Sem Desconto</button>
<button class="cob-chip" id="cob-chip-10" onclick="EFCobranca.aplicarChipDesconto(10, 'porcentagem', 'Desconto à vista')" type="button">10% À Vista</button>
<button class="cob-chip" id="cob-chip-15" onclick="EFCobranca.aplicarChipDesconto(15, 'porcentagem', 'Combo Especial Dupla')" type="button">15% Combo Dupla</button>
<button class="cob-chip" id="cob-chip-20" onclick="EFCobranca.aplicarChipDesconto(20, 'porcentagem', 'Convênio / Academia')" type="button">20% Parceria</button>
<button class="cob-chip" id="cob-chip-25" onclick="EFCobranca.aplicarChipDesconto(25, 'porcentagem', '2º Aluno 50% OFF')" type="button">25% (2º Aluno 50% OFF)</button>
<button class="cob-chip" id="cob-chip-fidelidade" onclick="EFCobranca.aplicarChipDesconto(30, 'valor', 'Desconto Fidelidade Retorno')" type="button">R$ 30 Fidelidade</button>
<button class="cob-chip" id="cob-chip-100" onclick="EFCobranca.aplicarChipDesconto(100, 'porcentagem', 'Cortesia')" type="button">100% Cortesia</button>
</div>
<div class="input-group" style="margin-top:0.85rem;">
<label for="cob_desconto_motivo">Motivo do Desconto (opcional)</label>
<input id="cob_desconto_motivo" oninput="EFCobranca.recalcular()" placeholder="Ex: Promoção de início de ano / Aluno fidelidade" type="text"/>
</div>
</div>
</div>
<!-- COLUNA 2: Resumo em Tempo Real e Ação de Registro -->
<div>
<!-- Card Hero: Resumo Financeiro ao Vivo com Total e Por Aluno -->
<div class="cob-hero-card">
<div class="cob-hero-rows">
<div class="cob-hero-row">
<span>Subtotal (<span id="cob-hero-qtd-lbl">1 pessoa</span>):</span>
<b id="cob-hero-subtotal">R$ 150,00</b>
</div>
<div class="cob-hero-row discount">
<span>Desconto aplicado:</span>
<b id="cob-hero-desconto">- R$ 0,00</b>
</div>
</div>
<!-- VALOR TOTAL -->
<div class="cob-hero-total-group">
<span class="cob-hero-total-label">Valor Total da Cobrança</span>
<span class="cob-hero-total-val" id="cob-hero-total">R$ 150,00</span>
</div>
<!-- VALOR POR ALUNO (SEMPRE EM DESTAQUE) -->
<div class="cob-hero-per-student-box">
<div class="cob-hero-per-student-info">
<span>👥 Valor por Aluno:</span>
<small id="cob-hero-per-student-desc">Atendimento individual (1 aluno)</small>
</div>
<div class="cob-hero-per-student-val" id="cob-hero-per-person">
                                    R$ 150,00
                                </div>
</div>
<!-- SELETOR DE FORMAS DE PAGAMENTO (PIX, CRÉDITO, DÉBITO, DINHEIRO) -->
<label style="font-size:0.75rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">
                                Forma de Pagamento:
                            </label>
<div aria-label="Forma de Pagamento" class="cob-pay-segmented" role="radiogroup">
<button class="cob-pay-seg-btn active" id="cob-pay-btn-pix" onclick="EFCobranca.setFormaPagamento('pix')" type="button">
<span>📱</span> Pix
                                </button>
<button class="cob-pay-seg-btn" id="cob-pay-btn-credito" onclick="EFCobranca.setFormaPagamento('credito')" type="button">
<span>💳</span> Crédito
                                </button>
<button class="cob-pay-seg-btn" id="cob-pay-btn-debito" onclick="EFCobranca.setFormaPagamento('debito')" type="button">
<span>💳</span> Débito
                                </button>
<button class="cob-pay-seg-btn" id="cob-pay-btn-dinheiro" onclick="EFCobranca.setFormaPagamento('dinheiro')" type="button">
<span>💵</span> Dinheiro
                                </button>
</div>
<!-- Detalhe Crédito: Parcelamento -->
<div class="cob-pay-subdetail hidden" id="cob-pay-detail-credito">
<div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem; font-size:0.8rem; color:#cbd5e1;">
<span>Parcelas:</span>
<select id="cob_select_parcelas" aria-label="Número de parcelas da cobrança" onchange="EFCobranca.aoMudarParcelas(this.value)" style="background:#1e293b; color:#fff; border:1px solid rgba(255,255,255,0.2); border-radius:6px; padding:0.25rem 0.5rem; font-size:0.8rem; font-weight:600;">
<option value="1">1x (à vista)</option>
<option value="2">2x</option>
<option value="3">3x</option>
<option value="4">4x</option>
<option value="5">5x</option>
<option value="6">6x</option>
<option value="10">10x</option>
<option value="12">12x</option>
</select>
</div>
<div id="cob-parcela-resumo" style="font-size:0.75rem; color:#94a3b8; margin-top:4px; text-align:right;">
                                    1x de R$ 150,00
                                </div>
</div>
<!-- Detalhe Dinheiro: Troco -->
<div class="cob-pay-subdetail hidden" id="cob-pay-detail-dinheiro">
<div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem; font-size:0.8rem; color:#cbd5e1;">
<span>Valor entregue:</span>
<input id="cob_dinheiro_recebido" aria-label="Valor recebido em dinheiro" min="0" oninput="EFCobranca.calcularTroco()" placeholder="R$ entregue" step="0.01" style="width:110px; background:#1e293b; color:#fff; border:1px solid rgba(255,255,255,0.2); border-radius:6px; padding:0.25rem 0.5rem; font-size:0.8rem; font-weight:700; text-align:right;" type="number"/>
</div>
<div id="cob-troco-display" style="font-size:0.75rem; color:#4ade80; margin-top:4px; text-align:right; font-weight:600;">
                                    Troco: R$ 0,00
                                </div>
</div>
<!-- SELETOR DE STATUS DO PAGAMENTO -->
<label style="font-size:0.75rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">
                                Status do Pagamento:
                            </label>
<div class="cob-status-segmented" role="radiogroup">
<button class="cob-status-seg-btn active pago" id="cob-hero-status-pago" onclick="EFCobranca.setStatusPagamento('pago')" type="button">
                                    🟢 Pago
                                </button>
<button class="cob-status-seg-btn pendente" id="cob-hero-status-pendente" onclick="EFCobranca.setStatusPagamento('pendente')" type="button">
                                    🟡 Pendente
                                </button>
</div>
<div id="cob-finance-date-field">
 <div id="cob-finance-paid-date"><label for="cob-finance-paid-input">Data efetiva do recebimento
 <input type="date" id="cob-finance-paid-input" onchange="EFCobranca.setDataFinanceira('recebimento',this.value)" required></label>
 <small>É esta data que determina o mês do caixa recebido.</small></div>
 <div id="cob-finance-due-date" hidden><label for="cob-finance-due-input">Vencimento da cobrança
 <input type="date" id="cob-finance-due-input" onchange="EFCobranca.setDataFinanceira('vencimento',this.value)"></label>
 <small>Usado para listar valores a receber no mês selecionado.</small></div>
</div>
<!-- BOTÃO PRINCIPAL: REGISTRAR NO HISTÓRICO -->
<button class="cob-btn-save-hero" onclick="EFCobranca.salvarCobrancaNoHistorico()" type="button">
                                💾 Registrar Pagamento no Histórico
                            </button>
<button class="cob-btn-reset-hero" onclick="EFCobranca.resetarFormulario()" type="button">
                                ↺ Limpar / Novo Atendimento
                            </button>
</div>
</div>
</div>
<!-- ========================================================== -->
<!-- HISTÓRICO DE PAGAMENTOS COM TOTAIS E POR ALUNO           -->
<!-- ========================================================== -->
<section id="ef-fin-panel" aria-labelledby="ef-fin-title">
  <div class="ef-fin-head">
    <div><h3 id="ef-fin-title">Caixa e histórico mensal</h3><p>O caixa inicia um novo período no dia 1º, sem eliminar registros anteriores.</p></div>
    <div class="ef-fin-controls">
      <button type="button" class="ef-fin-btn" id="ef-fin-prev" aria-label="Mês anterior">←</button>
      <label for="ef-fin-month" style="font-size:.8rem;font-weight:700">Selecionar mês
        <input id="ef-fin-month" type="month" aria-label="Mês do histórico"></label>
      <button type="button" class="ef-fin-btn" id="ef-fin-next" aria-label="Próximo mês">→</button>
      <button type="button" class="ef-fin-btn" id="ef-fin-today">Mês atual</button>
    </div>
  </div>
  <div id="ef-fin-security" class="ef-fin-alert" role="alert" hidden></div>
  <div class="ef-fin-period-label"><h4 id="ef-fin-period-label">Mês atual</h4><span style="font-size:.78rem;color:var(--text-muted,#61756a)">Caixa atual: <span id="ef-fin-current">—</span></span></div>
  <div class="ef-fin-kpis">
    <div class="ef-fin-kpi"><span>Recebido no mês</span><strong id="ef-fin-recebido">R$ 0,00</strong><small id="ef-fin-recebido-count">0 recebimentos</small></div>
    <div class="ef-fin-kpi"><span>A receber com vencimento no mês</span><strong id="ef-fin-pendente">R$ 0,00</strong><small id="ef-fin-pendente-count">0 cobranças</small></div>
    <div class="ef-fin-kpi"><span>Total pendente acumulado</span><strong id="ef-fin-geral">R$ 0,00</strong><small>Inclui pendências de meses anteriores</small></div>
  </div>
  <div class="ef-fin-controls" style="margin:15px 0 20px">
    <button class="ef-fin-btn primary" type="button" id="ef-fin-pdf-month">Gerar PDF do mês</button>
    <button class="ef-fin-btn" type="button" id="ef-fin-pdf-total">Gerar PDF completo</button>
  </div>
  <div class="ef-fin-blocks">
    <section class="ef-fin-block"><h4>Recebimentos do mês</h4><div id="ef-fin-paid-table" aria-live="polite"></div></section>
    <section class="ef-fin-block"><h4>Valores a receber no mês</h4><div id="ef-fin-pending-table" aria-live="polite"></div></section>
  </div>
  <h4 style="margin-top:24px">Histórico por mês</h4>
  <div class="ef-fin-listhead" aria-hidden="true"><span>Mês</span><span>Recebido</span><span>A receber</span><span>Registros</span></div>
  <div id="ef-fin-months" class="ef-fin-month-list" aria-label="Selecionar mês do histórico"></div>
  <p class="ef-fin-footnote">Recebido é contado pela data efetiva do pagamento; pendente pelo vencimento. Registros antigos sem data de pagamento usam a data da cobrança. Alterar uma cobrança para Pago registra a data de hoje. O fechamento mensal não apaga nem cancela dívidas.</p>
</section>
<div class="cob-history-card">
<div class="cob-history-head">
<div class="cob-history-title">
<span>📋 Histórico de Pagamentos</span>
<span class="tag" id="cob-history-total-count" style="font-size:0.8rem;">0 registros</span>
</div>
<div style="display:flex; gap:0.5rem; align-items:center;">
<button class="btn btn-outline btn-sm" onclick="EFCobranca.exportarCsvHistorico()" title="Exportar histórico financeiro com total e por aluno em CSV" type="button">
                                📊 Exportar CSV
                            </button>
<button class="btn btn-secondary btn-sm" onclick="EFCobranca.limparTodoHistorico()" title="Limpar todo o histórico de cobranças" type="button">
                                🗑️ Limpar
                            </button>
</div>
</div>
<!-- Dashboard Rápido de Faturamento (5 Métricas: Totais e Por Aluno) -->
<div class="cob-kpis-grid">
<div class="cob-kpi-card">
<div class="cob-kpi-icon" style="background:#ecfdf5; color:#10b981;">💰</div>
<div class="cob-kpi-info">
<span class="cob-kpi-label">Recebido neste mês</span>
<span class="cob-kpi-val" id="cob-kpi-faturado-mes" style="color:#059669;">R$ 0,00</span>
<span class="cob-kpi-sub" id="cob-kpi-faturado-qtd">0 recebimento(s)</span>
</div>
</div>
<div class="cob-kpi-card">
<div class="cob-kpi-icon" style="background:#fffbeb; color:#d97706;">⏳</div>
<div class="cob-kpi-info">
<span class="cob-kpi-label">A receber neste mês</span>
<span class="cob-kpi-val" id="cob-kpi-pendente-mes" style="color:#d97706;">R$ 0,00</span>
<span class="cob-kpi-sub" id="cob-kpi-pendente-qtd">0 pendência(s)</span>
</div>
</div>
<div class="cob-kpi-card">
<div class="cob-kpi-icon" style="background:#eff6ff; color:#007aff;">📈</div>
<div class="cob-kpi-info">
<span class="cob-kpi-label">Total da carteira (histórico)</span>
<span class="cob-kpi-val" id="cob-kpi-total-geral" style="color:#007aff;">R$ 0,00</span>
<span class="cob-kpi-sub">Pago + Pendente de todos os períodos</span>
</div>
</div>
<div class="cob-kpi-card">
<div class="cob-kpi-icon" style="background:#f5edfa; color:#8b5cf6;">👥</div>
<div class="cob-kpi-info">
<span class="cob-kpi-label">Ticket Médio / Aluno</span>
<span class="cob-kpi-val" id="cob-kpi-ticket-medio">R$ 0,00</span>
<span class="cob-kpi-sub" id="cob-kpi-ticket-sub">Por aluno atendido</span>
</div>
</div>
<div class="cob-kpi-card">
<div class="cob-kpi-icon" style="background:#f1f5f9; color:#475569;">👤</div>
<div class="cob-kpi-info">
<span class="cob-kpi-label">Alunos Atendidos</span>
<span class="cob-kpi-val" id="cob-kpi-total-alunos">0</span>
<span class="cob-kpi-sub" id="cob-kpi-total-avaliacoes-sub">0 avaliações</span>
</div>
</div>
</div>
<!-- Barra de Ferramentas: Busca, Filtros e Alternância de Visão -->
<div class="cob-toolbar">
<input class="cob-search-input" id="cob-busca-historico" aria-label="Buscar no histórico de cobranças" oninput="EFCobranca.filtrarHistorico()" placeholder="🔍 Buscar por aluno, serviço ou data..." type="text"/>
<div class="cob-toolbar-filters">
<button class="btn btn-secondary btn-sm active" id="cob-filter-btn-todos" onclick="EFCobranca.setFiltroStatus('todos')" type="button">Todas</button>
<button class="btn btn-secondary btn-sm" id="cob-filter-btn-pago" onclick="EFCobranca.setFiltroStatus('pago')" type="button">🟢 Pagas</button>
<button class="btn btn-secondary btn-sm" id="cob-filter-btn-pendente" onclick="EFCobranca.setFiltroStatus('pendente')" type="button">🟡 Pendentes</button>
<button class="btn btn-secondary btn-sm" id="cob-filter-btn-pix" onclick="EFCobranca.setFiltroStatus('pix')" type="button">📱 Pix</button>
<button class="btn btn-secondary btn-sm" id="cob-filter-btn-cartao" onclick="EFCobranca.setFiltroStatus('cartao')" type="button">💳 Cartão</button>
<button class="btn btn-secondary btn-sm" id="cob-filter-btn-dinheiro" onclick="EFCobranca.setFiltroStatus('dinheiro')" type="button">💵 Dinheiro</button>
<button class="btn btn-secondary btn-sm" id="cob-filter-btn-dupla" onclick="EFCobranca.setFiltroStatus('dupla')" type="button">👥 Duplas</button>
<button class="btn btn-secondary btn-sm" id="cob-filter-btn-individual" onclick="EFCobranca.setFiltroStatus('individual')" type="button">👤 Individuais</button>
</div>
<!-- Alternador de Visão: Extrato vs Consolidado por Aluno -->
<div class="cob-view-toggle">
<button class="cob-view-btn active" id="cob-view-btn-extrato" onclick="EFCobranca.setVisaoHistorico('extrato')" type="button">
                                📋 Lançamentos
                            </button>
<button class="cob-view-btn" id="cob-view-btn-alunos" onclick="EFCobranca.setVisaoHistorico('alunos')" type="button">
                                👥 Consolidado por Aluno
                            </button>
</div>
</div>
<!-- Mensagem de Vazio -->
<div class="cob-empty" id="cob-history-empty">
<span>📋</span>
<strong>Nenhum pagamento registrado no histórico.</strong>
<p style="font-size:0.84rem; margin-top:0.35rem;">Preencha a calculadora acima e clique em "💾 Registrar Pagamento no Histórico".</p>
</div>
<!-- VISÃO 1: Tabela de Lançamentos Detalhados (com Total e Por Aluno) -->
<div class="cob-table-wrapper hidden" id="cob-view-extrato-wrapper">
<table class="cob-table">
<thead>
<tr>
<th>Data</th>
<th>Aluno(s)</th>
<th>Modalidade</th>
<th>Serviço</th>
<th style="font-weight:800; color:#0f172a;">Valor Total</th>
<th style="font-weight:800; color:#047857;">Valor por Aluno</th>
<th>Forma Pagto</th>
<th>Status</th>
<th style="text-align:right;">Ações</th>
</tr>
</thead>
<tbody id="cob-history-tbody">
<!-- Preenchido dinamicamente via JS -->
</tbody>
<tfoot id="cob-history-tfoot">
<!-- Rodapé com soma total e média por aluno -->
</tfoot>
</table>
</div>
<!-- VISÃO 2: Tabela Consolidada por Aluno -->
<div class="cob-table-wrapper hidden" id="cob-view-alunos-wrapper">
<table class="cob-table">
<thead>
<tr>
<th>Aluno</th>
<th style="text-align:center;">Qtd Avaliações</th>
<th>Total Pago</th>
<th>Total Pendente</th>
<th style="font-weight:800;">Total Geral</th>
<th>Média / Avaliação</th>
<th>Situação</th>
</tr>
</thead>
<tbody id="cob-alunos-tbody">
<!-- Preenchido dinamicamente via JS -->
</tbody>
<tfoot id="cob-alunos-tfoot">
<!-- Rodapé consolidado -->
</tfoot>
</table>
</div>
</div>
</div>
</section>
