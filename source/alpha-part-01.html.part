<style id="ef-print-restore-css">
/* Impressoes individuais e comparativas - Android e desktop.
   O marcador nao altera a tela; aplica-se somente ao papel. */
@media print {
 body.ef-print-report-only > :not(#single-print-wrapper) { display:none !important; }
 body.ef-print-report-only > #single-print-wrapper {
    display:block !important; position:static !important;
    width:100% !important; margin:0 !important; padding:0 !important;
    background:#fff !important; visibility:visible !important;
 }
}
</style>
<style id="ef2-forms-clean-scope">
/* Somente a área Formulários: nenhum seletor do CSS original foi alterado. */
body.ef-simple-ui #tab-btn-ef-forms{display:flex;align-items:center;gap:12px}
body.ef-simple-ui #tab-btn-ef-forms .ef-local-nav-icon{width:20px;height:20px;flex:0 0 20px}
body.ef-simple-ui #tab-btn-ef-forms .ef-local-nav-icon svg{width:20px;height:20px;display:block}
#tab-ef-forms{color:var(--ef-ink)}
#tab-ef-forms .ef2f-shell{width:100%;max-width:1210px;margin:0 auto;padding:14px 0 38px;min-width:0}
#tab-ef-forms :is(input,select,textarea){font:inherit;max-width:100%;min-width:0}
#tab-ef-forms .ef2f-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:18px;margin-bottom:20px}
#tab-ef-forms .ef2f-header h1{font-size:clamp(1.45rem,2.4vw,2rem);letter-spacing:-.035em;margin:3px 0 6px;line-height:1.22;color:var(--ef-ink)}
#tab-ef-forms .ef2f-header p{color:var(--ef-muted);margin:0;max-width:600px;line-height:1.5}
#tab-ef-forms .ef2f-eyebrow{font-size:.68rem;font-weight:750;letter-spacing:.12em;color:var(--ef-accent);text-transform:uppercase}
#tab-ef-forms .ef2f-security{font-size:.79rem;color:var(--ef-muted);margin-bottom:16px;line-height:1.5}
#tab-ef-forms .ef2f-security span{color:var(--ef-accent);font-size:1.1rem;vertical-align:-.05em}
#tab-ef-forms .ef2f-client{display:grid;grid-template-columns:44px minmax(220px,1fr) minmax(140px,auto);gap:15px;align-items:center;border:1px solid var(--ef-line);border-radius:var(--ef-radius-lg,12px);padding:18px 20px;background:var(--ef-surface);margin-bottom:18px}
#tab-ef-forms .ef2f-client-symbol,#tab-ef-forms .ef2f-symbol{display:grid;place-items:center;width:42px;height:42px;border-radius:10px;background:var(--ef-soft);color:var(--ef-accent);flex:none}
#tab-ef-forms .ef2f-client-field{min-width:0}
#tab-ef-forms .ef2f-client-field label{display:block;margin-bottom:7px;font-weight:650;font-size:.79rem;color:var(--ef-ink)}
#tab-ef-forms .ef2f-client-field select{width:100%;max-width:520px;margin:0}
#tab-ef-forms .ef2f-client-state{display:flex;flex-direction:column;gap:4px;min-width:0;text-align:right}
#tab-ef-forms .ef2f-client-state strong{font-size:.84rem;overflow-wrap:anywhere}
#tab-ef-forms .ef2f-client-state span{font-size:.72rem;color:var(--ef-muted)}
#tab-ef-forms .ef2f-tabs{display:flex;gap:5px;align-items:center;padding:5px;border:1px solid var(--ef-line);border-radius:12px;background:var(--ef-soft);width:fit-content;max-width:100%;margin:0 0 24px}
#tab-ef-forms .ef2f-tabs button{display:flex;gap:8px;align-items:center;justify-content:center;border:0;background:transparent;color:var(--ef-muted);font-size:.86rem;font-weight:650;border-radius:9px;padding:11px 17px;cursor:pointer;white-space:nowrap;box-shadow:none}
#tab-ef-forms .ef2f-tabs button.is-active{background:var(--ef-surface);color:var(--ef-ink);box-shadow:0 1px 3px rgba(0,0,0,.06)}
#tab-ef-forms .ef2f-tabs button:focus-visible,#tab-ef-forms .ef2f-model-sub button:focus-visible{outline:2px solid var(--ef-accent);outline-offset:2px}
#tab-ef-forms .ef2f-sectionhead{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin:0 0 18px}
#tab-ef-forms .ef2f-sectionhead h2{font-size:1.18rem;letter-spacing:-.02em;color:var(--ef-ink);margin:0 0 5px}
#tab-ef-forms .ef2f-sectionhead p{margin:0;color:var(--ef-muted);font-size:.86rem;line-height:1.5}
#tab-ef-forms .ef2f-pill,#tab-ef-forms .ef2f-tag{border:1px solid var(--ef-line);border-radius:99px;padding:6px 10px;color:var(--ef-muted);font-size:.72rem;font-weight:600;white-space:nowrap}
#tab-ef-forms .ef2f-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:16px}
#tab-ef-forms .ef2f-search{display:flex;align-items:center;gap:10px;border:1px solid var(--ef-line);background:var(--ef-surface);border-radius:10px;padding:0 13px;max-width:400px;flex:1;color:var(--ef-muted)}
#tab-ef-forms .ef2f-search input{border:0!important;background:transparent!important;box-shadow:none!important;outline:none!important;padding:11px 0!important;width:100%;min-width:0}
#tab-ef-forms .ef2f-model-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
#tab-ef-forms .ef2f-card,#tab-ef-forms .ef2f-paper{background:var(--ef-surface);border:1px solid var(--ef-line);border-radius:var(--ef-radius-lg,13px);box-shadow:none;min-width:0}
#tab-ef-forms .ef2f-model{display:flex;flex-direction:column;padding:21px 22px;gap:0}
#tab-ef-forms .ef2f-model-top{display:flex;align-items:start;justify-content:space-between;margin-bottom:14px}
#tab-ef-forms .ef2f-model h3{font-size:1rem;letter-spacing:-.012em;color:var(--ef-ink);margin:0 0 8px}
#tab-ef-forms .ef2f-model p{font-size:.84rem;color:var(--ef-muted);line-height:1.6;margin:0 0 20px;min-height:42px}
#tab-ef-forms .ef2f-model-footer{margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
#tab-ef-forms .ef2f-model-footer>span{font-size:.75rem;color:var(--ef-muted)}
#tab-ef-forms .ef2f-model-footer>div{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
#tab-ef-forms .ef2f-model-footer .btn,#tab-ef-forms .ef2f-toolbar .btn,#tab-ef-forms .ef2f-form-footer .btn{display:inline-flex;align-items:center;justify-content:center;gap:7px}
#tab-ef-forms .ef2f-model-sub{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:18px;padding-top:14px;border-top:1px solid var(--ef-line)}
#tab-ef-forms .ef2f-model-sub button,#tab-ef-forms .ef2f-back{display:inline-flex;align-items:center;gap:7px;background:none;border:0;box-shadow:none;color:var(--ef-muted);font-size:.79rem;font-weight:600;padding:4px 0;cursor:pointer}
#tab-ef-forms .ef2f-model-sub button:hover,#tab-ef-forms .ef2f-back:hover{color:var(--ef-ink)}
#tab-ef-forms .ef2f-note{font-size:.76rem;color:var(--ef-muted);line-height:1.6;margin-top:18px}
#tab-ef-forms .ef2f-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:11px;min-height:210px;padding:25px;color:var(--ef-muted)}
#tab-ef-forms .ef2f-empty h3{font-size:1.02rem;color:var(--ef-ink);margin:0}
#tab-ef-forms .ef2f-empty p{max-width:350px;line-height:1.5;margin:0}
#tab-ef-forms .ef2f-paper{padding:24px;display:block}
#tab-ef-forms .ef2f-response{display:flex;align-items:center;gap:15px;padding:15px 3px;border-bottom:1px solid var(--ef-line)}
#tab-ef-forms .ef2f-response:last-child{border:0}
#tab-ef-forms .ef2f-response>div:nth-child(2){flex:1;min-width:0;display:flex;flex-direction:column;gap:4px}
#tab-ef-forms .ef2f-response strong{font-size:.91rem;overflow-wrap:anywhere}
#tab-ef-forms .ef2f-response span{font-size:.79rem;color:var(--ef-muted)}
#tab-ef-forms .ef2f-back{margin-bottom:17px}
#tab-ef-forms .ef2f-filled-client{display:flex;align-items:center;gap:8px;border-radius:9px;padding:12px 14px;background:var(--ef-soft);color:var(--ef-ink);margin-bottom:20px;font-size:.82rem;flex-wrap:wrap}
#tab-ef-forms .ef2f-question{display:flex;align-items:flex-start;gap:15px;padding:19px 0;border-bottom:1px solid var(--ef-line)}
#tab-ef-forms .ef2f-question:last-of-type{border:0}
#tab-ef-forms .ef2f-q-index{display:grid;place-items:center;border:1px solid var(--ef-line);border-radius:7px;min-width:35px;height:35px;color:var(--ef-muted);font-weight:700;font-size:.75rem}
#tab-ef-forms .ef2f-q-body{flex:1;min-width:0}
#tab-ef-forms .ef2f-q-body>label{display:block;font-size:.9rem;font-weight:700;margin:0 0 9px;line-height:1.5;color:var(--ef-ink)}
#tab-ef-forms .ef2f-q-body>input,#tab-ef-forms .ef2f-q-body>select,#tab-ef-forms .ef2f-q-body>textarea{width:100%}
#tab-ef-forms .ef2f-form-footer{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-top:22px;padding-top:18px;border-top:1px solid var(--ef-line)}
#tab-ef-forms .ef2f-form-footer span{font-size:.78rem;color:var(--ef-muted);max-width:400px}
#tab-ef-forms .ef2f-form-head{display:grid;grid-template-columns:1fr;gap:15px;padding-bottom:16px;border-bottom:1px solid var(--ef-line)}
#tab-ef-forms .ef2f-field label{display:block;margin:0 0 8px;font-size:.88rem;font-weight:680}
#tab-ef-forms .ef2f-field input,#tab-ef-forms .ef2f-field textarea{width:100%}
#tab-ef-forms .ef2f-builder-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:22px 0 5px;flex-wrap:wrap}
#tab-ef-forms .ef2f-builder-heading h3{font-size:1.02rem;margin:0 0 5px;color:var(--ef-ink)}
#tab-ef-forms .ef2f-builder-heading p{color:var(--ef-muted);margin:0;font-size:.78rem}
#tab-ef-forms .ef2f-build-meta{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:10px}
#tab-ef-forms .ef2f-build-meta>label{font-size:.75rem;color:var(--ef-muted)}
#tab-ef-forms .ef2f-build-meta>select{width:auto;max-width:180px;flex:1;min-width:125px}
#tab-ef-forms .ef2f-build-meta>div{display:flex;gap:4px;margin-left:auto}
#tab-ef-forms .ef2f-mini{background:var(--ef-soft);color:var(--ef-ink);border:1px solid var(--ef-line);border-radius:7px;min-width:30px;height:30px;cursor:pointer}
#tab-ef-forms .ef2f-mini:disabled{opacity:.35;cursor:not-allowed}
#tab-ef-forms .ef2f-answer{border-bottom:1px solid var(--ef-line);padding:14px 0}
#tab-ef-forms .ef2f-answer:last-child{border:0}
#tab-ef-forms .ef2f-answer small{color:var(--ef-muted);font-weight:600}
#tab-ef-forms .ef2f-answer p{margin:9px 0 0;line-height:1.7;overflow-wrap:anywhere;white-space:pre-wrap}
#tab-ef-forms .ef2f-status{font-size:.82rem;color:var(--ef-accent);min-height:0;margin:0}
#tab-ef-forms .ef2f-status:not(:empty){padding:11px 14px;background:var(--ef-soft);border:1px solid var(--ef-line);border-radius:8px;margin:0 0 15px}
@media(max-width:930px){#tab-ef-forms .ef2f-client{grid-template-columns:40px minmax(0,1fr)}#tab-ef-forms .ef2f-client-state{grid-column:2;text-align:left}}
@media(max-width:730px){#tab-ef-forms .ef2f-shell{padding:8px 0 25px}#tab-ef-forms .ef2f-model-grid{grid-template-columns:1fr}#tab-ef-forms .ef2f-header{align-items:start}#tab-ef-forms .ef2f-client{padding:14px;gap:12px}#tab-ef-forms .ef2f-tabs{width:100%}#tab-ef-forms .ef2f-tabs button{flex:1;padding:11px 6px;font-size:.78rem;gap:5px}#tab-ef-forms .ef2f-tabs button svg{width:16px;height:16px}#tab-ef-forms .ef2f-paper{padding:16px}#tab-ef-forms .ef2f-model{padding:17px}#tab-ef-forms .ef2f-toolbar{flex-wrap:wrap}#tab-ef-forms .ef2f-search{max-width:none;flex-basis:100%}#tab-ef-forms .ef2f-response{gap:10px}#tab-ef-forms .ef2f-response .ef2f-symbol{display:none}}
@media(max-width:385px){#tab-ef-forms .ef2f-tabs button{flex-direction:column;gap:3px;font-size:.73rem}#tab-ef-forms .ef2f-client{grid-template-columns:1fr}#tab-ef-forms .ef2f-client-symbol{display:none}#tab-ef-forms .ef2f-client-state{grid-column:1}#tab-ef-forms .ef2f-form-footer .btn{width:100%}}
@media print{#tab-ef-forms{display:none!important}}

/* Biblioteca em três níveis; isolada do CSS original do aplicativo. */
#tab-ef-forms .ef2f-level-filters{display:flex;align-items:center;flex-wrap:wrap;gap:8px;padding:0 0 19px;margin:0 0 4px}
#tab-ef-forms .ef2f-level-filters button{display:inline-flex;gap:9px;align-items:center;justify-content:center;border:1px solid var(--ef-line);border-radius:9px;background:var(--ef-surface);color:var(--ef-muted);box-shadow:none;padding:10px 13px;min-height:39px;font-size:.81rem;font-weight:650;cursor:pointer}
#tab-ef-forms .ef2f-level-filters button.is-selected{color:var(--ef-ink);background:var(--ef-soft);border-color:var(--ef-accent);box-shadow:0 0 0 1px var(--ef-accent) inset}
#tab-ef-forms .ef2f-level-filters button span{font-size:.7rem;border-radius:6px;background:var(--ef-soft);padding:3px 6px;font-weight:650;color:var(--ef-muted)}
#tab-ef-forms .ef2f-level-filters button:focus-visible{outline:2px solid var(--ef-accent);outline-offset:2px}
#tab-ef-forms .ef2f-level-section{margin:0 0 29px}
#tab-ef-forms .ef2f-level-head{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;border-bottom:1px solid var(--ef-line);padding:16px 0 13px;margin-bottom:15px}
#tab-ef-forms .ef2f-level-head h3{font-size:1.15rem;margin:3px 0 5px;color:var(--ef-ink);letter-spacing:-.018em}
#tab-ef-forms .ef2f-level-head p{font-size:.82rem;line-height:1.5;color:var(--ef-muted);margin:0}
#tab-ef-forms .ef2f-level-count{display:inline-flex;align-items:center;white-space:nowrap;border:1px solid var(--ef-line);border-radius:8px;padding:7px 10px;font-size:.72rem;font-weight:650;color:var(--ef-muted)}
#tab-ef-forms .ef2f-field small{display:block;color:var(--ef-muted);font-size:.73rem;margin-top:5px;line-height:1.4}
@media(max-width:560px){#tab-ef-forms .ef2f-level-filters{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}#tab-ef-forms .ef2f-level-filters button{min-width:0;justify-content:space-between;padding:9px 10px;font-size:.79rem}#tab-ef-forms .ef2f-level-head{align-items:flex-start}#tab-ef-forms .ef2f-level-count{margin-left:0}}
/* A barra original utiliza ::before como ícone padrão; removê-lo apenas neste botão para evitar ícone duplicado. */
body.ef-simple-ui #tab-btn-ef-forms::before{display:none!important;content:none!important}


/* Configurações segmentadas: somado ao CSS ORIGINAL sem sobrescrever os blocos existentes. */
#tab-settings .efs-tabs{display:flex;flex-wrap:wrap;gap:7px;padding:5px;margin:2px 0 26px;border-radius:11px;border:1px solid var(--ef-line);background:var(--ef-soft);width:fit-content;max-width:100%}
#tab-settings .efs-tabs button{appearance:none;background:transparent;border:0;border-radius:8px;padding:10px 17px;color:var(--ef-muted);font-size:13px;line-height:1.4;font-weight:650;cursor:pointer;box-shadow:none}
#tab-settings .efs-tabs button.is-active{color:var(--ef-ink);background:var(--ef-surface);box-shadow:0 1px 4px rgba(0,0,0,.055)}
#tab-settings .efs-tabs button:focus-visible{outline:2px solid var(--ef-accent);outline-offset:1px}
#tab-settings .efs-subpage[hidden]{display:none!important}
#tab-settings .efs-section-title{margin:0 0 16px}
#tab-settings .efs-section-title h3{margin:0 0 5px;font-size:17px;font-weight:700;letter-spacing:-.02em;color:var(--ef-ink)}
#tab-settings .efs-section-title p{margin:0;font-size:13px;color:var(--ef-muted)}
#tab-settings .efs-diagnostics-card{padding:21px;display:block}
#tab-settings #ef-setting-diagnostics{width:100%;min-width:0}
#tab-settings .efs-diagnostics-content{width:100%;min-width:0;position:static;box-shadow:none;border:none;padding:0;margin:0;background:transparent;color:var(--ef-ink)}
#tab-settings .efs-diagnostics-content .efdiag-wrap{max-width:none;margin:0;padding:0}
#tab-settings .efs-diagnostics-content .efdiag-head{margin:0 0 14px}
#tab-settings .efs-diagnostics-content .efdiag-head h2{font-size:18px;margin:0 0 5px;color:var(--ef-ink)}
#tab-settings .efs-diagnostics-content .efdiag-head p{margin:0;color:var(--ef-muted);font-size:13px}
#tab-settings .efs-diagnostics-content .efdiag-card{border:0;padding:0;box-shadow:none;background:transparent}
#tab-settings .efs-diagnostics-content .efdiag-actions{display:flex;flex-wrap:wrap;align-items:center;gap:10px}
@media(max-width:650px){#tab-settings .efs-tabs{width:100%}#tab-settings .efs-tabs button{flex:1;min-width:80px;padding:10px 8px;font-size:12px}#tab-settings .efs-diagnostics-card{padding:15px}}
/* Filtros de complexidade das anamneses. */
#tab-ef-forms .ef2f-level-filters{display:flex;flex-wrap:wrap;gap:7px;margin:0 0 18px}
#tab-ef-forms .ef2f-level-filter{display:inline-flex;align-items:center;gap:6px;background:var(--ef-surface);border:1px solid var(--ef-line);color:var(--ef-muted);border-radius:9px;padding:9px 13px;font-size:12px;font-weight:700;cursor:pointer;box-shadow:none}
#tab-ef-forms .ef2f-level-filter.active{color:var(--ef-ink);background:var(--ef-soft);border-color:var(--ef-accent)}
#tab-ef-forms .ef2f-level-filter small{font-size:10px;color:var(--ef-muted);font-variant-numeric:tabular-nums}
#tab-ef-forms .ef2f-level-filter:focus-visible{outline:2px solid var(--ef-accent);outline-offset:2px}
#tab-ef-forms .ef2f-level-block{margin:0 0 25px;min-width:0}
#tab-ef-forms .ef2f-level-heading{display:flex;justify-content:space-between;align-items:center;gap:16px;margin:0 0 14px;padding-top:12px}
#tab-ef-forms .ef2f-level-heading h3{margin:0 0 3px;font-size:17px;font-weight:750;letter-spacing:-.02em;color:var(--ef-ink)}
#tab-ef-forms .ef2f-level-heading p{margin:0;font-size:12px;line-height:1.5;color:var(--ef-muted)}
#tab-ef-forms .ef2f-level-kicker{font-size:10px;font-weight:750;letter-spacing:.09em;text-transform:uppercase;color:var(--ef-accent)}
#tab-ef-forms #ef2x-t-level{width:100%}
@media(max-width:600px){#tab-ef-forms .ef2f-level-filter{padding:8px 9px;font-size:11px}#tab-ef-forms .ef2f-level-heading{align-items:flex-start}#tab-ef-forms .ef2f-level-heading .ef2f-pill{display:none}}

/* O atalho faz parte da ficha e segue as mesmas cores e bordas do app. */
body.ef-simple-ui #ef2f-profile-shortcut{border:1px solid var(--ef-line);background:var(--ef-surface);border-radius:var(--ef-radius,12px);padding:16px;margin:12px 0;display:flex;flex-wrap:wrap;align-items:center;gap:12px}
body.ef-simple-ui #ef2f-profile-shortcut strong{color:var(--ef-ink);font-size:15px}
body.ef-simple-ui #ef2f-profile-shortcut span{color:var(--ef-muted);font-size:13px;flex:1;min-width:170px}
</style>
<style id="efs-settings-layout-fix">
@media screen {
 body.ef-simple-ui #tab-settings .efs-subpage[data-efs-panel="geral"] > .ef-settings-grid {align-items:start}
 body.ef-simple-ui #tab-settings .efs-subpage[data-efs-panel="geral"] .ef-settings-card {height:100%;box-sizing:border-box}
 body.ef-simple-ui #tab-settings .efs-subpage[data-efs-panel="personalizacao"] > .ef-settings-grid #efn-card{grid-column:1/-1;width:100%;box-sizing:border-box}
}
</style>

<style id="efdiag-expanded-only" media="screen">
#ef-setting-diagnostics .efdiag-filters{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:12px 0 16px;}
#ef-setting-diagnostics .efdiag-filters label{color:var(--ef-muted);font-size:13px;font-weight:650;}
#ef-setting-diagnostics .efdiag-filters select{min-height:39px;border:1px solid var(--ef-line);background:var(--ef-surface);color:var(--ef-ink);border-radius:10px;padding:6px 12px;max-width:100%;}
#ef-setting-diagnostics .efdiag-section{margin:16px 0 9px;padding:8px 11px;background:var(--ef-soft);color:var(--ef-ink);border-radius:8px;font-size:13px;font-weight:750;}
#ef-setting-diagnostics .efdiag-legend{color:var(--ef-muted);font-size:12px;line-height:1.5;margin-top:6px;}
#ef-setting-diagnostics .efdiag-actions{flex-wrap:wrap}
#ef-setting-diagnostics .efdiag-repair-wrap{display:grid;gap:14px;margin-top:6px}
#ef-setting-diagnostics .efdiag-repair-banner{display:flex;align-items:flex-start;gap:12px;padding:14px 16px;border:1px solid rgba(16,185,129,.24);background:linear-gradient(135deg,rgba(236,253,245,.95),rgba(248,250,252,.98));border-radius:16px;box-shadow:0 8px 22px rgba(15,23,42,.05)}
#ef-setting-diagnostics .efdiag-repair-banner strong{display:block;color:var(--ef-ink);font-size:14px;margin-bottom:2px}
#ef-setting-diagnostics .efdiag-repair-banner p{margin:0;color:var(--ef-muted);font-size:12px;line-height:1.55}
#ef-setting-diagnostics .efdiag-repair-banner .efdiag-banner-icon{display:grid;place-items:center;inline-size:42px;block-size:42px;border-radius:14px;background:rgba(16,185,129,.12);color:#047857;flex:0 0 auto}
#ef-setting-diagnostics .efdiag-repair-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(168px,1fr));gap:12px}
#ef-setting-diagnostics .efdiag-repair-card{position:relative;overflow:hidden;min-height:152px;padding:16px 14px 14px;border-radius:18px;border:1px solid var(--ef-line);background:linear-gradient(180deg,color-mix(in srgb,var(--ef-soft) 72%, #fff 28%), color-mix(in srgb,var(--ef-surface) 86%, #fff 14%));box-shadow:0 8px 18px rgba(15,23,42,.06);isolation:isolate}
#ef-setting-diagnostics .efdiag-repair-card::before{content:'';position:absolute;inset:auto -22px -28px auto;width:104px;height:104px;border-radius:50%;background:radial-gradient(circle at center, color-mix(in srgb,var(--ef-primary) 18%, transparent) 0%, transparent 72%);opacity:.85;pointer-events:none}
#ef-setting-diagnostics .efdiag-repair-card .efdiag-icon{display:grid;place-items:center;inline-size:44px;block-size:44px;border-radius:14px;background:color-mix(in srgb,var(--ef-primary) 10%, #fff 90%);color:var(--ef-primary);margin-bottom:12px;box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--ef-primary) 16%, transparent)}
#ef-setting-diagnostics .efdiag-repair-card .efdiag-title{display:block;color:var(--ef-ink);font-size:14px;font-weight:800;line-height:1.25;max-width:calc(100% - 4px)}
#ef-setting-diagnostics .efdiag-repair-card .efdiag-meta{display:block;margin-top:6px;color:var(--ef-muted);font-size:12px;line-height:1.45;max-width:calc(100% - 6px)}
#ef-setting-diagnostics .efdiag-repair-card .efdiag-pill{display:inline-flex;align-items:center;gap:6px;margin-top:12px;padding:5px 10px;border-radius:999px;background:color-mix(in srgb,var(--ef-primary) 10%, #fff 90%);color:var(--ef-primary);font-size:11px;font-weight:800}
#ef-setting-diagnostics .efdiag-repair-check{position:absolute;inset:50% auto auto 50%;transform:translate(-50%,-58%);display:grid;place-items:center;inline-size:56px;block-size:56px;border-radius:50%;background:rgba(255,255,255,.72);backdrop-filter:blur(10px) saturate(135%);-webkit-backdrop-filter:blur(10px) saturate(135%);box-shadow:0 10px 24px rgba(15,23,42,.14), inset 0 0 0 1px rgba(255,255,255,.5);color:color-mix(in srgb,var(--ef-primary) 74%, #047857 26%);font-size:28px;font-weight:900;z-index:1;pointer-events:none}
#ef-setting-diagnostics .efdiag-repair-card[data-state='warn'] .efdiag-repair-check{color:#b45309}
#ef-setting-diagnostics .efdiag-repair-card[data-state='fail'] .efdiag-repair-check{color:#b91c1c}
#ef-setting-diagnostics .efdiag-repair-card[data-state='warn'] .efdiag-pill{background:#fef3c7;color:#92400e}
#ef-setting-diagnostics .efdiag-repair-card[data-state='fail'] .efdiag-pill{background:#fee2e2;color:#991b1b}
#ef-setting-diagnostics .efdiag-repair-card[data-state='warn'] .efdiag-icon{background:#fff7ed;color:#b45309;box-shadow:inset 0 0 0 1px rgba(180,83,9,.14)}
#ef-setting-diagnostics .efdiag-repair-card[data-state='fail'] .efdiag-icon{background:#fef2f2;color:#b91c1c;box-shadow:inset 0 0 0 1px rgba(185,28,28,.14)}
#ef-setting-diagnostics .efdiag-repair-details{padding:12px 14px;border-radius:14px;border:1px dashed var(--ef-line);background:color-mix(in srgb,var(--ef-soft) 66%, #fff 34%)}
#ef-setting-diagnostics .efdiag-repair-details h4{margin:0 0 10px;color:var(--ef-ink);font-size:13px;font-weight:800}
#ef-setting-diagnostics .efdiag-repair-list{display:grid;gap:8px}
#ef-setting-diagnostics .efdiag-repair-item{display:grid;grid-template-columns:78px minmax(0,1fr);gap:10px;padding:10px 0;border-top:1px solid color-mix(in srgb,var(--ef-line) 82%, transparent)}
#ef-setting-diagnostics .efdiag-repair-item:first-child{border-top:0;padding-top:0}
#ef-setting-diagnostics .efdiag-repair-item b{display:block;margin-bottom:3px;color:var(--ef-ink);font-size:12px}
#ef-setting-diagnostics .efdiag-repair-item p{margin:0;color:var(--ef-muted);font-size:12px;line-height:1.45}
#ef-setting-diagnostics .efdiag-repair-empty{padding:14px 16px;border-radius:14px;border:1px dashed var(--ef-line);background:color-mix(in srgb,var(--ef-soft) 62%, #fff 38%);color:var(--ef-muted);font-size:12px;line-height:1.5}
@media(max-width:640px){#ef-setting-diagnostics .efdiag-repair-grid{grid-template-columns:repeat(2,minmax(0,1fr));}#ef-setting-diagnostics .efdiag-repair-card{min-height:144px;padding:14px 12px 12px}#ef-setting-diagnostics .efdiag-repair-check{inline-size:48px;block-size:48px;font-size:24px}#ef-setting-diagnostics .efdiag-repair-item{grid-template-columns:68px minmax(0,1fr)}}
@media(max-width:500px){#ef-setting-diagnostics .efdiag-filters{align-items:stretch;flex-direction:column;}#ef-setting-diagnostics .efdiag-filters select{width:100%}#ef-setting-diagnostics .efdiag-actions{gap:8px;}#ef-setting-diagnostics .efdiag-repair-grid{grid-template-columns:1fr;}#ef-setting-diagnostics .efdiag-repair-banner{padding:12px 13px}}
</style>
<style id="ef2-dark-profile-contrast-fix">
/* Correção isolada no resumo/evolução do perfil. CSS original intacto. */
@media screen {
  /* Escopo estrito ao painel do aluno, evitando efeitos nos geradores PDF. */
  :is(html.ef-dark-mode body, body.dark-mode) #patient-view-content .professional-notes-box[style] {
    background: var(--ef-surface, #172821) !important;
    color: var(--ef-ink, #f1f5f9) !important;
    border-color: var(--ef-accent, #34d399) !important;
  }
  :is(html.ef-dark-mode body, body.dark-mode) #patient-view-content .professional-notes-box[style] div[style*="color:#475569"] {
    color: var(--ef-muted, #b8c6c0) !important;
    border-color: var(--ef-line, #365047) !important;
  }
  :is(html.ef-dark-mode body, body.dark-mode) #patient-view-content .ef6-laudo {
    background: var(--ef-surface, #172821) !important;
    color: var(--ef-ink, #f1f5f9) !important;
    border-color: var(--ef-line, #365047) !important;
  }
  :is(html.ef-dark-mode body, body.dark-mode) #patient-view-content .ef6-laudo strong[style*="color:#0f172a"] {
    color: var(--ef-ink, #f1f5f9) !important;
  }
  :is(html.ef-dark-mode body, body.dark-mode) #patient-view-content .ef6-laudo [style*="background:#e2e8f0"] {
    background: var(--ef-line, #365047) !important;
  }
  :is(html.ef-dark-mode body, body.dark-mode) #patient-view-content .ef6-laudo [style*="border-top:1px dashed #cbd5e1"] {
    border-color: var(--ef-line, #365047) !important;
  }
  :is(html.ef-dark-mode body, body.dark-mode) #patient-view-content .ef6-laudo span[style*="border:1px solid #cbd5e1"] {
    border-color: var(--ef-line, #365047) !important;
    color: var(--ef-ink, #f1f5f9) !important;
  }
  :is(html.ef-dark-mode body, body.dark-mode) #patient-view-content #ef56-extra > div[style*="grid-template-columns"] > div {
    background: var(--ef-surface, #172821) !important;
    color: var(--ef-ink, #f1f5f9) !important;
    border-color: var(--ef-line, #365047) !important;
  }
  :is(html.ef-dark-mode body, body.dark-mode) #patient-view-content #ef56-extra svg {
    background: transparent !important;
  }
  :is(html.ef-dark-mode body, body.dark-mode) #patient-view-content #ef56-extra svg text[fill="#1d1d1f"] {
    fill: var(--ef-ink, #f1f5f9) !important;
  }
  :is(html.ef-dark-mode body, body.dark-mode) #patient-view-content #ef56-extra svg text[fill="#86868b"] {
    fill: var(--ef-muted, #b8c6c0) !important;
  }
  :is(html.ef-dark-mode body, body.dark-mode) #patient-view-content #ef56-extra svg circle[fill="#fff"] {
    fill: var(--ef-surface, #172821) !important;
  }
  :is(html.ef-dark-mode body, body.dark-mode) #patient-view-content #ef56-extra .btn-secondary {
    background: var(--ef-soft, #243b32) !important;
    color: var(--ef-ink, #f1f5f9) !important;
    border-color: var(--ef-line, #365047) !important;
  }
}
</style>
<style id="ef-proto-style">
/* EvoluFísico — laboratório de cards. Escopo estrito ao painel inicial. */
@media screen {
 body.ef-simple-ui #tab-painel #ef55-painel,
 body.ef-simple-ui #tab-painel #ef55-painel .ef90-home {max-width:none!important;width:100%!important;min-width:0!important}
 body.ef-simple-ui #tab-painel .ef-proto-dashboard{display:block!important;min-width:0!important;width:100%!important;max-width:none!important;overflow:visible!important}
 body.ef-simple-ui #tab-painel .ef-proto-row{display:grid!important;grid-template-columns:repeat(var(--ef-proto-cols,2),minmax(0,1fr))!important;gap:14px!important;align-items:start!important;width:100%!important;max-width:none!important;margin:0 0 14px!important}
 body.ef-simple-ui #tab-painel .ef-proto-row:last-child{margin-bottom:0!important}
 body.ef-simple-ui #tab-painel .ef-proto-dashboard > [data-ef-proto-width="full"]{margin-bottom:14px!important}
 body.ef-simple-ui #tab-painel .ef-proto-dashboard > [data-ef-proto-width="full"]:last-child{margin-bottom:0!important}
 body.ef-simple-ui #tab-painel .ef-proto-lane{display:flex!important;flex-direction:column!important;gap:14px!important;align-items:stretch!important;min-width:0!important;width:100%!important}
 body.ef-simple-ui #tab-painel .ef-proto-card{display:block!important;position:relative!important;box-sizing:border-box!important;max-width:none!important;width:100%!important;min-width:0!important;height:auto!important;max-height:none!important;overflow:visible!important;margin:0!important;grid-column:auto!important;transition:box-shadow .15s ease,outline-color .15s ease!important}
 body.ef-simple-ui #tab-painel details.ef-proto-card{display:block!important}
 body.ef-simple-ui #tab-painel .ef-proto-analysis-card > details{margin:0!important;padding:0!important;border:0!important;box-shadow:none!important;background:transparent!important;max-width:none!important}
 body.ef-simple-ui #tab-painel .ef-proto-card.ef-proto-editing{outline:1px dashed var(--ef-accent,#376f5a)!important;outline-offset:-3px!important;padding-top:var(--ef-proto-control-space,74px)!important}
 body.ef-simple-ui #tab-painel .ef-proto-card.ef-proto-over{box-shadow:0 0 0 3px var(--ef-accent,#376f5a)!important}
 body.ef-simple-ui #tab-painel .ef-proto-card.ef-proto-dragged{opacity:.62!important}
 body.ef-simple-ui #tab-painel #ef-home-analysis:empty{display:none!important}
 body.ef-simple-ui #tab-painel .ef-proto-toolbar{display:flex!important;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:9px;padding:11px 14px!important;margin:10px 0 15px!important;border-radius:12px;background:var(--ef-surface,#ffffff);border:1px solid var(--ef-line,#d4ded7);color:var(--ef-ink,#16342b);box-shadow:0 2px 12px #142d1f0a}
 body.ef-simple-ui #tab-painel .ef-proto-toolbar .ef-proto-left,body.ef-simple-ui #tab-painel .ef-proto-toolbar .ef-proto-right{display:flex;align-items:center;flex-wrap:wrap;gap:7px;min-width:0}
 body.ef-simple-ui #tab-painel .ef-proto-toolbar strong{font-size:13px}
 body.ef-simple-ui #tab-painel .ef-proto-toolbar small{font-size:11px;color:var(--ef-muted,#52655d)}
 body.ef-simple-ui #tab-painel .ef-proto-toolbar button,
 body.ef-simple-ui #tab-painel .ef-proto-tools button,
 body.ef-simple-ui #tab-painel .ef-proto-tools select{font:inherit;font-weight:650;font-size:11.5px;line-height:1.3!important;background:var(--ef-soft,#eff5f1)!important;color:var(--ef-ink,#153b2b)!important;border:1px solid var(--ef-line,#bfcfc6)!important;border-radius:8px!important;min-height:31px!important;max-width:100%;padding:5px 8px!important;cursor:pointer!important;box-shadow:none!important;white-space:normal!important}
 body.ef-simple-ui #tab-painel .ef-proto-toolbar .ef-proto-primary{background:var(--ef-accent,#226448)!important;color:white!important;border-color:transparent!important}
 body.ef-simple-ui #tab-painel .ef-proto-tools{position:absolute!important;top:8px;left:9px;right:9px;display:flex;flex-wrap:wrap;gap:5px;justify-content:flex-end;align-items:center;min-width:0;z-index:5;background:var(--ef-surface,#fff);border:1px solid var(--ef-line,#d3dcd5);border-radius:8px;padding:5px!important;box-shadow:0 4px 12px #0d2c1a10}
 body.ef-simple-ui #tab-painel .ef-proto-tools .ef-proto-drag{display:inline-flex!important;align-items:center;justify-content:center;padding:6px 8px!important;background:var(--ef-soft,#eef4f0)!important;border:1px dashed var(--ef-accent,#376f5a)!important;border-radius:7px;color:var(--ef-ink,#183b2a);font-weight:700;font-size:12px;cursor:grab;user-select:none;touch-action:pan-y}
 body.ef-simple-ui #tab-painel .ef-proto-tools .ef-proto-drag:active{cursor:grabbing}
 body.ef-simple-ui #tab-painel .ef-proto-tools .ef-proto-position{width:75px;min-width:70px}
 body.ef-simple-ui #tab-painel .ef-proto-tools button:disabled{opacity:.4;cursor:default!important}
 body.ef-simple-ui #tab-painel .ef-proto-toolbar button:focus-visible,
 body.ef-simple-ui #tab-painel .ef-proto-tools :is(button,select,span):focus-visible{outline:2px solid var(--ef-accent,#357957)!important;outline-offset:2px}
 body.ef-simple-ui #tab-painel .ef-proto-card .ef-proto-grip{display:none;position:absolute;right:0;bottom:0;width:28px;height:28px;border-radius:5px 0 10px 0;cursor:ns-resize;z-index:6;touch-action:none;align-items:end;justify-content:end;padding:5px;background:linear-gradient(135deg,transparent 55%,var(--ef-accent,#347754) 56%);box-shadow:none!important}
 body.ef-simple-ui #tab-painel .ef-proto-editing .ef-proto-grip{display:flex}
 body.ef-simple-ui #tab-painel .ef-proto-editing.ef-proto-resizing{user-select:none;transition:none!important}
 body.ef-simple-ui #tab-painel .ef-proto-status{flex-basis:100%;font-size:11px;color:var(--ef-muted,#56665e);margin:0;padding:0}
 body.ef-simple-ui #tab-painel .ef-proto-note{font-size:11px;color:var(--ef-muted,#52645b)}
 body.ef-simple-ui #tab-painel .ef-proto-card.ef-proto-editing summary{max-width:100%;overflow-wrap:anywhere}
 @media(max-width:920px){body.ef-simple-ui #tab-painel .ef-proto-row{grid-template-columns:minmax(0,1fr)!important}body.ef-simple-ui #tab-painel .ef-proto-toolbar{align-items:start}}
 @media(max-width:650px){body.ef-simple-ui #tab-painel .ef-proto-card.ef-proto-editing{padding-top:var(--ef-proto-control-space,116px)!important}body.ef-simple-ui #tab-painel .ef-proto-tools{justify-content:flex-start}body.ef-simple-ui #tab-painel .ef-proto-tools .ef-proto-drag{display:none!important}body.ef-simple-ui #tab-painel .ef-proto-toolbar{padding:10px!important}body.ef-simple-ui #tab-painel .ef-proto-toolbar small{flex-basis:100%}}
}
@media print{#ef-proto-toolbar,.ef-proto-tools,.ef-proto-grip{display:none!important}body.ef-simple-ui #tab-painel .ef-proto-card{min-height:0!important;outline:none!important;padding-top:initial!important}}

</style>
<style id="ef-proto-fix-styles">
/* Ajustes de fluxo: destaque transitório após usar Hoje. */
@media screen {
  body.ef-simple-ui #tab-painel .ef-today-highlight {outline:3px solid var(--ef-accent,#236d54)!important;outline-offset:3px!important;scroll-margin-top:105px;transition:outline-color .2s ease!important}
  body.ef-simple-ui #tab-painel .ef90-hero-actions {display:flex!important;justify-content:flex-end!important;flex-wrap:wrap!important;gap:8px!important}
  .efn-background-info {margin-top:10px!important;line-height:1.55!important}
  .efn-background-info b {font-weight:750}
}
</style>

<style id="ef-proto-compact-styles">
/* Tamanho real e reversível dos dois cards, inclusive fora do modo organizar. */
@media screen {
 body.ef-simple-ui #tab-painel .ef-proto-compact-actions {
  display:flex!important;align-items:center;justify-content:flex-end;gap:5px;
  flex:0 0 auto;min-width:0;max-width:100%;margin:0 0 5px auto;
 }
 body.ef-simple-ui #tab-painel .ef-proto-compact-actions button {
  display:inline-grid!important;place-items:center!important;
  width:32px;min-width:32px!important;height:32px;min-height:32px!important;
  padding:0!important;border:1px solid var(--ef-line,#ccd8d0)!important;
  border-radius:8px!important;background:var(--ef-soft,#eef5f0)!important;
  color:var(--ef-ink,#183b2e)!important;font-size:19px!important;
  font-weight:700!important;line-height:1!important;box-shadow:none!important;cursor:pointer;
 }
 body.ef-simple-ui #tab-painel .ef-proto-compact-actions button:disabled{opacity:.32!important;cursor:default!important}
 body.ef-simple-ui #tab-painel .ef-proto-compact-actions button:focus-visible,
 body.ef-simple-ui #tab-painel .ef-proto-day-toggle:focus-visible{outline:2px solid var(--ef-accent,#267e59)!important;outline-offset:2px}
 body.ef-simple-ui #tab-painel .ef-proto-compact-label {
  display:inline-block;text-align:center;min-width:89px;padding:3px 7px;
  color:var(--ef-muted,#52655a);font-size:11px;font-weight:700;
 }
 body.ef-simple-ui #tab-painel [data-ef-proto-card="calendario"] .ef90-section-head{row-gap:8px!important}
 body.ef-simple-ui #tab-painel [data-ef-proto-card="calendario"] .ef90-section-head .ef-proto-compact-actions{margin:0} body.ef-simple-ui #tab-painel [data-ef-proto-card="detalhes"] > .ef-proto-compact-actions{margin-bottom:8px}
 body.ef-simple-ui #tab-painel [data-ef-proto-card="calendario"][data-ef-compact-level="1"] .ef90-cal-day {
  min-height:45px!important;padding:5px 6px!important;border-radius:9px!important;gap:1px!important;
 }
 body.ef-simple-ui #tab-painel [data-ef-proto-card="calendario"][data-ef-compact-level="0"] .ef90-cal-day {
  min-height:30px!important;padding:3px 5px!important;border-radius:7px!important;gap:0!important;
 }
 body.ef-simple-ui #tab-painel [data-ef-proto-card="calendario"]:is([data-ef-compact-level="0"],[data-ef-compact-level="1"]) .ef90-calendar-grid{gap:4px!important}
 body.ef-simple-ui #tab-painel [data-ef-proto-card="calendario"]:is([data-ef-compact-level="0"],[data-ef-compact-level="1"]) .ef90-cal-day .num{font-size:12px!important;line-height:1.1!important}
 body.ef-simple-ui #tab-painel [data-ef-proto-card="calendario"]:is([data-ef-compact-level="0"],[data-ef-compact-level="1"]) .ef90-cal-day small{display:none!important}
 body.ef-simple-ui #tab-painel [data-ef-proto-card="calendario"]:is([data-ef-compact-level="0"],[data-ef-compact-level="1"]) .ef90-cal-day .dots{min-height:6px!important;gap:2px!important;margin-top:auto}
 body.ef-simple-ui #tab-painel [data-ef-proto-card="calendario"]:is([data-ef-compact-level="0"],[data-ef-compact-level="1"]) .ef90-cal-day .dots i{height:5px;width:5px}
 body.ef-simple-ui #tab-painel [data-ef-proto-card="calendario"][data-ef-compact-level="1"] .ef90-day-panel{max-height:250px;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin}
 body.ef-simple-ui #tab-painel [data-ef-proto-card="calendario"]:is([data-ef-compact-level="0"],[data-ef-compact-level="1"])[data-ef-proto-day-open="false"] .ef90-day-panel{display:none!important}
 body.ef-simple-ui #tab-painel [data-ef-proto-card="calendario"]:is([data-ef-compact-level="0"],[data-ef-compact-level="1"])[data-ef-proto-day-open="true"] .ef90-day-panel{max-height:220px;overflow-y:auto;overscroll-behavior:contain}
 body.ef-simple-ui #tab-painel [data-ef-proto-card="calendario"] .ef-proto-day-toggle{
  display:none!important;width:100%;text-align:center;margin:10px 0 0!important;
  padding:9px 11px!important;background:var(--ef-soft,#eef5f0)!important;
  color:var(--ef-ink,#183b2e)!important;border:1px solid var(--ef-line,#d4ded7)!important;
  border-radius:8px!important;font-size:12px!important;font-weight:700!important;cursor:pointer;
 }
 body.ef-simple-ui #tab-painel [data-ef-proto-card="calendario"]:is([data-ef-compact-level="0"],[data-ef-compact-level="1"]) .ef-proto-day-toggle{display:block!important}
 body.ef-simple-ui #tab-painel [data-ef-proto-card="detalhes"][data-ef-compact-level="1"] #ef-home-deep > .ef-simple-fold-content{
  max-height:285px!important;overflow-y:auto!important;overscroll-behavior:contain;scrollbar-width:thin;
  padding-right:8px!important;
 }
 body.ef-simple-ui #tab-painel [data-ef-proto-card="calendario"][data-ef-compact-level="0"] .ef90-section-head p{display:none!important}
 body.ef-simple-ui #tab-painel [data-ef-proto-card="detalhes"] .ef-proto-compact-actions{flex-wrap:nowrap}
 @media(max-width:640px){
  body.ef-simple-ui #tab-painel .ef-proto-compact-actions{justify-content:flex-start}
  body.ef-simple-ui #tab-painel [data-ef-proto-card="calendario"] .ef90-section-head .ef-proto-compact-actions{flex:1 1 100%;justify-content:flex-end}
  body.ef-simple-ui #tab-painel .ef-proto-compact-label{min-width:78px}
 }
}
@media print{.ef-proto-compact-actions,.ef-proto-day-toggle{display:none!important}
 #tab-painel [data-ef-proto-card="calendario"] .ef90-day-panel{display:block!important;max-height:none!important;overflow:visible!important}
 #tab-painel [data-ef-proto-card="detalhes"] .ef-simple-fold-content{max-height:none!important;overflow:visible!important}
}
</style>
<style id="ef-unified-analysis-styles">
/* Relatório por aluno, integrado à identidade visual do EvoluFísico. */
#ef-home-insights.ef-unified{display:block;overflow:visible;min-width:0;border:0;background:transparent;box-shadow:none}
#ef-home-insights > summary{display:none!important}
.ef-unified *{box-sizing:border-box}
.ef-unified .efu-header{display:flex;gap:14px;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;margin-bottom:13px}
.ef-unified .efu-heading{min-width:175px;flex:1 1 230px}
.ef-unified h3{font-size:1.1rem;font-weight:750;margin:0 0 5px;line-height:1.35;color:var(--ef-ink,#172d25)}
.ef-unified .efu-subtitle{font-size:.79rem;line-height:1.5;color:var(--ef-muted,#667a70);margin:0;max-width:600px}
.ef-unified .efu-selector{display:flex;flex-direction:column;gap:6px;flex:0 1 295px;min-width:175px;max-width:100%;font-size:.76rem;color:var(--ef-ink,#25362c);font-weight:650}
.ef-unified .efu-selector select{width:100%;min-width:0;min-height:38px;max-width:100%;border-radius:9px;border:1px solid var(--ef-line,#dce4de);background:var(--ef-card,#fff);color:var(--ef-ink,#16291e);padding:7px 28px 7px 11px;font:inherit;font-size:.84rem}
.ef-unified .efu-controls{flex:0 1 305px;min-width:190px;max-width:100%;display:grid;gap:7px}
.ef-unified .efu-controls .efu-selector{min-width:0;max-width:none;flex:initial}
.ef-unified .efu-links{display:flex;flex-wrap:wrap;gap:6px}
.ef-unified .efu-links .efu-action{flex:1 1 115px}
.ef-unified .efu-selector select:focus-visible,.ef-unified button:focus-visible,.ef-unified summary:focus-visible{outline:2px solid var(--ef-accent,#1684a7);outline-offset:2px}
.ef-unified .efu-context{display:flex;flex-wrap:wrap;align-items:center;gap:7px;margin:0 0 14px;color:var(--ef-muted,#61746a);font-size:.73rem}
.ef-unified .efu-chip{display:inline-flex;align-items:center;padding:5px 9px;border-radius:7px;border:1px solid var(--ef-line,#dfe6e1);background:var(--ef-soft,#f4f8f5);font-weight:600;color:var(--ef-ink,#25362c)}
.ef-unified .efu-kpis{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-bottom:12px}
.ef-unified .efu-kpi{min-width:0;border:1px solid var(--ef-line,#dce6df);border-radius:12px;background:var(--ef-soft,#f5f8f6);padding:12px 13px;display:flex;flex-direction:column;gap:5px}
.ef-unified .efu-kpi small{font-size:.7rem;font-weight:600;color:var(--ef-muted,#667b70);line-height:1.25}
.ef-unified .efu-kpi strong{color:var(--ef-ink,#172b20);font-size:1.25rem;font-weight:750;line-height:1.2;overflow-wrap:anywhere}
.ef-unified .efu-kpi span{font-size:.68rem;line-height:1.35;color:var(--ef-muted,#607568)}
.ef-unified .efu-section{border:1px solid var(--ef-line,#dfe5e0);border-radius:11px;margin-top:10px;overflow:hidden;background:var(--ef-card,#fff);min-width:0}
.ef-unified .efu-section > summary{list-style:none;display:flex;justify-content:space-between;align-items:center;gap:9px;min-height:44px;padding:10px 12px;cursor:pointer;font-size:.82rem;font-weight:750;color:var(--ef-ink,#23372a);user-select:none}
.ef-unified .efu-section > summary::-webkit-details-marker{display:none}
.ef-unified .efu-section > summary:after{content:'⌄';transition:transform .15s;color:var(--ef-muted,#64766e)}
.ef-unified .efu-section[open] > summary:after{transform:rotate(180deg)}
.ef-unified .efu-section[open] > summary{border-bottom:1px solid var(--ef-line,#dfe5e0)}
.ef-unified .efu-section-body{padding:11px 12px;min-width:0}
.ef-unified .efu-measure-title{font-size:.76rem;margin:8px 0 7px;color:var(--ef-ink,#20352b)}
.ef-unified .efu-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.ef-unified .efu-metric{min-width:0;border-radius:9px;background:var(--ef-soft,#f3f7f4);padding:10px 11px}
.ef-unified .efu-metric small{display:block;font-size:.68rem;color:var(--ef-muted,#607468);margin-bottom:5px}
.ef-unified .efu-metric strong{font-size:.87rem;font-weight:700;color:var(--ef-ink,#1b3324)}
.ef-unified .efu-metric span{display:block;margin-top:4px;font-size:.7rem;color:var(--ef-muted,#61756a)}
.ef-unified .efu-notice{font-size:.75rem;line-height:1.55;color:var(--ef-muted,#65766b);margin:5px 0}
.ef-unified .efu-findings{display:grid;gap:8px}
.ef-unified .efu-finding{border-radius:9px;padding:9px 10px;border:1px solid var(--ef-line,#e2e6e3);background:var(--ef-soft,#f6f9f6);min-width:0}
.ef-unified .efu-finding b{display:block;color:var(--ef-ink,#20352b);font-size:.78rem;line-height:1.35}
.ef-unified .efu-finding p{margin:5px 0 0;color:var(--ef-muted,#617369);font-size:.73rem;line-height:1.45}
.ef-unified .efu-finding[data-severity="warn"]{border-left:3px solid #dfaa4d}
.ef-unified .efu-finding[data-severity="good"]{border-left:3px solid #3a9f77}
.ef-unified .efu-finding[data-severity="info"]{border-left:3px solid #7195b7}
.ef-unified .efu-history{overflow:auto;max-height:260px;overscroll-behavior:contain}
.ef-unified .efu-history table{width:100%;min-width:380px;border-collapse:collapse;font-size:.72rem}
.ef-unified .efu-history th,.ef-unified .efu-history td{padding:9px 7px;text-align:left;border-bottom:1px solid var(--ef-line,#dae3de);white-space:nowrap;color:var(--ef-ink,#213c2a)}
.ef-unified .efu-history th{color:var(--ef-muted,#69766f);font-weight:700}
.ef-unified .efu-action{border:1px solid var(--ef-line,#dbe5df);background:var(--ef-soft,#e9f3ed);color:var(--ef-ink,#24513a);border-radius:8px;padding:7px 10px;cursor:pointer;font:inherit;font-size:.72rem;font-weight:650;min-height:32px}
.ef-unified .efu-foot{margin:12px 0 0;color:var(--ef-muted,#627369);font-size:.68rem;line-height:1.5}
.ef-unified .efu-empty{padding:20px 12px;border:1px dashed var(--ef-line,#dae1db);border-radius:10px;color:var(--ef-muted,#566c5f);font-size:.82rem;line-height:1.6}
@media(min-width:1200px){.ef-unified .efu-kpis{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:540px){.ef-unified .efu-header{display:block}.ef-unified .efu-controls{margin-top:12px;max-width:none}.ef-unified .efu-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.ef-unified .efu-metrics{grid-template-columns:1fr}.ef-unified .efu-kpi{padding:10px}.ef-unified .efu-kpi strong{font-size:1.06rem}.ef-unified .efu-section-body{padding:9px}}
@media(max-width:340px){.ef-unified .efu-kpis{grid-template-columns:1fr}}
html.ef-dark-mode .ef-unified .efu-section,html.ef-dark-mode .ef-unified .efu-selector select{background:#202b3b;color:#eef4ff;border-color:#37465c}
html.ef-dark-mode .ef-unified .efu-kpi,html.ef-dark-mode .ef-unified .efu-metric,html.ef-dark-mode .ef-unified .efu-chip,html.ef-dark-mode .ef-unified .efu-finding{background:#182332;border-color:#3d4b61}
html.ef-dark-mode .ef-unified :is(h3,.efu-section>summary,.efu-kpi strong,.efu-metric strong,.efu-finding b,.efu-selector,.efu-history td,.efu-action){color:#ecf3ff}
html.ef-dark-mode .ef-unified :is(.efu-subtitle,.efu-context,.efu-kpi small,.efu-kpi span,.efu-metric small,.efu-metric span,.efu-finding p,.efu-notice,.efu-foot,.efu-history th){color:#b4c1d5}
html.ef-dark-mode .ef-unified .efu-action{background:#24364c;border-color:#45516a}
@media print{.ef-unified .efu-action,.ef-unified .efu-selector{display:none!important}}
</style>

<style id="ef-review-enhancements">/* Refinamentos solicitados: paletas fortes, comandos somente em organização, relatório de análise. */
@media screen {
 body.ef-simple-ui #tab-painel .ef-proto-toolbar{justify-content:flex-end!important;padding:9px 12px!important;margin:10px 0 14px!important}
 body.ef-simple-ui #tab-painel .ef-proto-toolbar .ef-proto-left,body.ef-simple-ui #tab-painel .ef-proto-toolbar .ef-proto-status{display:none!important}
 body.ef-simple-ui #tab-painel .ef-proto-toolbar .ef-proto-right{width:100%;justify-content:flex-end}
 body.ef-simple-ui #tab-painel [data-ef-proto-card]:not(.ef-proto-editing) > .ef-proto-tools,
 body.ef-simple-ui #tab-painel [data-ef-proto-card]:not(.ef-proto-editing) > .ef-proto-grip{display:none!important}
 body.ef-simple-ui #tab-painel #efu-student-select{scroll-margin-top:120px}
 .ef-colors-list{display:flex!important;flex-wrap:wrap!important;gap:9px!important}
 .efu-report-overlay{position:fixed;z-index:2147482000;inset:0;background:rgba(12,26,38,.68);padding:20px;display:grid;place-items:center;overscroll-behavior:contain}
 .efu-report-modal{width:min(920px,100%);max-height:min(92dvh,1000px);display:flex;flex-direction:column;border-radius:14px;background:var(--ef-card,#fff);box-shadow:0 24px 80px #0c1b2b50;border:1px solid var(--ef-line,#d5dfe5);overflow:hidden;color:var(--ef-ink,#1d3543)}
 .efu-report-head,.efu-report-footer{display:flex;gap:12px;align-items:center;justify-content:space-between;padding:16px 20px;background:var(--ef-soft,#f1f5f8);flex-wrap:wrap}
 .efu-report-head{border-bottom:1px solid var(--ef-line,#d9e2e8)}
 .efu-report-head h2{font-size:20px;color:var(--ef-ink,#1b344a);margin:3px 0}.efu-report-head small{font-size:11px;letter-spacing:1.1px;text-transform:uppercase;font-weight:750;color:var(--ef-muted,#53748b)}.efu-report-head p{margin:0;font-size:12px;color:var(--ef-muted,#63788a)}
 .efu-report-head button,.efu-report-footer button{border:1px solid var(--ef-line,#bfcfdb);border-radius:8px;background:var(--ef-card,#fff);padding:10px 13px;font:inherit;font-size:12px;font-weight:700;cursor:pointer;color:var(--ef-ink,#1d3444)}
 .efu-report-footer button.efu-report-primary{background:#1c5d89;color:#fff;border-color:#1c5d89}
 .efu-report-content{padding:15px 20px;overflow-y:auto;overscroll-behavior:contain;display:grid;gap:12px;min-height:0}
 .efu-report-hint,.efu-report-alert{font-size:12px;line-height:1.5;margin:0;color:var(--ef-muted,#52667a)}.efu-report-alert{padding:10px 12px;background:#fff2d7;border:1px solid #c99140;border-radius:7px;color:#624416}
 .efu-report-label{display:grid;gap:6px;font-size:13px;color:var(--ef-ink,#263a4d);font-weight:700}
 .efu-report-label input,.efu-report-label textarea{resize:vertical;width:100%;min-width:0;padding:11px 12px;border:1px solid var(--ef-line,#b5c6d0);border-radius:8px;background:var(--ef-card,#fff);color:var(--ef-ink,#183043);font:400 13px/1.5 system-ui,Arial,sans-serif}
 .efu-report-label textarea{min-height:100px}.efu-report-label :focus-visible{outline:2px solid var(--ef-selected-color,#376a9a);outline-offset:1px}
 .efu-report-alert-small{font-size:11px;color:var(--ef-muted,#64798b);margin-right:auto}
 .ef-unified .efu-lab-evidence{border-left:3px solid var(--ef-selected-color,#2f6489);border-radius:8px;padding:10px 12px;background:var(--ef-soft,#f1f5f7);font-size:.75rem;line-height:1.5}
 .ef-unified .efu-lab-evidence strong{display:block;margin-bottom:4px;color:var(--ef-ink,#1d3545)}
 .ef-unified .efu-report-start{background:#235e86;color:white;border-color:#235e86}
 html.ef-dark-mode .efu-report-modal{background:#202b3b;color:#f0f4fc;border-color:#3c506a}
 html.ef-dark-mode .efu-report-head,html.ef-dark-mode .efu-report-footer{background:#182432}
 html.ef-dark-mode .efu-report-hint{color:#b9c6d4}
 html.ef-dark-mode .efu-report-alert{background:#3e3219;color:#ffe7b5;border-color:#a77b2d}
 html.ef-dark-mode .efu-report-footer button:not(.efu-report-primary){background:#26394e;color:#f0f4fc;border-color:#51657a}
 }
@media(max-width:650px){.efu-report-overlay{padding:6px}.efu-report-modal{max-height:96dvh;border-radius:10px}.efu-report-head,.efu-report-footer{padding:10px 12px}.efu-report-content{padding:10px 12px}.efu-report-footer button{flex:1 1 145px}}
@media print{.efu-report-overlay{display:none!important}}
</style>
<style id="ef-unified-safety-style">
.efu-safety-notes{padding:14px 16px;margin:10px 0 17px;border:1px solid var(--ef-line,#cbd5e1);border-left:4px solid #b7791f;border-radius:12px;background:var(--ef-soft,#f6f8fa);color:var(--ef-ink,#1f2937)}
.efu-safety-notes strong{display:block;margin-bottom:6px;font-weight:700}.efu-safety-notes ul{margin:0;padding-left:20px}.efu-safety-notes li{margin:5px 0;line-height:1.5;font-size:13px}
@media(max-width:520px){.efu-safety-notes{padding:12px;font-size:12px}}
</style><style id="ef-analyses-page-styles">/* EvoluFisico 1.0 — modulo Analises Automaticas, resumo e paletas profissionais. */
@media screen {
 body.ef-simple-ui #tab-analises.ef-analyses-page{max-width:none!important;width:100%!important;min-width:0;box-sizing:border-box;padding:20px clamp(14px,2.8vw,42px) 44px!important;}
 #tab-analises .ef-analyses-heading{display:flex;justify-content:space-between;gap:18px;align-items:center;margin:0 0 20px;flex-wrap:wrap}
 #tab-analises .ef-analyses-heading h1{margin:3px 0 7px;color:var(--ef-ink);font-size:clamp(1.5rem,2.5vw,2.2rem);line-height:1.25}
 #tab-analises .ef-analyses-heading p{margin:0;color:var(--ef-muted);line-height:1.55;max-width:740px;font-size:.9rem}
 .ef-analyses-overline{font-size:.68rem;letter-spacing:.11em;font-weight:800;color:var(--ef-accent)}
 .ef-analyses-tag{white-space:nowrap;border:1px solid var(--ef-line);border-radius:8px;background:var(--ef-soft);color:var(--ef-muted);padding:8px 12px;font-size:.75rem}
 #ef-analysis-container{width:100%;min-width:0;margin:0 auto;max-width:1700px}
 #tab-analises #ef-home-insights{display:block!important;width:100%!important;max-width:none!important;margin:0!important;background:var(--ef-surface,#fff);color:var(--ef-ink);border-radius:12px;border:1px solid var(--ef-line);box-sizing:border-box}
 #tab-analises #ef-home-insights>summary{display:none!important}
 #tab-analises .efu-root{padding:clamp(12px,2vw,26px)}
 #tab-analises .efu-heading h3{margin:0 0 7px}
 #tab-analises .efu-header{scroll-margin-top:15px}
 #ef-analyses-quick{width:100%;box-sizing:border-box;display:flex;flex-wrap:wrap;align-items:center;gap:13px;border:1px solid var(--ef-line);border-radius:12px;background:var(--ef-surface);padding:15px 18px;margin:14px 0 19px;color:var(--ef-ink)}
 #ef-analyses-quick .ef-analyses-quick-icon{border-radius:10px;background:var(--ef-soft);color:var(--ef-accent);width:43px;height:43px;display:grid;place-items:center;font-size:22px;flex:none}
 #ef-analyses-quick .ef-analyses-quick-copy{display:flex;flex-direction:column;gap:4px;flex:1 1 220px;min-width:0}
 #ef-analyses-quick .ef-analyses-quick-copy strong{font-size:.94rem}
 #ef-analyses-quick .ef-analyses-quick-copy span{font-size:.79rem;color:var(--ef-muted);line-height:1.45}
 #ef-analyses-quick .ef-analyses-open{border-radius:8px;border:1px solid var(--ef-line);background:var(--ef-soft);color:var(--ef-ink);padding:10px 15px;font-weight:700;cursor:pointer}
 #ef-analyses-quick .ef-analyses-open:hover{border-color:var(--ef-accent);color:var(--ef-accent)}
 #ef-analyses-quick .ef-analyses-open:focus-visible{outline:2px solid var(--ef-accent);outline-offset:2px}
 #tab-analises .efu-header{display:block!important;margin-bottom:22px}
 #tab-analises .efu-heading{max-width:none!important;margin-bottom:16px}
 #tab-analises .efu-subtitle{max-width:900px}
 #tab-analises .efu-controls{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px!important;max-width:none!important;min-width:0!important;width:100%!important}
 #tab-analises .efu-controls>.efu-selector{grid-column:1;max-width:none!important}
 #tab-analises .efu-controls>.efu-demo-bar{grid-column:2;align-self:stretch}
 #tab-analises .efu-controls>.efu-sample-picker,#tab-analises .efu-controls>.efu-links{grid-column:1/-1;width:100%!important}
 #tab-analises .efu-controls,#tab-analises .efu-sample-picker,#tab-analises .efu-links{min-width:0;max-width:100%;box-sizing:border-box}
 #tab-analises .efu-date-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;min-width:0} 
 #tab-analises .efu-date-grid{min-width:0}
 /* Dark variant contrast: keep very dark selection usable in light and dark surfaces. */
 [data-ef-palette="azul-marinho"]{--ef-palette-ink:#233f68}
 [data-ef-palette="petroleo"]{--ef-palette-ink:#145c68}
 [data-ef-palette="esmeralda"]{--ef-palette-ink:#17624e}
 [data-ef-palette="indigo"]{--ef-palette-ink:#343f79}
 [data-ef-palette="ameixa"]{--ef-palette-ink:#653a65}
}
@media screen and (max-width:700px){body.ef-simple-ui #tab-analises.ef-analyses-page{padding:14px 10px 30px!important}#tab-analises .efu-root{padding:11px}#tab-analises .efu-controls{grid-template-columns:1fr!important}#tab-analises .efu-controls>.efu-selector,#tab-analises .efu-controls>.efu-demo-bar{grid-column:1!important}#tab-analises .efu-date-grid{grid-template-columns:repeat(2,minmax(0,1fr))}#ef-analyses-quick{padding:12px;gap:9px}#ef-analyses-quick .ef-analyses-open{width:100%}}
@media print{#ef-analyses-quick,.ef-analyses-tag,.ef-analyses-heading{display:none!important}}
/* Ajuda acessível do módulo Análises. */
@media screen {
 #tab-analises .ef-analyses-heading>.ef-analysis-help-trigger{margin-left:auto;flex:0 0 36px;width:36px;height:36px;border-radius:10px;border:1px solid var(--ef-line);background:var(--ef-soft);color:var(--ef-ink);font-size:19px;font-weight:750;cursor:pointer}
 #tab-analises .ef-analyses-heading>.ef-analysis-help-trigger:hover{border-color:var(--ef-accent)}
 #tab-analises .ef-analyses-heading>.ef-analysis-help-trigger:focus-visible,#tab-analises .efu-help-mini:focus-visible{outline:2px solid var(--ef-accent);outline-offset:2px}
 #tab-analises .efu-help-mini{appearance:none;border:1px solid var(--ef-line);border-radius:50%;width:19px;height:19px;min-height:19px;margin-left:5px;padding:0;background:var(--ef-soft);color:var(--ef-ink);font-size:12px;font-weight:750;cursor:pointer;vertical-align:middle}
 #tab-analises .efu-kpi small:has(.efu-help-mini){display:flex;align-items:center;flex-wrap:wrap;gap:2px}
 #tab-analises .ef-analysis-glossary{box-sizing:border-box;width:min(720px,calc(100vw - 28px));max-width:720px;max-height:min(85vh,900px);padding:0;border:1px solid var(--ef-line);border-radius:14px;background:var(--ef-surface,#fff);color:var(--ef-ink);box-shadow:0 20px 70px rgba(0,0,0,.26);overflow:hidden}
 #tab-analises .ef-analysis-glossary::backdrop{background:rgba(6,14,20,.72)}
 #tab-analises .ef-analysis-glossary-head{display:flex;align-items:flex-start;gap:16px;justify-content:space-between;padding:20px 22px 12px;border-bottom:1px solid var(--ef-line)}
 #tab-analises .ef-analysis-glossary-head h2{font-size:1.32rem;line-height:1.3;margin:4px 0 6px;color:var(--ef-ink)}
 #tab-analises .ef-analysis-glossary-head p{margin:0;color:var(--ef-muted);font-size:.87rem}
 #tab-analises .ef-analysis-help-close{cursor:pointer;white-space:nowrap;border:1px solid var(--ef-line);border-radius:8px;padding:9px 11px;background:var(--ef-soft);color:var(--ef-ink);font-weight:700}
 #tab-analises .ef-analysis-glossary-content{max-height:min(55vh,580px);overflow-y:auto;overscroll-behavior:contain;padding:10px 22px 18px}
 #tab-analises .ef-analysis-glossary-content section{padding:12px 0;border-bottom:1px solid var(--ef-line)}
 #tab-analises .ef-analysis-glossary-content section:last-child{border-bottom:0}
 #tab-analises .ef-analysis-glossary-content h3{margin:0 0 5px;color:var(--ef-ink);font-size:.95rem}
 #tab-analises .ef-analysis-glossary-content p{margin:0;color:var(--ef-muted);font-size:.85rem;line-height:1.6}
 #tab-analises .ef-analysis-glossary-foot{margin:0;padding:11px 22px 15px;color:var(--ef-muted);font-size:.78rem;border-top:1px solid var(--ef-line)}
}
@media screen and (max-width:600px){#tab-analises .ef-analyses-heading>.ef-analysis-help-trigger{margin-left:0}#tab-analises .ef-analysis-glossary-head{padding:14px;gap:8px}#tab-analises .ef-analysis-glossary-content{padding:8px 14px 12px}#tab-analises .ef-analysis-glossary-foot{padding:10px 14px}#tab-analises .ef-analysis-glossary-head h2{font-size:1.1rem}}
@media print{#tab-analises .ef-analysis-help-trigger,#tab-analises .efu-help-mini,#tab-analises .ef-analysis-glossary{display:none!important}}
</style>
<style id="efprof-first-run-style">

/* Identificação inicial profissional: mesmo armazenamento de Configurações. */
#efprof-first-run[hidden] { display: none !important; }
#efprof-first-run { position:fixed; inset:0; z-index:2147483000; background:rgba(7,25,18,.66); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); display:grid; place-items:center; padding:calc(16px + env(safe-area-inset-top, 0px)) 16px calc(16px + env(safe-area-inset-bottom, 0px)); box-sizing:border-box; overflow-y:auto; overscroll-behavior:contain; }
#efprof-first-run, #efprof-first-run * { box-sizing:border-box; }
#efprof-first-run .efprof-card { width:min(100%,530px); min-width:0; max-height:calc(100dvh - 32px); overflow-y:auto; background:#fff; border:1px solid #d4e7dc; border-radius:16px; box-shadow:0 24px 80px rgba(0,0,0,.24); color:#173329; padding:clamp(20px,4vw,30px); font-family:inherit; }
#efprof-first-run .efprof-top { display:flex; align-items:center; gap:13px; margin-bottom:18px; }
#efprof-first-run .efprof-logo { width:48px; height:48px; flex:none; display:grid; place-items:center; background:#e6f3eb; color:#146646; border-radius:11px; }
#efprof-first-run .efprof-logo svg { width:27px; height:27px; }
#efprof-first-run .efprof-kicker { color:#277553; font-size:11px; font-weight:750; letter-spacing:.11em; text-transform:uppercase; }
#efprof-first-run h2 { font-size:clamp(21px,3vw,26px); line-height:1.2; font-weight:790; margin:5px 0 8px; color:#14372a; }
#efprof-first-run .efprof-description { color:#64776b; font-size:13px; line-height:1.55; margin:0 0 19px; }
#efprof-first-run .efprof-fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
#efprof-first-run .efprof-field { display:flex; flex-direction:column; gap:6px; min-width:0; }
#efprof-first-run .efprof-field.full { grid-column:1/-1; }
#efprof-first-run label { color:#213d30; font-weight:700; font-size:12px; }
#efprof-first-run .efprof-optional { font-weight:500; color:#6c8175; }
#efprof-first-run input { width:100%; min-width:0; min-height:47px; background:#fff; border:1px solid #c8d8ce; border-radius:9px; color:#1b3a2b; padding:12px 13px; font:inherit; font-size:14px; outline:none; }
#efprof-first-run input:focus { border-color:#138857; box-shadow:0 0 0 3px #0b8b561f; }
#efprof-first-run .efprof-help { margin:0; font-size:11px; line-height:1.4; color:#718074; }
#efprof-first-run .efprof-error { color:#b42318; font-size:12px; padding:9px 10px; background:#fff1ed; border:1px solid #f3c4b7; border-radius:8px; margin:12px 0 0; }
#efprof-first-run .efprof-bottom { margin-top:20px; padding-top:17px; border-top:1px solid #edf1ed; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; }
#efprof-first-run .efprof-required {font-size:12px;color:#617569;}
#efprof-first-run .efprof-submit { min-height:45px; background:#177a50; color:white; border:1px solid #177a50; padding:11px 21px; border-radius:9px; font:inherit; font-size:13px; font-weight:760; cursor:pointer; }
#efprof-first-run .efprof-submit:hover { background:#0b6240; }
#efprof-first-run .efprof-submit:focus-visible { outline:3px solid #59b58e; outline-offset:3px; }
html.ef-dark-mode #efprof-first-run .efprof-card, body.dark-mode #efprof-first-run .efprof-card {background:#161f1c;color:#e8f5ed;border-color:#344b3e;}
html.ef-dark-mode #efprof-first-run h2,html.ef-dark-mode #efprof-first-run label,body.dark-mode #efprof-first-run h2,body.dark-mode #efprof-first-run label {color:#eff9f2;}
html.ef-dark-mode #efprof-first-run .efprof-description,html.ef-dark-mode #efprof-first-run .efprof-help,html.ef-dark-mode #efprof-first-run .efprof-optional,body.dark-mode #efprof-first-run .efprof-description,body.dark-mode #efprof-first-run .efprof-help,body.dark-mode #efprof-first-run .efprof-optional {color:#b7c8bd;}
html.ef-dark-mode #efprof-first-run input,body.dark-mode #efprof-first-run input {background:#101815;color:#f5fff9;border-color:#456352;}
html.ef-dark-mode #efprof-first-run input::placeholder,body.dark-mode #efprof-first-run input::placeholder {color:#97ae9e;}
html.ef-dark-mode #efprof-first-run .efprof-bottom,body.dark-mode #efprof-first-run .efprof-bottom {border-color:#365140;}
@media(max-width:480px){#efprof-first-run .efprof-fields{grid-template-columns:minmax(0,1fr);}#efprof-first-run .efprof-bottom{align-items:stretch;}#efprof-first-run .efprof-submit{width:100%;}#efprof-first-run .efprof-card{max-height:calc(100dvh - 20px);}}
@media print { #efprof-first-run {display:none!important;} }

</style>
<style id="ef-billing-monthly-style">/* EvoluFísico2 1.0.3 — histórico mensal de Cobranças */
#ef-fin-panel{--ef-fin-green:#11704f;display:block;margin:22px 0;padding:clamp(16px,2vw,26px);border:1px solid var(--border-color,#d5e6db);border-radius:16px;color:var(--text-main,#19392c);background:var(--card-bg,var(--ef-surface,#fff));box-shadow:0 12px 34px rgba(5,40,27,.08);max-width:100%;min-width:0}
#ef-fin-panel .ef-fin-head{display:flex;align-items:start;justify-content:space-between;flex-wrap:wrap;gap:14px;margin-bottom:16px}
#ef-fin-panel h3{font-size:1.25rem;margin:0;color:var(--text-main,#1b3b2b)}
#ef-fin-panel h4{font-size:1rem;margin:14px 0 10px;color:var(--text-main,#1b3b2b)}
#ef-fin-panel p{font-size:.89rem;line-height:1.55;color:var(--text-muted,#657a70);margin:5px 0 0}
#ef-fin-panel button{font:inherit;cursor:pointer;min-height:40px}
#ef-fin-panel .ef-fin-controls{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
#ef-fin-panel .ef-fin-controls input{min-width:156px;min-height:41px;border:1px solid var(--border-color,#cedfd3);border-radius:9px;padding:7px 9px;background:var(--input-bg,var(--card-bg,#fff));color:var(--text-main,#173b2b);font:inherit}
#ef-fin-panel button.ef-fin-btn{background:var(--input-bg,var(--card-bg,#fff));border:1px solid var(--border-color,#cadfd2);color:var(--text-main,#17402e);border-radius:9px;padding:8px 12px;white-space:normal}
#ef-fin-panel button.ef-fin-btn:hover{background:var(--primary-light,#e7f6ec)}
#ef-fin-panel button.ef-fin-btn.primary{background:var(--primary,#16714f);color:#fff;border-color:var(--primary,#16714f);font-weight:750}
#ef-fin-panel .ef-fin-kpis{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:13px 0}
#ef-fin-panel .ef-fin-kpi{border:1px solid var(--border-color,#dceae1);border-radius:12px;padding:15px;min-width:0;background:var(--bg-secondary,rgba(120,175,145,.07));overflow-wrap:anywhere}
#ef-fin-panel .ef-fin-kpi span{font-size:.78rem;color:var(--text-muted,#60776b);font-weight:650;display:block}
#ef-fin-panel .ef-fin-kpi strong{display:block;font-size:clamp(1.2rem,2vw,1.7rem);font-variant-numeric:tabular-nums;margin:8px 0;color:var(--text-main,#123d2e)}
#ef-fin-panel .ef-fin-kpi small{font-size:.76rem;color:var(--text-muted,#60776b)}
#ef-fin-panel .ef-fin-period-label{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
#ef-fin-panel .ef-fin-blocks{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:15px;min-width:0}
#ef-fin-panel .ef-fin-block{min-width:0;border:1px solid var(--border-color,#dfe9e1);border-radius:12px;padding:14px;background:var(--card-bg,#fff)}
#ef-fin-panel .ef-fin-table-wrap{max-width:100%;overflow:auto}
#ef-fin-panel .ef-fin-table{width:100%;border-collapse:collapse;table-layout:auto;font-size:.82rem;min-width:380px}
#ef-fin-panel .ef-fin-table th,#ef-fin-panel .ef-fin-table td{padding:9px 7px;text-align:left;border-bottom:1px solid var(--border-color,#e4ece6);max-width:240px;overflow-wrap:anywhere;color:var(--text-main,#20392e)}
#ef-fin-panel .ef-fin-table th{color:var(--text-muted,#60776b);font-weight:750;font-size:.76rem}
#ef-fin-panel .ef-fin-table .ef-fin-num{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
#ef-fin-panel .ef-fin-empty{padding:18px;color:var(--text-muted,#627a6b);text-align:center;border:1px dashed var(--border-color,#cedfd3);border-radius:9px}
#ef-fin-panel .ef-fin-month-list{display:grid;gap:7px;max-width:100%}
#ef-fin-panel .ef-fin-monthrow{display:grid;grid-template-columns:minmax(100px,1.5fr) minmax(90px,1fr) minmax(90px,1fr) auto;align-items:center;gap:9px;text-align:left;width:100%;padding:12px 14px;border:1px solid var(--border-color,#d7e6dc);border-radius:10px;color:var(--text-main,#224636);background:transparent}
#ef-fin-panel .ef-fin-monthrow:hover,#ef-fin-panel .ef-fin-monthrow.is-active{border-color:var(--primary,#1a7d56);background:var(--primary-light,#e8f6ee)}
#ef-fin-panel .ef-fin-monthrow strong{font-variant-numeric:tabular-nums;color:var(--primary,#0e6846)}
#ef-fin-panel .ef-fin-monthrow small{color:var(--text-muted,#567261);text-align:right}
#ef-fin-panel .ef-fin-listhead{display:grid;grid-template-columns:minmax(100px,1.5fr) minmax(90px,1fr) minmax(90px,1fr) auto;gap:9px;padding:8px 14px;font-size:.75rem;color:var(--text-muted,#627d6d);font-weight:700}
#ef-fin-panel .ef-fin-alert{padding:12px 14px;margin:10px 0;border-radius:10px;border:1px solid #ce9560;background:#ffedce;color:#663a14}
#ef-fin-panel .ef-fin-footnote{margin-top:18px!important;font-size:.75rem!important}
#tab-cobranca .cob-kpi-card{min-width:0}
#cob-finance-date-field{display:block;margin:10px 0 15px;border:1px solid rgba(255,255,255,.24);border-radius:9px;padding:11px 12px;color:var(--text-main,#183b2a)}
#cob-finance-date-field label{font-size:.82rem;font-weight:650;display:flex;gap:7px;flex-direction:column}
#cob-finance-date-field input{width:100%;max-width:270px;min-height:42px;border:1px solid #a0c7b1;border-radius:7px;padding:7px 9px;background:#fff;color:#163829;font:inherit;color-scheme:light}
#cob-finance-date-field small{font-size:.74rem;color:var(--text-muted,#62766b);display:block;margin-top:4px}
@media(max-width:1000px){#ef-fin-panel .ef-fin-blocks{grid-template-columns:1fr}}
@media(max-width:680px){#ef-fin-panel .ef-fin-kpis{grid-template-columns:1fr}#ef-fin-panel .ef-fin-listhead{display:none}#ef-fin-panel .ef-fin-monthrow{grid-template-columns:1fr 1fr}#ef-fin-panel .ef-fin-monthrow span:first-child{grid-column:1/-1;font-weight:700}#ef-fin-panel .ef-fin-monthrow small{text-align:left}#ef-fin-panel .ef-fin-head{flex-direction:column}}
@media(prefers-reduced-motion:no-preference){#ef-fin-panel .ef-fin-kpi,#ef-fin-panel .ef-fin-monthrow{transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease}#ef-fin-panel .ef-fin-kpi:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(15,80,45,.09)}}
@media print{#ef-fin-panel{display:none!important}}
</style>
<style id="ef-mobile-float-105">
/* EvoluFisico2 1.0.30 Pré-Beta — menu flutuante SOMENTE para smartphones. */
#efm-float-nav{display:none!important;}
@media screen and (max-width:600px){
  html body.ef-simple-ui header.top-navbar > nav.nav-tabs{display:none!important;visibility:hidden!important;pointer-events:none!important;position:static!important;}
  body.ef-simple-ui{padding-bottom:calc(104px + env(safe-area-inset-bottom, 0px))!important;}
  #efm-float-nav{display:block!important;position:fixed;inset:0;z-index:99990;pointer-events:none;font-family:inherit;}
  #efm-float-nav [hidden]{display:none!important;}
  #efm-float-nav .efm-scrim{position:fixed;inset:0;background:rgba(5,25,19,.37);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);pointer-events:auto;}
  #efm-float-nav .efm-trigger{
    pointer-events:auto;position:fixed;left:clamp(16px,4vw,24px);bottom:calc(30px + env(safe-area-inset-bottom, 0px));
    z-index:2;display:inline-flex;align-items:center;justify-content:center;gap:13px;
    min-width:148px;min-height:61px;padding:13px 22px;border:1px solid rgba(58,126,100,.16);
    border-radius:18px;background:#e3f2e9;color:#087352;box-shadow:0 10px 26px rgba(1,36,24,.22),inset 0 1px 0 rgba(255,255,255,.65);
    font-family:inherit;font-size:18px;font-weight:700;line-height:1.25;letter-spacing:0;cursor:pointer;touch-action:manipulation;
    -webkit-tap-highlight-color:transparent;transition:transform .18s ease,background .18s ease,box-shadow .18s ease;
  }
  #efm-float-nav .efm-trigger svg{width:24px;height:24px;stroke:currentColor;stroke-width:2.3;flex-shrink:0;}
  #efm-float-nav .efm-trigger[aria-expanded="true"]{background:#d7f5e5;box-shadow:0 12px 36px rgba(0,38,24,.33);}
  #efm-float-nav .efm-trigger:active{transform:scale(.97);}
  #efm-float-nav .efm-panel{
    position:fixed;left:clamp(12px,3vw,22px);bottom:calc(108px + env(safe-area-inset-bottom, 0px));
    width:min(386px,calc(100vw - 24px));max-height:min(70dvh,680px);overflow-y:auto;
    pointer-events:auto;z-index:2;box-sizing:border-box;padding:15px;
    border-radius:22px;border:1px solid rgba(140,198,168,.5);
    color:#173b30;background:rgba(246,252,248,.97);
    -webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px);
    box-shadow:0 25px 65px rgba(0,27,16,.28),inset 0 1px 0 rgba(255,255,255,.86);
    animation:efm-pop .2s cubic-bezier(.16,1,.3,1) both;
    overscroll-behavior:contain;
  }
  #efm-float-nav .efm-panel-header{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;padding:3px 3px 12px;}
  #efm-float-nav .efm-panel-header strong{display:block;font-size:17px;line-height:1.35;color:#093b2b;}
  #efm-float-nav .efm-panel-header span{display:block;margin-top:3px;color:#597b6d;font-size:12px;}
  #efm-float-nav .efm-close{display:grid;place-items:center;background:#e7f1eb;color:#315f4f;border:0;width:31px;height:31px;border-radius:10px;cursor:pointer;}
  #efm-float-nav .efm-close svg{width:18px;height:18px;stroke:currentColor;stroke-width:2;}
  #efm-float-nav .efm-items{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;}
  #efm-float-nav .efm-item{
    display:flex;align-items:center;justify-content:flex-start;text-align:left;gap:8px;min-width:0;min-height:55px;padding:12px 9px;
    border-radius:13px;border:1px solid rgba(22,112,77,.12);background:#fff;color:#2d5b49;
    font-family:inherit;font-size:13px;font-weight:650;line-height:1.3;cursor:pointer;touch-action:manipulation;
  }
  #efm-float-nav .efm-item svg{width:19px;height:19px;stroke:currentColor;stroke-width:1.85;flex:0 0 19px;}
  #efm-float-nav .efm-item span{white-space:normal;overflow-wrap:normal;word-break:normal;}
  #efm-float-nav .efm-item[aria-current="page"]{border-color:#57b98d;background:#def5e7;color:#046642;box-shadow:inset 0 0 0 1px rgba(49,164,112,.14);}
  #efm-float-nav .efm-item:active{transform:scale(.98);}
  #efm-float-nav .efm-panel-footer{border-top:1px solid rgba(59,116,86,.13);margin-top:12px;padding-top:10px;font-size:11px;color:#6a8174;}
  #efm-float-nav :is(button):focus-visible{outline:3px solid #2b9b73;outline-offset:3px;}
  body[data-efx-visual="essential"] #efm-float-nav .efm-panel,
  body[data-efx-visual="essential"] #efm-float-nav .efm-trigger{box-shadow:0 3px 9px rgba(0,0,0,.13);backdrop-filter:none;-webkit-backdrop-filter:none;animation:none;}
  @keyframes efm-pop{from{opacity:0;transform:translateY(12px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
}
@media (prefers-reduced-motion:reduce){#efm-float-nav .efm-panel,#efm-float-nav .efm-trigger{animation:none!important;transition:none!important;}}
@media print{#efm-float-nav{display:none!important;}}
</style>
<style id="ef-quick-action-smartphone-109">
/* No smartphone, ocultar apenas o atalho duplicado 'Nova avaliação' no menu. */
body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav[data-efm-phone="true"] .efm-item[data-efm-smartphone-hidden="true"],
#efm-float-nav[data-efm-phone="true"] .efm-item[data-efm-smartphone-hidden="true"] { display:none!important; }
/* Com nove módulos, 'Configurações' ocupa a última linha integralmente. */
body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav[data-efm-phone="true"] .efm-item[data-efm-route="tab-settings"],
#efm-float-nav[data-efm-phone="true"] .efm-item[data-efm-route="tab-settings"] {grid-column:1 / -1;}
</style>
<style id="ef-layout-selector-106">
/* EvoluFisico2 1.0.13 Pre-Beta: tres apresentacoes, com Compacto obrigatorio no smartphone. */
@media screen {
  #ef-layout-controls { margin-top:20px;padding-top:19px;border-top:1px solid var(--ef-line,#dce7e0);min-width:0; }
  #ef-layout-controls .efl-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:7px;}
  #ef-layout-controls h4{margin:0;font-size:15px;line-height:1.4;color:var(--ef-ink,#163e31);font-weight:750;}
  #ef-layout-controls .efl-intro{color:var(--ef-muted,#66786e);font-size:13px;line-height:1.55;margin:4px 0 12px;}
  #ef-layout-controls .efl-choices{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;}
  #ef-layout-controls .efl-choice{display:flex;flex-direction:column;align-items:flex-start;text-align:left;gap:6px;min-height:106px;padding:13px 11px;min-width:0;border:1px solid var(--ef-line,#d5e6db);border-radius:12px;background:var(--ef-surface,#fff);color:var(--ef-ink,#103528);font:inherit;cursor:pointer;box-shadow:0 2px 5px #0b35240b;transition:border .15s,box-shadow .15s,background .15s;}
  #ef-layout-controls .efl-choice:hover:not(:disabled){border-color:var(--ef-accent,#15805d);box-shadow:0 6px 16px #143f2415;}
  #ef-layout-controls .efl-choice[aria-pressed="true"]{border-color:var(--ef-accent,#13875d);background:var(--ef-soft,#e5f3eb);box-shadow:inset 0 0 0 1px var(--ef-accent,#13875d);}
  #ef-layout-controls .efl-choice:disabled{opacity:.4;cursor:not-allowed;}
  #ef-layout-controls .efl-choice strong{font-weight:750;font-size:13px;}
  #ef-layout-controls .efl-choice small{font-size:11px;line-height:1.4;color:var(--ef-muted,#6b7b73);}
  #ef-layout-controls .efl-choice svg{width:22px;height:22px;stroke:currentColor;stroke-width:1.8;fill:none;}
  #ef-layout-controls .efl-state{margin:12px 0 0;font-size:12px;line-height:1.5;color:var(--ef-muted,#65786c);}
  #ef-layout-controls .efl-badge{font-size:11px;font-weight:750;padding:3px 8px;border-radius:7px;background:var(--ef-soft,#e8f5ed);color:var(--ef-accent,#126b50);}
  #ef-layout-controls .efl-choice:focus-visible{outline:3px solid var(--ef-accent,#198b66);outline-offset:2px;}
}
@media screen and (max-width:600px){
  #ef-layout-controls .efl-choices{grid-template-columns:1fr;gap:9px;}
  #ef-layout-controls .efl-choice{display:grid;grid-template-columns:30px minmax(0,1fr);grid-template-rows:auto auto;align-content:center;column-gap:10px;row-gap:2px;min-height:66px;padding:12px;}
  #ef-layout-controls .efl-choice svg{grid-column:1;grid-row:1/span 2;align-self:center;}
  #ef-layout-controls .efl-choice strong{grid-column:2;font-size:13px;}
  #ef-layout-controls .efl-choice small{grid-column:2;font-size:11px;margin:0;}
}
/* A categoria de personalização mantém os quatro acessos legíveis em smartphones. */
@media screen and (max-width:540px){
  #tab-settings .efs-tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));width:100%;gap:5px;}
  #tab-settings .efs-tabs button{min-width:0;min-height:44px;white-space:normal;}
}
#ef-setting-layout #ef-layout-controls{width:100%;margin:0;padding:0;border:0;}
#ef-layout-card{align-self:start;}

/* Este seletor atua tambem em telas maiores quando Compacto foi selecionado. */
@media screen {
  body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav{display:block!important;position:fixed!important;inset:0!important;z-index:99990!important;pointer-events:none!important;}
  body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav [hidden]{display:none!important;}
  body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav :is(.efm-trigger,.efm-panel,.efm-scrim){pointer-events:auto!important;}
  body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav .efm-trigger{position:fixed!important;left:clamp(16px,4vw,24px)!important;bottom:calc(30px + env(safe-area-inset-bottom, 0px))!important;z-index:2!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:13px!important;min-width:148px!important;min-height:61px!important;padding:13px 22px!important;border:1px solid rgba(58,126,100,.16)!important;border-radius:18px!important;background:#e3f2e9!important;color:#087352!important;box-shadow:0 10px 26px rgba(1,36,24,.22),inset 0 1px 0 rgba(255,255,255,.65)!important;font-family:inherit!important;font-size:18px!important;font-weight:700!important;line-height:1.25!important;cursor:pointer!important;}
  body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav .efm-trigger svg{width:24px;height:24px;stroke:currentColor;stroke-width:2.3;}
  body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav .efm-panel{position:fixed!important;left:clamp(12px,3vw,22px)!important;bottom:calc(108px + env(safe-area-inset-bottom, 0px))!important;width:min(386px,calc(100vw - 24px))!important;max-height:min(70dvh,680px)!important;overflow-y:auto!important;z-index:2!important;box-sizing:border-box!important;padding:15px!important;border-radius:22px!important;border:1px solid rgba(140,198,168,.5)!important;color:#173b30!important;background:rgba(246,252,248,.97)!important;backdrop-filter:blur(20px)!important;-webkit-backdrop-filter:blur(20px)!important;box-shadow:0 25px 65px rgba(0,27,16,.28)!important;overscroll-behavior:contain!important;}
  body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav .efm-panel-header{display:flex!important;align-items:flex-start!important;justify-content:space-between!important;gap:8px!important;padding:3px 3px 12px!important;}
  body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav .efm-panel-header strong{display:block;font-size:17px;}
  body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav .efm-panel-header span{display:block;font-size:12px;}
  body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav .efm-close{display:grid!important;place-items:center!important;width:31px!important;height:31px!important;}
  body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav .efm-items{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important;}
  body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav .efm-item{display:flex!important;align-items:center!important;gap:8px!important;min-width:0!important;min-height:55px!important;padding:12px 9px!important;border-radius:13px!important;background:#fff!important;color:#2d5b49!important;border:1px solid rgba(22,112,77,.12)!important;text-align:left!important;font-size:13px!important;font-weight:650!important;}
  body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav .efm-item svg{width:19px;height:19px;stroke:currentColor;stroke-width:1.85;flex:0 0 19px;}
  body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav .efm-panel-footer{font-size:11px;}
  body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav .efm-scrim{position:fixed!important;inset:0!important;background:rgba(5,25,19,.37)!important;backdrop-filter:blur(3px)!important;}
  body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav .efm-item[aria-current="page"]{background:#def5e7!important;color:#046642!important;}
  body.ef-simple-ui[data-ef-layout="compact"] header.top-navbar > nav.nav-tabs{display:none!important;visibility:hidden!important;}
  body.ef-simple-ui[data-ef-layout="compact"] {padding-bottom:calc(108px + env(safe-area-inset-bottom, 0px))!important;}
  body.ef-simple-ui[data-ef-layout="compact"]:is([data-efx-visual="essential"]) #efm-float-nav .efm-panel{box-shadow:0 3px 9px #0002!important;backdrop-filter:none!important;}
  body.ef-simple-ui:not([data-ef-layout="compact"]) #efm-float-nav{display:none!important;}
}
/* Aplicar layouts escolhidos de forma independente dos breakpoints originais. */
@media screen and (min-width:601px){
  body.ef-simple-ui[data-ef-layout="compact"] .top-navbar{display:none!important;}
  body.ef-simple-ui[data-ef-layout="compact"] #ef-workspace-heading,
  body.ef-simple-ui[data-ef-layout="extended"] #ef-workspace-heading{display:flex!important;align-items:center!important;position:fixed!important;top:0!important;left:0!important;right:0!important;width:100%!important;height:68px!important;box-sizing:border-box!important;padding:0 20px!important;z-index:100!important;background:var(--ef-surface,#fff)!important;border-bottom:1px solid var(--ef-line,#ddd)!important;}
  body.ef-simple-ui[data-ef-layout="compact"] #ef-sidebar-toggle,
  body.ef-simple-ui[data-ef-layout="extended"] #ef-sidebar-toggle{display:none!important;}
  body.ef-simple-ui[data-ef-layout="compact"] .app-container,
  body.ef-simple-ui[data-ef-layout="extended"] .app-container{width:100%!important;max-width:1664px!important;margin:0 auto!important;padding:90px clamp(14px,3vw,32px) 132px!important;box-sizing:border-box!important;}
  body.ef-simple-ui[data-ef-layout="compact"],body.ef-simple-ui[data-ef-layout="extended"]{--ef-sidebar:0px!important;padding-bottom:120px!important;}
  body.ef-simple-ui[data-ef-layout="extended"] header.top-navbar{display:contents!important;visibility:visible!important;transform:none!important;}
  body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > :not(nav.nav-tabs){display:none!important;}
  body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs{
    display:flex!important;visibility:visible!important;position:fixed!important;
    top:auto!important;inset-block-start:auto!important;bottom:calc(14px + env(safe-area-inset-bottom, 0px))!important;inset-block-end:calc(14px + env(safe-area-inset-bottom, 0px))!important;
    left:50%!important;right:auto!important;transform:translateX(-50%)!important;
    z-index:1500!important;width:min(650px,calc(100vw - 28px))!important;max-width:min(650px,calc(100vw - 28px))!important;
    min-height:70px!important;max-height:80px!important;height:76px!important;margin:0!important;padding:8px!important;
    flex-direction:row!important;flex-wrap:nowrap!important;align-items:center!important;justify-content:flex-start!important;gap:6px!important;
    overflow-x:auto!important;overflow-y:hidden!important;overscroll-behavior-x:contain!important;
    border:1px solid var(--ef-line,#d2e2db)!important;border-radius:22px!important;background:var(--ef-surface,#fff)!important;
    box-shadow:0 14px 34px rgba(5,34,24,.17)!important;
    backdrop-filter:blur(16px)!important;-webkit-backdrop-filter:blur(16px)!important;
  }
  body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs::before{display:none!important;content:none!important;}
  body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs > .nav-tab-btn{display:flex!important;flex:0 0 auto!important;align-items:center!important;justify-content:center!important;flex-direction:column!important;min-width:100px!important;max-width:none!important;width:110px!important;height:58px!important;min-height:58px!important;padding:4px 8px!important;gap:4px!important;border-radius:13px!important;text-align:center!important;font-size:11px!important;white-space:normal!important;}
  body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs > .nav-tab-btn::before{width:19px;height:19px;}
  body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs > .nav-tab-btn.active{background:var(--ef-soft,#dcf3e8)!important;color:var(--ef-accent,#087a55)!important;box-shadow:inset 0 0 0 1px var(--ef-line,#b2dcca)!important;}
}
/* Desktop forcado em tablets/monitores de janela estreita: sidebar como no computador. */
@media screen and (min-width:601px) and (max-width:1199px){
  body.ef-simple-ui[data-ef-layout="desktop"]{--ef-sidebar:clamp(188px,22vw,236px)!important;padding-bottom:0!important;}
  body.ef-simple-ui[data-ef-layout="desktop"] header.top-navbar{
    display:flex!important;visibility:visible!important;transform:none!important;
    position:fixed!important;inset:0 auto 0 0!important;width:var(--ef-sidebar)!important;height:100dvh!important;
    box-sizing:border-box!important;flex-direction:column!important;flex-wrap:nowrap!important;align-items:stretch!important;
    justify-content:flex-start!important;gap:12px!important;padding:18px 10px!important;
    overflow-x:hidden!important;overflow-y:auto!important;z-index:120!important;
    border-right:1px solid var(--ef-line,#dce6dd)!important;border-bottom:0!important;
  }
  body.ef-simple-ui[data-ef-layout="desktop"] .top-navbar > .brand-wrapper{padding:0 6px 15px!important;border-bottom:1px solid var(--ef-line,#ddd)!important;width:100%!important;}
  body.ef-simple-ui[data-ef-layout="desktop"] .top-navbar > nav.nav-tabs{
    display:flex!important;visibility:visible!important;position:static!important;inset:auto!important;inset-block-start:auto!important;inset-block-end:auto!important;
    left:auto!important;right:auto!important;bottom:auto!important;top:auto!important;transform:none!important;
    flex-direction:column!important;flex-wrap:nowrap!important;justify-content:flex-start!important;align-items:stretch!important;
    gap:5px!important;width:100%!important;max-width:100%!important;min-height:0!important;max-height:none!important;height:auto!important;
    margin:0!important;padding:0!important;overflow:visible!important;border:0!important;box-shadow:none!important;background:transparent!important;
  }
  body.ef-simple-ui[data-ef-layout="desktop"] .top-navbar > nav.nav-tabs::before{content:'ÁREA DE TRABALHO'!important;font-size:10px!important;font-weight:750!important;color:var(--ef-muted,#677)!important;padding:8px 9px!important;}
  body.ef-simple-ui[data-ef-layout="desktop"] .top-navbar > nav.nav-tabs > .nav-tab-btn{width:100%!important;max-width:100%!important;flex:0 0 43px!important;min-height:43px!important;height:43px!important;padding:0 11px!important;display:flex!important;flex-direction:row!important;justify-content:flex-start!important;align-items:center!important;gap:10px!important;font-size:13px!important;text-align:left!important;}
  body.ef-simple-ui[data-ef-layout="desktop"] .top-navbar > nav.nav-tabs > .nav-tab-btn.active{background:var(--ef-soft,#e6f3ee)!important;color:var(--ef-accent,#146e52)!important;}
  body.ef-simple-ui[data-ef-layout="desktop"] #ef-tools{grid-row:auto!important;grid-column:auto!important;padding:10px 0 0!important;border-top:1px solid var(--ef-line,#ddd)!important;width:100%!important;}
  body.ef-simple-ui[data-ef-layout="desktop"] #ef-tools-content{grid-template-columns:1fr!important;}
  body.ef-simple-ui[data-ef-layout="desktop"] #ef-workspace-heading{display:flex!important;align-items:center!important;position:fixed!important;top:0!important;left:var(--ef-sidebar)!important;right:0!important;width:auto!important;height:64px!important;padding:0 20px!important;box-sizing:border-box!important;background:var(--ef-surface,#fff)!important;border-bottom:1px solid var(--ef-line,#ddd)!important;z-index:100!important;}
  body.ef-simple-ui[data-ef-layout="desktop"] #ef-primary-actions{position:fixed!important;top:14px!important;right:20px!important;}
  body.ef-simple-ui[data-ef-layout="desktop"] .app-container{width:calc(100% - var(--ef-sidebar))!important;max-width:none!important;margin:0 0 0 var(--ef-sidebar)!important;padding:84px 18px 38px!important;box-sizing:border-box!important;}
}
/* Garantir que a area de trabalho nao ultrapasse a viewport no desktop amplo. */
@media screen and (min-width:1200px){
  body.ef-simple-ui[data-ef-layout="desktop"] .app-container{
    width:calc(100vw - var(--ef-sidebar,236px))!important;
    max-width:calc(100vw - var(--ef-sidebar,236px))!important;
    margin:0 0 0 var(--ef-sidebar,236px)!important;
    padding:98px 32px 56px!important;
    box-sizing:border-box!important;
  }
}
@media print{
  #ef-layout-controls{display:none!important;}
  body.ef-simple-ui #efm-float-nav{display:none!important;}
  body.ef-simple-ui[data-ef-layout="desktop"] .app-container,body.ef-simple-ui[data-ef-layout="compact"] .app-container,body.ef-simple-ui[data-ef-layout="extended"] .app-container{width:100%!important;margin:0!important;padding:0!important;}
}
</style>
<style id="ef-111-navigation-and-search-fixes">
/* Menu Compacto: nove módulos, sem o atalho duplicado de Nova avaliação. */
@media screen {
 body.ef-simple-ui[data-ef-layout="compact"] #efm-float-nav .efm-item[data-efm-route="tab-settings"] {grid-column:1/-1!important;}
 /* Estendido: barra inferior com rolagem horizontal e indicador nativo visível. */
 body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs {
  overflow-x:scroll!important;overflow-y:hidden!important;
  scrollbar-width:thin!important;
  scrollbar-color:var(--ef-accent,#15865f) var(--ef-soft,#e5efe9)!important;
  overscroll-behavior-inline:contain!important;
  -webkit-overflow-scrolling:touch!important;
  scroll-behavior:smooth;
  scroll-snap-type:x proximity;
  padding-bottom:9px!important;
 }
 body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs::-webkit-scrollbar {
  display:block!important;height:8px!important;width:8px!important;
 }
 body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs::-webkit-scrollbar-track {
  background:var(--ef-soft,#e7f0eb)!important;border-radius:9px!important;
 }
 body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs::-webkit-scrollbar-thumb {
  background:var(--ef-accent,#22835f)!important;border:1px solid var(--ef-soft,#e7f0eb)!important;border-radius:9px!important;
 }
 body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs > .nav-tab-btn {
  scroll-snap-align:start;touch-action:pan-x!important;
 }
 /* Barra de rolagem explícita: sempre visível com conteúdo excedente, mesmo em sistemas com scrollbar sobreposta. */
 body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs {scrollbar-width:none!important;}
 body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs::-webkit-scrollbar {display:none!important;height:0!important;}
 body.ef-simple-ui[data-ef-layout="extended"] #ef111-scrollbar[data-overflow="true"]{display:block!important;}
 #ef111-scrollbar{display:none;position:fixed;z-index:1502;bottom:calc(17px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%);width:min(610px,calc(100vw - 54px));height:10px;cursor:ew-resize;touch-action:none;user-select:none;-webkit-user-select:none;}
 #ef111-scrollbar::before{content:"";position:absolute;left:0;right:0;top:2px;height:6px;border-radius:9px;background:var(--ef-soft,#dcefe3);box-shadow:inset 0 0 0 1px var(--ef-line,#c5ddd0);}
 #ef111-scrollbar-thumb{position:absolute;left:0;top:2px;height:6px;min-width:28px;border-radius:9px;background:var(--ef-accent,#087b57);box-shadow:0 0 0 1px rgba(255,255,255,.22);pointer-events:none;transition:background .15s;}
 #ef111-scrollbar:is(:hover,:focus-visible) #ef111-scrollbar-thumb{background:var(--ef-ink,#114d38);}
 #ef111-scrollbar:focus-visible{outline:2px solid var(--ef-accent,#087b57);outline-offset:4px;border-radius:7px;}
 /* Apenas a pesquisa duplicada no cabeçalho do Início. A busca interna permanece. */
 body.ef-simple-ui.ef-home-search-hidden #ef-workspace-heading #efg-header-search {display:none!important;visibility:hidden!important;}
}
@media (prefers-reduced-motion:reduce) {
 body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs {scroll-behavior:auto!important;}
}
</style>
</head>
<body>
<!-- TELA DE ABERTURA (SPLASH SCREEN INTRO) -->
<div aria-hidden="true" class="ef-splash-overlay" id="ef-splash" onclick="fecharAbertura()">
<div class="ef-splash-backdrop"></div>
<div class="ef-splash-card">
<div class="ef-splash-icon-wrapper">
<div class="ef-splash-glow"></div>
<div class="ef-splash-icon">EF</div>
</div>
<div class="ef-splash-titles">
<h1 class="ef-splash-title">EvoluFísico</h1>
<p class="ef-splash-subtitle">Avaliação Física &amp; Composição Corporal</p>
<div class="ef-splash-version-pill">v1.0.30 Pré-Beta • Avaliação Física</div>
</div>
<div class="ef-splash-loader-box">
<div class="ef-splash-bar">
<div class="ef-splash-bar-fill"></div>
</div>
<span class="ef-splash-status" id="ef-splash-status">Inicializando módulos clínicos…</span>
</div>
<span class="ef-splash-skip">Clique para continuar</span>
</div>
</div>
<!-- NAVBAR PRINCIPAL (100% HTML, CSS E JS) -->
<header class="top-navbar no-print">
<a class="brand-wrapper" href="#" onclick="switchTab('tab-novo-checkin'); return false;">
<div class="brand-icon-box">EF</div>
<div class="brand-title-group">
<span class="brand-title-row">
<span class="brand-title">EvoluFísico</span>

</span>
<span class="brand-subtitle">Avaliação Física &amp; Composição Corporal</span>
</div>
</a>
<nav class="nav-tabs">
<button class="nav-tab-btn active" id="tab-btn-form" onclick="switchTab('tab-novo-checkin')">
<span id="tab-form-icon">📝</span> <span id="tab-form-label">Nova Avaliação</span>
</button>
<button class="nav-tab-btn" id="tab-btn-history" onclick="switchTab('tab-historico')">
<span>📋</span> <span>Histórico de Avaliações (<span id="history-counter">0</span>)</span>
</button>
<button class="nav-tab-btn" id="tab-btn-compare" onclick="switchTab('tab-comparison')">
<span>⚖️</span> <span>Comparar Evolução</span>
</button>
</nav>
<div class="nav-actions">
<button class="btn btn-outline btn-sm btn-pro-pill" id="btn-theme-toggle" onclick="alternarModoEscuroGlobal()" title="Alternar entre modo claro e escuro" type="button">
<span id="nav-theme-icon" style="font-size:1.05rem;">🌙</span> <span id="nav-theme-text">Escuro</span>
</button>
<button class="btn btn-outline btn-sm btn-pro-pill" id="btn-security-pill" onclick="abrirConfiguracaoCriptografia()" title="Configurações de Segurança e Chave Mestra" type="button">
<span style="font-size:1.05rem;">🔐</span> <span id="nav-security-status">Cofre</span>
</button>
<button class="btn btn-outline btn-sm btn-pro-pill" id="btn-config-profissional" onclick="abrirModalConfigProfissional()" title="Definir Nome e CREF do Profissional para o Cabeçalho do PDF" type="button">
<span style="font-size:1.05rem;">👨‍⚕️</span> <span>Profissional / CREF</span>
</button>
<button class="folder-status-pill" id="folder-status-pill" onclick="conectarPastaBanco()" title="Conectar pasta local para salvar em subpastas no disco">
<span class="folder-dot" id="folder-dot"></span>
<span id="folder-status-text">Pasta Local</span>
</button>
<button class="btn btn-secondary btn-sm" onclick="abrirModalCentralBackup('exportar')" title="Central de Backup e Restauração Inteligente">
<span>⬇️</span> Backup
            </button>
<button class="btn btn-secondary btn-sm" onclick="abrirModalCentralBackup('importar')" title="Restaurar avaliações com pré-visualização e segurança">
<span>⬆️</span> Importar
            </button>
</div>
</header>
<main class="app-container">
<!-- ============================================================== -->
<!-- ABA 1: FORMULÁRIO DE CHECK-IN / EDIÇÃO (5 ETAPAS COMPLETAS)    -->
<!-- ============================================================== -->
<section class="tab-panel active" id="tab-novo-checkin">
<div class="form-container">
<!-- Banner de Modo de Edição -->
<div class="edit-mode-banner hidden" id="edit-mode-alert">
<div>
<strong>✏️ Modo de Edição Ativo:</strong> Você está alterando uma avaliação existente.
                    </div>
<button class="btn btn-secondary btn-sm" onclick="cancelarEdicao()" type="button">Cancelar Edição</button>
</div>
<div class="form-header" id="form-header">
<h1 id="form-title-text">Nova avaliação</h1>
<p id="form-subtitle-text">Preencha em cinco etapas. Você pode consultar os resultados ao longo do caminho.</p>
</div>
<div class="wizard-header-card">
<div style="display:flex; justify-content:space-between; align-items:center;">
<div>
<h2 style="font-size:1.25rem; font-weight:800; color:var(--slate-900); margin:0;">Novo Registro de Avaliação</h2>
<p style="font-size:0.82rem; color:var(--slate-500); margin:2px 0 0 0;">Preencha os dados clínicos e fotográficos do aluno em 5 etapas rápidas</p>
</div>
<span class="brand-badge" id="wizard-progress-badge" style="font-size:0.8rem; padding:0.3rem 0.75rem;">Etapa 1 de 5 • 20%</span>
</div>
<div class="progress-wrapper" id="progress-wrapper" style="display:none;">
<div class="progress-header">
<span>Etapa <span id="current-step-num">1</span> de 5</span>
<span id="step-name">Identificação</span>
</div>
<div class="progress-bar">
<div class="progress-fill" id="progress-fill"></div>
</div>
</div>
<div class="stepper-container">
<div class="stepper-progress-bg">
<div class="stepper-progress-fill" id="stepper-progress-fill"></div>
</div>
<div class="step-indicator active" data-step-target="1" onclick="irParaEtapa(0)">
<div class="step-dot" id="step-dot-1">1</div>
<div class="step-label">Dados</div>
</div>
<div class="step-indicator" data-step-target="2" onclick="irParaEtapa(1)">
<div class="step-dot" id="step-dot-2">2</div>
<div class="step-label">Medidas</div>
</div>
<div class="step-indicator" data-step-target="3" onclick="irParaEtapa(2)">
<div class="step-dot" id="step-dot-3">3</div>
<div class="step-label">Dobras/BIA</div>
</div>
<div class="step-indicator" data-step-target="4" onclick="irParaEtapa(3)">
<div class="step-dot" id="step-dot-4">4</div>
<div class="step-label">Fotos</div>
</div>
<div class="step-indicator" data-step-target="5" onclick="irParaEtapa(4)">
<div class="step-dot" id="step-dot-5">5</div>
<div class="step-label">Parecer</div>
</div>
</div>
</div>
<!-- Alerta de Rascunho Recuperado (Auto-Save v3.3) -->
<div class="hidden" id="draft-alert" style="background:#eff6ff; border:1px solid #bfdbfe; border-radius:var(--radius-md); padding:0.75rem 1rem; margin-bottom:1rem; display:flex; justify-content:space-between; align-items:center;">
<div style="font-size:0.875rem; color:#1e40af;">
                        💾 <strong>Rascunho recuperado:</strong> Encontramos dados não salvos de uma avaliação anterior.
                    </div>
<div style="display:flex; gap:0.5rem;">
<button class="btn btn-primary btn-sm" onclick="aplicarRascunho()" type="button">Restaurar</button>
<button class="btn btn-secondary btn-sm" onclick="descartarRascunho()" type="button">Descartar</button>
</div>
</div>
<!-- WIDGET DE CÁLCULO AO VIVO (ESTATÍSTICAS EM TEMPO REAL) -->
<div class="live-kpi-summary no-print" id="live-kpi-summary">
<div class="live-kpi-item">
<span class="live-kpi-label">% Gordura (Pollock)</span>
<span class="live-kpi-val" id="live-kpi-pgordura">--%</span>
<span class="live-kpi-sub" id="live-kpi-classificacao">Aguardando dados</span>
</div>
<div class="live-kpi-item">
<span class="live-kpi-label">Massa magra (Pollock)</span>
<span class="live-kpi-val" id="live-kpi-massa-magra">-- kg</span>
<span class="live-kpi-sub" id="live-kpi-massa-gorda">Massa Gorda: -- kg</span>
</div>
<div class="live-kpi-item">
<span class="live-kpi-label">Somatotipo</span>
<span class="live-kpi-val" id="live-kpi-somato-tipo" style="font-size:1.05rem;">--</span>
<span class="live-kpi-sub" id="live-kpi-somato-coords">X: -- | Y: --</span>
</div>
<div class="live-kpi-item">
<span class="live-kpi-label">RCQ &amp; Risco</span>
<span class="live-kpi-val" id="live-kpi-rcq">--</span>
<span class="live-kpi-sub" id="live-kpi-rcq-risco">IMC: --</span>
</div>
</div>
<form id="checkin-form" novalidate="">
<input id="avaliacao_id" name="avaliacao_id" type="hidden"/>
<!-- ETAPA 1: Identificação do Aluno, Avaliador e Prazos -->
<div class="step active" data-name="Identificação" data-step="1">
<h2 class="step-title">Identificação</h2>
<div class="input-group">
<label for="nome">Nome completo do Aluno/Paciente *</label>
<input id="nome" name="nome" placeholder="Ex: Carlos Mendes" required="" type="text"/>
</div>
<div class="input-row">
<div class="input-group">
<label for="email">E-mail *</label>
<input id="email" name="email" placeholder="carlos@exemplo.com" required="" type="email"/>
</div>
<div class="input-group">
<label for="whatsapp">WhatsApp (com DDD) *</label>
<input id="whatsapp" name="whatsapp" placeholder="11999999999" required="" type="text"/>
</div>
</div>
<div class="input-row-3 input-row">
<div class="input-group">
<label for="sexo">Sexo Biológico *</label>
<select id="sexo" name="sexo" onchange="recalcularCamposAutomaticos()" required="">
<option value="M">Masculino</option>
<option value="F">Feminino</option>
</select>
</div>
<div class="input-group">
<label for="idade">Idade (anos) *</label>
<input id="idade" max="100" min="10" name="idade" oninput="recalcularCamposAutomaticos()" placeholder="Anos" required="" type="number"/>
</div>
<div class="input-group">
<label for="altura">Estatura / Altura (cm) *</label>
<input id="altura" max="250" min="100" name="altura" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 183" required="" type="number"/>
</div>
</div>
<div class="input-row-4 input-row">
<div class="input-group">
<label for="data_avaliacao">Data de Avaliação *</label>
<input id="data_avaliacao" name="data_avaliacao" required="" type="date"/>
</div>
<div class="input-group">
<label for="data_proxima_avaliacao">Próxima Avaliação (Retorno)</label>
<input id="data_proxima_avaliacao" name="data_proxima_avaliacao" type="date"/>
</div>
<div class="input-group">
<label for="checkin_semana">Check-in / Período *</label>
<select id="checkin_semana" name="checkin_semana" required="">
<option value="Semana 1">Semana 1 (Inicial)</option>
<option value="Semana 2">Semana 2</option>
<option value="Semana 3">Semana 3</option>
<option value="Semana 4">Semana 4</option>
<option value="Semana 8">Semana 8</option>
<option value="Semana 12">Semana 12</option>
<option value="Trimestral">Trimestral</option>
<option value="Outro">Outro</option>
</select>
</div>
<div class="input-group">
<label for="fase">Fase no programa *</label>
<select id="fase" name="fase" required="">
<option value="Cutting">Cutting (Déficit)</option>
<option value="Bulking">Bulking (Superávit)</option>
<option value="Manutenção">Manutenção</option>
</select>
</div>
</div>
<div class="section-subhead">📋 Dados do Profissional / Clínica (Opcional - Deixe em branco se preferir cabeçalho limpo no PDF)</div>
<div class="input-row-3 input-row">
<div class="input-group">
<label for="avaliador_clinica">Nome da Clínica / Consultório</label>
<input id="avaliador_clinica" name="avaliador_clinica" placeholder="Deixe em branco ou nome da clínica" type="text"/>
</div>
<div class="input-group">
<label for="avaliador_nome">Nome do Profissional / Avaliador</label>
<input id="avaliador_nome" name="avaliador_nome" placeholder="Deixe em branco ou seu nome" type="text"/>
</div>
<div class="input-group">
<label for="avaliador_registro">Registro Profissional (CREF / CRN / CRM)</label>
<input id="avaliador_registro" name="avaliador_registro" placeholder="Ex: CREF 12345-G/UF" type="text"/>
</div>
</div>
</div>
<!-- ETAPA 2: Perimetria Completa -->
<div class="step" data-name="Perimetria (Circunferências)" data-step="2">
<h2 class="step-title">Medidas corporais</h2>
<span class="help-text">Medidas de fita com soma perimétrica automática em tempo real.</span>
<div class="input-group">
<label for="peso">Peso Corporal (kg) *</label>
<input id="peso" max="400" min="20" name="peso" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 97.4" required="" step="any" type="number"/>
</div>
<div class="input-row">
<div class="input-group">
<label for="peri_pescoco">Pescoço (cm) <span>*novo</span></label>
<input id="peri_pescoco" max="250" min="0" name="peri_pescoco" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 41.5" step="any" type="number"/>
</div>
<div class="input-group">
<label for="peri_ombros">Ombros (cm) <span>*novo</span></label>
<input id="peri_ombros" max="250" min="0" name="peri_ombros" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 133.2" step="any" type="number"/>
</div>
</div>
<div class="input-row-3 input-row">
<div class="input-group">
<label for="peri_abdomen">Abdômen (cm)</label>
<input id="peri_abdomen" max="250" min="0" name="peri_abdomen" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 90.0" step="any" type="number"/>
</div>
<div class="input-group">
<label for="cintura">Cintura (cm) *</label>
<span class="help-text">Menor curvatura do tronco</span>
<input id="cintura" max="250" min="0" name="cintura" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 90.4" step="any" type="number"/>
</div>
<div class="input-group">
<label for="quadril">Quadril (cm) *</label>
<span class="help-text">Ponto de maior volume glúteo</span>
<input id="quadril" max="250" min="0" name="quadril" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 104.8" step="any" type="number"/>
</div>
</div>
<div class="input-row">
<div class="input-group">
<label for="braco_esq">Braço Esquerdo (cm)</label>
<input id="braco_esq" max="250" min="0" name="braco_esq" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 40.3" step="any" type="number"/>
</div>
<div class="input-group">
<label for="braco_dir">Braço Direito (cm)</label>
<input id="braco_dir" max="250" min="0" name="braco_dir" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 40.0" step="any" type="number"/>
</div>
</div>
<div class="input-row-3 input-row">
<div class="input-group">
<label for="coxa_esq">Coxa Esquerda (cm)</label>
<input id="coxa_esq" max="250" min="0" name="coxa_esq" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 66.0" step="any" type="number"/>
</div>
<div class="input-group">
<label for="coxa_dir">Coxa Direita (cm)</label>
<input id="coxa_dir" max="250" min="0" name="coxa_dir" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 67.0" step="any" type="number"/>
</div>
<div class="input-group">
<label for="panturrilha">Panturrilha (cm)</label>
<input id="panturrilha" max="250" min="0" name="panturrilha" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 41.0" step="any" type="number"/>
</div>
</div>
<div style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:var(--radius-md); padding:0.75rem 1rem; margin-top:0.75rem; display:flex; justify-content:space-between; align-items:center; font-size:0.9rem;">
<span>⚡ <strong>Soma da Perimetria (Σ Perimetria):</strong></span>
<strong id="preview-soma-perimetria" style="font-size:1.15rem; color:#15803d;">0.0 cm</strong>
</div>
</div>
<!-- ETAPA 3: Antropometria (Pollock 7 Dobras) & Bioimpedância v3.0 -->
<div class="step" data-name="Antropometria (Pollock 7) &amp; BIA" data-step="3">
<h2 class="step-title">Composição corporal</h2>
<div class="section-subhead">1️⃣ Antropometria (Pollock, 1984 – 7 Dobras em mm)</div>
<div class="input-row-3 input-row">
<div class="input-group">
<label for="dobra_triceps">Tricipital (mm)</label>
<input id="dobra_triceps" max="80" min="0" name="dobra_triceps" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 8.5" step="any" type="number"/>
</div>
<div class="input-group">
<label for="dobra_subescapular">Subescapular (mm)</label>
<input id="dobra_subescapular" max="80" min="0" name="dobra_subescapular" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 23.0" step="any" type="number"/>
</div>
<div class="input-group">
<label for="dobra_suprailiaca">Supra-ilíaca (mm)</label>
<input id="dobra_suprailiaca" max="80" min="0" name="dobra_suprailiaca" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 24.0" step="any" type="number"/>
</div>
</div>
<div class="input-row-4 input-row">
<div class="input-group">
<label for="dobra_peitoral">Peitoral (mm)</label>
<input id="dobra_peitoral" max="80" min="0" name="dobra_peitoral" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 9.0" step="any" type="number"/>
</div>
<div class="input-group">
<label for="dobra_axilar">Axilar Média (mm)</label>
<input id="dobra_axilar" max="80" min="0" name="dobra_axilar" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 12.0" step="any" type="number"/>
</div>
<div class="input-group">
<label for="dobra_abdominal">Abdominal (mm)</label>
<input id="dobra_abdominal" max="80" min="0" name="dobra_abdominal" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 16.0" step="any" type="number"/>
</div>
<div class="input-group">
<label for="dobra_coxa">Coxa (mm)</label>
<input id="dobra_coxa" max="80" min="0" name="dobra_coxa" oninput="recalcularCamposAutomaticos()" placeholder="Ex: 11.0" step="any" type="number"/>
</div>
</div>
<div style="background:#f8fafc; border:1px solid #cbd5e1; border-radius:var(--radius-md); padding:0.85rem 1rem; margin-bottom:1.5rem; display:flex; justify-content:space-between; flex-wrap:wrap; gap:0.75rem; font-size:0.85rem;">
<div>Soma Antropometria: <strong id="preview-soma-dobras">- mm</strong></div>
<div>% Gordura Estimado: <strong id="preview-gordura-dobras" style="color:var(--primary-color);">-</strong></div>
<div>Massa Magra: <strong id="preview-mm-dobras">- kg</strong></div>
<div>Massa Gorda: <strong id="preview-mg-dobras">- kg</strong></div>
<div>Faixa de peso de referência: <strong id="preview-faixa-peso-ideal" style="color:#059669;">- kg</strong></div>
</div>
<div class="section-subhead">2️⃣ Bioimpedância Elétrica Completa</div>
<div class="input-row-4 input-row">
<div class="input-group">
<label for="bia_peso">Peso na BIA (kg)</label>
<input id="bia_peso" max="400" min="20" name="bia_peso" oninput="sincronizarPesoBia(this.value)" placeholder="Ex: 97.4" step="any" type="number"/>
</div>
<div class="input-group">
<label for="bia_pgordura">Percentual de gordura (%)</label>
<input id="bia_pgordura" min="0" name="bia_pgordura" oninput="recalcularKgGorduraAuto()" placeholder="Ex: 15.5" step="any" type="number"/>
</div>
<div class="input-group">
<label for="bia_pmusculo">% Músculo esquelético (%)</label>
<input id="bia_pmusculo" min="0" name="bia_pmusculo" oninput="recalcularKgMusculoAuto()" placeholder="Ex: 44.8" step="any" type="number"/>
</div>
<div class="input-group">
<label for="bia_imc">IMC (kg/m²)</label>
<input id="bia_imc" min="0" name="bia_imc" placeholder="Ex: 29.1" step="any" type="number"/>
</div>
</div>
<div class="input-row-4 input-row">
<div class="input-group">
<label for="bia_gordura_kg">Kg de gordura (kg)</label>
<input id="bia_gordura_kg" min="0" name="bia_gordura_kg" placeholder="Ex: 15.1" step="any" type="number"/>
</div>
<div class="input-group">
<label for="bia_mme">Kg Massa muscular (kg)</label>
<input id="bia_mme" min="0" name="bia_mme" placeholder="Ex: 82.3" step="any" type="number"/>
</div>
<div class="input-group">
<label for="bia_tmb">Metabolismo basal (kcal)</label>
<input id="bia_tmb" name="bia_tmb" placeholder="Ex: 2050" step="1" type="number"/>
</div>
<div class="input-group">
<label for="bia_visceral">Gordura visceral (nível)</label>
<input id="bia_visceral" max="30" min="1" name="bia_visceral" placeholder="Ex: 6" step="1" type="number"/>
</div>
</div>
<div class="input-row-3 input-row">
<div class="input-group">
<label for="bia_idade_corporal">Idade corporal (anos)</label>
<input id="bia_idade_corporal" name="bia_idade_corporal" placeholder="Ex: 29" step="1" type="number"/>
</div>
<div class="input-group">
<label for="bia_rcq">Relação cintura/quadril (RCQ)</label>
<input id="bia_rcq" min="0" name="bia_rcq" placeholder="Ex: 0.86" step="any" type="number"/>
</div>
<div class="input-group">
<label for="bia_risco">Classificação de Risco</label>
<select id="bia_risco" name="bia_risco">
<option value="Baixo Risco (Normal)">Baixo Risco (Normal)</option>
<option value="Risco Moderado">Risco Moderado</option>
<option value="Risco Alto">Risco Alto</option>
<option value="Risco Muito Alto">Risco Muito Alto</option>
</select>
</div>
</div>
<div class="input-group">
<label for="bia_analise_texto">Análise Clínica da Bioimpedância</label>
<textarea id="bia_analise_texto" name="bia_analise_texto" placeholder="Observações específicas da bioimpedância..." rows="2"></textarea>
</div>
</div>
<!-- ETAPA 4: Fotos -->
<div class="step" data-name="Registro Fotográfico (5 Fotos)" data-step="4">
<h2 class="step-title">Fotos de acompanhamento</h2>
<div class="info-box">
<strong>Padronização:</strong> Adicione até 5 fotos padronizadas do aluno para análise postural, acompanhamento estético e emissão do laudo oficial em PDF (sem distorções e sem quebras de página).
                        </div>
<div class="photo-grid" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 1rem;">
<!-- Foto 1: Frente -->
<div class="photo-upload-card" style="background:#ffffff; border:1px solid #cbd5e1; border-radius:10px; padding:0.85rem; text-align:center;">
<label for="foto_frente" style="font-weight:700; color:var(--text-main); margin-bottom:6px; display:block; font-size:0.85rem;">1. Frente (Anterior)</label>
<div class="photo-preview-wrapper" style="display:flex; flex-direction:column; align-items:center; gap:8px;">
<div class="photo-thumb" id="thumb-frente-box" style="width:100%; height:190px; background:#f8fafc; border:1px dashed #cbd5e1; border-radius:8px; display:flex; align-items:center; justify-content:center; overflow:hidden;">
<span id="thumb-frente-empty" style="font-size:0.75rem; color:#94a3b8;">Sem foto</span>
<img alt="Preview Frente" class="hidden" decoding="async" id="thumb-frente-img" loading="lazy" style="width:100%; height:100%; object-fit:contain;"/>
</div>
<div class="photo-upload-meta" style="width:100%;">
<input accept="image/*" id="foto_frente" name="foto_frente" onchange="previewAndCompressImage(this, 'frente')" style="font-size:0.75rem; width:100%;" type="file"/>
<span class="help-text" style="display:block; font-size:0.7rem; color:var(--text-muted); margin-top:3px;">Vista anterior ereta.</span>
<span class="photo-status" id="status-frente" style="font-size:0.7rem; color:var(--apple-blue);"></span>
</div>
</div>
</div>
<!-- Foto 2: Perfil Direito -->
<div class="photo-upload-card" style="background:#ffffff; border:1px solid #cbd5e1; border-radius:10px; padding:0.85rem; text-align:center;">
<label for="foto_perfil_direito" style="font-weight:700; color:var(--text-main); margin-bottom:6px; display:block; font-size:0.85rem;">2. Perfil Direito</label>
<div class="photo-preview-wrapper" style="display:flex; flex-direction:column; align-items:center; gap:8px;">
<div class="photo-thumb" id="thumb-perfil_direito-box" style="width:100%; height:190px; background:#f8fafc; border:1px dashed #cbd5e1; border-radius:8px; display:flex; align-items:center; justify-content:center; overflow:hidden;">
<span id="thumb-perfil_direito-empty" style="font-size:0.75rem; color:#94a3b8;">Sem foto</span>
<img alt="Preview Perfil Direito" class="hidden" decoding="async" id="thumb-perfil_direito-img" loading="lazy" style="width:100%; height:100%; object-fit:contain;"/>
</div>
<div class="photo-upload-meta" style="width:100%;">
<input accept="image/*" id="foto_perfil_direito" name="foto_perfil_direito" onchange="previewAndCompressImage(this, 'perfil_direito')" style="font-size:0.75rem; width:100%;" type="file"/>
<span class="help-text" style="display:block; font-size:0.7rem; color:var(--text-muted); margin-top:3px;">Lateral direita alinhada.</span>
<span class="photo-status" id="status-perfil_direito" style="font-size:0.7rem; color:var(--apple-blue);"></span>
</div>
</div>
</div>
<!-- Foto 3: Perfil Esquerdo -->
<div class="photo-upload-card" style="background:#ffffff; border:1px solid #cbd5e1; border-radius:10px; padding:0.85rem; text-align:center;">
<label for="foto_perfil_esquerdo" style="font-weight:700; color:var(--text-main); margin-bottom:6px; display:block; font-size:0.85rem;">3. Perfil Esquerdo</label>
<div class="photo-preview-wrapper" style="display:flex; flex-direction:column; align-items:center; gap:8px;">
<div class="photo-thumb" id="thumb-perfil_esquerdo-box" style="width:100%; height:190px; background:#f8fafc; border:1px dashed #cbd5e1; border-radius:8px; display:flex; align-items:center; justify-content:center; overflow:hidden;">
<span id="thumb-perfil_esquerdo-empty" style="font-size:0.75rem; color:#94a3b8;">Sem foto</span>
<img alt="Preview Perfil Esquerdo" class="hidden" decoding="async" id="thumb-perfil_esquerdo-img" loading="lazy" style="width:100%; height:100%; object-fit:contain;"/>
</div>
<div class="photo-upload-meta" style="width:100%;">
<input accept="image/*" id="foto_perfil_esquerdo" name="foto_perfil_esquerdo" onchange="previewAndCompressImage(this, 'perfil_esquerdo')" style="font-size:0.75rem; width:100%;" type="file"/>
<span class="help-text" style="display:block; font-size:0.7rem; color:var(--text-muted); margin-top:3px;">Lateral esquerda alinhada.</span>
<span class="photo-status" id="status-perfil_esquerdo" style="font-size:0.7rem; color:var(--apple-blue);"></span>
</div>
</div>
</div>
<!-- Foto 4: Costas -->
<div class="photo-upload-card" style="background:#ffffff; border:1px solid #cbd5e1; border-radius:10px; padding:0.85rem; text-align:center;">
<label for="foto_costas" style="font-weight:700; color:var(--text-main); margin-bottom:6px; display:block; font-size:0.85rem;">4. Costas (Posterior)</label>
<div class="photo-preview-wrapper" style="display:flex; flex-direction:column; align-items:center; gap:8px;">
<div class="photo-thumb" id="thumb-costas-box" style="width:100%; height:190px; background:#f8fafc; border:1px dashed #cbd5e1; border-radius:8px; display:flex; align-items:center; justify-content:center; overflow:hidden;">
<span id="thumb-costas-empty" style="font-size:0.75rem; color:#94a3b8;">Sem foto</span>
<img alt="Preview Costas" class="hidden" decoding="async" id="thumb-costas-img" loading="lazy" style="width:100%; height:100%; object-fit:contain;"/>
</div>
<div class="photo-upload-meta" style="width:100%;">
<input accept="image/*" id="foto_costas" name="foto_costas" onchange="previewAndCompressImage(this, 'costas')" style="font-size:0.75rem; width:100%;" type="file"/>
<span class="help-text" style="display:block; font-size:0.7rem; color:var(--text-muted); margin-top:3px;">Vista posterior completa.</span>
<span class="photo-status" id="status-costas" style="font-size:0.7rem; color:var(--apple-blue);"></span>
</div>
</div>
</div>
<!-- Foto 5: Livre / Detalhe / Postural --><div class="photo-upload-card" style="background:#ffffff; border:1px solid #cbd5e1; border-radius:10px; padding:0.85rem; text-align:center;">
<label for="foto_extra" style="font-weight:700; color:var(--text-main); margin-bottom:6px; display:block; font-size:0.85rem;">5. Livre / Detalhe / Postural</label>
<div class="photo-preview-wrapper" style="display:flex; flex-direction:column; align-items:center; gap:8px;">
<div class="photo-thumb" id="thumb-extra-box" style="width:100%; height:190px; background:#f8fafc; border:1px dashed #cbd5e1; border-radius:8px; display:flex; align-items:center; justify-content:center; overflow:hidden;">
<span id="thumb-extra-empty" style="font-size:0.75rem; color:#94a3b8;">Sem foto</span>
<img alt="Preview Extra" class="hidden" decoding="async" id="thumb-extra-img" loading="lazy" style="width:100%; height:100%; object-fit:contain;"/>
</div>
<div class="photo-upload-meta" style="width:100%;">
<input accept="image/*" id="foto_extra" name="foto_extra" onchange="previewAndCompressImage(this, 'extra')" style="font-size:0.75rem; width:100%;" type="file"/>
<span class="help-text" style="display:block; font-size:0.7rem; color:var(--text-muted); margin-top:3px;">Pose livre, postura ou abdômen.</span>
<span class="photo-status" id="status-extra" style="font-size:0.7rem; color:var(--apple-blue);"></span>
</div>
</div>
</div>
</div>
</div>
<!-- ETAPA 5: Aderência & Parecer do Avaliador -->
<div class="step" data-name="Aderência &amp; Parecer Técnico" data-step="5">
<h2 class="step-title">Acompanhamento e parecer</h2>
<div class="ef6-resumo" id="ef6-resumo"></div>
<div class="input-group">
<label for="energia">Nível de disposição / energia do aluno (1 a 5)</label>
<input id="energia" max="5" min="1" name="energia" step="1" type="range" value="3"/>
<div class="range-labels">
<span>1 (Baixa)</span>
<span>3 (Normal)</span>
<span>5 (Excelente)</span>
</div>
</div>
<div class="input-row">
<div class="input-group">
<label for="aderencia_treino">Aderência ao treino *</label>
<select id="aderencia_treino" name="aderencia_treino" required="">
<option value="100% no plano">100% no plano (Treinou tudo)</option>
<option value="Faltei 1-2x">Faltei 1-2x</option>
<option value="Faltei 3x ou mais">Faltei 3x ou mais</option>
<option value="Nunca treinou">Nunca treinou (ainda não iniciou um programa)</option>
<option value="Não treinei">Não treinei</option>
</select>
</div>
<div class="input-group">
<label for="aderencia_dieta">Aderência à dieta *</label>
<select id="aderencia_dieta" name="aderencia_dieta" required="">
<option value="100% no plano">100% no plano (Sem deslizes)</option>
<option value="Pequenos furos">Pequenos furos (1-2 refeições livres)</option>
<option value="Muitos furos">Muitos furos</option>
<option value="Nunca fez dieta">Nunca fez dieta (ainda não iniciou um plano)</option>
<option value="Fora do plano">Totalmente fora do plano</option>
</select>
</div>
</div>
<div class="input-group">
<label>Participante do Desafio de Transformação? *</label>
<div class="radio-group">
<label class="radio-option">
<input checked="" name="desafio" required="" type="radio" value="Sim"/> Sim
                                </label>
<label class="radio-option">
<input name="desafio" type="radio" value="Não"/> Não
                                </label>
</div>
</div>
<div class="ef6-sec">
<h3>🌙 Bem-estar &amp; recuperação</h3>
<div class="input-row">
<div class="input-group"><label for="ef6_sono">Qualidade do sono (1 a 5)</label><input id="ef6_sono" max="5" min="1" name="ef6_sono" step="1" type="range" value="3"/><div class="range-labels"><span>1 (Ruim)</span><span>3</span><span>5 (Ótimo)</span></div></div>
<div class="input-group"><label for="ef6_estresse">Nível de estresse (1 a 5)</label><input id="ef6_estresse" max="5" min="1" name="ef6_estresse" step="1" type="range" value="3"/><div class="range-labels"><span>1 (Baixo)</span><span>3</span><span>5 (Alto)</span></div></div>
</div>
<div class="input-group"><label for="ef6_dor">Dor / desconforto relatado</label><select id="ef6_dor" name="ef6_dor"><option value="Nenhuma">Nenhuma</option><option value="Leve">Leve</option><option value="Moderada">Moderada</option><option value="Forte">Forte</option></select></div>
</div>
<div class="ef6-sec">
<h3>🎯 Metas do aluno</h3>
<div class="input-row">
<div class="input-group"><label for="ef6_meta_pg">Meta de % de gordura</label><input id="ef6_meta_pg" max="60" min="3" name="ef6_meta_pg" placeholder="Ex: 12" step="0.1" type="number"/></div>
<div class="input-group"><label for="ef6_meta_peso">Meta de peso (kg)</label><input id="ef6_meta_peso" max="400" min="20" name="ef6_meta_peso" placeholder="Ex: 90" step="0.1" type="number"/></div>
<div class="input-group"><label for="ef6_meta_prazo">Prazo da meta</label><input id="ef6_meta_prazo" name="ef6_meta_prazo" type="date"/></div>
</div>
<span class="help-text">O progresso é calculado a partir da primeira avaliação do aluno.</span>
</div>
<div class="ef6-sec">
<h3>🧭 Parecer estruturado</h3>
<div class="input-group"><label for="ef6_status">Status geral do check-in</label><select id="ef6_status" name="ef6_status"><option value="">Automático (sugerido pela aderência)</option><option>Excelente</option><option>Bom</option><option>Regular</option><option>Atenção</option></select></div>
<div class="input-group"><label>Marcadores rápidos</label><input id="ef6_tags" name="ef6_tags" type="hidden" value=""/><div class="ef6-chips" id="ef6-tags"></div></div>
<div class="input-group"><label for="ef6_fortes">✅ Pontos fortes</label><textarea id="ef6_fortes" name="ef6_fortes" placeholder="O que está funcionando bem neste ciclo..." rows="2"></textarea></div>
<div class="input-group"><label for="ef6_atencao">⚠️ Pontos de atenção</label><textarea id="ef6_atencao" name="ef6_atencao" placeholder="O que precisa de cuidado ou correção..." rows="2"></textarea></div>
<div class="input-row">
<div class="input-group"><label for="ef6_treino">🏋️ Ajustes no treino</label><textarea id="ef6_treino" name="ef6_treino" placeholder="Carga, volume, frequência..." rows="2"></textarea></div>
<div class="input-group"><label for="ef6_dieta">🥗 Ajustes na dieta</label><textarea id="ef6_dieta" name="ef6_dieta" placeholder="Orientações alimentares..." rows="2"></textarea></div>
</div>
<div class="input-group"><label for="ef6_proximos">🚀 Próximos passos até a reavaliação</label><textarea id="ef6_proximos" name="ef6_proximos" placeholder="Ações práticas para as próximas semanas..." rows="2"></textarea></div>
</div>
<div class="input-group">
<label for="observacoes">Feedback / Relato do Aluno</label>
<textarea id="observacoes" name="observacoes" placeholder="Sensações relatadas pelo aluno, dores ou dificuldades..." rows="2"></textarea>
</div>
<div class="input-group" style="background:#fefce8; border:1px solid #fef08a; padding:1rem; border-radius:var(--radius-md);">
<label for="parecer_profissional" style="color:#854d0e; font-weight:700;">
                                ✍️ Parecer Técnico &amp; Observações do Profissional Avaliador (Sai no PDF) *
                            </label>
<span class="help-text">Este campo é exportado em destaque no relatório. Descreva a evolução nas dobras e na BIA, metas e ajustes de treino/dieta.</span>
<textarea id="parecer_profissional" name="parecer_profissional" placeholder="Ex: Excelente adesão e redução de adiposidade subcutânea visível nas dobras do tronco. Aumento de massa muscular confirmado na BIA." rows="4"></textarea>
<div class="ef6-acoes"><button class="btn btn-secondary btn-sm" id="ef6-btn-rascunho" type="button">✨ Gerar rascunho com os dados</button><button class="btn btn-secondary btn-sm" id="ef6-btn-copiar" type="button">📋 Copiar resumo (WhatsApp)</button></div>
<div style="margin-top:.6rem"><span class="help-text">Frases rápidas (clique para inserir):</span><div class="ef6-chips" id="ef6-frases" style="margin-top:.3rem"></div></div>
</div>
</div>
<!-- Botões de Ação do Wizard -->
<div class="form-actions" id="form-actions">
<button class="btn btn-prev hidden" id="btn-prev" type="button">Voltar</button>
<button class="btn btn-next" id="btn-next" type="button">Próxima Etapa</button>
<button class="btn btn-submit hidden" id="btn-submit" type="submit">Salvar Avaliação</button>
</div>
<!-- Mensagem de Sucesso -->
<div class="hidden success-message" id="success-screen">
<div class="success-icon">✓</div>
<h2 id="success-title" style="color: var(--text-main); margin-bottom: 0.5rem;">Avaliação Salva com Sucesso!</h2>
<p id="success-db-info" style="color: var(--text-muted); margin-bottom: 1.5rem;">Os dados foram registrados no banco de dados.</p>
<div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
<button class="btn btn-primary" onclick="irParaComparacaoComRecente()" type="button">⚖️ Comparar Avaliações</button>
<button class="btn btn-secondary" onclick="resetFormulario()" type="button">➕ Novo Check-in</button>
<button class="btn btn-secondary" onclick="switchTab('tab-historico')" type="button">📋 Ver Todas Avaliações</button>
</div>
</div>
</form>
</div>
</section>
<!-- ============================================================== -->
<!-- ABA 2: AVALIAÇÕES CADASTRADAS (COM BOTÃO DE PDF COM FOTOS)     -->
<!-- ============================================================== -->
<section class="tab-panel" id="tab-historico">
<!-- DASHBOARD KPI SUMMARY v5.0 -->
<div class="dashboard-kpi-grid no-print">
<div class="kpi-card">
<div class="kpi-icon-box" style="background:#eff6ff; color:#2563eb;">👥</div>
<div class="kpi-info">
<span class="kpi-title">Avaliações Totais <span id="history-header-count" style="display:none;">0</span></span>
<span class="kpi-value" id="kpi-total-avaliacoes">0</span>
</div>
</div>
<div class="kpi-card">
<div class="kpi-icon-box" style="background:#ecfdf5; color:#10b981;">📉</div>
<div class="kpi-info">
<span class="kpi-title">Média de % Gordura</span>
<span class="kpi-value" id="kpi-media-gordura">--%</span>
</div>
</div>
<div class="kpi-card">
<div class="kpi-icon-box" style="background:#fef3c7; color:#d97706;">🏋️</div>
<div class="kpi-info">
<span class="kpi-title">Massa Magra Média</span>
<span class="kpi-value" id="kpi-media-massa">-- kg</span>
</div>
</div>
<div class="kpi-card">
<div class="kpi-icon-box" style="background:#f5edfa; color:#9333ea;">📷</div>
<div class="kpi-info">
<span class="kpi-title">Com 5 Fotos</span>
<span class="kpi-value" id="kpi-com-fotos">0</span>
</div>
</div>
</div>
<!-- Barra de Busca e Filtros Rápidos -->
<div class="search-bar-container no-print">
<div class="search-input-box">
<input id="filtro-busca" aria-label="Buscar avaliações por aluno, e-mail ou semana" oninput="filtrarAvaliacoes()" placeholder="🔍 Buscar por nome do aluno, e-mail ou semana..." type="text"/>
</div>
<div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
<button class="btn btn-secondary btn-sm" onclick="abrirModalCentralBackup('exportar')">⬇️ Exportar Backup</button>
<button class="btn btn-secondary btn-sm" onclick="exportarCSV()">📊 Exportar CSV</button>
<button class="btn btn-secondary btn-sm" onclick="abrirModalCentralBackup('importar')">⬆️ Importar JSON</button>
<input accept=".json,.efx" id="import-file-input" aria-label="Selecionar arquivo para importar" onchange="importarBackupJSON(event)" style="display: none;" type="file"/>
</div>
</div>
<div class="card">
<div class="card-header">
<div class="card-title">
<span>📋</span> <span>Avaliações Físicas Cadastradas (<span id="history-header-count-list">0</span>)</span>
</div>
<div style="font-size:0.85rem; color:var(--text-muted);">
                        Clique em <strong>🖨️ Relatório PDF</strong> para gerar o laudo com todos os dados e fotos!
                    </div>
</div>
<div id="history-empty-state" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
<div style="font-size: 3rem; margin-bottom: 0.75rem;">📁</div>
<h3 style="color: var(--text-main); margin-bottom: 0.5rem;">Nenhuma avaliação encontrada</h3>
<p style="margin-bottom: 1.5rem;">Cadastre uma nova avaliação física ou carregue os dados de demonstração.</p>
<button class="btn btn-primary" onclick="carregarDadosExemplo()">⚡ Experimentar com dados de exemplo</button>
</div>
<div class="history-list" id="history-list-grid">
<!-- Cards renderizados dinamicamente via JS -->
</div>
</div>
</section>
