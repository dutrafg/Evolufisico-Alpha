@media print {
  body.ef-simple-ui .top-navbar > .nav-tabs::before { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  body.ef-simple-ui * { transition: none !important; animation: none !important; }
}

/* ==========================================================================
   Modo escuro: substitui as superfícies azul-marinho fixas do CSS antigo
   ========================================================================== */
@media screen {
  html.ef-dark-mode body.ef-simple-ui :is(#tab-painel, #tab-historico, #tab-comparison, #tab-cobranca, #tab-lab77, #tab-novo-checkin)
