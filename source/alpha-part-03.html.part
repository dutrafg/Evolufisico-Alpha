  html.ef-dark-mode body.ef-simple-ui #filtro-busca { border-color: var(--ef-line) !important; }
  body.ef-simple-ui :is(.cob-seg-btn, .cob-view-btn, .cob-kpi-label):not(.active) { color: var(--ef-muted) !important; }
  body.ef-simple-ui .cob-view-btn.active { background: var(--ef-soft) !important; }
}
@media screen {
  html.ef-dark-mode body.ef-simple-ui :is(#tab-historico, #tab-painel) :is(.history-badge, .ef70-badge) {
    background: var(--ef-soft) !important;
    color: var(--ef-fir) !important;
    border-color: transparent !important;
  }
  body.ef-simple-ui .cob-kpi-val { color: var(--ef-fir) !important; }
}


/* Ajustes de acabamento da 9.0: safe-area, nomes longos e foco sem halo legado. */
@media screen {
  body.ef-simple-ui #ef55-toasts {
    bottom: calc(82px + env(safe-area-inset-bottom, 0px)) !important;
    left: 50% !important;
