    color: var(--ef-ink) !important;
  }
  html.ef-dark-mode body.ef-simple-ui #tab-painel .ef55-kpis { background: var(--ef-surface) !important; border-color: var(--ef-line) !important; }
  html.ef-dark-mode body.ef-simple-ui #tab-painel .ef55-kpis > * { background: transparent !important; border-color: var(--ef-line) !important; }
  html.ef-dark-mode body.ef-simple-ui #tab-historico > .card { background: transparent !important; border: 0 !important; }
  html.ef-dark-mode body.ef-simple-ui th,
  html.ef-dark-mode body.ef-simple-ui #tab-comparison .comparison-table :is(th, thead th) { background: var(--ef-soft) !important; color: var(--ef-ink) !important; border-color: var(--ef-line) !important; }
  html.ef-dark-mode body.ef-simple-ui :is(td, .cob-table td, #tab-comparison .comparison-table :is(td, tr, tbody tr)) { background: transparent !important; border-color: var(--ef-line) !important; }
  html.ef-dark-mode body.ef-simple-ui :is(input, select, textarea):not([type=checkbox]):not([type=radio]):not([type=range]):not([type=file]) {
    background: var(--ef-surface) !important;
    border-color: var(--ef-line) !important;
    color: var(--ef-ink) !important;
  }
  html.ef-dark-mode body.ef-simple-ui .kpi-icon-box[style] { background: var(--ef-soft) !important; color: var(--ef-fir) !important; }
  html.ef-dark-mode body.ef-simple-ui .ef-simple-fold { background: var(--ef-surface) !important; border-color: var(--ef-line) !important; }
}

/* ==========================================================================
   Azuis remanescentes do CSS antigo → paleta da ficha viva (claro e escuro)
   ========================================================================== */
@media screen {
  body.ef-simple-ui :is(.ef-help-btn, #comp-period-badge, .history-badge, .ef70-badge, .cob-view-btn.active, .cob-kpi-icon, .ef-nav-count) {
