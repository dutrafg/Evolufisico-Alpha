<script>/* 14-runtime.js */
/* ===== v7.7.0 · Evolution Profile ===== */
(function(){
'use strict';
var S=window.__EF63_STATE__||null;
if(!S||!window.EF70)return;
var VERSION='7.1',cache=new Map();
function norm(v){return EFU.norm(v)}
function esc(v){return EFU.esc(v)}
function fmt(v,d){return v==null?'—':Number(v).toFixed(d==null?1:d)}
function current(id){return (typeof encontrarAvaliacaoPorId==='function'?encontrarAvaliacaoPorId(id):null)||(S.getAvaliacoes?S.getAvaliacoes():[]).find(function(x){return String(x.id)===String(id)})||null}
function profile(id){
 var a=current(id);if(!a)return null;var k=EFIdentity.key(a)+'|'+S.version,c=cache.get(k);if(c)return c;
 var d=EF70.student(a);if(!d)return null;
 var latest=d.last||{},score=d.score||{},insights=d.correlations||[],metrics=[];
 [['gordura','% Gordura','%',true],['massaMagra','Massa magra',' kg',false],['cintura','Cintura',' cm',true],['peso','Peso',' kg',null]].forEach(function(m){var tr=d.trends&&d.trends[m[0]];metrics.push({key:m[0],label:m[1],unit:m[2],current:latest[m[0]],trend:tr?tr.per30:null,favorable:m[3]})});
 var r={id:String(a.id),name:a.nome||'',date:a.data_avaliacao||'',count:d.count,score:score,confidence:d.confidence,metrics:metrics,insights:insights,scenarios:d.scenarios||[],actions:d.actions||[],timeline:d.timeline||[],consistency:d.consistency||{}};cache.set(k,r);return r;
}
function scoreLabel(v){if(v==null)return 'Sem score';if(v>=80)return 'trajetória muito consistente';if(v>=65)return 'trajetória consistente';if(v>=50)return 'trajetória em acompanhamento';return 'trajetória com pontos de atenção'}
function confidenceLabel(v){return v>=80?'Alta':v>=60?'Moderada':'Baixa'}
function trendText(m){if(m.trend==null)return 'sem tendência calculável';if(Math.abs(m.trend)<0.05)return 'estável';return(m.trend>0?'↗':'↘')+' '+fmt(Math.abs(m.trend))+' '+m.unit+'/30d'}
function trendColor(m){if(m.trend==null||Math.abs(m.trend)<0.05)return '';var good=m.trend>0;if(m.key==='gordura'||m.key==='cintura')good=!good;if(m.key==='peso')return '';return good?'#16a34a':'#dc2626'}
function render(id){
 var box=document.getElementById('patient-view-content'),p=profile(id);if(!box||!p)return;var old=document.getElementById('ef71-profile');if(old)old.remove();
 var score=p.score&&p.score.value!=null?p.score.value:null;
 var topMetrics=p.metrics.map(function(m){return '<div class="ef71-metric"><small>'+esc(m.label)+'</small><strong>'+fmt(m.current)+(m.current!=null?esc(m.unit):'')+'</strong><span style="'+(trendColor(m)?'color:'+trendColor(m)+';font-weight:600':'')+'">'+esc(trendText(m))+'</span></div>'}).join('');
 var ins=p.insights.slice(0,4).map(function(e){return '<div class="ef71-insight '+(e.severity==='good'?'good':e.severity==='warn'?'attention':'info')+'"><b>'+(e.severity==='good'?'✓':e.severity==='warn'?'!':'•')+' '+esc(e.title)+'</b><p>'+esc(e.text)+'</p></div>'}).join('');
 var scen=p.scenarios.slice(0,4).map(function(x){var label=x.label||x.metric||'Cenário';var v=x.in60!=null?x.in60:(x.value60!=null?x.value60:null);return '<div class="ef71-scenario"><small>'+esc(label)+'</small><strong>'+fmt(v)+'</strong><span>em 60 dias · '+esc(x.basis||'tendência disponível')+'</span></div>'}).join('');
 var acts=p.actions.slice(0,3).map(function(x){return '<div class="ef71-action '+(x.priority==='attention'?'attention':'')+'"><span>→</span><div><b>'+esc(x.priority==='attention'?'Ponto de atenção':'Próximo acompanhamento')+'</b><p>'+esc(x.text)+'</p></div></div>'}).join('');
 var timeline=p.timeline.slice(-5).reverse().map(function(x,i){return '<div class="ef71-time"><span class="dot"></span><div><b>'+esc(x.data||'Avaliação')+'</b><span>'+(i===0?'Avaliação atual':i===1?'Última avaliação':'Avaliação anterior')+'</span></div></div>'}).join('');
 var card=document.createElement('section');card.id='ef71-profile';card.className='ef71-profile';
 card.innerHTML='<div class="ef71-head"><div><div class="ef71-kicker">Evolução do aluno</div><h2>🎯 Estado atual da evolução</h2><p>Resumo individual da sua evolução, calculado a partir das avaliações registradas.</p></div><div class="ef71-score"><strong>'+(score==null?'—':score)+'</strong><span>/100</span><small>'+esc(scoreLabel(score))+'</small></div></div><div class="ef71-confidence"><span>Confiança dos dados <b>'+esc(String(p.confidence||0))+'%</b></span><span>'+esc(confidenceLabel(p.confidence||0))+' · '+p.count+' avaliações</span></div><div class="ef71-metrics">'+topMetrics+'</div><div class="ef71-cols"><div><h3>🧠 O que o motor identificou</h3>'+(ins||'<div class="ef71-empty">Ainda não há padrões compostos suficientes.</div>')+'</div><div><h3>⚡ O que merece acompanhamento</h3>'+(acts||'<div class="ef71-empty">Nenhuma ação prioritária identificada.</div>')+'</div></div>'+(scen?'<div class="ef71-section"><h3>🔭 Cenários de tendência</h3><div class="ef71-scenarios">'+scen+'</div><small class="ef71-note">Cenários são extrapolações matemáticas simples das avaliações disponíveis; não representam previsões clínicas.</small></div>':'')+'<div class="ef71-section"><h3>🗓️ Linha do tempo recente</h3><div class="ef71-timeline">'+timeline+'</div></div><div class="ef71-foot">Última avaliação: '+esc(p.date||'—')+'</div>';
 box.insertBefore(card,box.firstChild);
}
function renderCurrent(){var id=window.avaliacaoEmVisualizacaoId;if(id)render(id);else if(window.avaliacaoLaudoWebAtiva&&window.avaliacaoLaudoWebAtiva.id)render(window.avaliacaoLaudoWebAtiva.id)}
var oldOpen=window.abrirVisualizacaoPacienteWeb;if(typeof oldOpen==='function'&&!oldOpen.__ef71){var open=function(id){var r=oldOpen.apply(this,arguments);setTimeout(function(){render(id)},0);return r};open.__ef71=true;window.abrirVisualizacaoPacienteWeb=open}
var oldDetails=window.abrirModalDetalhes;if(typeof oldDetails==='function'&&!oldDetails.__ef71){var details=function(id){var r=oldDetails.apply(this,arguments);setTimeout(function(){try{var host=document.getElementById('modal-body-content');if(host&&host.closest('.modal-overlay')){var a=current(id),d=a&&window.EF70&&EF70.student&&EF70.student(a);if(d){var old=document.getElementById('ef71-modal-profile');if(old)old.remove();var temp=document.createElement('div');temp.id='ef71-modal-profile';temp.className='ef71-mini';temp.innerHTML='<b>🎯 Perfil Evolutivo · '+esc(String(d.score&&d.score.value!=null?d.score.value:'—'))+'/100</b><span>Confiança '+esc(String(d.confidence||0))+'% · '+d.count+' avaliações</span>';host.insertBefore(temp,host.firstChild)}}}catch(e){console.warn('EF71 details decorator err:',e)}},0);return r};details.__ef71=true;window.abrirModalDetalhes=details}
var oldTouch=S.touch;S.touch=function(){if(typeof oldTouch==='function')oldTouch.apply(S,arguments);cache.clear()};
window.EF71={version:VERSION,profile:profile,render:render,invalidate:function(){cache.clear()},stats:function(){return{engine:VERSION,cacheEntries:cache.size}}};
var css=document.createElement('style');css.textContent='.ef71-profile{margin:0 0 1.5rem;padding:1.25rem;border:1px solid var(--border-color,#dbe2ea);border-radius:16px;background:linear-gradient(180deg,#fff,#f8fafc);box-shadow:0 8px 24px rgba(15,23,42,.06)}.ef71-head{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.ef71-kicker{font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#64748b}.ef71-head h2{margin:.2rem 0 .35rem;font-size:1.15rem}.ef71-head p{margin:0;color:#64748b;font-size:.78rem;max-width:650px;line-height:1.5}.ef71-score{min-width:94px;text-align:center;padding:.65rem .8rem;border-radius:14px;background:#eff6ff;border:1px solid #bfdbfe}.ef71-score strong{font-size:1.7rem}.ef71-score span{font-size:.72rem;color:#64748b}.ef71-score small{display:block;font-size:.64rem;font-weight:700;margin-top:.15rem}.ef71-confidence{display:flex;justify-content:space-between;gap:1rem;margin:1rem 0;padding:.65rem .8rem;border-radius:10px;background:#f1f5f9;font-size:.72rem;color:#475569}.ef71-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.ef71-metric{padding:.75rem;border:1px solid #e2e8f0;border-radius:11px;background:#fff}.ef71-metric small,.ef71-metric span{display:block;color:#64748b;font-size:.65rem}.ef71-metric strong{display:block;font-size:1rem;margin:.2rem 0}.ef71-cols{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem}.ef71-cols h3,.ef71-section h3{font-size:.82rem;margin:0 0 .55rem}.ef71-insight,.ef71-action{padding:.65rem .75rem;border-radius:10px;margin:.4rem 0;border:1px solid #e2e8f0;background:#fff}.ef71-insight.good{border-left:3px solid #16a34a}.ef71-insight.attention,.ef71-action.attention{border-left:3px solid #dc2626}.ef71-insight.info{border-left:3px solid #64748b}.ef71-insight b,.ef71-action b{font-size:.72rem}.ef71-insight p,.ef71-action p{margin:.22rem 0 0;font-size:.68rem;color:#64748b;line-height:1.4}.ef71-action{display:flex;gap:.55rem}.ef71-action>span{font-weight:800}.ef71-section{margin-top:1rem;padding-top:1rem;border-top:1px solid #e2e8f0}.ef71-scenarios{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px}.ef71-scenario{padding:.7rem;border-radius:10px;background:#fff;border:1px solid #e2e8f0}.ef71-scenario small,.ef71-scenario span{display:block;color:#64748b;font-size:.62rem}.ef71-scenario strong{display:block;font-size:.95rem;margin:.15rem 0}.ef71-note{display:block;color:#64748b;font-size:.62rem;margin-top:.5rem}.ef71-timeline{display:flex;gap:0;overflow:auto}.ef71-time{position:relative;min-width:125px;padding-left:16px}.ef71-time:not(:last-child):after{content:"";position:absolute;top:6px;left:5px;width:calc(100% - 5px);height:1px;background:#cbd5e1}.ef71-time .dot{position:absolute;left:0;top:2px;width:10px;height:10px;border-radius:50%;background:#2563eb;z-index:1}.ef71-time b,.ef71-time span{display:block;font-size:.63rem}.ef71-time span{color:#64748b;margin-top:.15rem}.ef71-empty{font-size:.7rem;color:#64748b;padding:.7rem;background:#f8fafc;border-radius:9px}.ef71-foot{margin-top:1rem;color:#94a3b8;font-size:.6rem;text-align:right}.ef71-mini{margin-bottom:1rem;padding:.75rem;border-radius:10px;background:#eff6ff;border:1px solid #bfdbfe;display:flex;justify-content:space-between;gap:1rem;font-size:.72rem}.ef71-mini span{color:#64748b}@media(max-width:700px){.ef71-head,.ef71-confidence{flex-direction:column}.ef71-metrics{grid-template-columns:1fr 1fr}.ef71-cols{grid-template-columns:1fr}.ef71-score{align-self:flex-start}.ef71-time{min-width:105px}}';document.head.appendChild(css);
window.addEventListener('DOMContentLoaded',function(){setTimeout(renderCurrent,250)});
})();
</script>
<script>/* 15-runtime.js */
/* ===== Comparação da evolução ===== */
(function(){
'use strict';
var S=window.__EF63_STATE__||null;
if(!S||!window.EF70)return;
var VERSION='7.2',cache=new Map();
var MET={gordura:{label:'% Gordura',unit:'%',lower:true},massaMagra:{label:'Massa magra',unit:' kg',higher:true},cintura:{label:'Cintura',unit:' cm',lower:true},peso:{label:'Peso',unit:' kg'}};
function norm(v){return EFU.norm(v)}
function esc(v){return EFU.esc(v)}
function num(v){return EFU.num(v)}
function date(v){var t=Date.parse(v||'');return isNaN(t)?0:t}
function source(){return S.getAvaliacoes?S.getAvaliacoes():[]}
function val(a){var d=a.dobras_resultado||{},b=a.bioimpedancia||{},p=a.perimetria||{};return{cliente_id:a.cliente_id||String(a.id),id:String(a.id),nome:String(a.nome||''),date:date(a.data_avaliacao||a.timestamp),data:a.data_avaliacao||'',peso:num(a.peso),gordura:num(d.percGordura!=null?d.percGordura:b.pgordura),massaMagra:num(d.massaMagra),cintura:num(p.cintura)}}
function list(name){var k=EFIdentity.key(name),a=source().filter(function(x){return EFIdentity.key(x)===k}).map(val);a.sort(function(x,y){return x.date-y.date});return a}
function avg(arr,k){var v=arr.map(function(x){return x[k]}).filter(function(x){return x!=null});return v.length?v.reduce(function(a,b){return a+b},0)/v.length:null}
function delta(a,b,k){return a!=null&&b!=null?+(b-a).toFixed(2):null}
function favorable(k,d){if(d==null||k==='peso')return null;return MET[k].lower?d<-.05:d>.05}
function phase(arr){if(!arr.length)return null;var mid=Math.floor(arr.length/2);return{early:arr.slice(0,Math.max(1,mid)),late:arr.slice(mid)} }
function compareGroups(a,b){var out={};Object.keys(MET).forEach(function(k){var av=avg(a,k),bv=avg(b,k),d=delta(av,bv,k);out[k]={a:av,b:bv,delta:d,favorable:favorable(k,d)}});return out}
function transitionDelta(arr,k){var out=[];for(var i=1;i<arr.length;i++){var d=delta(arr[i-1][k],arr[i][k]);if(d!=null)out.push({date:arr[i].data,delta:d})}return out}
function compare(name){var arr=list(name);if(!arr.length)return null;var ph=phase(arr),first=arr[0],last=arr[arr.length-1],recent=arr.slice(-Math.min(3,arr.length)),previous=arr.slice(Math.max(0,arr.length-Math.min(6,arr.length)),Math.max(0,arr.length-Math.min(3,arr.length)));
var overall={},phaseCmp={},momentum={};Object.keys(MET).forEach(function(k){overall[k]={first:first[k],last:last[k],delta:delta(first[k],last[k]),favorable:favorable(k,delta(first[k],last[k]))};phaseCmp[k]=ph&&ph.early.length&&ph.late.length?compareGroups(ph.early,ph.late)[k]:{a:null,b:null,delta:null,favorable:null};var r=transitionDelta(arr,k), n=r.length;momentum[k]={last:r[n-1]||null,previous:n>1?r[n-2]:null,reversal:n>1&&r[n-1].delta!=null&&r[n-2].delta!=null&&Math.sign(r[n-1].delta)!==Math.sign(r[n-2].delta),acceleration:n>1&&r[n-1].delta!=null&&r[n-2].delta!=null?+(r[n-1].delta-r[n-2].delta).toFixed(2):null};});
var recentVsPrevious=(recent.length>=2&&previous.length>=1)?compareGroups(previous,recent):{};
var changes=[];Object.keys(MET).forEach(function(k){var o=overall[k],p=phaseCmp[k],m=momentum[k],rv=recentVsPrevious[k];if(o.delta!=null&&Math.abs(o.delta)>=.5&&o.favorable!==null)changes.push({kind:o.favorable?'positive':'attention',metric:k,title:o.favorable?MET[k].label+' melhorou no período':'Mudança relevante em '+MET[k].label,text:MET[k].label+': '+fmt(o.first)+MET[k].unit+' → '+fmt(o.last)+MET[k].unit+'.'});if(m.reversal)changes.push({kind:'reversal',metric:k,title:'Reversão de direção',text:MET[k].label+' mudou de direção entre as duas últimas transições.'});if(rv&&rv.delta!=null&&p&&p.delta!=null&&Math.abs(rv.delta-p.delta)>=.25)changes.push({kind:rv.favorable?'positive':'attention',metric:k,title:'Mudança de ritmo',text:'O comportamento recente de '+MET[k].label.toLowerCase()+' difere da fase anterior.'});});
return{version:VERSION,name:name,count:arr.length,first:first,last:last,overall:overall,phase:phaseCmp,recentVsPrevious:recentVsPrevious,momentum:momentum,changes:changes.slice(0,12),periods:{early:ph.early,late:ph.late,recent:recent,previous:previous}}
}
function fmt(v){return v==null?'—':Number(v).toFixed(1)}
function fmtDate(v){if(!v)return '—';var d=new Date(v);return isNaN(d.getTime())?'—':d.toLocaleDateString('pt-BR')}
function labelChange(d,k){if(d==null)return 'sem comparação';if(Math.abs(d)<.05)return 'estável';var fav=favorable(k,d);return (fav?'melhorou':'mudou')+' '+(d>0?'+':'')+fmt(d)+MET[k].unit}
function render(id){var host=document.getElementById('patient-view-content');var a=source().find(function(x){return String(x.id)===String(id)});if(!host||!a)return;var c=compare(a);if(!c)return;var old=document.getElementById('ef72-comparison');if(old)old.remove();var rows=Object.keys(MET).map(function(k){var o=c.overall[k],r=c.recentVsPrevious[k]||{},m=c.momentum[k];return '<div class="ef72-row"><div><b>'+esc(MET[k].label)+'</b><span>'+fmt(o.first)+esc(MET[k].unit)+' → '+fmt(o.last)+esc(MET[k].unit)+'</span></div><strong class="'+(o.favorable===true?'good':o.favorable===false?'attention':'neutral')+'">'+esc(labelChange(o.delta,k))+'</strong><small>'+esc(m.reversal?'reversão recente':r.delta!=null?'fase recente: '+labelChange(r.delta,k):'sem fase comparável')+'</small></div>'}).join('');var changes=c.changes.map(function(x){return '<div class="ef72-change '+esc(x.kind)+'"><b>'+(x.kind==='positive'?'✓':x.kind==='reversal'?'↔':'!')+' '+esc(x.title)+'</b><p>'+esc(x.text)+'</p></div>'}).join('');var card=document.createElement('section');card.id='ef72-comparison';card.className='ef72-card';card.innerHTML='<div class="ef72-head"><div><div class="ef72-kicker">Comparação da evolução</div><h2>📊 Como a trajetória mudou</h2><p>Comparação centralizada entre o início, as fases da evolução e as transições mais recentes.</p></div><div class="ef72-count">'+c.count+' avaliações</div></div><div class="ef72-grid">'+rows+'</div><div class="ef72-bottom"><div><h3>🔎 Mudanças de padrão</h3>'+(changes||'<div class="ef72-empty">Nenhuma mudança de padrão relevante identificada.</div>')+'</div><div class="ef72-phases"><h3>🗓️ Fases analisadas</h3><div><span><b>Início</b>'+fmtDate(c.periods.early[0]&&c.periods.early[0].data)+' · '+c.periods.early.length+' aval.</span><span><b>Fase recente</b>'+fmtDate(c.periods.late[0]&&c.periods.late[0].data)+' → '+fmtDate(c.last.data)+' · '+c.periods.late.length+' aval.</span></div><small>Quando há poucos registros, a comparação é reduzida ao que os dados permitem.</small></div></div><div class="ef72-foot">Comparação entre períodos feita com base nas avaliações registradas.</div>';var profile=document.getElementById('ef71-profile');if(profile&&profile.parentNode)profile.parentNode.insertBefore(card,profile.nextSibling);else host.insertBefore(card,host.firstChild)}
function renderCurrent(){var id=window.avaliacaoEmVisualizacaoId;if(id)render(id);else if(window.avaliacaoLaudoWebAtiva&&window.avaliacaoLaudoWebAtiva.id)render(window.avaliacaoLaudoWebAtiva.id)}
function invalidate(){cache.clear()}
window.EF72={version:VERSION,compare:compare,student:function(name){var k=EFIdentity.key(name)+'|'+S.version;if(cache.has(k))return cache.get(k);var r=compare(name);cache.set(k,r);return r},render:render,invalidate:invalidate,stats:function(){return{engine:VERSION,cacheEntries:cache.size,version:S.version}}};
var oldOpen=window.abrirVisualizacaoPacienteWeb;if(typeof oldOpen==='function'&&!oldOpen.__ef72){var f=function(id){var r=oldOpen.apply(this,arguments);setTimeout(function(){render(id)},0);return r};f.__ef72=true;window.abrirVisualizacaoPacienteWeb=f}
var oldTouch=S.touch;S.touch=function(){if(typeof oldTouch==='function')oldTouch.apply(S,arguments);invalidate();if(window.EF71&&EF71.invalidate)EF71.invalidate();setTimeout(renderCurrent,100)};
window.addEventListener('DOMContentLoaded',function(){setTimeout(renderCurrent,400)});
var css=document.createElement('style');css.textContent='.ef72-card{margin:0 0 1.5rem;padding:1.25rem;border:1px solid var(--border-color,#dbe2ea);border-radius:16px;background:#fff;box-shadow:0 7px 22px rgba(15,23,42,.05)}.ef72-head{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.ef72-kicker{font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#64748b}.ef72-head h2{margin:.2rem 0 .35rem;font-size:1.08rem}.ef72-head p{margin:0;color:#64748b;font-size:.76rem;line-height:1.45}.ef72-count{padding:.5rem .7rem;border-radius:999px;background:#f1f5f9;font-size:.68rem;font-weight:700;color:#475569;white-space:nowrap}.ef72-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:1rem}.ef72-row{padding:.75rem;border:1px solid #e2e8f0;border-radius:11px;background:#f8fafc}.ef72-row div{display:flex;justify-content:space-between;gap:5px}.ef72-row b{font-size:.72rem}.ef72-row span{font-size:.68rem;color:#64748b}.ef72-row strong{display:block;margin:.35rem 0;font-size:.76rem}.ef72-row strong.good{color:#15803d}.ef72-row strong.attention{color:#b91c1c}.ef72-row strong.neutral{color:#64748b}.ef72-row small{display:block;color:#64748b;font-size:.62rem}.ef72-bottom{display:grid;grid-template-columns:1.2fr .8fr;gap:1rem;margin-top:1rem}.ef72-bottom h3{font-size:.8rem;margin:0 0 .5rem}.ef72-change{padding:.62rem .72rem;border:1px solid #e2e8f0;border-radius:9px;margin:.35rem 0}.ef72-change.positive{border-left:3px solid #16a34a}.ef72-change.attention,.ef72-change.reversal{border-left:3px solid #dc2626}.ef72-change b{font-size:.7rem}.ef72-change p{margin:.2rem 0 0;color:#64748b;font-size:.66rem}.ef72-phases{padding:.8rem;border-radius:11px;background:#f8fafc;border:1px solid #e2e8f0}.ef72-phases span{display:block;padding:.35rem 0;font-size:.66rem;color:#64748b}.ef72-phases b{display:block;color:#334155;font-size:.68rem}.ef72-phases small{display:block;margin-top:.45rem;color:#94a3b8;font-size:.6rem;line-height:1.4}.ef72-empty{padding:.7rem;border-radius:9px;background:#f8fafc;color:#64748b;font-size:.68rem}.ef72-foot{margin-top:1rem;padding-top:.7rem;border-top:1px solid #eef2f7;text-align:right;color:#94a3b8;font-size:.6rem}@media(max-width:760px){.ef72-head{flex-direction:column}.ef72-grid{grid-template-columns:1fr 1fr}.ef72-bottom{grid-template-columns:1fr}}@media(max-width:430px){.ef72-grid{grid-template-columns:1fr}}';document.head.appendChild(css);
})();
</script>
<style>/* 14-styles.css */
/* ============================================================================
   EvoluFísico v7.3 — EVOLUTION MONITORING ENGINE
   ============================================================================ */
.ef73-card{margin:18px 0;padding:20px;border:1px solid var(--slate-200,#e5e7eb);border-radius:18px;background:#fff;box-shadow:0 8px 24px rgba(15,23,42,.07)}
.ef73-head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin-bottom:16px}
.ef73-kicker{font-size:.72rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#2563eb}
.ef73-head h2{margin:4px 0 5px;font-size:1.18rem}.ef73-head p{margin:0;color:#64748b;font-size:.88rem}
.ef73-count{white-space:nowrap;padding:7px 10px;border-radius:999px;background:#eff6ff;color:#1d4ed8;font-weight:800;font-size:.75rem}
.ef73-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:16px}
.ef73-kpi{padding:13px;border:1px solid #e5e7eb;border-radius:14px;background:#f8fafc}.ef73-kpi small{display:block;color:#64748b;font-weight:700}.ef73-kpi strong{display:block;margin-top:4px;font-size:1rem;color:#0f172a}.ef73-kpi span{display:block;margin-top:3px;font-size:.75rem;color:#64748b}
.ef73-alerts{display:grid;gap:9px}.ef73-alert{padding:12px 14px;border-radius:13px;border-left:4px solid #64748b;background:#f8fafc}.ef73-alert.good{border-left-color:#16a34a;background:#f0fdf4}.ef73-alert.attention{border-left-color:#f59e0b;background:#fffbeb}.ef73-alert.warning{border-left-color:#dc2626;background:#fef2f2}.ef73-alert.neutral{border-left-color:#64748b}.ef73-alert b{display:block;margin-bottom:3px}.ef73-alert p{margin:0;font-size:.84rem;color:#475569}.ef73-foot{margin-top:14px;padding-top:12px;border-top:1px solid #e5e7eb;color:#64748b;font-size:.76rem}
@media(max-width:800px){.ef73-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.ef73-head{flex-direction:column}}
</style>
<script>/* 16-runtime.js */
/* ============================================================================
   EvoluFísico v7.3 — Evolution Monitoring Engine
   ============================================================================ */
(function(){
'use strict';
var S=window.__EF63_STATE__||null;
if(!S||!window.EF70||!window.EF72)return;
var VERSION='7.3',cache=new Map(),lastRenderId=null;
var MET={
 gordura:{label:'Gordura',unit:'%',lowerBetter:true,key:'gordura'},
 massaMagra:{label:'Massa magra',unit:' kg',lowerBetter:false,key:'massaMagra'},
 cintura:{label:'Cintura',unit:' cm',lowerBetter:true,key:'cintura'},
 peso:{label:'Peso',unit:' kg',lowerBetter:null,key:'peso'}
};
function norm(v){return String(v==null?'':v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim()}
function esc(v){return EFU.esc(v)}
function num(v){var n=Number(v);return Number.isFinite(n)?n:null}
function fmt(v,d){var n=num(v);return n==null?'—':n.toFixed(d==null?1:d)}
function fmtDate(v){if(!v)return'—';var d=new Date(v+'T00:00:00');return isNaN(d)?String(v):d.toLocaleDateString('pt-BR')}
function source(){return S.getAvaliacoes?S.getAvaliacoes():[]}
function sorted(name){return source().filter(function(a){return EFIdentity.key(a)===EFIdentity.key(name)}).map(function(a){return {a:a,date:new Date((a.data_avaliacao||a.data||'')+'T00:00:00')}}).filter(function(x){return !isNaN(x.date)}).sort(function(x,y){return x.date-y.date})}
// CORREÇÃO CIRÚRGICA: val(a, key) extrai dobras_resultado, bioimpedancia e perimetria sem falhar
function val(a,key){
  if(!a)return null;
  var d=a.dobras_resultado||{},b=a.bioimpedancia||{},p=a.perimetria||{};
  if(key==='gordura'){var g=num(d.percGordura!=null?d.percGordura:b.pgordura);if(g!=null)return g}
  if(key==='massaMagra'){var m=num(d.massaMagra);if(m!=null)return m}
  if(key==='cintura'){var c=num(p.cintura!=null?p.cintura:a.cintura);if(c!=null)return c}
  if(key==='peso'){var w=num(a.peso!=null?a.peso:b.peso);if(w!=null)return w}
  var n=num(a[key]);if(n!=null)return n;
  var aliases={gordura:['percentualGordura','percentual_gordura','gorduraPercentual'],massaMagra:['massa_magra','massaMagraKg'],cintura:['cinturaAbdominal','cintura_abdominal'],peso:['pesoKg','peso_kg']};
  var arr=aliases[key]||[];
  for(var i=0;i<arr.length;i++){n=num(a[arr[i]]);if(n!=null)return n}
  return null;
}
function delta(first,last){return first==null||last==null?null:last-first}
function pct(first,last){return first==null||!first?null:(last-first)/Math.abs(first)*100}
function signFor(key,d){var m=MET[key];if(d==null)return'neutral';if(m.lowerBetter===true)return d<0?'good':d>0?'attention':'neutral';if(m.lowerBetter===false)return d>0?'good':d<0?'attention':'neutral';return d===0?'neutral':'neutral'}
function analyze(name){
 var list=sorted(name);if(!list.length)return null;
 var last=list[list.length-1],prev=list.length>1?list[list.length-2]:null,ef72=window.EF72.compare(name)||{};
 var metrics={},alerts=[],changes=[];
 Object.keys(MET).forEach(function(k){
  var first=val(list[0].a,k),latest=val(last.a,k),d=delta(first,latest),recent=prev?delta(val(prev.a,k),latest):null;
  var vals=list.map(function(x){return val(x.a,k)}).filter(function(x){return x!=null});
  var volatility=null;if(vals.length>=3){var diffs=[];for(var i=1;i<vals.length;i++)diffs.push(Math.abs(vals[i]-vals[i-1]));volatility=diffs.reduce(function(a,b){return a+b},0)/diffs.length}
  var plateau=false;if(list.length>=3){var recentVals=list.slice(-3).map(function(x){return val(x.a,k)}).filter(function(x){return x!=null});if(recentVals.length===3){var range=Math.max.apply(null,recentVals)-Math.min.apply(null,recentVals),base=Math.max(Math.abs(recentVals[0]),1);plateau=range/base<0.01}}
  metrics[k]={first:first,latest:latest,delta:d,pct:pct(first,latest),recent:recent,volatility:volatility,plateau:plateau,state:signFor(k,d)};
  if(recent!=null&&list.length>=2){var s1=signFor(k,d),s2=signFor(k,recent);if(s1==='good'&&s2==='attention')changes.push({kind:'warning',title:'Reversão em '+MET[k].label,text:'A direção recente passou a contrariar a direção acumulada.'});}
  if(plateau)changes.push({kind:'neutral',title:'Platô em '+MET[k].label,text:'As três avaliações mais recentes ficaram dentro de uma faixa estreita.'});
 });
 if(list.length<2)alerts.push({kind:'neutral',title:'Base histórica curta',text:'Há apenas uma avaliação. O monitoramento longitudinal será ampliado a partir da próxima avaliação.'});
 var missing=Object.keys(MET).filter(function(k){return metrics[k].latest==null});
 if(missing.length)alerts.push({kind:'attention',title:'Dados incompletos',text:'Sem valor recente para: '+missing.map(function(k){return MET[k].label}).join(', ')+'.'});
 var reversals=changes.filter(function(x){return x.title.indexOf('Reversão')===0});
 if(reversals.length)alerts.unshift({kind:'warning',title:'Reversão detectada',text:'Uma ou mais métricas mudaram recentemente de direção em relação à trajetória acumulada.'});
 else if(list.length>=2){
  var positive=Object.keys(metrics).filter(function(k){return metrics[k].state==='good'}).length;
  var attention=Object.keys(metrics).filter(function(k){return metrics[k].state==='attention'}).length;
  if(positive>0&&attention===0)alerts.push({kind:'good',title:'Trajetória favorável nas métricas monitoradas',text:'As métricas com direção definida mantêm mudança compatível com o objetivo configurado.'});
  else if(attention>0)alerts.push({kind:'attention',title:'Acompanhamento recomendado',text:'Há pelo menos uma métrica recente em direção de atenção; o histórico deve ser acompanhado antes de concluir tendência.'});
 }
 var quality={assessments:list.length,withDates:list.length,missingLatest:missing.length,complete:missing.length===0};
 return {name:name,count:list.length,first:list[0].a,last:last.a,metrics:metrics,alerts:alerts,changes:changes,quality:quality,ef72:ef72};
}
function student(name){var key=EFIdentity.key(name)+'|'+S.version,c=cache.get(key);if(c)return c;var r=analyze(name);if(r)cache.set(key,r);return r}
function render(id){
 var host=document.getElementById('patient-view-content'),a=source().find(function(x){return String(x.id)===String(id)});if(!host||!a)return;
 var d=student(a);if(!d)return;
 var old=document.getElementById('ef73-monitoring');if(old)old.remove();
 var cards=Object.keys(MET).map(function(k){var m=d.metrics[k];return '<div class="ef73-kpi"><small>'+esc(MET[k].label)+'</small><strong>'+fmt(m.latest,2)+esc(MET[k].unit)+'</strong><span>'+(m.delta==null?'sem comparação':(m.delta>0?'+':'')+fmt(m.delta,2)+esc(MET[k].unit)+' desde o início'+(m.plateau?' · platô recente':''))+'</span></div>'}).join('');
 var alerts=d.alerts.map(function(x){return '<div class="ef73-alert '+esc(x.kind)+'"><b>'+esc(x.title)+'</b><p>'+esc(x.text)+'</p></div>'}).join('');
 var changes=d.changes.map(function(x){return '<div class="ef73-alert '+esc(x.kind)+'"><b>'+esc(x.title)+'</b><p>'+esc(x.text)+'</p></div>'}).join('');
 var card=document.createElement('section');card.id='ef73-monitoring';card.className='ef73-card';card.innerHTML='<div class="ef73-head"><div><div class="ef73-kicker">Acompanhamento da evolução</div><h2>🧭 Monitoramento inteligente da evolução</h2><p>Detecta mudanças recentes, platôs, reversões e lacunas de dados usando a inteligência já produzida pelas camadas anteriores.</p></div><div class="ef73-count">'+d.count+' avaliações</div></div><div class="ef73-grid">'+cards+'</div><div class="ef73-alerts">'+(alerts||'<div class="ef73-alert neutral"><b>Monitoramento estável</b><p>Nenhum evento operacional relevante foi identificado.</p></div>')+'</div>'+(changes?'<div class="ef73-alerts" style="margin-top:9px">'+changes+'</div>':'')+'<div class="ef73-foot">Acompanhamento atualizado sempre que novas avaliações são registradas.</div>';
 var profile=document.getElementById('ef71-profile');var comparison=document.getElementById('ef72-comparison');if(comparison&&comparison.parentNode)comparison.parentNode.insertBefore(card,comparison.nextSibling);else if(profile&&profile.parentNode)profile.parentNode.insertBefore(card,profile.nextSibling);else host.insertBefore(card,host.firstChild);lastRenderId=String(id);
}
function invalidate(){cache.clear();if(lastRenderId)render(lastRenderId)}
var oldTouch=S.touch;S.touch=function(){if(typeof oldTouch==='function')oldTouch.apply(S,arguments);invalidate()};
window.EF73={version:VERSION,student:student,analyze:analyze,render:render,invalidate:invalidate,stats:function(){return{engine:VERSION,cacheEntries:cache.size,version:S.version}}};
var oldOpen=window.abrirVisualizacaoPacienteWeb;
if(typeof oldOpen==='function'&&!oldOpen.__ef73){
    var f=function(id){
        var r=oldOpen.apply(this,arguments);
        setTimeout(function(){render(id)},0);
        return r;
    };
    f.__ef73=true;
    window.abrirVisualizacaoPacienteWeb=f;
}
window.addEventListener('DOMContentLoaded',function(){setTimeout(function(){var id=window.avaliacaoEmVisualizacaoId;if(id!=null)render(id)},120)});
})();
</script>
<script>/* 17-runtime.js */
/* v7.3.1 — acessibilidade: rótulos, teclado e papéis de diálogo */
(function(){
  function run(){
    var L={'filtro-busca':'Buscar avaliações por nome, e-mail ou semana','import-file-input':'Importar backup JSON','web-link-input':'Link do laudo','ef55-q':'Buscar aluno ou ação'};
    Object.keys(L).forEach(function(id){var e=document.getElementById(id);if(e&&!e.getAttribute('aria-label'))e.setAttribute('aria-label',L[id])});
    var rg=document.querySelector('input[name="desafio"]'),g=rg&&rg.closest('.radio-group');if(g){g.setAttribute('role','radiogroup');g.setAttribute('aria-label','Participa de desafio?')}
    document.querySelectorAll('.step-indicator').forEach(function(el){
      el.setAttribute('role','button');el.setAttribute('tabindex','0');
      el.addEventListener('keydown',function(ev){if(ev.key==='Enter'||ev.key===' '){ev.preventDefault();el.click()}});
    });
    ['view-modal','web-report-modal','modal-config-profissional','modal-central-backup','ef-security-modal'].forEach(function(id){var m=document.getElementById(id);if(m){m.setAttribute('role','dialog');m.setAttribute('aria-modal','true')}});
    var pv=document.querySelector('.patient-view-overlay');if(pv){pv.setAttribute('role','dialog');pv.setAttribute('aria-modal','true');pv.setAttribute('aria-label','Visão do aluno')}
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',run);else run();
})();
</script>
<style>/* 15-styles.css */
/* ===== EvoluFísico v7.8.2 · Lab (módulo isolado, prefixo ef77) ===== */
.ef77-wrap{max-width:1100px;margin:0 auto;padding:0 0 3rem}
.ef77-head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.75rem;margin-bottom:1rem}
.ef77-head h2{font-size:1.5rem;font-weight:800;letter-spacing:-.02em;margin:0}
.ef77-head p{margin:.2rem 0 0;color:#6b7280;font-size:.88rem}
.ef77-tools{display:flex;gap:.5rem;flex-wrap:wrap}
.ef77-btn{border:0;border-radius:10px;padding:.55rem .9rem;font-weight:700;font-size:.82rem;cursor:pointer;background:rgba(118,118,128,.14);color:#111}
.ef77-btn.pri{background:#007aff;color:#fff}
.ef77-btn:disabled{opacity:.45;cursor:not-allowed}
.ef77-btn:focus-visible,.ef77-form input:focus-visible,.ef77-form select:focus-visible{outline:3px solid rgba(0,122,255,.45);outline-offset:1px}
.ef77-card{background:#fff;border:1px solid #e5e7eb;border-radius:16px;padding:1.1rem 1.2rem;box-shadow:0 1px 3px rgba(0,0,0,.04);min-width:0}
.ef77-form{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(180px,100%),1fr));gap:.85rem}
@media(max-width:640px){.ef77-form{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:440px){.ef77-form{grid-template-columns:minmax(0,1fr)}}
.ef77-form label{display:block;font-size:.7rem;font-weight:700;color:#6b7280;margin-bottom:.2rem;text-transform:uppercase;letter-spacing:.03em}
.ef77-form input,.ef77-form select{width:100%;box-sizing:border-box;padding:.55rem .6rem;border:1px solid #d1d5db;border-radius:10px;font-size:.9rem;background:#f9fafb}
.ef77-form input.bad{border-color:#ef4444;background:#fef2f2}
.ef77-form .wide{grid-column:1/-1}
.ef77-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(310px,100%),1fr));gap:1rem}
.ef77-grid .full{grid-column:1/-1}
.ef77-card h3{margin:0 0 .6rem;font-size:1rem;font-weight:800;display:flex;align-items:center;gap:.4rem}
.ef77-card .sub{font-size:.74rem;color:#6b7280;margin:.5rem 0 0;line-height:1.4}
.ef77-row{display:flex;justify-content:space-between;align-items:baseline;gap:.5rem;padding:.38rem 0;border-bottom:1px solid #f1f5f9;font-size:.86rem}
.ef77-row:last-child{border-bottom:0}
.ef77-row b{font-variant-numeric:tabular-nums;text-align:right}
.ef77-pill{font-size:.68rem;font-weight:800;padding:.12rem .5rem;border-radius:99px;background:#e5e7eb;color:#374151;white-space:nowrap}
.ef77-pill.ok{background:#dcfce7;color:#166534}.ef77-pill.warn{background:#fef3c7;color:#92400e}.ef77-pill.bad{background:#fee2e2;color:#991b1b}
.ef77-bar{height:9px;border-radius:6px;background:#eef2f7;overflow:hidden;margin:.15rem 0 .5rem}
.ef77-bar i{display:block;height:100%;border-radius:6px}
.ef77-empty{color:#9ca3af;font-size:.84rem;padding:.5rem 0}
.ef77-note{border-radius:12px;padding:.65rem .85rem;font-size:.8rem;line-height:1.45;background:#fffbeb;border:1px solid #fde68a;color:#78350f}
.ef77-note.err{background:#fef2f2;border-color:#fecaca;color:#7f1d1d}
.ef77-donut{display:flex;align-items:center;gap:1rem;margin-top:.6rem;flex-wrap:wrap}
.ef77-zone{display:grid;grid-template-columns:auto 1fr auto;gap:.6rem;align-items:center;padding:.32rem 0;font-size:.84rem}
.ef77-zone span.d{width:10px;height:10px;border-radius:50%}
#ef77-print{display:none}
@media print{
    @page { size: A4 portrait; margin: 0 !important; }
    .ef77-wrap{display:none}
    body.ef77-printing>*:not(#ef77-print){display:none!important}
    body.ef77-printing #ef77-print{
        display:block!important;
        position:static!important;
        width:210mm!important;
        margin:0 auto!important;
        padding:0 12mm!important;
        box-sizing:border-box!important;
        background:#ffffff!important;
    }
}
</style>
<script id="ef77-script">/* 18-runtime.js */
(function(){
'use strict';
if(window.EF77&&window.EF77.mounted)return;
var VER='8.7';
var $=function(s,r){return (r||document).querySelector(s)};
function num(v){var n=parseFloat(String(v==null?'':v).replace(',','.'));return isFinite(n)?n:0}
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function f1(x){return x==null||!isFinite(x)?'—':x.toFixed(1)}
function f2(x){return x==null||!isFinite(x)?'—':x.toFixed(2)}
function recs(){try{var S=window.__EF63_STATE__;var r=S&&S.getAvaliacoes&&S.getAvaliacoes();return Array.isArray(r)?r:[]}catch(e){return[]}}
function store(k,v){try{if(v===undefined)return localStorage.getItem(k);localStorage.setItem(k,v)}catch(e){return null}}
var log10=Math.log10||function(x){return Math.log(x)/Math.LN10};

/* ---------- Limites plausíveis (valores fora são ignorados e sinalizados) ---------- */
var LIM={idade:[5,110,'Idade'],altura:[100,230,'Altura'],peso:[20,400,'Peso'],pescoco:[20,70,'Pescoço'],cintura:[40,200,'Cintura'],quadril:[50,200,'Quadril'],pollock:[2,60,'% Gord. Pollock'],bia:[2,60,'% Gord. BIA'],fcrep:[30,120,'FC repouso'],alvo:[3,50,'Meta % gordura']};

/* ---------- Cálculos puros ---------- */
var C={
  navy:function(sexo,h,pesc,cint,quad){
    if(!(h>0&&pesc>0&&cint>0))return null;var r;
    if(sexo==='F'){if(!(quad>0)||cint+quad-pesc<=0)return null;r=495/(1.29579-0.35004*log10(cint+quad-pesc)+0.221*log10(h))-450}
    else{if(cint-pesc<=0)return null;r=495/(1.0324-0.19077*log10(cint-pesc)+0.15456*log10(h))-450}
    return isFinite(r)&&r>=2&&r<=60?r:null},
  rfm:function(sexo,h,cint){if(!(h>0&&cint>0))return null;var raw=(sexo==='F'?76:64)-20*(h/cint);return Number.isFinite(raw)&&raw>=2&&raw<=60?raw:null},
  whtr:function(h,cint){return h>0&&cint>0?cint/h:null},
  bri:function(h,cint){if(!(h>0&&cint>0))return null;var a=(cint/100)/(2*Math.PI),b=0.5*(h/100);if(a>=b)return null;return 364.2-365.5*Math.sqrt(1-(a*a)/(b*b))},
  absi:function(h,peso,cint){if(!(h>0&&peso>0&&cint>0))return null;var hm=h/100,bmi=peso/(hm*hm);return(cint/100)/(Math.pow(bmi,2/3)*Math.sqrt(hm))},
  ffmi:function(h,peso,pg){if(!(h>0&&peso>0&&pg>0&&pg<100))return null;var hm=h/100,ffm=peso*(1-pg/100),v=ffm/(hm*hm);return{ffm:ffm,ffmi:v,norm:v+6.1*(1.8-hm)}},
  mifflin:function(sexo,peso,h,idade){if(!(peso>0&&h>0&&idade>0))return null;return 10*peso+6.25*h-5*idade+(sexo==='F'?-161:5)},
  harris:function(sexo,peso,h,idade){if(!(peso>0&&h>0&&idade>0))return null;return sexo==='F'?(447.593+9.247*peso+3.098*h-4.330*idade):(88.362+13.397*peso+4.799*h-5.677*idade)},
  harris1919:function(sexo,peso,h,idade){if(!(peso>0&&h>0&&idade>0))return null;return sexo==='F'?(655.0955+9.5634*peso+1.8496*h-4.6756*idade):(66.4730+13.7516*peso+5.0033*h-6.7550*idade)},
  act:function(sexo,peso,h,idade){if(!(peso>0&&h>0&&idade>0))return null;var v=sexo==='F'?(-2.097+0.1069*h+0.2466*peso):(2.447-0.09516*idade+0.1074*h+0.3362*peso);return isFinite(v)&&v>0?v:null},
  rcq:function(cint,quad){return(cint>0&&quad>0)?(cint/quad):null},
  katch:function(ffm){return ffm>0?370+21.6*ffm:null},
  fcmax:function(idade){return idade>0?208-0.7*idade:null},
  meta:function(peso,pg,alvo){if(!(peso>0&&pg>0&&alvo>0&&alvo<pg))return null;var mm=peso*(1-pg/100),pa=mm/(1-alvo/100);return{pesoAlvo:pa,delta:peso-pa,gorduraPerder:peso*pg/100-pa*alvo/100}}
};

/* ---------- Leitura de fontes ---------- */
function fromForm(){
  var g=function(id){var e=document.getElementById(id);return e?e.value:''};
  var sexo=g('sexo')==='F'?'F':'M',idade=num(g('idade')),h=num(g('altura')),peso=num(g('peso'))||num(g('bia_peso'));
  var d={};['triceps','subescapular','peitoral','axilar','suprailiaca','abdominal','coxa'].forEach(function(k){d[k]=num(g('dobra_'+k))});
  var pol=null;try{var r=window.calcularPollock7&&window.calcularPollock7(sexo,idade,peso,d);if(r)pol=num(r.percGordura)}catch(e){}
  return{sexo:sexo,idade:idade,altura:h,peso:peso,pescoco:num(g('peri_pescoco')),cintura:num(g('cintura')),quadril:num(g('quadril')),pollock:pol,bia:num(g('bia_pgordura'))||null,nome:(g('nome')||'').trim()}}
function fromRec(a){
  var p=a.perimetria||{},pol=null,sexo=a.sexo==='F'?'F':'M';
  if(a.dobras_resultado&&a.dobras_resultado.percGordura!=null)pol=num(a.dobras_resultado.percGordura);
  else{try{var r=window.calcularPollock7&&window.calcularPollock7(sexo,num(a.idade),num(a.peso),a.dobras||{});if(r)pol=num(r.percGordura)}catch(e){}}
  var b=a.bioimpedancia||{};
  return{sexo:sexo,idade:num(a.idade),altura:num(a.altura),peso:num(a.peso),pescoco:num(p.pescoco),cintura:num(p.cintura||a.cintura),quadril:num(p.quadril||a.quadril),pollock:pol||null,bia:num(b.pgordura)||null,nome:String(a.nome||'').trim(),data:a.data_avaliacao||''}}

/* ---------- Estado da UI ---------- */
var NUMF=['idade','altura','peso','pescoco','cintura','quadril','pollock','bia','fcrep','alvo'];
var FIELDS=['sexo'].concat(NUMF,['fator','obj','formula']);
var dirty=false,last=null;
function el(k){return document.getElementById('ef77-'+k)}
function setForm(o){
  ['sexo','idade','altura','peso','pescoco','cintura','quadril','pollock','bia'].forEach(function(k){
    var e=el(k);if(!e)return;var v=o[k];
    e.value=(v==null||v===0)?'':((k==='pollock'||k==='bia')&&typeof v==='number'?v.toFixed(1):v)});
  dirty=false;compute()}
function srcRecord(){var v=el('src')&&el('src').value;if(!v||v==='form')return null;return recs().filter(function(x){return String(x.id)===v})[0]||null}
function buildSrc(){
  var s=el('src');if(!s)return;var keep=s.value;
  var list=recs().slice().sort(function(a,b){return String(b.data_avaliacao||'').localeCompare(String(a.data_avaliacao||''))});
  s.innerHTML='<option value="form">Formulário atual (Nova Avaliação)</option>'+list.map(function(a){return'<option value="'+esc(a.id)+'">'+esc(a.nome||'Sem nome')+' · '+esc(a.data_avaliacao||'')+'</option>'}).join('');
  var ok=false;for(var i=0;i<s.options.length;i++)if(s.options[i].value===keep)ok=true;
  if(!ok&&keep&&keep!=='form')dirty=false;
  s.value=ok?keep:'form'}
function loadSrc(){var a=srcRecord();setForm(a?fromRec(a):fromForm());updateButtons()}
function updateButtons(){var b=el('csv1');if(b)b.disabled=!srcRecord()}

/* ---------- Gráficos ---------- */
function bar(label,val,max,col){var w=Math.max(0,Math.min(100,val/max*100));return'<div class="ef77-row"><span>'+esc(label)+'</span><b>'+f1(val)+'%</b></div><div class="ef77-bar"><i style="width:'+w+'%;background:'+col+'"></i></div>'}
function donut(pg){var r=42,c=2*Math.PI*r,g=Math.max(0,Math.min(100,pg))/100*c;
  return'<svg width="110" height="110" viewBox="0 0 110 110" role="img" aria-label="Gordura '+pg.toFixed(1)+'%, massa magra '+(100-pg).toFixed(1)+'%"><circle cx="55" cy="55" r="'+r+'" fill="none" stroke="#34c759" stroke-width="14"/><circle cx="55" cy="55" r="'+r+'" fill="none" stroke="#ff9500" stroke-width="14" stroke-dasharray="'+g.toFixed(2)+' '+(c-g).toFixed(2)+'" transform="rotate(-90 55 55)"/><text x="55" y="60" text-anchor="middle" font-size="16" font-weight="800" fill="#111">'+pg.toFixed(1)+'%</text></svg>'}

/* ---------- Leitura validada do formulário do Lab ---------- */
function readInputs(){
  var o={sexo:el('sexo').value==='F'?'F':'M',fator:num(el('fator').value)||1.55,obj:el('obj').value||'manter',formula:el('formula')?el('formula').value:'harris'},bad=[];
  NUMF.forEach(function(k){var e=el(k),v=num(e.value),L=LIM[k],inv=v>0&&(v<L[0]||v>L[1]);e.classList.toggle('bad',inv);e.setAttribute('aria-invalid',inv?'true':'false');if(inv){bad.push(L[2]+' ('+L[0]+'–'+L[1]+')');v=0}o[k]=v>0?v:0});
  o.bad=bad;return o}

/* ---------- Cálculo e renderização ---------- */
function compute(){
  var out=$('#ef77-out');if(!out)return;
  try{
    var f=readInputs(),sexo=f.sexo,idade=f.idade,h=f.altura,peso=f.peso,minor=idade>0&&idade<18;
    var pol=minor?null:(f.pollock||null),bia=f.bia||null,nav=minor?null:C.navy(sexo,h,f.pescoco,f.cintura,f.quadril),rfm=minor?null:C.rfm(sexo,h,f.cintura);
    var R={sexo:sexo,idade:idade,peso:peso,altura:h,pollock:pol,navy:nav,rfm:rfm,bia:bia};
    /* avisos */
    var notes=[];if(minor)notes.push('<div class="ef77-note err" role="alert">Menor de 18 anos: equações e classificações corporais adultas (Pollock, Navy, RFM e TMB para adultos) não serão aplicadas. Utilize métodos apropriados à faixa etária.</div>');
    if(f.bad.length)notes.push('<div class="ef77-note err" role="alert"><b>Valores fora do intervalo plausível foram ignorados:</b> '+esc(f.bad.join('; '))+'.</div>');
    var miss=[];
    if(nav==null&&!minor){var m1=[];if(!(h>0))m1.push('altura');if(!(f.pescoco>0))m1.push('pescoço');if(!(f.cintura>0))m1.push('cintura');if(sexo==='F'&&!(f.quadril>0))m1.push('quadril');if(m1.length)miss.push('US Navy (falta '+m1.join(', ')+')');else miss.push('US Navy (medidas incoerentes)')}
    if(rfm==null){if(minor){}else if(h>0&&f.cintura>0)notes.push('<div class="ef77-note err" role="alert">RFM indisponível: resultado fora do intervalo operacional de 2% a 60%. Nenhum limite foi aplicado silenciosamente.</div>');else miss.push('RFM (falta '+[!(h>0)?'altura':'',!(f.cintura>0)?'cintura':''].filter(Boolean).join(', ')+')');}
    if(!pol&&!bia)miss.push('Pollock/BIA (informe o %)');
    if(miss.length&&(peso>0||h>0||f.cintura>0))notes.push('<div class="ef77-note" role="status"><b>Métodos indisponíveis:</b> '+esc(miss.join(' · '))+'.</div>');
    /* 1. Comparador */
    var m=[];if(pol)m.push(['Pollock 7 dobras',pol,'#007aff']);if(nav!=null)m.push(['US Navy (perímetros)',nav,'#5856d6']);if(rfm!=null)m.push(['RFM (cintura/altura)',rfm,'#af52de']);if(bia)m.push(['Bioimpedância',bia,'#32ade6']);
    var vals=m.map(function(x){return x[1]}),ref=null,c1;
    if(vals.length){
      var mean=vals.reduce(function(a,b){return a+b},0)/vals.length;var amp=Math.max.apply(null,vals)-Math.min.apply(null,vals);var inconsistent=amp>=8;ref=inconsistent?null:mean;
      if(inconsistent)notes.push('<div class="ef77-note err" role="alert">Métodos divergem '+f1(amp)+' p.p. A média não será usada como referência de composição corporal, FFMI ou cálculo de metas; avalie individualmente os protocolos.</div>');
      c1=m.map(function(x){return bar(x[0],x[1],50,x[2])}).join('')+'<div class="ef77-row"><span>Média aritmética (não clínica)</span><b>'+f1(mean)+'%</b></div>'+(vals.length>1?'<div class="ef77-row"><span>Amplitude entre métodos</span><b>'+f1(amp)+' p.p. <span class="ef77-pill '+(amp<=4?'ok':amp<=8?'warn':'bad')+'">'+(amp<=4?'consistente':amp<=8?'moderada':'alta')+'</span></b></div>':'')+
        '<div class="ef77-donut">'+(ref==null?'':donut(ref))+'<div style="font-size:.8rem;line-height:1.7"><span style="color:#ff9500">●</span> Média aritmética '+f1(mean)+'%<br><span style="color:#34c759">●</span> Não equivale a referência clínica'+(peso>0&&ref!=null?'<br><span style="color:#6b7280">'+f1(peso*ref/100)+' kg gordura · '+f1(peso*(1-ref/100))+' kg magra</span>':'')+'</div></div>';
      R.ref=ref;R.amp=amp;
      var ff0=C.ffmi(h,peso,ref);
      if(rfm!=null&&vals.length>1&&ff0&&ff0.norm>=22&&rfm-ref>5)c1+='<p class="sub"><b>Atenção:</b> o RFM tende a superestimar a gordura em pessoas muito musculosas; priorize dobras ou BIA.</p>';
      c1+='<p class="sub">Métodos diferem por natureza (protocolo, equação, hidratação). A média não equivale a uma referência clínica. Compare tendências do mesmo método sob condições padronizadas e revise divergências.</p>'
    }else c1='<div class="ef77-empty">Informe altura, pescoço e cintura (Navy/RFM) ou o % de dobras/BIA para comparar métodos.</div>';
    /* 2. Índices & Composição Corporal  */
    var wh=C.whtr(h,f.cintura),bri=C.bri(h,f.cintura),absi=C.absi(h,peso,f.cintura),ff=!minor&&ref!=null?C.ffmi(h,peso,ref):null,c2='';
    var rcq=C.rcq(f.cintura,f.quadril),act=minor?null:C.act(sexo,peso,h,idade);
    R.whtr=wh;R.bri=bri;R.absi=absi;R.ffmi=ff;R.rcq=rcq;R.act=act;
    if(wh!=null){var cl=wh<0.5?['ok','baixo risco']:wh<0.6?['warn','risco aumentado']:['bad','risco alto'];c2+='<div class="ef77-row"><span>Cintura/Estatura (RCE)</span><b>'+f2(wh)+' <span class="ef77-pill '+cl[0]+'">'+cl[1]+'</span></b></div>'}
    if(rcq!=null){
      var rCl=sexo==='F'?(rcq<0.80?['ok','baixo risco']:rcq<=0.84?['warn','risco moderado']:['bad','risco alto']):(rcq<0.90?['ok','baixo risco']:rcq<=0.99?['warn','risco moderado']:['bad','risco alto']);
      c2+='<div class="ef77-row"><span>Cintura/Quadril (RCQ)</span><b>'+f2(rcq)+' <span class="ef77-pill '+rCl[0]+'">'+rCl[1]+'</span></b></div>';
    }
    if(act!=null){
      var pctAct=(act/peso)*100,aCl=sexo==='F'?(pctAct>=45&&pctAct<=60?['ok','normal']:pctAct<45?['warn','baixa hidratação']:['warn','elevada']):(pctAct>=50&&pctAct<=65?['ok','normal']:pctAct<50?['warn','baixa hidratação']:['warn','elevada']);
      c2+='<div class="ef77-row"><span>Água Corporal Est. (ACT Watson)</span><b>'+f1(act)+' L ('+f1(pctAct)+'%) <span class="ef77-pill '+aCl[0]+'">'+aCl[1]+'</span></b></div>';
    }
    if(bri!=null)c2+='<div class="ef77-row"><span>Índice de Arredondamento (BRI)</span><b>'+f1(bri)+'</b></div>';
    if(absi!=null)c2+='<div class="ef77-row"><span>ABSI (forma corporal)</span><b>'+absi.toFixed(4)+'</b></div>';
    if(ff){var n=ff.norm,cls=sexo==='M'?(n<18?'abaixo da média':n<20?'médio':n<22?'acima da média':n<23?'excelente':n<26?'superior':'avaliar'):null;
      c2+='<div class="ef77-row"><span>FFMI</span><b>'+f1(ff.ffmi)+'</b></div><div class="ef77-row"><span>FFMI normalizado</span><b>'+f1(n)+(cls?' <span class="ef77-pill">'+cls+'</span>':'')+'</b></div>'}
    c2=c2||'<div class="ef77-empty">Informe altura e cintura (e peso) para calcular os índices.</div>';
    c2+='<p class="sub">Índices antropométricos e hidratação calculados com as medidas informadas. Triagem funcional, não diagnóstico médico.</p>';
    /* 3. Energia — Comparador de TMB (Harris-Benedict, Mifflin e Katch) */
    var mif=minor?null:C.mifflin(sexo,peso,h,idade),hb=minor?null:C.harris(sexo,peso,h,idade),hb19=minor?null:C.harris1919(sexo,peso,h,idade),kat=minor?null:ff?C.katch(ff.ffm):null,c3='';
    R.mifflin=mif;R.harris=hb;R.harris1919=hb19;R.katch=kat;
    if(hb!=null||mif!=null){
      var arrTmbs=[];
      if(hb!=null)arrTmbs.push(hb);
      if(mif!=null)arrTmbs.push(mif);
      if(kat!=null)arrTmbs.push(kat);
      var mediaTmb=arrTmbs.length>0?(arrTmbs.reduce(function(a,b){return a+b},0)/arrTmbs.length):(hb||mif);
      R.mediaTmb=mediaTmb;

      var base=hb||mif,formulaNome='Harris-Benedict (1984)';
      if(f.formula==='mifflin'){base=mif||hb;formulaNome='Mifflin-St Jeor (1990)'}
      else if(f.formula==='katch'){base=kat||hb||mif;formulaNome=kat?'Katch-McArdle (Massa Magra)':'Harris-Benedict (Katch requer % gordura)'}
      else if(f.formula==='harris1919'){base=hb19||hb;formulaNome='Harris-Benedict (Original 1919)'}
      else if(f.formula==='media'){base=mediaTmb;formulaNome='Média das Fórmulas ('+arrTmbs.length+' equações)'}
      else{base=hb||mif;formulaNome='Harris-Benedict (Revisada 1984)'}

      var get=base*f.fator,adj={manter:0,def:-0.2,sup:0.1}[f.obj]||0,alvoK=get*(1+adj);
      R.baseTmb=base;R.formulaNome=formulaNome;R.get=get;R.kcal=alvoK;

      var difKcal=Math.round(hb-(mif||hb));
      var difStr=difKcal===0?'':(' <small style="color:#64748b;">(dif: '+(difKcal>0?'+':'')+difKcal+' kcal vs Mifflin)</small>');

      c3='<div class="ef77-row"><span>TMB Harris-Benedict (1984)</span><b>'+Math.round(hb)+' kcal'+difStr+'</b></div>'+
         '<div class="ef77-row"><span>TMB Mifflin-St Jeor (1990)</span><b>'+Math.round(mif)+' kcal</b></div>'+
         (kat?'<div class="ef77-row"><span>TMB Katch-McArdle (FFM)</span><b>'+Math.round(kat)+' kcal</b></div>':'')+
         '<div class="ef77-row" style="background:rgba(0,122,255,0.07); padding:0.35rem 0.6rem; border-radius:8px; margin:0.4rem 0;"><span>TMB Adotada ('+formulaNome+')</span><b style="color:#007aff;">'+Math.round(base)+' kcal</b></div>'+
         '<div class="ef77-row"><span>Gasto total GET (×'+f.fator+')</span><b>'+Math.round(get)+' kcal</b></div>'+
         '<div class="ef77-row"><span>Meta calórica ('+({manter:'manutenção',def:'déficit −20%',sup:'superávit +10%'}[f.obj]||'manutenção')+')</span><b style="color:#10b981;">'+Math.round(alvoK)+' kcal</b></div>'+
         '<p class="sub">Estimativas metabólicas baseadas em equações validadas (Harris-Benedict, Mifflin e Katch-McArdle). O Gasto Energético Total serve de parâmetro para planejamento de treino físico; prescrição de dieta é privativa de nutricionista.</p>';}
    else c3='<div class="ef77-empty">Informe sexo, idade, altura e peso.</div>';
    /* 4. Meta */
    var mt=!minor&&ref!=null?C.meta(peso,ref,f.alvo):null,c4='';R.meta=mt;R.alvo=f.alvo;
    if(mt)c4='<div class="ef77-row"><span>Peso-alvo (mantendo massa magra)</span><b>'+f1(mt.pesoAlvo)+' kg</b></div><div class="ef77-row"><span>Variação de peso</span><b>−'+f1(mt.delta)+' kg</b></div><div class="ef77-row"><span>Gordura a reduzir</span><b>'+f1(mt.gorduraPerder)+' kg</b></div><p class="sub">Simulação: pressupõe massa magra constante, o que é otimista em déficits longos.</p>';
    else c4='<div class="ef77-empty">Informe uma meta de % de gordura menor que a atual ('+(ref!=null?f1(ref)+'%':'—')+').</div>';
    /* 5. FC */
    var fm=minor?null:C.fcmax(idade),rep=f.fcrep,c5='';R.fcmax=fm;
    if(fm){var P=[[50,60,'#34c759','Recuperação'],[60,70,'#a3d900','Aeróbio base'],[70,80,'#ffcc00','Aeróbio'],[80,90,'#ff9500','Limiar'],[90,100,'#ff3b30','Máximo']];
      c5='<div class="ef77-row"><span>FC máx. estimada (Tanaka)</span><b>'+Math.round(fm)+' bpm</b></div>'+P.map(function(z){var lo=rep>0?rep+(fm-rep)*z[0]/100:fm*z[0]/100,hi=rep>0?rep+(fm-rep)*z[1]/100:fm*z[1]/100;return'<div class="ef77-zone"><span class="d" style="background:'+z[2]+'"></span><span>'+z[3]+' <small style="color:#9ca3af">'+z[0]+'–'+z[1]+'%</small></span><b>'+Math.round(lo)+'–'+Math.round(hi)+'</b></div>'}).join('')+'<p class="sub">'+(rep>0?'Método de Karvonen (reserva de FC).':'Informe a FC de repouso para usar Karvonen; mostrando % da FC máx.')+'</p>'}
    else c5='<div class="ef77-empty">Informe a idade.</div>';
    last=R;
    out.innerHTML=(notes.length?'<div class="full" style="display:grid;gap:.5rem">'+notes.join('')+'</div>':'')+'<div class="ef77-card"><h3>⚖️ Comparador de métodos</h3>'+c1+'</div><div class="ef77-card"><h3>📏 Índices de risco & FFMI</h3>'+c2+'</div><div class="ef77-card"><h3>🔥 Energia & Gasto Calórico</h3>'+c3+'</div><div class="ef77-card"><h3>🎯 Simulador de meta</h3>'+c4+'</div><div class="ef77-card"><h3>❤️ Zonas de frequência cardíaca</h3>'+c5+'</div>';
  }catch(err){
    console.warn('EF77: erro ao calcular',err);
    out.innerHTML='<div class="ef77-note err full" role="alert">Não foi possível calcular com os dados atuais. Revise os campos.</div>'}
}

/* ---------- Resumo copiável ---------- */
function summaryText(){
  var R=last;if(!R)return'';var a=srcRecord(),nome=a?(a.nome||''):(fromForm().nome||''),L=[];
  L.push('EvoluFísico · Resumo do Lab'+(nome?' — '+nome:'')+(a&&a.data_avaliacao?' ('+a.data_avaliacao+')':''));
  var met=[];if(R.pollock)met.push('Pollock '+f1(R.pollock)+'%');if(R.navy!=null)met.push('Navy '+f1(R.navy)+'%');if(R.rfm!=null)met.push('RFM '+f1(R.rfm)+'%');if(R.bia)met.push('BIA '+f1(R.bia)+'%');
  if(met.length)L.push('Gordura: '+met.join(' | ')+(R.ref!=null?' → média aritmética '+f1(R.ref)+'% (não clínica)':' · resultados divergentes; média não recomendada'));
  if(R.whtr!=null)L.push('Cintura/Estatura: '+f2(R.whtr));
  if(R.ffmi)L.push('FFMI: '+f1(R.ffmi.ffmi)+' (normalizado '+f1(R.ffmi.norm)+')');
  if(R.harris!=null)L.push('TMB (Harris-Benedict): '+Math.round(R.harris)+' kcal · TMB (Mifflin): '+Math.round(R.mifflin)+' kcal · Base: '+Math.round(R.baseTmb||R.harris)+' kcal ('+(R.formulaNome||'Harris-Benedict')+')'+(R.kcal?' · Meta calórica: '+Math.round(R.kcal)+' kcal':''));
  if(R.meta)L.push('Meta '+f1(R.alvo)+'% gordura → '+f1(R.meta.pesoAlvo)+' kg (−'+f1(R.meta.delta)+' kg)');
  L.push('Estimativas — não substituem avaliação profissional.');
  return L.join('\n')}
function copySummary(){
  var t=summaryText(),msg=window.efToast||function(){};
  if(!t){msg('Nada para copiar ainda.','warn');return}
  var fb=function(){try{var ta=document.createElement('textarea');ta.value=t;ta.style.cssText='position:fixed;opacity:0';document.body.appendChild(ta);ta.select();var ok=document.execCommand('copy');ta.remove();msg(ok?'Resumo copiado.':'Não foi possível copiar.',ok?'ok':'warn')}catch(e){msg('Não foi possível copiar.','warn')}};
  if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(t).then(function(){msg('Resumo copiado.','ok')},fb);else fb()}

/* ---------- CSV (separador ; e vírgula decimal: abre direto no Excel pt-BR) ---------- */
function csvCell(v){
  var s=String(v==null?'':v);
  if(/^-?\d+(\.\d+)?$/.test(s))return s.replace('.',',');
  if(/^[=+\-@\t\r]/.test(s))s="'"+s;
  return /[;"\n\r]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s}
function exportCSV(onlyStudent){
  var msg=window.efToast||window.alert,list=recs();
  if(onlyStudent){var a=srcRecord();if(a){list=list.filter(function(x){return EFIdentity.same(a,x)})}}
  if(!list.length){msg('Nenhuma avaliação para exportar.','warn');return}
  list=list.slice().sort(function(a,b){return String(a.nome||'').localeCompare(String(b.nome||''))||String(a.data_avaliacao||'').localeCompare(String(b.data_avaliacao||''))});
  var head=['Nome','Data','Fase','Sexo','Idade','Altura_cm','Peso_kg','Gordura_Pollock_%','Massa_Gorda_kg','Massa_Magra_kg','Pescoco_cm','Cintura_cm','Quadril_cm','Gordura_BIA_%','Gordura_Navy_%','Gordura_RFM_%','Cintura_Estatura'];
  var rows=list.map(function(a){
    var p=a.perimetria||{},r=a.dobras_resultado||{},b=a.bioimpedancia||{},x=fromRec(a),nv=C.navy(x.sexo,x.altura,x.pescoco,x.cintura,x.quadril),rf=C.rfm(x.sexo,x.altura,x.cintura),wh=C.whtr(x.altura,x.cintura);
    return[a.nome,a.data_avaliacao,a.fase,a.sexo,a.idade,a.altura,a.peso,r.percGordura,r.massaGorda,r.massaMagra,p.pescoco,p.cintura||a.cintura,p.quadril||a.quadril,b.pgordura,nv!=null?nv.toFixed(1):'',rf!=null?rf.toFixed(1):'',wh!=null?wh.toFixed(3):''].map(csvCell).join(';')});
  var blob=new Blob(['\ufeff'+head.join(';')+'\r\n'+rows.join('\r\n')],{type:'text/csv;charset=utf-8'});
  var u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download='EvoluFisico_avaliacoes_'+new Date().toISOString().slice(0,10)+'.csv';document.body.appendChild(a);a.click();a.remove();setTimeout(function(){URL.revokeObjectURL(u)},1500);
  (window.efToast||function(){})('CSV exportado ('+list.length+' avaliação'+(list.length>1?'ões':'')+').','ok')}


/* ---------- Aluno: mesma regra para CSV e PDF ---------- */
function sameStudent(a){return recs().filter(x=>EFIdentity.same(a,x))}

/* ---------- PDF do aluno (impressão do navegador → "Salvar como PDF") ---------- */
function br(v,d){if(v==null||String(v).trim()==='')return'—';var n=typeof v==='number'?v:Number(String(v).trim().replace(',','.'));return isFinite(n)?n.toFixed(d).replace('.',','):'—'}
function brDate(s){var m=/^(\d{4})-(\d{2})-(\d{2})/.exec(String(s||''));return m?m[3]+'/'+m[2]+'/'+m[1]:String(s||'—')}
function pdfSec(t,body,cls,acc){return'<section class="lb-card '+(cls||'')+'" style="--acc:'+(acc||'#2563eb')+'"><h3 class="lb-h"><i></i>'+t+'</h3>'+body+'</section>'}
function pdfBox(t,rows,empty,cls,acc,extra){return pdfSec(t,(rows.length?'<table class="lb-kv"><tbody>'+rows.join('')+'</tbody></table>':'<div class="lb-empty">'+esc(empty||'Dados insuficientes para este bloco.')+'</div>')+(rows.length&&extra?extra:''),cls,acc)}
function pdfRow(l,v){return'<tr><td>'+esc(l)+'</td><td class="v">'+v+'</td></tr>'}
function pdfMeter(l,val,max,txt,color){var w=Math.max(3,Math.min(100,val/max*100));return'<div class="lb-meter"><span class="ml">'+esc(l)+'</span><span class="mt"><i style="width:'+w.toFixed(1)+'%;background:'+color+'"></i></span><span class="mv">'+txt+'</span></div>'}
function pdfChip(label,txt,tone){return'<span class="lb-chip '+(tone||'')+'"><small>'+esc(label)+'</small>'+esc(txt)+'</span>'}
function pdfHTML(a,list,R,F){
  var nome=String(a.nome||'Sem nome'),pro=store('evolufisico_pro_nome')||'',cref=store('evolufisico_pro_cref')||'',cli=store('evolufisico_pro_clinica')||'';
  var hist=list.map(function(x){var r=x.dobras_resultado||{},y=fromRec(x),sel=String(x.id)===String(a.id);
    return'<tr'+(sel?' class="sel"':'')+'><td class="l">'+esc(brDate(x.data_avaliacao))+'</td><td class="l">'+esc(x.fase||'—')+'</td><td>'+br(y.peso,1)+'</td><td>'+br(r.percGordura,1)+'</td><td>'+br(r.massaGorda,1)+'</td><td>'+br(r.massaMagra,1)+'</td><td>'+br(y.cintura,1)+'</td><td>'+(C.whtr(y.altura,y.cintura)!=null?br(C.whtr(y.altura,y.cintura),2):'—')+'</td></tr>'}).join('');
  var evo='';
  if(list.length>1){var f0=list[0],f1_=list[list.length-1],p0=num(f0.peso),p1=num(f1_.peso),g0=num((f0.dobras_resultado||{}).percGordura),g1=num((f1_.dobras_resultado||{}).percGordura),t=[];
    if(p0>0&&p1>0)t.push(pdfChip('Peso',(p1-p0>0?'+':'')+br(p1-p0,1)+' kg','blue'));
    if(g0>0&&g1>0)t.push(pdfChip('% Gordura (Pollock)',(g1-g0>0?'+':'')+br(g1-g0,1)+' p.p.',g1-g0<0?'good':g1-g0>0?'bad':''));
    if(t.length)evo='<div class="lb-evo"><span class="lb-evo-t">Evolução · '+esc(brDate(f0.data_avaliacao))+' → '+esc(brDate(f1_.data_avaliacao))+'</span>'+t.join('')+'</div>'}
  /* métodos de % de gordura */
  var mm=[],mv=[R.pollock,R.navy,R.rfm,R.bia].map(Number).filter(isFinite),mx=Math.max(30,Math.ceil((Math.max.apply(null,mv.concat([0]))*1.25)/5)*5);
  if(R.pollock)mm.push(pdfMeter('Pollock 7 dobras',Number(R.pollock),mx,br(R.pollock,1)+'%','#2563eb'));
  if(R.navy!=null)mm.push(pdfMeter('US Navy (perímetros)',Number(R.navy),mx,br(R.navy,1)+'%','#0ea5e9'));
  if(R.rfm!=null)mm.push(pdfMeter('RFM (cintura/altura)',Number(R.rfm),mx,br(R.rfm,1)+'%','#8b5cf6'));
  if(R.bia)mm.push(pdfMeter('Bioimpedância',Number(R.bia),mx,br(R.bia,1)+'%','#10b981'));
  var m=[];
  if(R.ref!=null){m.push(pdfRow('Média aritmética dos métodos (não clínica)','<span class="hl">'+br(R.ref,1)+'%</span>'));if(R.amp!=null&&isFinite(R.amp)&&mm.length>1)m.push(pdfRow('Amplitude entre métodos',br(R.amp,1)+' p.p.'));
    if(R.peso>0)m.push(pdfRow('Gordura / massa magra (kg)',br(R.peso*R.ref/100,1)+' / '+br(R.peso*(1-R.ref/100),1)))}
  var ix=[];
  if(R.whtr!=null){var wt=R.whtr<0.5?['baixo risco','good']:R.whtr<0.6?['risco aumentado','warn']:['risco alto','bad'];ix.push(pdfRow('Cintura/Estatura',br(R.whtr,2)+' <span class="lb-tag '+wt[1]+'">'+wt[0]+'</span>'))}
  if(R.bri!=null)ix.push(pdfRow('BRI',br(R.bri,1)));
  if(R.absi!=null)ix.push(pdfRow('ABSI',R.absi.toFixed(4).replace('.',',')));
  if(R.ffmi){ix.push(pdfRow('FFMI',br(R.ffmi.ffmi,1)));ix.push(pdfRow('FFMI normalizado',br(R.ffmi.norm,1)))}
  var en=[];
  if(R.harris!=null||R.mifflin!=null){
    if(R.harris!=null)en.push(pdfRow('TMB Harris-Benedict (1984)',Math.round(R.harris)+' kcal'));
    if(R.mifflin!=null)en.push(pdfRow('TMB Mifflin-St Jeor (1990)',Math.round(R.mifflin)+' kcal'));
    if(R.katch!=null)en.push(pdfRow('TMB Katch-McArdle (FFM)',Math.round(R.katch)+' kcal'));
    if(R.baseTmb!=null)en.push(pdfRow('TMB Base ('+(R.formulaNome||'Harris-Benedict')+')','<span class="hl">'+Math.round(R.baseTmb)+' kcal</span>'));
    if(R.get!=null)en.push(pdfRow('Gasto total GET (×'+String(F.fator).replace('.',',')+')',Math.round(R.get)+' kcal'));
    if(R.kcal!=null)en.push(pdfRow('Meta calórica ('+({manter:'manutenção',def:'déficit −20%',sup:'superávit +10%'}[F.obj]||'manutenção')+')','<span class="hl">'+Math.round(R.kcal)+' kcal</span>'));}
  var mt=[];
  if(R.meta){mt.push(pdfRow('Meta de gordura',br(R.alvo,1)+'%'));mt.push(pdfRow('Peso-alvo (massa magra constante)','<span class="hl">'+br(R.meta.pesoAlvo,1)+' kg</span>'));mt.push(pdfRow('Variação de peso',(-R.meta.delta>0?'+':'−')+br(Math.abs(R.meta.delta),1)+' kg'));mt.push(pdfRow('Gordura a reduzir',br(R.meta.gorduraPerder,1)+' kg'))}
  var fc='';
  if(R.fcmax){var fm=R.fcmax,rep=(F.fcrep>0&&F.fcrep<fm)?F.fcrep:0,zc=['#94a3b8','#38bdf8','#10b981','#f59e0b','#ef4444'],zi=0,zr='';
    zr+='<div class="lb-fcmax"><small>FC máxima estimada (Tanaka)</small><b>'+Math.round(fm)+' bpm</b></div>';
    [[50,60,'Recuperação'],[60,70,'Aeróbio base'],[70,80,'Aeróbio'],[80,90,'Limiar'],[90,100,'Máximo']].forEach(function(z){
      var lo=rep?rep+(fm-rep)*z[0]/100:fm*z[0]/100,hi=rep?rep+(fm-rep)*z[1]/100:fm*z[1]/100,col=zc[zi++];
      zr+='<div class="lb-zone"><span class="zn"><i style="background:'+col+'"></i>'+esc(z[2])+' <small>'+z[0]+'–'+z[1]+'%</small></span><span class="zb"><i style="left:'+(lo/fm*100).toFixed(1)+'%;width:'+((hi-lo)/fm*100).toFixed(1)+'%;background:'+col+'"></i></span><span class="zv">'+Math.round(lo)+'–'+Math.round(hi)+' bpm</span></div>'});
    fc='<div class="lb-zones">'+zr+'</div><div class="lb-fnote">'+(rep?'Método de Karvonen (FC de repouso '+Math.round(rep)+' bpm).':'Percentuais da FC máxima (FC de repouso não informada).')+'</div>'}
  var perfil=[R.sexo==='F'?'Feminino':'Masculino',R.idade>0?R.idade+' anos':'',R.altura>0?br(R.altura,0)+' cm':'',R.peso>0?br(R.peso,1)+' kg':''].filter(Boolean);
  var metCard=pdfSec('Comparador de métodos de % de gordura',(mm.length?mm.join(''):'<div class="lb-empty">Dados insuficientes para este bloco.</div>')+(m.length?'<table class="lb-kv"><tbody>'+m.join('')+'</tbody></table>':''),'','#2563eb');
  return'<div class="lb-doc">'+
    '<div class="lb-head"><div><div class="lb-kick">Laboratório de Avaliação</div><div class="lb-title">EvoluFísico · Relatório do Laboratório</div><div class="lb-sub">Emitido em '+new Date().toLocaleDateString('pt-BR')+'</div></div>'+
    '<div class="lb-pro">'+(pro?'<b>'+esc(pro)+'</b>':'')+(cref?'<span>'+esc(cref)+'</span>':'')+(cli?'<span>'+esc(cli)+'</span>':'')+'</div></div>'+
    '<div class="lb-student"><div><small>Aluno</small><h2>'+esc(nome)+'</h2></div><div class="lb-chips">'+perfil.map(function(p){return'<span class="lb-chip">'+esc(p)+'</span>'}).join('')+'<span class="lb-chip blue"><small>Referência</small>'+esc(brDate(a.data_avaliacao))+'</span></div></div>'+
    '<section class="lb-card lb-hist" style="--acc:#0ea5e9"><h3 class="lb-h"><i></i>Histórico do aluno <em>('+list.length+' avaliaç'+(list.length>1?'ões':'ão')+')</em></h3>'+
    '<table class="lb-table"><thead><tr><th class="l">Data</th><th class="l">Fase</th><th>Peso (kg)</th><th>% Gord.</th><th>M. gorda (kg)</th><th>M. magra (kg)</th><th>Cintura (cm)</th><th>Cint./Est.</th></tr></thead><tbody>'+hist+'</tbody></table>'+evo+'</section>'+
    '<div class="lb-note">Cálculos abaixo conforme os valores exibidos no Laboratório (podem ter sido ajustados manualmente).</div>'+
    '<div class="lb-grid">'+metCard+
    pdfBox('Índices de risco & FFMI',ix,'','','#f59e0b')+
    pdfBox('Energia & Gasto Calórico',en,'','','#ef4444')+
    pdfBox('Simulador de meta',mt,'Nenhuma meta de % de gordura informada (ou a meta não é menor que o valor atual).','','#10b981')+
    '</div>'+
    (fc?pdfSec('Zonas de frequência cardíaca',fc,'lb-wide','#ef4444'):pdfSec('Zonas de frequência cardíaca','<div class="lb-empty">Dados insuficientes para este bloco.</div>','lb-wide','#ef4444'))+
    '<div class="lb-foot">Estimativas populacionais e de triagem, não diagnóstico. Não substituem avaliação profissional; prescrição nutricional é atribuição de nutricionista. EvoluFísico v'+VER+'.</div></div>'}

function exportPDF1(){
  var msg=window.efToast||window.alert;
  compute();
  if(!last){
    msg('Preencha os dados do Lab para gerar o PDF.','warn');
    return;
  }
  var a=srcRecord();
  if(!a){
    var frm=fromForm();
    var inp=readInputs();
    var nomeAluno=(frm.nome||'').trim();
    if(!nomeAluno){
      var s=el('src');
      if(s&&s.selectedIndex>=0&&s.options[s.selectedIndex].value!=='form'){
        nomeAluno=s.options[s.selectedIndex].text.replace(/ ·.*$/,'').trim();
      }
    }
    if(!nomeAluno){
      var nomeInput=document.getElementById('nome');
      if(nomeInput&&nomeInput.value.trim())nomeAluno=nomeInput.value.trim();
    }
    if(!nomeAluno){
      nomeAluno='Aluno(a) / Avaliação Lab';
    }
    var dataAv=(document.getElementById('data_avaliacao')&&document.getElementById('data_avaliacao').value)||new Date().toISOString().slice(0,10);
    var faseAv=(document.getElementById('fase')&&document.getElementById('fase').value)||'Laboratório de Avaliação';
    a={
      id:'lab_sim_'+Date.now(),
      nome:nomeAluno,
      data_avaliacao:dataAv,
      fase:faseAv,
      sexo:inp.sexo,
      idade:inp.idade,
      altura:inp.altura,
      peso:inp.peso,
      dobras_resultado:inp.pollock?{percGordura:inp.pollock,massaGorda:inp.peso*inp.pollock/100,massaMagra:inp.peso*(1-inp.pollock/100)}:{},
      bioimpedancia:inp.bia?{pgordura:inp.bia}:{},
      perimetria:{pescoco:inp.pescoco,cintura:inp.cintura,quadril:inp.quadril}
    };
  }

  var box=document.getElementById('ef77-print');
  if(!box){
    box=document.createElement('div');
    box.id='ef77-print';
    box.setAttribute('aria-hidden','true');
    document.body.appendChild(box);
  }

  var list=sameStudent(a).slice().sort(function(x,y){return String(x.data_avaliacao||'').localeCompare(String(y.data_avaliacao||''))});
  if(!list.length)list=[a];

  var F={
    fator:el('fator')?el('fator').value:'1.55',
    obj:el('obj')?el('obj').value:'manter',
    fcrep:el('fcrep')?num(el('fcrep').value):0
  };

  box.innerHTML=pdfHTML(a,list,last,F);

  var oldTitle=document.title;
  var safeNome=(a.nome||'Aluno').replace(/[^a-zA-Z0-9áéíóúÁÉÍÓÚãõÃÕâêîôûÂÊÎÔÛçÇ\s_-]/g,'').trim();
  document.title='EvoluFisico_Lab_'+safeNome.replace(/\s+/g,'_')+'_'+(a.data_avaliacao||new Date().toISOString().slice(0,10));

  var cleaned=false;
  var done=function(){
    if(cleaned)return;
    cleaned=true;
    document.body.classList.remove('ef77-printing');
    document.title=oldTitle;
    box.innerHTML='';
    if(typeof window.removeEventListener==='function')window.removeEventListener('afterprint',done);
  };

  document.body.classList.add('ef77-printing');
  window.addEventListener('afterprint',done,{once:true});
  setTimeout(done,60000);

  setTimeout(function(){
    try{
      window.print();
    }catch(e){
      done();
      msg('Não foi possível abrir a impressão do navegador: '+(e&&e.message||e),'warn');
    }
  },100);
}

/* ---------- Tema escuro ---------- */

/* ---------- Autoteste (valores de referência calculados à mão) ---------- */
function selfTest(){
  var T=[['navy M',C.navy('M',183,41,88,104),15.6,.1],['rfm M',C.rfm('M',183,88),22.4,.1],['rfm F',C.rfm('F',165,75),32.0,.1],['mifflin M',C.mifflin('M',97.4,183,33),1957.75,.01],['mifflin F',C.mifflin('F',60,165,30),1320.25,.01],['katch',C.katch(82.3),2147.68,.01],['tanaka',C.fcmax(33),184.9,.01],['whtr',C.whtr(183,88),0.4809,.001],['meta',C.meta(97.4,15.5,12).pesoAlvo,93.526,.01],['ffmi norm',C.ffmi(183,97.4,15.5).norm,24.4,.1]],bad=[];
  T.forEach(function(t){if(!(t[1]!=null&&Math.abs(t[1]-t[2])<=t[3]))bad.push(t[0]+': '+t[1]+' ≠ '+t[2])});
  if(C.navy('M',180,50,40,0)!==null)bad.push('navy deve rejeitar pescoço>cintura');
  if(C.rfm('M',0,80)!==null||C.bri(180,0)!==null)bad.push('entradas vazias devem retornar null');
  return{ok:!bad.length,total:T.length+2,failed:bad}}

/* ---------- Montagem ---------- */
function mount(){
  try{
    var nav=$('.nav-tabs'),after=$('#tab-comparison');
    if(!nav||!after){console.warn('EF77: ponto de montagem não encontrado');return}
    if($('#tab-lab77')){updateButtons();compute();return}
    if(!$('#tab-btn-lab77'))nav.insertAdjacentHTML('beforeend','<button class="nav-tab-btn" id="tab-btn-lab77" onclick="switchTab(\'tab-lab77\')"><span>🧪</span> <span>Lab</span></button>');
    var opt=function(a){return a.map(function(x){return'<option value="'+x[0]+'">'+x[1]+'</option>'}).join('')};
    var inp=function(k,l,st){return'<div><label for="ef77-'+k+'">'+l+'</label><input id="ef77-'+k+'" type="number" inputmode="decimal" step="'+(st||'any')+'" min="0"></div>'};
    after.insertAdjacentHTML('afterend','<section id="tab-lab77" class="tab-panel"><div class="ef77-wrap"><div class="ef77-head"><div><h2>Laboratório de Avaliação</h2><p>Calculadoras complementares. Não alteram nem salvam dados das avaliações.</p></div><div class="ef77-tools"><button class="ef77-btn" id="ef77-copy" type="button">📋 Copiar resumo</button><button class="ef77-btn" id="ef77-pdf1" type="button" title="PDF do aluno da fonte selecionada: histórico + cálculos do Lab">📄 PDF do aluno</button><button class="ef77-btn" id="ef77-csv1" type="button" title="Exporta só o aluno da fonte selecionada">⬇️ CSV do aluno</button><button class="ef77-btn pri" id="ef77-csv" type="button">⬇️ CSV (todas)</button></div></div>'+
    '<div class="ef77-card" style="margin-bottom:1rem"><div class="ef77-form"><div class="wide"><label for="ef77-src">Fonte dos dados</label><select id="ef77-src"></select></div>'+
    '<div><label for="ef77-sexo">Sexo</label><select id="ef77-sexo">'+opt([['M','Masculino'],['F','Feminino']])+'</select></div>'+inp('idade','Idade')+inp('altura','Altura (cm)')+inp('peso','Peso (kg)')+inp('pescoco','Pescoço (cm)')+inp('cintura','Cintura (cm)')+inp('quadril','Quadril (cm)')+inp('pollock','% Gord. Pollock')+inp('bia','% Gord. BIA')+inp('fcrep','FC repouso (bpm)','1')+
    '<div><label for="ef77-fator">Nível de atividade</label><select id="ef77-fator">'+opt([['1.2','Sedentário (1,2)'],['1.375','Leve (1,375)'],['1.55','Moderado (1,55)'],['1.725','Intenso (1,725)'],['1.9','Muito intenso (1,9)']])+'</select></div><div><label for="ef77-obj">Objetivo</label><select id="ef77-obj">'+opt([['manter','Manutenção'],['def','Déficit (−20%)'],['sup','Superávit (+10%)']])+'</select></div><div><label for="ef77-formula">Fórmula TMB</label><select id="ef77-formula">'+opt([['harris','Harris-Benedict (1984)'],['mifflin','Mifflin-St Jeor (1990)'],['katch','Katch-McArdle (Massa Magra)'],['harris1919','Harris-Benedict (1919)'],['media','Média das Equações']])+'</select></div>'+inp('alvo','Meta % gordura')+'</div></div>'+
    '<div class="ef77-grid" id="ef77-out" aria-live="polite"></div></div></section>');
    /* preferências salvas */
    var pr={};try{pr=JSON.parse(store('ef77_prefs')||'{}')||{}}catch(e){pr={}}
    el('fator').value=['1.2','1.375','1.55','1.725','1.9'].indexOf(String(pr.fator))>=0?String(pr.fator):'1.55';
    el('obj').value=['manter','def','sup'].indexOf(pr.obj)>=0?pr.obj:'manter';
    if(el('formula'))el('formula').value=['harris','mifflin','katch','harris1919','media'].indexOf(pr.formula)>=0?pr.formula:'harris';
    var savePrefs=function(){store('ef77_prefs',JSON.stringify({fator:el('fator').value,obj:el('obj').value,formula:el('formula')?el('formula').value:'harris'}))};
    FIELDS.forEach(function(k){var e=el(k);if(!e)return;
      e.addEventListener('input',function(){if(NUMF.indexOf(k)>=0||k==='sexo')dirty=true;compute()});
      e.addEventListener('change',function(){if(k==='sexo')dirty=true;if(k==='fator'||k==='obj'||k==='formula')savePrefs();compute()})});
    el('src').addEventListener('change',loadSrc);
    el('copy').addEventListener('click',copySummary);
    el('csv').addEventListener('click',function(){exportCSV(false)});
    el('csv1').addEventListener('click',function(){exportCSV(true)});
    if(el('pdf1')) el('pdf1').addEventListener('click',exportPDF1);
    var _sw=window.switchTab;
    window.switchTab=function(id){
      var r=_sw.apply(this,arguments);
      if(id==='tab-lab77'){try{document.querySelectorAll('.nav-tab-btn').forEach(function(b){b.classList.remove('active')});var b=$('#tab-btn-lab77');if(b)b.classList.add('active');buildSrc();if(!dirty)loadSrc();else{compute();updateButtons()}}catch(e){console.warn('EF77',e)}}
      return r};
    updateButtons();compute();
  }catch(err){console.warn('EF77: falha ao montar o Lab',err)}
}
window.EF77={version:VER,mounted:true,calc:C,selfTest:selfTest,sameStudent:sameStudent,exportPDF1:exportPDF1,mount:mount};
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',mount);else mount();
})();
</script>
<style>/* 16-styles.css */
/* ===== EvoluFísico v7.8.1 · Parecer editável no Comparar Evolução ===== */
.ef781-editor textarea{width:100%;box-sizing:border-box;min-height:9rem;padding:.75rem .85rem;border:1px solid var(--border-color,#d1d5db);border-radius:12px;font:inherit;font-size:.92rem;line-height:1.55;resize:vertical;background:#fff;color:inherit}
.ef781-editor textarea:focus-visible{outline:3px solid rgba(0,122,255,.35);outline-offset:1px}
.ef781-editor textarea:disabled{opacity:.55;cursor:not-allowed}
.ef781-bar{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;justify-content:space-between;margin-top:.55rem}
.ef781-btns{display:flex;gap:.5rem;flex-wrap:wrap}
#ef781-status{font-size:.78rem;color:#6b7280}
#ef781-status.ok{color:#166534}
#ef781-status.dirty{color:#92400e;font-weight:700}
.ef781-print-text{display:none;white-space:pre-wrap}
@media print{.ef781-print-text{display:block!important}.ef781-editor{display:none!important}}
</style>
<script id="ef781-script">/* 19-runtime.js */
(function(){
'use strict';
if(window.EF781)return;
var VER='7.8.1',cur=null,dirty=false;
function $(i){return document.getElementById(i)}
function recs(){try{var r=window.__EF63_STATE__.getAvaliacoes();return Array.isArray(r)?r:[]}catch(e){return[]}}
function toast(m,t){if(window.efToast)window.efToast(m,t);else alert(m)}
function autoText(a1,a2){return a2.parecer_profissional||a1.parecer_profissional||'Sem observações.'}
function custom(a1,a2){var m=a2&&a2.parecer_comparativo;return(m&&typeof m==='object'&&typeof m[a1.id]==='string')?m[a1.id]:null}
function setStatus(){var s=$('ef781-status');if(!s)return;
  if(!cur){s.textContent='';s.className='';return}
  s.textContent=dirty?'● Alterações não salvas':(cur.edited?'✏️ Parecer editado (salvo)':'🤖 Texto automático das avaliações');
  s.className=dirty?'dirty':(cur.edited?'ok':'')}
function mirror(){var ta=$('ef781-parecer'),d=$('comp-pro-notes-display');if(d)d.textContent=(ta&&ta.value.trim())||'Sem observações.'}
function ctrls(on){['ef781-parecer','ef781-save','ef781-restore'].forEach(function(i){var e=$(i);if(e)e.disabled=!on})}

async function persist(c,text){
  var orig=recs().filter(function(x){return x.id===c.a2id})[0];
  if(!orig)throw new Error('avaliação não encontrada');
  var fn=window.salvarAvaliacaoNoDB;if(typeof fn!=='function')throw new Error('função de salvar indisponível');
  var rec=Object.assign({},orig),m=Object.assign({},orig.parecer_comparativo||{}),t=String(text).replace(/\s+$/,'');
  if(t.trim()===c.auto.trim())delete m[c.a1id];else m[c.a1id]=t;
  if(Object.keys(m).length)rec.parecer_comparativo=m;else delete rec.parecer_comparativo;
  await fn(rec);
  return Object.prototype.hasOwnProperty.call(m,c.a1id)}

function render(a1,a2){
  var ta=$('ef781-parecer');
  if(!ta){var d=$('comp-pro-notes-display');if(d)d.textContent=autoText(a1,a2);return}
  var key=a1.id+'|'+a2.id;
  if(cur&&dirty&&cur.key!==key){
    var prev=cur,txt=ta.value;dirty=false;
    persist(prev,txt).then(function(){toast('Parecer do comparativo anterior salvo automaticamente.','ok')},function(e){console.warn('EF781',e);toast('Não foi possível salvar o parecer da comparação anterior.','warn')})}
  if(cur&&cur.key===key&&dirty){cur.auto=autoText(a1,a2)}
  else{var c=custom(a1,a2),auto=autoText(a1,a2);
    cur={key:key,a1id:a1.id,a2id:a2.id,auto:auto,edited:c!==null};
    ta.value=c!==null?c:auto;dirty=false}
  ctrls(true);mirror();setStatus()}
function vazio(){
  var ta=$('ef781-parecer'),d=$('comp-pro-notes-display');
  cur=null;dirty=false;if(ta)ta.value='';ctrls(false);
  if(d)d.textContent='Nenhuma observação técnica disponível.';setStatus()}

async function save(){
  if(!cur)return;var c=cur,ta=$('ef781-parecer'),b=$('ef781-save');if(b)b.disabled=true;
  try{c.edited=await persist(c,ta.value);dirty=false;
    toast(c.edited?'Parecer do comparativo salvo.':'Parecer igual ao automático: nada a personalizar.','ok')}
  catch(e){console.warn('EF781',e);toast('Não foi possível salvar o parecer: '+(e&&e.message||e),'warn')}
  if(b)b.disabled=!cur;setStatus()}
function restore(){
  if(!cur)return;var ta=$('ef781-parecer');
  if(ta.value.trim()!==cur.auto.trim()&&!confirm('Descartar o texto editado e voltar ao parecer automático das avaliações?'))return;
  ta.value=cur.auto;dirty=true;mirror();save()}

var ta0=$('ef781-parecer');
if(ta0){
  ta0.addEventListener('input',function(){if(!cur)return;dirty=true;mirror();setStatus()});
  $('ef781-save').addEventListener('click',save);
  $('ef781-restore').addEventListener('click',restore);
  ctrls(false)}
window.addEventListener('beforeunload',function(e){if(dirty){e.preventDefault();e.returnValue=''}});
window.EF781={version:VER,render:render,vazio:vazio,save:save};
})();
</script>
<script id="efdiag-script">/* 20-runtime.js */
(function(){
'use strict';
if(window.EFDiag&&window.EFDiag.mounted)return;
var running=false,lastResults=[];
var $=function(id){return document.getElementById(id)};
function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function ensureUI(){
 var nav=document.querySelector('.nav-tabs'),panel=$('tab-diagnostics');
 // Navegação de Diagnóstico removida; painel integrado a Configurações > Manutenção.
 if(!panel){panel=document.createElement('section');panel.id='tab-diagnostics';panel.className='tab-panel';var lab=$('tab-lab77'),cmp=$('tab-comparison');if(lab&&lab.parentNode)lab.parentNode.insertBefore(panel,lab.nextSibling);else if(cmp&&cmp.parentNode)cmp.parentNode.insertBefore(panel,cmp.nextSibling);else document.body.appendChild(panel)}
 if(!panel.querySelector('.efdiag-wrap'))panel.innerHTML='<div class="efdiag-wrap"><header class="efdiag-head"><div><h2>Diagnóstico do aplicativo</h2><p>Testes locais de integridade, módulos, cálculos e componentes principais. As verificações são somente leitura; nenhuma avaliação é salva, alterada ou apagada.</p></div></header><div class="efdiag-card"><div class="efdiag-actions"><button class="efdiag-btn primary" id="efdiag-run" type="button">▶ Executar testes</button><button class="efdiag-btn repair" id="efdiag-repair" type="button">🛠 Autocorreção segura</button><span class="efdiag-summary" id="efdiag-summary" role="status">Aguardando teste</span></div><div class="efdiag-results" id="efdiag-results" aria-live="polite"><p class="efdiag-note">Execute os testes para verificar o estado atual. A autocorreção executa apenas reparos não destrutivos de interface e caches derivados; dados de alunos, cobranças, anamneses e backups não são alterados.</p></div><p class="efdiag-note">Cobertura ampliada: avaliações, banco de dados, fórmulas, formulários, fichas de alunos, agenda, PDF, cobranças, cofre, backups, notificações, navegação e impressão. Integrações externas, impressão física e todos os caminhos possíveis de uso não podem ser provados automaticamente.</p></div></div>';
 var buttons=panel.querySelector('.efdiag-actions');
 if(buttons&&!$('efdiag-category')){
   var filters=document.createElement('div');filters.className='efdiag-filters';
   var label=document.createElement('label');label.textContent='Verificar módulo';label.htmlFor='efdiag-category';
   var select=document.createElement('select');select.id='efdiag-category';select.setAttribute('aria-label','Escolher módulo dos testes');
   [['all','Todos os módulos'],['core','Avaliações e cálculos'],['forms','Formulários e alunos'],['agenda','Agenda e notificações'],['finance','Cobranças e recebimentos'],['storage','Banco, cofre e backup'],['pdf','PDF e impressão'],['ui','Interface e configurações']].forEach(function(v){select.add(new Option(v[1],v[0]))});
   var exportButton=document.createElement('button');exportButton.type='button';exportButton.id='efdiag-export';exportButton.className='efdiag-btn';exportButton.textContent='↓ Exportar resumo de QA';
   exportButton.addEventListener('click',exportReport);
   filters.append(label,select,exportButton);
   var desc=document.createElement('p');desc.className='efdiag-legend';desc.textContent='Os testes são de leitura. Avisos de cofre, permissões ou suporte do navegador não são falhas. O relatório contém apenas resultados técnicos, sem dados pessoais.';
   buttons.after(filters,desc);
 }
 bindButtons();
 return !!nav&&!!panel;
}
function setStatus(text,kind){var e=$('efdiag-summary');if(e){e.textContent=text;e.className='efdiag-summary'+(kind?' '+kind:'')}}
const CATS={core:'Avaliações e cálculos',forms:'Formulários e alunos',agenda:'Agenda e notificações',finance:'Cobranças e recebimentos',storage:'Banco, cofre e backup',pdf:'PDF e impressão',ui:'Interface e configurações'};
const CAT_META={
 core:{label:'Avaliações e cálculos',icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19h16"></path><path d="M6 16l4-4 3 2 5-6"></path><path d="M17 8h1.5A1.5 1.5 0 0 1 20 9.5V11"></path></svg>',hint:'Cálculos, indicadores e leituras principais revalidados.'},
 forms:{label:'Formulários e alunos',icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 7h8"></path><path d="M8 11h8"></path><path d="M8 15h5"></path><rect x="5" y="3.5" width="14" height="17" rx="2.5"></rect></svg>',hint:'Modelos, anamneses e vínculo com alunos preservados.'},
 agenda:{label:'Agenda e notificações',icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2.5"></rect><path d="M7 3.5v3M17 3.5v3M3.5 9.5h17"></path></svg>',hint:'Agenda rápida, compromissos e lembretes revisados.'},
 finance:{label:'Cobranças e recebimentos',icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="6" width="17" height="12" rx="2.5"></rect><path d="M3.5 10h17"></path><circle cx="15.5" cy="14" r="1.2"></circle></svg>',hint:'Cobranças, histórico e exportações financeiras verificados.'},
 storage:{label:'Banco, cofre e backup',icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="6" rx="6.5" ry="2.5"></ellipse><path d="M5.5 6v6c0 1.4 2.9 2.5 6.5 2.5s6.5-1.1 6.5-2.5V6"></path><path d="M5.5 12v6c0 1.4 2.9 2.5 6.5 2.5s6.5-1.1 6.5-2.5v-6"></path></svg>',hint:'Persistência local, cofre e backups não foram afetados.'},
 pdf:{label:'PDF e impressão',icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 8V4.5A1.5 1.5 0 0 1 8.5 3h7L19 6.5V8"></path><rect x="4" y="8" width="16" height="8" rx="2"></rect><path d="M7 16h10v4H7z"></path></svg>',hint:'Exportadores e isolamento visual de impressão mantidos.'},
 ui:{label:'Interface e configurações',icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"></path><path d="M4 12h10"></path><path d="M4 17h16"></path><circle cx="8" cy="7" r="1.2"></circle><circle cx="16" cy="12" r="1.2"></circle><circle cx="11" cy="17" r="1.2"></circle></svg>',hint:'Navegação, aparência e áreas visuais recompostas com segurança.'}
};
function compactDetail(text){text=String(text||'').trim();if(text.length>110)text=text.slice(0,107).trimEnd()+'…';return text}
function renderDiagnosticCards(rows,repairBanner){
 var host=$('efdiag-results');if(!host)return;
 var grouped={},order=[];
 rows.forEach(function(r){if(!grouped[r.group]){grouped[r.group]=[];order.push(r.group)}grouped[r.group].push(r)});
 var fail=rows.filter(function(x){return x.state==='fail'}).length;
 var warn=rows.filter(function(x){return x.state==='warn'}).length;
 var pass=rows.filter(function(x){return x.state==='pass'}).length;
 var type=repairBanner?'reparo':'teste';
 var message=repairBanner||'Verificações concluídas em modo somente leitura, sem alterar os dados cadastrados.';
 var title=repairBanner?'Autocorreção finalizada':'Testes finalizados';
 var icon=fail?'×':warn?'!':'✓';
 var banner='<div class="efdiag-repair-banner" data-state="'+(fail?'fail':warn?'warn':'pass')+'"><div class="efdiag-banner-icon" aria-hidden="true">'+icon+'</div><div><strong>'+title+'</strong><p>'+esc(message)+'</p><span class="efdiag-total">'+pass+' aprovado(s) · '+warn+' aviso(s) · '+fail+' falha(s)</span></div></div>';
 var cards=order.map(function(g){
  var items=grouped[g], failures=items.filter(function(x){return x.state==='fail'}).length;
  var warnings=items.filter(function(x){return x.state==='warn'}).length;
  var good=items.filter(function(x){return x.state==='pass'}).length;
  var meta=CAT_META[g]||{label:CATS[g]||g,icon:'',hint:'Área do aplicativo verificada.'};
  var state=failures?'fail':warnings?'warn':'pass';
  var symbol=failures?'×':warnings?'!':'✓';
  var pill=failures?failures+' falha(s)':warnings?warnings+' aviso(s)':'Aprovado';
  var summary=good+'/'+items.length+' aprovado(s)';
  return '<article class="efdiag-repair-card" data-state="'+state+'" aria-label="'+esc(meta.label+': '+summary+', '+pill)+'">'
    +'<div class="efdiag-card-art"><span class="efdiag-icon" aria-hidden="true">'+meta.icon+'</span><span class="efdiag-repair-check" aria-hidden="true">'+symbol+'</span></div>'
    +'<span class="efdiag-title">'+esc(meta.label)+'</span><span class="efdiag-meta">'+esc(summary)+'</span><span class="efdiag-pill">'+esc(pill)+'</span></article>';
 }).join('');
 var issues=rows.filter(function(r){return r.state!=='pass'});
 var issuesHTML=issues.length?'<section class="efdiag-repair-details"><h4>Itens que precisam de atenção</h4><div class="efdiag-repair-list">'+issues.map(function(r){return '<div class="efdiag-repair-item"><span class="efdiag-badge '+esc(r.state)+'">'+(r.state==='fail'?'FALHA':'AVISO')+'</span><div><b>'+esc(r.name)+'</b><p>'+esc(r.detail)+'</p></div></div>'}).join('')+'</div></section>'
 :'<p class="efdiag-repair-empty">Nenhum aviso ou falha detectado nas verificações executadas.</p>';
 var allDetails=rows.length?'<details class="efdiag-all-details"><summary>Ver todas as '+rows.length+' verificações</summary><div class="efdiag-detail-list">'+rows.map(function(r){return '<div class="efdiag-detail-row"><span class="efdiag-badge '+esc(r.state)+'">'+(r.state==='pass'?'OK':r.state==='warn'?'AVISO':'FALHA')+'</span><div><b>'+esc(r.name)+'</b><p>'+esc(r.detail)+'</p></div></div>'}).join('')+'</div></details>':'';
 host.innerHTML='<div class="efdiag-repair-wrap">'+banner+(cards?'<div class="efdiag-repair-grid">'+cards+'</div>':'<p class="efdiag-repair-empty">Nenhum teste disponível para o filtro selecionado.</p>')+issuesHTML+allDetails+'</div>';
 setStatus(pass+' OK · '+warn+' aviso(s) · '+fail+' falha(s)',fail?'fail':warn?'warn':'ok');
}
function renderRows(rows,repairBanner){
 lastResults=rows.slice();renderDiagnosticCards(rows,repairBanner);
}
function groupOf(name){
 if(/Formulários|Anamnese|Ficha do aluno/.test(name))return'forms';
 if(/Agenda|Notificações|Lembretes/.test(name))return'agenda';
 if(/Cobranças|Recebimento|Histórico financeiro/.test(name))return'finance';
 if(/Backup|Cofre|IndexedDB|Armazenamento|Proteção|Rascunho/.test(name))return'storage';
 if(/PDF|impressão|imprimível|Relatório/i.test(name))return'pdf';
 if(/Interface|Navegação|Configurações|Temas|Visual/.test(name))return'ui';
 return'core';
}
function selected(){return $('efdiag-category')?.value||'all'}
function normalize(detail){if(detail&&typeof detail==='object'&&detail.status==='warn')return{state:'warn',detail:String(detail.detail||'Requer atenção do profissional.')};return{state:'pass',detail:String(detail||'Verificação concluída.')}}
function exportReport(){
 if(!lastResults.length){setStatus('Execute os testes antes de exportar','warn');return}
 var payload={produto:'EvoluFísico2',versao:'Teste do diagnóstico v2.0',data:new Date().toISOString(),filtro:selected(),totais:{aprovados:lastResults.filter(r=>r.state==='pass').length,avisos:lastResults.filter(r=>r.state==='warn').length,falhas:lastResults.filter(r=>r.state==='fail').length},resultados:lastResults.map(function(r){return{modulo:CATS[r.group]||r.group,teste:r.name,resultado:r.state,descricao:r.detail}}),nota:'Sem nomes de alunos, documentos pessoais, valores financeiros, senhas ou conteúdo clínico.'};
 var url=URL.createObjectURL(new Blob([JSON.stringify(payload,null,2)],{type:'application/json'}));
 var link=document.createElement('a');link.href=url;link.download='evolufisico2_relatorio_qa_'+new Date().toISOString().slice(0,10)+'.json';document.body.append(link);link.click();link.remove();setTimeout(function(){URL.revokeObjectURL(url)},1500);
}
function check(rows,name,fn){
 var group=groupOf(name);if(selected()!=='all'&&selected()!==group)return Promise.resolve();
 try{var v=fn();if(v&&typeof v.then==='function')return v.then(function(detail){rows.push({name:name,group:group,...normalize(detail)})},function(e){rows.push({name:name,group:group,state:'fail',detail:e&&e.message||String(e)})});rows.push({name:name,group:group,...normalize(v)});return Promise.resolve()}catch(e){rows.push({name:name,group:group,state:'fail',detail:e&&e.message||String(e)});return Promise.resolve()}
}
async function runTests(repairBanner){
 if(running)return;running=true;var b=$('efdiag-run'),fix=$('efdiag-repair');if(b)b.disabled=true;if(fix)fix.disabled=true;setStatus('Executando…','');var rows=[],S=window.__EF63_STATE__,records=[];
 await check(rows,'Estado e avaliações',function(){if(!S||typeof S.getAvaliacoes!=='function')throw Error('Estado central EF63 indisponível.');records=S.getAvaliacoes();if(!Array.isArray(records))throw Error('A lista de avaliações não é um array.');return records.length+' avaliação(ões) lidas; sem gravação.'});
 await check(rows,'Módulos e APIs',function(){var ids=['EFU','EF6','EF63','EF64','EF65','EF66','EF67','EF68','EF70','EF71','EF72','EF73','EF77','EF781'];var miss=ids.filter(function(k){return !window[k]||typeof window[k]!=='object'});if(miss.length)throw Error('Módulos ausentes: '+miss.join(', '));if(typeof window.EFU.num!=='function'||typeof window.EFU.norm!=='function'||typeof window.EFU.esc!=='function')throw Error('API utilitária EFU incompleta.');return ids.length+' módulos presentes; API utilitária íntegra.'});
 await check(rows,'Integridade básica dos dados',function(){if(!Array.isArray(records))throw Error('Não foi possível ler dados.');var noId=records.filter(function(x){return !x||x.id==null||String(x.id)===''}).length,dups=new Set(),seen=new Set();records.forEach(function(x){if(x&&x.id!=null){var k=String(x.id);if(seen.has(k))dups.add(k);seen.add(k)}});if(noId)throw Error(noId+' avaliação(ões) sem identificador.');if(dups.size)return{status:'warn',detail:dups.size+' identificador(es) repetido(s); faça backup e revise manualmente sem excluir registros.'};return records.length?records.length+' registros com identificadores; sem exposição de dados pessoais.':'Base vazia, pronta para receber avaliações.'});
 await check(rows,'Autoteste matemático do Lab',function(){if(!window.EF77||typeof EF77.selfTest!=='function')throw Error('Autoteste do Lab indisponível.');var r=EF77.selfTest();if(!r||!r.ok)throw Error((r&&r.failed||['Falha no autoteste']).join('; '));return r.total+' casos numéricos passaram.'});
 await check(rows,'Motor de histórico EF67',function(){var r=EF67.summary();if(!r||typeof r.records!=='number'||!r.averages)throw Error('Resumo do histórico retornou estrutura inválida.');return r.records+' registros indexados; API respondeu.'});
 await check(rows,'Motor de insights EF68',function(){var r=EF68.all();if(!r||!Array.isArray(r.studentsData)||!Array.isArray(r.events))throw Error('Resposta do motor EF68 incompleta.');return r.studentsData.length+' aluno(s), '+r.events.length+' evento(s) analisados.'});
 await check(rows,'Motor de decisão EF70',function(){var r=EF70.all();if(!r||!Array.isArray(r.studentsData)||!Array.isArray(r.events))throw Error('Resposta do motor EF70 incompleta.');return r.studentsData.length+' aluno(s), '+r.events.length+' evento(s) analisados.'});
 await check(rows,'Comparador EF72 / monitor EF73',function(){var sentinel='__efdiag_sem_aluno__';if(EF72.compare(sentinel)!==null)throw Error('Consulta de comparação vazia não retornou nulo.');if(EF73.student(sentinel)!==null)throw Error('Consulta de monitoramento vazia não retornou nulo.');return'Consultas sem correspondência tratadas sem exceção.'});
 await check(rows,'Worker e motores auxiliares',function(){var stats=[EF63.stats(),EF64.stats(),EF65.stats(),EF66.stats()];if(stats.some(function(x){return !x||typeof x!=='object'}))throw Error('Um ou mais motores não devolveram estado.');var pending=stats.some(function(x){return Number(x.pending||0)>0||Number(x.active||0)>0});return pending?'APIs responsivas; há tarefa de cálculo ainda em andamento.':'Quatro motores responderam; estado consultado sem executar cálculo em lote.'});
 await check(rows,'Interface e impressão',function(){var ids=['tab-btn-lab77','tab-lab77','ef77-out','tab-comparison','single-print-wrapper','ef77-print','tab-painel','history-list-grid'];var missing=ids.filter(function(id){return !$(id)});if(missing.length)throw Error('Elementos essenciais ausentes: '+missing.join(', '));if(typeof window.switchTab!=='function')throw Error('Navegação entre abas não disponível.');if(!EF77.exportPDF1||typeof EF77.exportPDF1!=='function')throw Error('Exportação PDF do Lab indisponível.');return ids.length+' elementos essenciais e ação de PDF presentes.'});

 // Verificações adicionais: somente leitura e nunca expõem informações dos alunos.
 await check(rows,'Formulários: modelos e níveis',function(){
  var api=window.EF2Forms;if(!api||typeof api.presets!=='function')throw Error('Módulo de Formulários não carregado.');
  var list=api.presets();if(!Array.isArray(list)||list.length<9)throw Error('Biblioteca de modelos incompleta.');
  var ids=new Set(list.map(x=>x.id));if(ids.size!==list.length)throw Error('IDs de modelos duplicados.');
  var levels=['iniciante','intermediario','avancado'];if(levels.some(level=>!list.some(x=>x.level===level)))throw Error('Nível de anamnese ausente.');
  return list.length+' modelos verificados nos três níveis, sem modificar perguntas.';
 });
 await check(rows,'Anamneses: vínculo por ID de cadastro',function(){
  var api=window.EF2Forms,st=api?.getState?.(),cl=api?.clients?.();
  if(!st||!Array.isArray(st.responses)||!Array.isArray(cl))throw Error('Histórico de anamneses indisponível.');
  var unique=new Set(cl.map(c=>c.id));if(unique.size!==cl.length)throw Error('Identificadores de cadastro repetidos.');
  var miss=st.responses.filter(r=>!r.clientId||!unique.has(r.clientId));
  if(miss.length)return{status:'warn',detail:miss.length+' resposta(s) sem vínculo resolvido; revisão manual necessária. Nenhum dado será apagado.'};
  return st.responses.length+' resposta(s) vinculada(s) por ID; '+cl.length+' aluno(s) localizados.';
 });
 await check(rows,'Ficha do aluno: atalho de anamneses',function(){
  if(typeof window.EF2Forms?.openForClient!=='function')throw Error('Abertura de anamneses pelo perfil não disponível.');
  if(!$('patient-view-content'))return{status:'warn',detail:'A ficha do aluno não está aberta; o atalho será verificado quando acessada.'};
  return'API de vínculo com o perfil ativa; abertura da ficha não foi forçada.';
 });
 await check(rows,'Formulários: editor e PDF preenchível',function(){
  var x=window.EF2Forms;if(typeof x?.pdfForm!=='function'||typeof x?.exportFormPDF!=='function')throw Error('Exportação PDF do formulário indisponível.');
  if(!$('tab-ef-forms')||!$('tab-btn-ef-forms'))throw Error('Navegação de Formulários incompleta.');
  return'Editor, navegação e geração de PDF presentes (sem exportar informações reais).';
 });
 await check(rows,'Anamneses: proteção de respostas',function(){
  var x=window.EF2Forms,st=x?.getState?.();if(!st)throw Error('Estado das anamneses indisponível.');
  if(window.EF_Security?.isConfigured?.()&&!window.EF_Security.key)return{status:'warn',detail:'O cofre está bloqueado; desbloqueie para salvar ou acessar respostas protegidas.'};
  if(!window.EF_Security?.isConfigured?.())return{status:'warn',detail:'Cofre não configurado: não há persistência protegida das anamneses. Faça backup após configurar.'};
  return'Camada de criptografia disponível para respostas.';
 });
 await check(rows,'Agenda: compromissos e datas',function(){
  var key='ef90_home_agenda',raw=localStorage.getItem(key);if(!raw)return'Agenda vazia ou ainda não configurada.';
  var ar=JSON.parse(raw);if(!Array.isArray(ar))throw Error('Estrutura da agenda inválida; não modifique registros antes de exportar backup.');
  var wrong=ar.filter(x=>!x||typeof x!=='object');if(wrong.length)return{status:'warn',detail:wrong.length+' compromisso(s) malformado(s). Corrija com conferência manual e backup.'};
  return ar.length+' compromisso(s) reconhecido(s).';
 });
 await check(rows,'Agenda: comandos do calendário',function(){
  var api=['ef90PickDay','ef90JumpToday','ef90ShiftMonth','ef90SaveAgenda','ef90ExportAgenda'];
  var missing=api.filter(x=>typeof window[x]!=='function');if(missing.length)throw Error('Funções ausentes: '+missing.join(', '));
  return'Calendário, agendamento e exportação acessíveis (sem criar compromissos).';
 });
 await check(rows,'Notificações: preferências e permissões',function(){
  var n=window.EFNotifications;if(!n||typeof n.getSettings!=='function')throw Error('Módulo de lembretes não está carregado.');
  var cfg=n.getSettings();if(!cfg||typeof cfg.reminders!=='boolean')throw Error('Preferências de lembrete inválidas.');
  if(typeof window.Notification==='undefined')return{status:'warn',detail:'Este navegador não disponibiliza notificações do sistema; lembretes locais dependem do app aberto.'};
  return'Preferências válidas; notificações em segundo plano não são garantidas.';
 });
 await check(rows,'Cobranças: recebimento de pendências',function(){
  var c=window.EFCobranca;if(!c||typeof c.alternarStatusNoHistorico!=='function'||typeof c.salvarCobrancaNoHistorico!=='function')throw Error('Comandos de recebimento ou salvamento ausentes.');
  if(!$('tab-cobranca'))throw Error('Painel de cobranças não encontrado.');
  return'Rotinas de recebimento, gravação e interface presentes; nenhuma cobrança foi alterada.'; });
 await check(rows,'Cobranças: exportação e integridade',function(){
  var c=window.EFCobranca;if(typeof c?.exportData!=='function'||typeof c?.exportarCsvHistorico!=='function')throw Error('Exportação financeira indisponível.');
  var key='evolufisico_cobrancas_db',raw=localStorage.getItem(key);if(!raw)return'Base financeira ainda não iniciada; funções de exportação disponíveis.';
  var payload=JSON.parse(raw);if(Array.isArray(payload))return{status:'warn',detail:'Histórico financeiro em formato não criptografado. Configure o cofre e faça cópia de segurança.'};
  if(payload&&payload.__efEncrypted&&payload.payload)return'Histórico financeiro protegido; pacote cifrado presente.';
  return{status:'warn',detail:'Formato financeiro não reconhecido; revisar sem apagar ou regravar a base.'};
 });
 await check(rows,'Backup: exportação e restauração',function(){
  if(typeof window.exportarBackupJSON!=='function'||typeof window.importarBackupJSON!=='function'||typeof window.confirmarImportacaoBackup!=='function')throw Error('Backup ou restauração não estão disponíveis.');
  return'Exportação, importação e confirmação de restauração acessíveis; nenhuma operação disparada.';
 });
 await check(rows,'Backup: motor e armazenamento',function(){
  if(!window.EF_BackupEngine||typeof window.EF_BackupEngine!=='object')throw Error('Motor de backup indisponível.');
  if(window.EF_TEMPORARY_STORAGE)return{status:'warn',detail:'Armazenamento temporário detectado neste navegador; faça backup antes de fechar.'};
  return'Motor de backup presente e persistência local aparentemente habilitada.';
 });
 await check(rows,'Cofre: criptografia e bloqueio',function(){
  var api=window.EF_Security;
  if(!api||typeof api.encryptObject!=='function'||typeof api.decryptObject!=='function'||typeof api.lock!=='function')throw Error('API do cofre incompleta.');
  if(!window.crypto||!window.crypto.subtle)return{status:'warn',detail:'Crypto Web não disponível neste contexto. Use origem segura para ativar o cofre.'};
  if(!api.isConfigured())return{status:'warn',detail:'Cofre ainda não configurado. Dados de saúde devem ser protegidos antes do uso real.'};
  return api.key?'Cofre configurado e desbloqueado.':'Cofre configurado e bloqueado corretamente.';
 });
 await check(rows,'IndexedDB: acesso ao banco de dados',async function(){
  if(!window.indexedDB)return{status:'warn',detail:'IndexedDB indisponível; armazenamento pode ser temporário.'};
  if(typeof indexedDB.databases==='function'){
   // Arquivos locais/Android content:// têm origem opaca; consultar databases() pode gerar rejeição não tratada no navegador.
   if(location.origin==='null'||location.protocol==='file:'||location.protocol==='content:')return{status:'warn',detail:'Origem local ou restrita: o catálogo IndexedDB não foi consultado para evitar falhas de permissão. Teste a persistência em HTTPS.'};
   var list;try{list=await indexedDB.databases()}catch(e){return{status:'warn',detail:'A origem do arquivo bloqueou a leitura do catálogo IndexedDB; teste em HTTP/HTTPS. Nenhum banco foi modificado.'}}
   if(!Array.isArray(list))throw Error('Consulta ao catálogo IndexedDB inválida.');return'IndexedDB respondeu à inspeção não destrutiva; '+list.length+' base(s) visível(is).';
  }
  return'IndexedDB existe; o navegador não oferece listagem de bancos sem abrir uma conexão.';
 });
 await check(rows,'Rascunho: integridade do armazenamento',function(){
  if(window.EF_TEMPORARY_STORAGE)return{status:'warn',detail:'Rascunhos em modo temporário; dados podem se perder ao recarregar.'};
  var auto=Object.keys(localStorage).filter(k=>/autosave/i.test(k));for(var k of auto){var v=localStorage.getItem(k);if(v&&v.trim().startsWith('{'))JSON.parse(v)}
  return auto.length+' registro(s) de rascunho localizado(s); JSON sintaticamente válido.';
 });
 await check(rows,'PDF: exportadores disponíveis',function(){
  if(typeof window.EF77?.exportPDF1!=='function'||typeof window.EF2Forms?.exportFormPDF!=='function')throw Error('Algum exportador PDF está ausente.');
  if(!$('single-print-wrapper')||!$('ef77-print'))throw Error('Área de impressão incompleta.');
  return'Gerador do Lab, formulário preenchível e áreas de impressão disponíveis.';
 });
 await check(rows,'Impressão: isolamento visual',function(){
  var printing=window.matchMedia?.('print').matches;
  if(!printing&&(document.body.classList.contains('print-mode-single')||document.body.classList.contains('print-mode-comparison')))return{status:'warn',detail:'Sinalizador de impressão parece não ter sido removido; autocorreção visual pode redefini-lo.'};
  return'Modo de impressão sem classes residuais (não produz nem testa arquivo PDF).';
 });
 await check(rows,'Configurações: seções e diagnóstico',function(){
  if(!window.EFSettings||typeof window.EFSettings.open!=='function')throw Error('Abas de Configurações indisponíveis.');
  if(!$('ef-setting-diagnostics')||!$('efdiag-run'))throw Error('Painel de testes não localizado em Manutenção.');
  if($('tab-btn-diagnostics'))return{status:'warn',detail:'Botão Diagnóstico ainda aparece na navegação principal; revisão visual recomendada.'};
  return'Configurações e diagnóstico organizados em Manutenção.';
 });
 await check(rows,'Navegação: formulário e perfil do aluno',function(){
  if(typeof window.switchTab!=='function')throw Error('Roteador não está disponível.');
  var calc=$('tab-btn-lab77'),forms=$('tab-btn-ef-forms'),nav=document.querySelector('.top-navbar > .nav-tabs');
  if(!calc||!forms||!nav)throw Error('Atalhos de Calculadora ou Formulários ausentes.');
  if(calc.nextElementSibling!==forms)return{status:'warn',detail:'Formulários fora da posição esperada após Calculadora; recomposição do menu disponível.'};
  return'Menu principal organizado, com Formulários após Calculadora.';
 });
 await check(rows,'Temas: paletas e modo escuro',function(){
  var palette=['Verde','Azul','Roxo','Laranja','Rosa'];
  var btns=[...document.querySelectorAll('#ef-setting-appearance button')];
  if(!btns.length)return{status:'warn',detail:'Botões de aparência ainda não montados; reabra Configurações.'};
  return'Controles de aparência disponíveis; paletas originais preservadas.';
 });
 renderRows(rows,typeof repairBanner==='string'?repairBanner:null);running=false;if(b)b.disabled=false;if(fix)fix.disabled=false;return rows;
}
async function safeRepair(){
 if(window.matchMedia?.('print').matches){setStatus('Feche a prévia de impressão antes de reparar.','warn');return}
 if(running)return;running=true;var b=$('efdiag-run'),fix=$('efdiag-repair');if(b)b.disabled=true;if(fix)fix.disabled=true;setStatus('Aplicando reparos seguros…','warn');var ops=[],S=window.__EF63_STATE__;
 try{
  document.body.classList.remove('print-mode-single','print-mode-comparison');
  document.body.classList.add('ef-simple-ui');
  if(!$('tab-lab77')&&window.EF77&&typeof EF77.mount==='function'){EF77.mount();ops.push('remontagem do Lab')}
  if(!$('tab-btn-lab77')){var nav=document.querySelector('.nav-tabs');if(nav){nav.insertAdjacentHTML('beforeend','<button class="nav-tab-btn" id="tab-btn-lab77" type="button" onclick="switchTab(\'tab-lab77\')"><span>🧪</span> <span>Lab</span></button>');ops.push('botão do Lab recriado')}}
  if(!$('ef77-print')){var print=document.createElement('div');print.id='ef77-print';print.setAttribute('aria-hidden','true');document.body.appendChild(print);ops.push('área de impressão do Lab recriada')}
  var invalidators=[['EF63','invalidate'],['EF64','clear'],['EF65','invalidate'],['EF66','invalidate'],['EF67','invalidate'],['EF68','invalidate'],['EF70','invalidate'],['EF71','invalidate'],['EF72','invalidate'],['EF73','invalidate']];
  var cleared=0;
  invalidators.forEach(function(x){var api=window[x[0]],fn=api&&api[x[1]];if(typeof fn==='function'){fn.call(api);cleared++}});
  if(cleared)ops.push(cleared+' caches analíticos limpos');
  if(S&&typeof S.getAvaliacoes==='function')S.getAvaliacoes();
  ensureUI();
  // Reparos apenas visuais: não alteram dados clínicos, agenda, histórico, cofre ou backups.
  var scope=selected();
  if((scope==='all'||scope==='forms')&&window.EF2Forms&&typeof EF2Forms.render==='function'){
    var activeForm=$('tab-ef-forms')?.classList.contains('active');
    var focus=document.activeElement;
    if(activeForm&&($('ef2x-t-title')||document.querySelector('#tab-ef-forms .ef2f-question')||(focus&&focus.closest('#tab-ef-forms input,#tab-ef-forms textarea,#tab-ef-forms select'))))ops.push('Formulários preservados: edição ou respostas em andamento');
    else if(activeForm){EF2Forms.render();ops.push('lista de Formulários e vínculo visual com aluno atualizados')}
  }
  var topNav=document.querySelector('.top-navbar'),tools=$('ef-tools'),sup=$('ef-support-section'),pref=$('ef-preferences-section');
  if(topNav){topNav.scrollLeft=0;topNav.scrollTop=0;}
  if(tools){tools.hidden=false;tools.style.display='';if(topNav&&tools.parentNode!==topNav)topNav.appendChild(tools);}
  [sup,pref].forEach(function(sec){if(sec){sec.hidden=false;sec.style.display='';}});
  if(window.EFSimpleUI){
   if(typeof window.EFSimpleUI.arrangeNavigation==='function')window.EFSimpleUI.arrangeNavigation();
   if(typeof window.EFSimpleUI.arrangeDetails==='function')window.EFSimpleUI.arrangeDetails();
   ops.push('menu lateral e navegação recompostos');
  }
  if(typeof window.atualizarContadorHistorico==='function')window.atualizarContadorHistorico();
  if(typeof window.preencherSeletoresComparacao==='function')window.preencherSeletoresComparacao();
  if(typeof window.renderizarHistorico==='function')window.renderizarHistorico();
  if(typeof window.atualizarBotoesTema==='function')window.atualizarBotoesTema(document.documentElement.classList.contains('ef-dark-mode'));
 }catch(e){ops.push('reparo interrompido: '+(e&&e.message||e))}
 running=false;if(b)b.disabled=false;if(fix)fix.disabled=false;
 var summaryMsg=(ops.length?ops.join('; '):'nenhuma ação de reparo necessária')+'. Dados de avaliações preservados.';
 await runTests(summaryMsg);
 if(typeof window.efToast==='function')window.efToast('🛠 Autocorreção concluída: '+ops.length+' ação(ões) aplicada(s).','ok');
}
function bindButtons(){
 var run=$('efdiag-run'),fix=$('efdiag-repair');
 if(run&&!run.__efdiag){run.addEventListener('click',function(){runTests()});run.__efdiag=true}
 if(fix&&!fix.__efdiag){fix.addEventListener('click',safeRepair);fix.__efdiag=true}
}
function mount(){
 ensureUI();
 var old=window.switchTab;if(typeof old==='function'&&!old.__efdiag){var wrapped=function(id){var r=old.apply(this,arguments);if(id==='tab-diagnostics'){document.querySelectorAll('.nav-tab-btn').forEach(function(x){x.classList.remove('active')});var b=$('tab-btn-diagnostics');if(b)b.classList.add('active')}return r};wrapped.__efdiag=true;window.switchTab=wrapped}
 bindButtons();
}
window.EFDiag={version:'2.1-cards',mounted:true,run:function(){return runTests()},repair:safeRepair,results:function(){return lastResults.slice()},categories:CATS,exportReport:exportReport};
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',mount);else mount();
})();
</script>
<script id="ef-splash-script">/* 21-runtime.js */
/* ===== MÓDULO DE ABERTURA & TRANSIÇÕES ===== */
(function() {
    let splashFechada = false;

    function fecharAbertura() {
        const splash = document.getElementById('ef-splash');
        if (!splash || splashFechada) return;
        splashFechada = true;
        const status = document.getElementById('ef-splash-status');
        if (status) status.textContent = 'Pronto para uso';
        splash.classList.add('dismissed');
        setTimeout(() => {
            splash.style.display = 'none';
            window.dispatchEvent(new Event('ef-splash-finished'));
        }, 500);
    }

    function reabrirAbertura() {
        const splash = document.getElementById('ef-splash');
        if (!splash) return;
        splashFechada = false;
        splash.style.display = 'flex';
        splash.classList.remove('dismissed');
        const status = document.getElementById('ef-splash-status');
        if (status) status.textContent = 'Inicializando módulos clínicos…';
        setTimeout(() => {
            fecharAbertura();
        }, 1150);
    }

    window.fecharAbertura = fecharAbertura;
    window.reabrirAbertura = reabrirAbertura;

    // Auto-fechar após 1.1s para experiência fluida sem espera excessiva
    window.addEventListener('DOMContentLoaded', () => {
        setTimeout(fecharAbertura, 1100);
    });

    // Teclas Esc e Enter fecham a abertura instantaneamente
    window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' || e.key === 'Enter') {
            const splash = document.getElementById('ef-splash');
            if (splash && !splash.classList.contains('dismissed')) {
                fecharAbertura();
            }
        }
    });
})();
</script>
<script id="ef-cobranca-script">/* 22-runtime.js */
/* ==========================================================================
   EVOLUFÍSICO v1.0.30 Pré-Beta — MÓDULO DE COBRANÇA, PRECIFICAÇÃO E HISTÓRICO
   Foco exclusivo na precificação e histórico com Totais e Por Aluno
   ========================================================================== */
(function() {
    'use strict';

    const DB_KEY = 'evolufisico_cobrancas_db';
    let billingCache = null, billingRaw = null;
    async function loadBilling() {
        const raw=localStorage.getItem(DB_KEY);
        if (billingCache && raw===billingRaw) return structuredClone(billingCache);
        if (!raw) { billingCache=[]; billingRaw=raw; return []; }
        let data;
        try { data=JSON.parse(raw); } catch(e) {
            console.warn('[EvoluFísico] Histórico financeiro corrompido:', e);
            billingCache=[]; billingRaw=raw; return [];
        }
        const list=data&&data.__efEncrypted?await EF_Security.decryptObject(data.payload):data;
        if (!Array.isArray(list)) throw new Error('Histórico financeiro inválido. Restaure um backup.');
        billingCache=list;billingRaw=raw;
        return structuredClone(list);
    }


    function esc(v) {
        return String(v == null ? '' : v)
            .replace(/[&<>"']/g, function(c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
    }

    function sanitizeCsv(v) {
        let s = String(v == null ? '' : v).replace(/;/g, ' ').trim();
        if (/^[=+\-@]/.test(s)) {
            s = "'" + s;
        }
        return s;
    }


    function formatarData(dataIso) {
        if (!dataIso) return '—';
        const limpa = String(dataIso).split('T')[0];
        const partes = limpa.split('-');
        if (partes.length === 3) return `${partes[2]}/${partes[1]}/${partes[0]}`;
        return dataIso;
    }

    const state = {
        modalidade: '1', // '1' = Individual, '2' = Dupla
        aluno1: { nome: '' },
        aluno2: { nome: '' },
        servicoId: 'completa',
        servicoNomePersonalizado: '',
        valorBaseUnitario: 150.00,
        data: new Date().toISOString().split('T')[0],
        tipoDesconto: 'porcentagem', // 'porcentagem' | 'valor'
        descontoInput: 0,
        motivoDesconto: '',
        formaPagamento: 'pix', // 'pix' | 'credito' | 'debito' | 'dinheiro'
        parcelasCartao: 1,
        valorDinheiroEntregue: 0,
        statusPagamento: 'pago', // 'pago' | 'pendente'
        dataRecebimento: new Date().toLocaleDateString('en-CA'),
        dataVencimento: new Date().toLocaleDateString('en-CA'),
        
        // Filtros do Histórico
        filtroTexto: '',
        filtroStatus: 'todos', // 'todos' | 'pago' | 'pendente' | 'pix' | 'cartao' | 'dinheiro' | 'dupla' | 'individual'
        visaoHistorico: 'extrato' // 'extrato' | 'alunos'
    };

    const hojeLocal = () => {const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;};
    state.data=hojeLocal();state.dataRecebimento=hojeLocal();state.dataVencimento=hojeLocal();
    function setDataFinanceira(tipo,data) {
        if(!/^\d{4}-\d{2}-\d{2}$/.test(String(data||''))) return;
        if(tipo==='recebimento')state.dataRecebimento=data;
        if(tipo==='vencimento')state.dataVencimento=data;
    }
    const PRECOS_SERVICOS = {
        completa: 150.00,
        reavaliacao: 100.00,
        bioimpedancia: 80.00,
        treino_consultoria: 250.00,
        trimestral: 350.00,
        semestral: 600.00,
        personalizado: 150.00
    };

    function gerarIdCobranca() {
        return 'cob_' + Date.now() + '_' + Math.random().toString(36).substr(2, 8);
    }

    function carregarCobrancas() { return structuredClone(billingCache || []); }
    async function writeBilling(lista, key=EF_Security.key, protectedMode=EF_Security.isConfigured()) {
        if (!Array.isArray(lista)) throw new Error('Histórico financeiro inválido');
        const packet=protectedMode?{__efEncrypted:true,payload:await EF_Security.encryptObject(lista,key)}:lista;
        const raw=JSON.stringify(packet);
        localStorage.setItem(DB_KEY,raw);
        billingRaw=raw;billingCache=structuredClone(lista);
        return true;
    }
    async function salvarCobrancasDb(lista) {
        if (window.EF_Security && EF_Security.isConfigured() && !EF_Security.key) {
            const pass = prompt('🔐 O cofre está protegido. Digite a chave mestra para salvar a cobrança de forma criptografada:');
            if (!pass || !(await EF_Security.unlock(pass))) {
                notificar('Operação cancelada: a cobrança não pôde ser salva com o cofre bloqueado.', 'warning');
                return false;
            }
        }
        try { return await writeBilling(lista); }
        catch(e) { notificar('Não foi possível salvar a cobrança: '+e.message,'error'); return false; }
    }


    function notificar(msg, tipo) {
        if (typeof window.efToast === 'function') {
            window.efToast(msg, tipo || 'info');
        } else if (typeof window !== 'undefined' && typeof window.alert === 'function') {
            window.alert(msg);
        } else if (typeof alert === 'function') {
            alert(msg);
        } else {
            console.log(msg);
        }
    }

    // Modal de confirmação próprio: window.confirm() é bloqueado/ignorado em PWAs instalados
    // e WebViews (retorna false sem mostrar nada), o que impedia a exclusão.
    function confirmar(msg, onConfirm, rotuloOk) {
        const antigo = document.getElementById('cob-confirm-overlay');
        if (antigo) antigo.remove();

        const overlay = document.createElement('div');
        overlay.id = 'cob-confirm-overlay';
        overlay.setAttribute('role', 'dialog');
        overlay.setAttribute('aria-modal', 'true');
        overlay.style.cssText = 'position:fixed;inset:0;z-index:2147483000;background:rgba(15,23,42,.55);display:flex;align-items:center;justify-content:center;padding:1rem;';
        overlay.innerHTML =
            '<div style="background:var(--card-bg,#fff);color:var(--text-main,#0f172a);border-radius:14px;max-width:380px;width:100%;padding:1.25rem;box-shadow:0 20px 50px rgba(0,0,0,.35);">' +
              '<div style="font-weight:700;margin-bottom:.5rem;">Confirmar exclusão</div>' +
              '<div id="cob-confirm-msg" style="font-size:.9rem;line-height:1.4;margin-bottom:1rem;"></div>' +
              '<div style="display:flex;gap:.5rem;justify-content:flex-end;">' +
                '<button type="button" id="cob-confirm-cancel" class="btn btn-secondary btn-sm">Cancelar</button>' +
                '<button type="button" id="cob-confirm-ok" class="btn btn-danger btn-sm"></button>' +
              '</div>' +
            '</div>';
        document.body.appendChild(overlay);
        overlay.querySelector('#cob-confirm-msg').textContent = msg;
        overlay.querySelector('#cob-confirm-ok').textContent = rotuloOk || '🗑️ Excluir';

        const fechar = () => { overlay.remove(); document.removeEventListener('keydown', onKey, true); };
        const onKey = (e) => { if (e.key === 'Escape') fechar(); };
        document.addEventListener('keydown', onKey, true);

        overlay.addEventListener('click', (e) => { if (e.target === overlay) fechar(); });
        overlay.querySelector('#cob-confirm-cancel').addEventListener('click', fechar);
        overlay.querySelector('#cob-confirm-ok').addEventListener('click', () => {
            fechar();
            try { onConfirm(); } catch (err) { console.error(err); }
        });
        overlay.querySelector('#cob-confirm-cancel').focus();
    }

    function formatarMoeda(val) {
        const v = typeof val === 'number' && !isNaN(val) ? val : 0;
        return v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }

    function obterNomeServico() {
        if (state.servicoId === 'personalizado') {
            return state.servicoNomePersonalizado.trim() || 'Serviço Personalizado';
        }
        const sel = document.getElementById('cob_servico_select');
        if (sel && sel.selectedIndex >= 0) {
            return sel.options[sel.selectedIndex].text.split('(')[0].trim();
        }
        return 'Avaliação Física Completa';
    }

    function popularSelectAlunos() {
        let alunosCadastrados = [];
        try {
            if (typeof avaliacoes !== 'undefined' && Array.isArray(avaliacoes)) {
                alunosCadastrados = [...new Set(avaliacoes.map(a => a.nome).filter(Boolean))];
            } else {
                const bkp = localStorage.getItem('avaliacoes') || localStorage.getItem('evolufisico_avaliacoes');
                if (bkp) {
                    const parsed = JSON.parse(bkp);
                    if (Array.isArray(parsed)) {
                        alunosCadastrados = [...new Set(parsed.map(a => a.nome).filter(Boolean))];
                    }
                }
            }
        } catch(e) {
            console.warn('Não foi possível carregar lista de alunos', e);
        }

        const sel1 = document.getElementById('cob_select_aluno1');
        const sel2 = document.getElementById('cob_select_aluno2');
        if (!sel1 || !sel2) return;

        let opts = '<option value="">-- Selecione um aluno cadastrado --</option>';
        alunosCadastrados.sort().forEach(nome => {
            opts += `<option value="${esc(nome)}">${esc(nome)}</option>`;
        });
        opts += '<option value="__manual__">➕ Outro (Digitar manualmente)</option>';

        sel1.innerHTML = opts;
        sel2.innerHTML = opts;
    }

    function aoSelecionarAluno(alunoNum, valor) {
        if (valor === '__manual__' || !valor) {
            const inputNome = document.getElementById(alunoNum === 1 ? 'cob_nome1' : 'cob_nome2');
            if (inputNome && valor === '__manual__') {
                inputNome.value = '';
                inputNome.focus();
            }
            if (alunoNum === 1) state.aluno1.nome = inputNome ? inputNome.value : '';
            else state.aluno2.nome = inputNome ? inputNome.value : '';
            recalcularEAtualizarUI();
            return;
        }

        if (alunoNum === 1) {
            state.aluno1.nome = valor;
            const in1 = document.getElementById('cob_nome1');
            if (in1) in1.value = valor;
        } else {
            state.aluno2.nome = valor;
            const in2 = document.getElementById('cob_nome2');
            if (in2) in2.value = valor;
        }

        recalcularEAtualizarUI();
    }

    function setModalidade(mod) {
        state.modalidade = mod === '2' ? '2' : '1';

        const btn1 = document.getElementById('cob-btn-pessoa-1');
        const btn2 = document.getElementById('cob-btn-pessoa-2');
        const bannerDuo = document.getElementById('cob-duo-alert');
        const aluno2Wrap = document.getElementById('cob-aluno2-wrapper');
        const badge = document.getElementById('cob-badge-modalidade');

        if (state.modalidade === '2') {
            if (btn1) btn1.classList.remove('active');
            if (btn2) btn2.classList.add('active');
            if (bannerDuo) bannerDuo.classList.remove('hidden');
            if (aluno2Wrap) aluno2Wrap.classList.remove('hidden');
            if (badge) {
                badge.innerText = 'Dupla (2 Alunos)';
                badge.style.background = '#8b5cf6';
                badge.style.color = '#fff';
            }
        } else {
            if (btn1) btn1.classList.add('active');
            if (btn2) btn2.classList.remove('active');
            if (bannerDuo) bannerDuo.classList.add('hidden');
            if (aluno2Wrap) aluno2Wrap.classList.add('hidden');
            if (badge) {
                badge.innerText = 'Individual (1 Aluno)';
                badge.style.background = '';
                badge.style.color = '';
            }
        }

        recalcularEAtualizarUI();
    }

    function aoMudarServico(servicoId) {
        state.servicoId = servicoId;
        const boxCustom = document.getElementById('cob-servico-custom-box');
        if (boxCustom) {
            if (servicoId === 'personalizado') boxCustom.classList.remove('hidden');
            else boxCustom.classList.add('hidden');
        }

        if (PRECOS_SERVICOS[servicoId] !== undefined) {
            state.valorBaseUnitario = PRECOS_SERVICOS[servicoId];
            const inValor = document.getElementById('cob_valor_base');
            if (inValor) inValor.value = state.valorBaseUnitario.toFixed(2);
        }

        recalcularEAtualizarUI();
    }

    function ajustarValorBase(delta) {
        const inValor = document.getElementById('cob_valor_base');
        let atual = parseFloat(inValor ? inValor.value : state.valorBaseUnitario) || 0;
        atual = Math.max(0, atual + delta);
        state.valorBaseUnitario = atual;
        if (inValor) inValor.value = atual.toFixed(2);
        recalcularEAtualizarUI();
    }

    function setTipoDesconto(tipo) {
        state.tipoDesconto = tipo === 'valor' ? 'valor' : 'porcentagem';

        const btnPct = document.getElementById('cob-btn-desc-pct');
        const btnVal = document.getElementById('cob-btn-desc-val');
        const lblInput = document.getElementById('cob-label-desconto-input');

        if (state.tipoDesconto === 'valor') {
            if (btnPct) btnPct.classList.remove('active');
            if (btnVal) btnVal.classList.add('active');
            if (lblInput) lblInput.innerText = 'Desconto Fixo (R$)';
        } else {
            if (btnPct) btnPct.classList.add('active');
            if (btnVal) btnVal.classList.remove('active');
            if (lblInput) lblInput.innerText = 'Desconto (%)';
        }

        recalcularEAtualizarUI();
    }

    function aplicarChipDesconto(valor, tipo, motivo) {
        setTipoDesconto(tipo);
        state.descontoInput = valor;
        state.motivoDesconto = motivo || '';

        const inDesc = document.getElementById('cob_desconto_input');
        if (inDesc) inDesc.value = valor;

        const inMotivo = document.getElementById('cob_desconto_motivo');
        if (inMotivo) inMotivo.value = state.motivoDesconto;

        document.querySelectorAll('.cob-chip').forEach(c => c.classList.remove('active'));
        if (valor === 0 && tipo === 'porcentagem') {
            const c0 = document.getElementById('cob-chip-0');
            if (c0) c0.classList.add('active');
        } else if (valor === 10 && tipo === 'porcentagem') {
            const c10 = document.getElementById('cob-chip-10');
            if (c10) c10.classList.add('active');
        } else if (valor === 15 && tipo === 'porcentagem') {
            const c15 = document.getElementById('cob-chip-15');
            if (c15) c15.classList.add('active');
        } else if (valor === 20 && tipo === 'porcentagem') {
            const c20 = document.getElementById('cob-chip-20');
            if (c20) c20.classList.add('active');
        } else if (valor === 25 && tipo === 'porcentagem') {
            const c25 = document.getElementById('cob-chip-25');
            if (c25) c25.classList.add('active');
        } else if (valor === 30 && tipo === 'valor') {
            const cfid = document.getElementById('cob-chip-fidelidade');
            if (cfid) cfid.classList.add('active');
        } else if (valor === 100 && tipo === 'porcentagem') {
            const c100 = document.getElementById('cob-chip-100');
            if (c100) c100.classList.add('active');
        }

        recalcularEAtualizarUI();
    }

    function aplicarDescontoDuplaPadrao() {
        aplicarChipDesconto(15, 'porcentagem', 'Combo Especial Dupla (15% OFF)');
    }

    function setStatusPagamento(status) {
        state.statusPagamento = status === 'pendente' ? 'pendente' : 'pago';
        const btnPago = document.getElementById('cob-hero-status-pago');
        const btnPendente = document.getElementById('cob-hero-status-pendente');

        if (state.statusPagamento === 'pago') {
            if (btnPago) btnPago.classList.add('active');
            if (btnPendente) btnPendente.classList.remove('active');
        } else {
            if (btnPago) btnPago.classList.remove('active');
            if (btnPendente) btnPendente.classList.add('active');
        }
        const recebido=document.getElementById('cob-finance-paid-date');
        const vencimento=document.getElementById('cob-finance-due-date');
        if(recebido)recebido.hidden=state.statusPagamento!=='pago';
        if(vencimento)vencimento.hidden=state.statusPagamento==='pago';
    }

    function setFormaPagamento(forma) {
        state.formaPagamento = ['pix', 'credito', 'debito', 'dinheiro'].includes(forma) ? forma : 'pix';

        ['pix', 'credito', 'debito', 'dinheiro'].forEach(f => {
            const btn = document.getElementById(`cob-pay-btn-${f}`);
            if (btn) {
                if (f === state.formaPagamento) btn.classList.add('active');
                else btn.classList.remove('active');
            }
        });

        const detailCredito = document.getElementById('cob-pay-detail-credito');
        const detailDinheiro = document.getElementById('cob-pay-detail-dinheiro');

        if (detailCredito) {
            if (state.formaPagamento === 'credito') detailCredito.classList.remove('hidden');
            else detailCredito.classList.add('hidden');
        }

        if (detailDinheiro) {
            if (state.formaPagamento === 'dinheiro') detailDinheiro.classList.remove('hidden');
            else detailDinheiro.classList.add('hidden');
        }

        atualizarResumoParcelasETroco();
    }

    function aoMudarParcelas(num) {
        state.parcelasCartao = Math.max(1, parseInt(num) || 1);
        atualizarResumoParcelasETroco();
    }

    function calcularTroco() {
        const inTroco = document.getElementById('cob_dinheiro_recebido');
        const entregue = parseFloat(inTroco ? inTroco.value : 0) || 0;
        state.valorDinheiroEntregue = entregue;

        const vals = calcularValores();
        const displayTroco = document.getElementById('cob-troco-display');
        if (displayTroco) {
            if (entregue > 0) {
                const troco = Math.max(0, entregue - vals.totalFinal);
                if (entregue < vals.totalFinal) {
                    displayTroco.innerText = `Faltam: ${formatarMoeda(vals.totalFinal - entregue)}`;
                    displayTroco.style.color = '#ef4444';
                } else {
                    displayTroco.innerText = `Troco: ${formatarMoeda(troco)}`;
                    displayTroco.style.color = '#4ade80';
                }
            } else {
                displayTroco.innerText = 'Troco: R$ 0,00';
                displayTroco.style.color = '#4ade80';
            }
        }
    }

    function atualizarResumoParcelasETroco() {
        const vals = calcularValores();
        const resParcela = document.getElementById('cob-parcela-resumo');
        if (resParcela) {
            const p = state.parcelasCartao || 1;
            const valorParcela = vals.totalFinal > 0 ? (vals.totalFinal / p) : 0;
            resParcela.innerText = `${p}x de ${formatarMoeda(valorParcela)}${p === 1 ? ' (à vista)' : ''}`;
        }
        calcularTroco();
    }


    function calcularValores() {
        const qPessoas = state.modalidade === '2' ? 2 : 1;
        const subtotal = Math.round(state.valorBaseUnitario * qPessoas * 100) / 100;
        
        let valorDesconto = 0;
        if (state.tipoDesconto === 'porcentagem') {
            const pct = Math.min(100, Math.max(0, state.descontoInput));
            valorDesconto = Math.round((subtotal * (pct / 100)) * 100) / 100;
        } else {
            valorDesconto = Math.min(subtotal, Math.max(0, state.descontoInput));
            valorDesconto = Math.round(valorDesconto * 100) / 100;
        }

        const totalFinal = Math.max(0, Math.round((subtotal - valorDesconto) * 100) / 100);
        const valorPorPessoa = qPessoas === 2 ? Math.round((totalFinal / 2) * 100) / 100 : totalFinal;

        return {
            qPessoas,
            subtotal,
            valorDesconto,
            descontoPct: subtotal > 0 ? (valorDesconto / subtotal) * 100 : 0,
            totalFinal,
            valorPorPessoa
        };
    }

    function recalcularEAtualizarUI() {
        const in1 = document.getElementById('cob_nome1');
        if (in1) state.aluno1.nome = in1.value;

        const in2 = document.getElementById('cob_nome2');
        if (in2) state.aluno2.nome = in2.value;

        const inCustom = document.getElementById('cob_servico_nome_custom');
        if (inCustom) state.servicoNomePersonalizado = inCustom.value;

        const inBase = document.getElementById('cob_valor_base');
        if (inBase) state.valorBaseUnitario = Math.max(0, parseFloat(inBase.value) || 0);

        const inData = document.getElementById('cob_data');
        if (inData) state.data = inData.value || new Date().toISOString().split('T')[0];

        const inDesc = document.getElementById('cob_desconto_input');
        if (inDesc) state.descontoInput = Math.max(0, parseFloat(inDesc.value) || 0);

        const inMotivo = document.getElementById('cob_desconto_motivo');
        if (inMotivo) state.motivoDesconto = inMotivo.value;

        const vals = calcularValores();

        // Atualizar Hero Card
        const heroSubtotal = document.getElementById('cob-hero-subtotal');
        if (heroSubtotal) heroSubtotal.innerText = formatarMoeda(vals.subtotal);

        const heroQtd = document.getElementById('cob-hero-qtd-lbl');
        if (heroQtd) heroQtd.innerText = vals.qPessoas === 2 ? '2 pessoas' : '1 pessoa';

        const heroDesconto = document.getElementById('cob-hero-desconto');
        if (heroDesconto) {
            heroDesconto.innerText = vals.valorDesconto > 0 
                ? `- ${formatarMoeda(vals.valorDesconto)} (${vals.descontoPct.toFixed(1)}%)`
                : '- R$ 0,00';
        }

        const heroTotal = document.getElementById('cob-hero-total');
        if (heroTotal) heroTotal.innerText = formatarMoeda(vals.totalFinal);

        // VALOR POR ALUNO
        const heroPerPerson = document.getElementById('cob-hero-per-person');
        if (heroPerPerson) heroPerPerson.innerText = formatarMoeda(vals.valorPorPessoa);

        const heroPerStudentDesc = document.getElementById('cob-hero-per-student-desc');
        if (heroPerStudentDesc) {
            heroPerStudentDesc.innerText = vals.qPessoas === 2 
                ? 'Rateio igualitário (50% para cada aluno)' 
                : 'Atendimento individual (1 aluno)';
        }

        // Badge desconto
        const badgeDesc = document.getElementById('cob-badge-desconto-aplicado');
        if (badgeDesc) {
            if (vals.valorDesconto > 0) {
                badgeDesc.innerText = `${vals.descontoPct.toFixed(0)}% OFF`;
                badgeDesc.style.background = '#ef4444';
                badgeDesc.style.color = '#fff';
            } else {
                badgeDesc.innerText = '0% off';
                badgeDesc.style.background = '';
                badgeDesc.style.color = '';
            }
        }

        atualizarResumoParcelasETroco();
    }

    async function salvarCobrancaNoHistorico() {
        await loadBilling();
        recalcularEAtualizarUI();

        const nome1 = state.aluno1.nome.trim();
        if (!nome1) {
            notificar('Por favor, informe o nome do aluno principal para registrar a cobrança.', 'warning');
            const in1 = document.getElementById('cob_nome1');
            if (in1) in1.focus();
            return;
        }

        let nome2 = '';
        if (state.modalidade === '2') {
            nome2 = state.aluno2.nome.trim();
            if (!nome2) {
                notificar('Por favor, informe o nome do 2º aluno na modalidade em dupla.', 'warning');
                const in2 = document.getElementById('cob_nome2');
                if (in2) in2.focus();
                return;
            }
        }

        if (state.statusPagamento==='pago' && (!state.dataRecebimento || state.dataRecebimento>hojeLocal())) {
            notificar('Informe uma data de recebimento válida, não futura.', 'warning');return;
        }
        const vals = calcularValores();
        const nova = {
            id: gerarIdCobranca(),
            data: state.data || new Date().toISOString().split('T')[0],
            modalidade: state.modalidade, // '1' ou '2'
            qPessoas: vals.qPessoas,
            aluno1: { nome: nome1 },
            aluno2: state.modalidade === '2' ? { nome: nome2 } : null,
            servicoId: state.servicoId,
            servicoNome: obterNomeServico(),
            valorBaseUnitario: state.valorBaseUnitario,
            subtotal: vals.subtotal,
            tipoDesconto: state.tipoDesconto,
            descontoInput: state.descontoInput,
            valorDesconto: vals.valorDesconto,
            motivoDesconto: state.motivoDesconto,
            valorTotal: vals.totalFinal,
            valorPorAluno: vals.valorPorPessoa,
            formaPagamento: state.formaPagamento || 'pix',
            parcelasCartao: state.formaPagamento === 'credito' ? (state.parcelasCartao || 1) : 1,
            status: state.statusPagamento, // 'pago' ou 'pendente'
            recebidoEm: state.statusPagamento === 'pago' ? state.dataRecebimento : null,
            vencimento: state.statusPagamento === 'pendente' ? state.dataVencimento : state.data,
            createdAt: new Date().toISOString()
        };

        const lista = carregarCobrancas();
        lista.unshift(nova);
        if (!await salvarCobrancasDb(lista)) return;

        renderizarHistoricoCompleto();

        if (typeof window.efToast === 'function') {
            window.efToast(`✅ Cobrança de ${formatarMoeda(nova.valorTotal)} registrada com sucesso!`, 'success');
        } else {
            notificar(`✅ Cobrança de ${formatarMoeda(nova.valorTotal)} (${formatarMoeda(nova.valorPorAluno)} por aluno) registrada no histórico!`);
        }
    }

    async function alternarStatusNoHistorico(id) {
        await loadBilling();
        const alvo = String(id);
        const lista = carregarCobrancas();
        const item = lista.find(c => String(c.id) === alvo);
        if (!item) return;

        item.status = item.status === 'pago' ? 'pendente' : 'pago';
        item.recebidoEm = item.status === 'pago' ? hojeLocal() : null;
        if (!await salvarCobrancasDb(lista)) return;
        renderizarHistoricoCompleto();
    }

    function excluirCobrancaDoHistorico(id) {
        const alvo = String(id);
        confirmar('Deseja realmente excluir este registro de cobrança do histórico?', async function() {
            await loadBilling();
            const lista = carregarCobrancas();
            const nova = lista.filter(c => String(c.id) !== alvo);
            if (nova.length === lista.length) {
                notificar('Registro não encontrado (já foi excluído?).', 'warning');
                renderizarHistoricoCompleto();
                return;
            }
            if (!await salvarCobrancasDb(nova)) return;
            renderizarHistoricoCompleto();
            notificar('🗑️ Cobrança excluída com sucesso!', 'info');
        });
    }

    async function limparTodoHistorico() {
        await loadBilling();
        const lista = carregarCobrancas();
        if (lista.length === 0) {
            notificar('O histórico já está vazio.', 'info');
            return;
        }
        confirmar(`Tem certeza que deseja apagar todos os ${lista.length} registros de cobrança? Esta ação não pode ser desfeita.`, async function() {
            await loadBilling();
            if (!await salvarCobrancasDb([])) return;
            renderizarHistoricoCompleto();
            notificar('🗑️ Histórico de cobranças limpo.', 'info');
        }, '🗑️ Apagar tudo');
    }

    function setFiltroStatus(status) {
        state.filtroStatus = status;
        ['todos', 'pago', 'pendente', 'pix', 'cartao', 'dinheiro', 'dupla', 'individual'].forEach(s => {
            const b = document.getElementById(`cob-filter-btn-${s}`);
            if (b) {
                if (s === status) b.classList.add('active');
                else b.classList.remove('active');
            }
        });
        renderizarHistoricoCompleto();
    }

    function setVisaoHistorico(visao) {
        state.visaoHistorico = visao;
        const bExtrato = document.getElementById('cob-view-btn-extrato');
        const bAlunos = document.getElementById('cob-view-btn-alunos');
        const wrapExtrato = document.getElementById('cob-view-extrato-wrapper');
        const wrapAlunos = document.getElementById('cob-view-alunos-wrapper');

        if (visao === 'alunos') {
            if (bExtrato) bExtrato.classList.remove('active');
            if (bAlunos) bAlunos.classList.add('active');
            if (wrapExtrato) wrapExtrato.classList.add('hidden');
            if (wrapAlunos) wrapAlunos.classList.remove('hidden');
        } else {
            if (bExtrato) bExtrato.classList.add('active');
            if (bAlunos) bAlunos.classList.remove('active');
            if (wrapExtrato) wrapExtrato.classList.remove('hidden');
            if (wrapAlunos) wrapAlunos.classList.add('hidden');
        }

        renderizarHistoricoCompleto();
    }

    function filtrarHistorico() {
        const inBusca = document.getElementById('cob-busca-historico');
        if (inBusca) state.filtroTexto = inBusca.value.toLowerCase().trim();
        renderizarHistoricoCompleto();
    }

    function obterRegistrosFiltrados() {
        const lista = carregarCobrancas();
        return lista.filter(c => {
            // Filtro de status / modalidade / forma de pagamento
            if (state.filtroStatus === 'pago' && c.status !== 'pago') return false;
            if (state.filtroStatus === 'pendente' && c.status !== 'pendente') return false;
            if (state.filtroStatus === 'pix' && c.formaPagamento !== 'pix') return false;
            if (state.filtroStatus === 'cartao' && c.formaPagamento !== 'credito' && c.formaPagamento !== 'debito') return false;
            if (state.filtroStatus === 'dinheiro' && c.formaPagamento !== 'dinheiro') return false;
            if (state.filtroStatus === 'dupla' && c.modalidade !== '2') return false;
            if (state.filtroStatus === 'individual' && c.modalidade === '2') return false;

            // Filtro de texto livre
            if (state.filtroTexto) {
                const termo = state.filtroTexto;
                const nome1 = (c.aluno1 && c.aluno1.nome ? c.aluno1.nome : '').toLowerCase();
                const nome2 = (c.aluno2 && c.aluno2.nome ? c.aluno2.nome : '').toLowerCase();
                const serv = (c.servicoNome || '').toLowerCase();
                const dataFormatada = formatarData(c.data).toLowerCase();
                if (!nome1.includes(termo) && !nome2.includes(termo) && !serv.includes(termo) && !dataFormatada.includes(termo)) {
                    return false;
                }
            }
            return true;
        });
    }

    function renderizarHistoricoCompleto() {
        if(window.EFBillingMonthly?.refresh) queueMicrotask(()=>window.EFBillingMonthly.refresh());
        const todas = carregarCobrancas();
        const filtradas = obterRegistrosFiltrados();

        // 1. Atualizar KPIs Gerais com Totais e Por Aluno
        atualizarKpis(todas);

        // Atualizar Badge de Contagem
        const countBadge = document.getElementById('cob-history-total-count');
        if (countBadge) {
            countBadge.innerText = `${filtradas.length} de ${todas.length} registro(s)`;
        }

        const emptyBox = document.getElementById('cob-history-empty');
        const wrapExtrato = document.getElementById('cob-view-extrato-wrapper');
        const wrapAlunos = document.getElementById('cob-view-alunos-wrapper');

        if (todas.length === 0) {
            if (emptyBox) emptyBox.classList.remove('hidden');
            if (wrapExtrato) wrapExtrato.classList.add('hidden');
            if (wrapAlunos) wrapAlunos.classList.add('hidden');
            return;
        }

        if (emptyBox) emptyBox.classList.add('hidden');
        if (state.visaoHistorico === 'alunos') {
            if (wrapExtrato) wrapExtrato.classList.add('hidden');
            if (wrapAlunos) wrapAlunos.classList.remove('hidden');
            renderizarTabelaAlunos(filtradas);
        } else {
            if (wrapExtrato) wrapExtrato.classList.remove('hidden');
            if (wrapAlunos) wrapAlunos.classList.add('hidden');
            renderizarTabelaExtrato(filtradas);
        }
    }

    function atualizarKpis(cobrancas) {
        let totalPago = 0;
        let totalPendente = 0;
        let countPago = 0;
        let countPendente = 0;
        let somaAlunos = 0;
        let acumulado = 0;
        const mesAtual=hojeLocal().slice(0,7);
        const setAlunosUnicos = new Set();

        cobrancas.forEach(c => {
            const vTotal = Number(c.valorTotal) || 0;
            acumulado += vTotal;
            const qP = Number(c.qPessoas) || (c.modalidade === '2' ? 2 : 1);
            somaAlunos += qP;

            if (c.aluno1 && c.aluno1.nome) setAlunosUnicos.add(c.aluno1.nome.trim().toLowerCase());
            if (c.aluno2 && c.aluno2.nome) setAlunosUnicos.add(c.aluno2.nome.trim().toLowerCase());

            if (c.status === 'pago') {
                if (String(c.recebidoEm || c.data || c.createdAt || '').slice(0,7) === mesAtual) { totalPago += vTotal; countPago++; }
            } else if (String(c.vencimento || c.data || '').slice(0,7) === mesAtual) {
                totalPendente += vTotal;countPendente++;
            }
        });

        const totalGeral = acumulado;
        const ticketMedio = somaAlunos > 0 ? (totalGeral / somaAlunos) : 0;

        const kpiPago = document.getElementById('cob-kpi-faturado-mes');
        if (kpiPago) kpiPago.innerText = formatarMoeda(totalPago);

        const kpiPagoQtd = document.getElementById('cob-kpi-faturado-qtd');
        if (kpiPagoQtd) kpiPagoQtd.innerText = `${countPago} recebimento(s) pago(s)`;

        const kpiPend = document.getElementById('cob-kpi-pendente-mes');
        if (kpiPend) kpiPend.innerText = formatarMoeda(totalPendente);

        const kpiPendQtd = document.getElementById('cob-kpi-pendente-qtd');
        if (kpiPendQtd) kpiPendQtd.innerText = `${countPendente} cobrança(s) pendente(s)`;

        const kpiGeral = document.getElementById('cob-kpi-total-geral');
        if (kpiGeral) kpiGeral.innerText = formatarMoeda(totalGeral);

        const kpiTicket = document.getElementById('cob-kpi-ticket-medio');
        if (kpiTicket) kpiTicket.innerText = formatarMoeda(ticketMedio);

        const kpiTicketSub = document.getElementById('cob-kpi-ticket-sub');
        if (kpiTicketSub) kpiTicketSub.innerText = `Média por aluno (${somaAlunos} atendimentos)`;

        const kpiAlunos = document.getElementById('cob-kpi-total-alunos');
        if (kpiAlunos) kpiAlunos.innerText = setAlunosUnicos.size;

        const kpiAvalSub = document.getElementById('cob-kpi-total-avaliacoes-sub');
        if (kpiAvalSub) kpiAvalSub.innerText = `${cobrancas.length} cobranças registradas`;
    }

    
    function obterBadgeFormaPagamento(forma, parcelas) {
        if (forma === 'credito') {
            const p = parcelas > 1 ? ` (${parcelas}x)` : '';
            return `<span class="tag" style="background:#f5f3ff; color:#6d28d9; border:1px solid #ddd6fe;">💳 Crédito${p}</span>`;
        }
        if (forma === 'debito') {
            return `<span class="tag" style="background:#f0fdf4; color:#15803d; border:1px solid #bbf7d0;">💳 Débito</span>`;
        }
        if (forma === 'dinheiro') {            return `<span class="tag" style="background:#fefce8; color:#a16207; border:1px solid #fef08a;">💵 Dinheiro</span>`;
        }
        return `<span class="tag" style="background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe;">📱 Pix</span>`;
    }

    function renderizarTabelaExtrato(cobrancas) {
        const tbody = document.getElementById('cob-history-tbody');
        const tfoot = document.getElementById('cob-history-tfoot');
        if (!tbody) return;

        if (cobrancas.length === 0) {
            tbody.innerHTML = `<tr><td colspan="9" style="text-align:center; padding:2rem; color:var(--text-muted);">Nenhum lançamento encontrado com os filtros selecionados.</td></tr>`;
            if (tfoot) tfoot.innerHTML = '';
            return;
        }

        let somaTotalVisivel = 0;
        let somaAlunosVisiveis = 0;
        let html = '';

        cobrancas.forEach(c => {
            const vTotal = Number(c.valorTotal) || 0;
            const vPorAluno = Number(c.valorPorAluno) || (c.qPessoas === 2 ? vTotal / 2 : vTotal);
            somaTotalVisivel += vTotal;
            somaAlunosVisiveis += (c.qPessoas || (c.modalidade === '2' ? 2 : 1));

            const isDupla = c.modalidade === '2';
            const nome1 = c.aluno1 && c.aluno1.nome ? esc(c.aluno1.nome) : '—';
            const nome2 = c.aluno2 && c.aluno2.nome ? esc(c.aluno2.nome) : '';

            let nomesHtml = `<div style="font-weight:700; color:var(--text-main);">👤 ${nome1}</div>`;
            if (isDupla) {
                nomesHtml = `
                    <div style="font-weight:700; color:var(--text-main);">👥 ${nome1}</div>
                    <div style="font-size:0.78rem; color:var(--text-muted); margin-top:2px;">&amp; ${nome2}</div>
                `;
            }

            const statusClass = c.status === 'pago' ? 'pago' : 'pendente';
            const statusLabel = c.status === 'pago' ? '🟢 Pago' : '🟡 Pendente';

            html += `
                <tr>
                    <td style="white-space:nowrap; font-variant-numeric:tabular-nums; color:var(--text-muted);">${formatarData(c.data)}</td>
                    <td>${nomesHtml}</td>
                    <td>
                        <span class="tag" style="${isDupla ? 'background:#8b5cf6; color:#fff;' : ''}">
                            ${isDupla ? '👥 Dupla (2x)' : '👤 Individual'}
                        </span>
                    </td>
                    <td>
                        <div style="font-weight:600;">${esc(c.servicoNome || 'Avaliação')}</div>
                        ${c.motivoDesconto ? `<small style="color:var(--text-muted); font-size:0.72rem;">🏷️ ${esc(c.motivoDesconto)}</small>` : ''}
                    </td>
                    <td>
                        <span class="cob-badge-total">${formatarMoeda(vTotal)}</span>
                    </td>
                    <td>
                        <span class="cob-badge-per-aluno">
                            ${formatarMoeda(vPorAluno)} / aluno
                        </span>
                    </td>
                    <td>
                        ${obterBadgeFormaPagamento(c.formaPagamento, c.parcelasCartao)}
                    </td>
                    <td>
                        <button type="button" class="cob-status-pill ${statusClass}" data-cob-action="toggle" data-cob-id="${esc(c.id)}" title="Clique para alternar entre Pago e Pendente">
                            ${statusLabel}
                        </button>
                    </td>
                    <td style="text-align:right; white-space:nowrap;">
                        <button type="button" class="btn btn-danger btn-sm cob-btn-excluir" data-cob-action="delete" data-cob-id="${esc(c.id)}" title="Excluir esta cobrança" aria-label="Excluir esta cobrança">
                            🗑️ Excluir
                        </button>
                    </td>
                </tr>
            `;
        });

        tbody.innerHTML = html;

        // Rodapé com Totais da Visualização
        if (tfoot) {
            const mediaPorAlunoVisivel = somaAlunosVisiveis > 0 ? (somaTotalVisivel / somaAlunosVisiveis) : 0;
            tfoot.innerHTML = `
                <tr>
                    <td colspan="2" style="font-size:0.84rem; text-transform:uppercase; letter-spacing:0.04em;">
                        📊 Totais da Visualização:
                    </td>
                    <td colspan="2" style="font-size:0.84rem; color:var(--text-muted);">
                        ${cobrancas.length} cobrança(s) &bull; ${somaAlunosVisiveis} aluno(s)
                    </td>
                    <td style="color:#007aff; font-size:1.05rem;">
                        ${formatarMoeda(somaTotalVisivel)}
                    </td>
                    <td style="color:#047857; font-size:0.92rem;">
                        ${formatarMoeda(mediaPorAlunoVisivel)} / aluno
                    </td>
                    <td style="font-size:0.75rem; color:var(--text-muted);">
                        —
                    </td>
                    <td colspan="2" style="text-align:right; font-size:0.75rem; color:var(--text-muted);">
                        Clique no status para alterar
                    </td>
                </tr>
            `;
        }
    }

    function renderizarTabelaAlunos(cobrancas) {
        const tbody = document.getElementById('cob-alunos-tbody');
        const tfoot = document.getElementById('cob-alunos-tfoot');
        if (!tbody) return;

        const mapaAlunos = {};

        cobrancas.forEach(c => {
            const vPorAluno = Number(c.valorPorAluno) || (Number(c.valorTotal) / (c.qPessoas || 1));

            // Aluno 1
            if (c.aluno1 && c.aluno1.nome) {
                const n1 = c.aluno1.nome.trim();
                if (!mapaAlunos[n1]) {
                    mapaAlunos[n1] = { nome: n1, avaliacoes: 0, pago: 0, pendente: 0, total: 0 };
                }
                mapaAlunos[n1].avaliacoes++;
                if (c.status === 'pago') mapaAlunos[n1].pago += vPorAluno;
                else mapaAlunos[n1].pendente += vPorAluno;
                mapaAlunos[n1].total += vPorAluno;
            }

            // Aluno 2 (se dupla)
            if (c.modalidade === '2' && c.aluno2 && c.aluno2.nome) {
                const n2 = c.aluno2.nome.trim();
                if (!mapaAlunos[n2]) {
                    mapaAlunos[n2] = { nome: n2, avaliacoes: 0, pago: 0, pendente: 0, total: 0 };
                }
                mapaAlunos[n2].avaliacoes++;
                if (c.status === 'pago') mapaAlunos[n2].pago += vPorAluno;
                else mapaAlunos[n2].pendente += vPorAluno;
                mapaAlunos[n2].total += vPorAluno;
            }
        });

        const listaAlunos = Object.values(mapaAlunos);
        if (listaAlunos.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:2rem; color:var(--text-muted);">Nenhum aluno encontrado para consolidar.</td></tr>`;
            if (tfoot) tfoot.innerHTML = '';
            return;
        }

        listaAlunos.sort((a, b) => b.total - a.total);

        let somaPago = 0;
        let somaPend = 0;
        let somaGeral = 0;
        let somaAval = 0;
        let html = '';

        listaAlunos.forEach(item => {
            somaPago += item.pago;
            somaPend += item.pendente;
            somaGeral += item.total;
            somaAval += item.avaliacoes;

            const mediaAval = item.avaliacoes > 0 ? (item.total / item.avaliacoes) : 0;
            const emDia = item.pendente <= 0.001;

            html += `
                <tr>
                    <td style="font-weight:700; color:var(--text-main);">
                        👤 ${esc(item.nome)}
                    </td>
                    <td style="text-align:center; font-variant-numeric:tabular-nums; font-weight:600;">
                        ${item.avaliacoes}
                    </td>
                    <td style="color:#059669; font-weight:700; font-variant-numeric:tabular-nums;">
                        ${formatarMoeda(item.pago)}
                    </td>
                    <td style="color:#d97706; font-weight:700; font-variant-numeric:tabular-nums;">
                        ${item.pendente > 0 ? formatarMoeda(item.pendente) : '—'}
                    </td>
                    <td style="color:#007aff; font-weight:800; font-size:0.95rem; font-variant-numeric:tabular-nums;">
                        ${formatarMoeda(item.total)}
                    </td>
                    <td style="color:var(--text-muted); font-variant-numeric:tabular-nums;">
                        ${formatarMoeda(mediaAval)}
                    </td>
                    <td>
                        <span class="tag" style="${emDia ? 'background:#ecfdf5; color:#047857; border:1px solid #a7f3d0;' : 'background:#fffbeb; color:#b45309; border:1px solid #fde68a;'}">
                            ${emDia ? '🟢 Em Dia' : '🟡 Com Pendência'}
                        </span>
                    </td>
                </tr>
            `;
        });

        tbody.innerHTML = html;

        if (tfoot) {
            const mediaGeralAluno = listaAlunos.length > 0 ? (somaGeral / listaAlunos.length) : 0;
            tfoot.innerHTML = `
                <tr>
                    <td>📊 TOTAL (${listaAlunos.length} alunos)</td>
                    <td style="text-align:center;">${somaAval} aval.</td>
                    <td style="color:#059669;">${formatarMoeda(somaPago)}</td>
                    <td style="color:#d97706;">${formatarMoeda(somaPend)}</td>
                    <td style="color:#007aff; font-size:1.05rem;">${formatarMoeda(somaGeral)}</td>
                    <td colspan="2" style="color:var(--text-muted); font-size:0.8rem;">
                        Média Acumulada / Aluno: <b>${formatarMoeda(mediaGeralAluno)}</b>
                    </td>
                </tr>
            `;
        }
    }

    function exportarCsvHistorico() {
        const lista = carregarCobrancas();
        if (lista.length === 0) {
            notificar('Não há dados no histórico para exportar.', 'info');
            return;
        }

        let csv = 'Data;Aluno 1;Aluno 2;Modalidade;Qtd Alunos;Servico;Valor Total (R$);Valor Por Aluno (R$);Forma Pagamento;Status;Desconto Aplicado (R$);Motivo Desconto\n';

        lista.forEach(c => {
            const d = formatarData(c.data);
            const a1 = sanitizeCsv(c.aluno1 && c.aluno1.nome ? c.aluno1.nome : '');
            const a2 = sanitizeCsv(c.aluno2 && c.aluno2.nome ? c.aluno2.nome : '');
            const mod = c.modalidade === '2' ? 'Dupla' : 'Individual';
            const qP = c.qPessoas || (c.modalidade === '2' ? 2 : 1);
            const serv = sanitizeCsv(c.servicoNome || '');
            const total = (Number(c.valorTotal) || 0).toFixed(2).replace('.', ',');
            const porAluno = (Number(c.valorPorAluno) || 0).toFixed(2).replace('.', ',');
            const st = c.status === 'pago' ? 'Pago' : 'Pendente';
            const desc = (Number(c.valorDesconto) || 0).toFixed(2).replace('.', ',');
            const motivo = sanitizeCsv(c.motivoDesconto || '');

                        const formaStr = c.formaPagamento === 'credito' ? `Crédito (${c.parcelasCartao || 1}x)` : (c.formaPagamento === 'debito' ? 'Débito' : (c.formaPagamento === 'dinheiro' ? 'Dinheiro' : 'Pix'));
            csv += `${d};${a1};${a2};${mod};${qP};${serv};${total};${porAluno};${formaStr};${st};${desc};${motivo}\n`;
        });

        const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `EvoluFisico_Cobrancas_Estavel_v8.9_${new Date().toISOString().split('T')[0]}.csv`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
    }

    function resetarFormulario() {
        state.modalidade = '1';
        state.aluno1.nome = '';
        state.aluno2.nome = '';
        state.servicoId = 'completa';
        state.servicoNomePersonalizado = '';
        state.valorBaseUnitario = PRECOS_SERVICOS.completa;
        state.data = new Date().toISOString().split('T')[0];
        state.tipoDesconto = 'porcentagem';
        state.descontoInput = 0;
        state.motivoDesconto = '';
        state.statusPagamento = 'pago';
        state.dataRecebimento = hojeLocal();
        state.dataVencimento = hojeLocal();
        const pd=document.getElementById('cob-finance-paid-input'); if(pd)pd.value=state.dataRecebimento;
        const dd=document.getElementById('cob-finance-due-input'); if(dd)dd.value=state.dataVencimento;

        const sel1 = document.getElementById('cob_select_aluno1');
        if (sel1) sel1.value = '';
        const in1 = document.getElementById('cob_nome1');
        if (in1) in1.value = '';

        const sel2 = document.getElementById('cob_select_aluno2');
        if (sel2) sel2.value = '';
        const in2 = document.getElementById('cob_nome2');
        if (in2) in2.value = '';

        const selServ = document.getElementById('cob_servico_select');
        if (selServ) selServ.value = 'completa';

        const inCustom = document.getElementById('cob_servico_nome_custom');
        if (inCustom) inCustom.value = '';

        const inBase = document.getElementById('cob_valor_base');
        if (inBase) inBase.value = state.valorBaseUnitario.toFixed(2);

        const inData = document.getElementById('cob_data');
        if (inData) inData.value = state.data;

        const inDesc = document.getElementById('cob_desconto_input');
        if (inDesc) inDesc.value = '0';

        const inMotivo = document.getElementById('cob_desconto_motivo');
        if (inMotivo) inMotivo.value = '';

        setModalidade('1');
        setTipoDesconto('porcentagem');
        setStatusPagamento('pago');
        setFormaPagamento('pix');
        const selP = document.getElementById('cob_select_parcelas');
        if (selP) selP.value = '1';
        const inD = document.getElementById('cob_dinheiro_recebido');
        if (inD) inD.value = '';
        aplicarChipDesconto(0, 'porcentagem', 'Sem desconto');

        recalcularEAtualizarUI();
    }

    function mount() {
        loadBilling().then(renderizarHistoricoCompleto).catch(e=>console.warn("Cobranças indisponíveis: "+e.message));
        const nav = document.querySelector('.nav-tabs');
        const diagBtn = document.getElementById('tab-btn-diagnostics');
        let cobBtn = document.getElementById('tab-btn-cobranca');
        
        // 1. Botão da aba estritamente após tab-btn-diagnostics
        if (!cobBtn) {
            cobBtn = document.createElement('button');
            cobBtn.className = 'nav-tab-btn';
            cobBtn.id = 'tab-btn-cobranca';
            cobBtn.type = 'button';
            cobBtn.onclick = function() { switchTab('tab-cobranca'); };
            cobBtn.innerHTML = '<span>💳</span> <span>Cobrança</span>';

            if (diagBtn && diagBtn.parentNode) {
                diagBtn.parentNode.insertBefore(cobBtn, diagBtn.nextSibling);
            } else if (nav) {
                nav.appendChild(cobBtn);
            }
        } else if (diagBtn && cobBtn.previousElementSibling !== diagBtn && diagBtn.parentNode) {
            diagBtn.parentNode.insertBefore(cobBtn, diagBtn.nextSibling);
        }

        // 2. Seção #tab-cobranca estritamente após #tab-diagnostics
        const diagPanel = document.getElementById('tab-diagnostics');
        const cobPanel = document.getElementById('tab-cobranca');
        // Diagnóstico pode ter sido realocado para Configurações > Manutenção.
        // Jamais mover a tela de Cobranças para dentro do Diagnóstico.
        const appRoot = document.querySelector('.app-container');
        if (cobPanel && appRoot) {
            if (cobPanel.parentElement !== appRoot) {
                appRoot.appendChild(cobPanel);
            } else if (diagPanel && diagPanel.parentElement === appRoot && cobPanel.previousElementSibling !== diagPanel) {
                appRoot.insertBefore(cobPanel, diagPanel.nextSibling);
            }
        }

        popularSelectAlunos();
        const inData = document.getElementById('cob_data');
        if (inData && !inData.value) inData.value = state.data;

        const dtPago=document.getElementById('cob-finance-paid-input');if(dtPago)dtPago.value=state.dataRecebimento;
        const dtPend=document.getElementById('cob-finance-due-input');if(dtPend)dtPend.value=state.dataVencimento;
        setStatusPagamento(state.statusPagamento);
        const inBase = document.getElementById('cob_valor_base');
        if (inBase && !inBase.value) inBase.value = state.valorBaseUnitario.toFixed(2);

        recalcularEAtualizarUI();
        renderizarHistoricoCompleto();
    }

    // Interceptar switchTab
    const _oldSwitch = window.switchTab;
    if (typeof _oldSwitch === 'function') {
        window.switchTab = function(id) {
            const r = _oldSwitch.apply(this, arguments);
            if (id === 'tab-cobranca') {
                document.querySelectorAll('.nav-tab-btn').forEach(b => b.classList.remove('active'));
                const btn = document.getElementById('tab-btn-cobranca');
                if (btn) btn.classList.add('active');
                if (window.EFCobranca && window.EFCobranca.atualizarUI) window.EFCobranca.atualizarUI();
            }
            return r;
        };
    }

    // Exportar API Global EFCobranca
    window.EFCobranca = {
        exportData: loadBilling,
        importData: async function(lista, replace=false, skip=false) {
            const existing=replace?[]:await loadBilling();
            const map=new Map(existing.map(x=>[String(x.id),x]));
            for (const item of lista) { const row=structuredClone(item); if(!row.id) row.id=gerarIdCobranca(); if(!skip || !map.has(String(row.id))) map.set(String(row.id),row); }
            await writeBilling([...map.values()]);renderizarHistoricoCompleto();
        },
        protect: async function(key=EF_Security.key) { const list=await loadBilling(); await writeBilling(list,key,true); },
        unprotect: async function() {const list=await loadBilling();await writeBilling(list,null,false);},
        clearMemory: function(){billingCache=null;billingRaw=null;},
        version: '1.0.3-pre-beta',
        mounted: true,
        state: state,
        mount: mount,
        formatarData: formatarData,
        formatarMoeda: formatarMoeda,
        calcularValores: calcularValores,
        recalcular: recalcularEAtualizarUI,
        ajustarValorBase: ajustarValorBase,
        setModalidade: setModalidade,
        aoMudarServico: aoMudarServico,
        aoSelecionarAluno: aoSelecionarAluno,
        setTipoDesconto: setTipoDesconto,
        aplicarChipDesconto: aplicarChipDesconto,
        aplicarDescontoDuplaPadrao: aplicarDescontoDuplaPadrao,
        setStatusPagamento: setStatusPagamento,
        setDataFinanceira: setDataFinanceira,
        setFormaPagamento: setFormaPagamento,
        aoMudarParcelas: aoMudarParcelas,
        calcularTroco: calcularTroco,
        salvarCobrancaNoHistorico: salvarCobrancaNoHistorico,
        alternarStatusNoHistorico: alternarStatusNoHistorico,
        excluirCobrancaDoHistorico: excluirCobrancaDoHistorico,
        limparTodoHistorico: limparTodoHistorico,
        setFiltroStatus: setFiltroStatus,
        setVisaoHistorico: setVisaoHistorico,
        filtrarHistorico: filtrarHistorico,
        exportarCsvHistorico: exportarCsvHistorico,
        resetarFormulario: resetarFormulario,
        atualizarUI: function() {
            mount();
            popularSelectAlunos();
            recalcularEAtualizarUI();
            renderizarHistoricoCompleto();
        }
    };

    // Paleta de Comando Ctrl+K
    setTimeout(() => {
        try {
            if (typeof acoes !== 'undefined' && Array.isArray(acoes)) {
                acoes = acoes.filter(a => !(a[0] && a[0].includes('Cobrança')));
                acoes.push(['💳 Cobrança & Precificação', 'Alt+6', function() { switchTab('tab-cobranca'); }]);
            }
        } catch(e) {}
    }, 150);

    // Tecla de atalho Alt+6
    document.addEventListener('keydown', (e) => {
        if (e.altKey && !e.ctrlKey && !e.metaKey && e.key === '6') {
            e.preventDefault();
            switchTab('tab-cobranca');
        }
    });

    // Delegação de eventos: funciona mesmo quando a tabela é re-renderizada.
    document.addEventListener('click', function(e) {
        const btn = e.target && e.target.closest ? e.target.closest('[data-cob-action]') : null;
        if (!btn) return;
        const id = btn.getAttribute('data-cob-id');
        const acao = btn.getAttribute('data-cob-action');
        if (!id) return;
        e.preventDefault();
        if (acao === 'delete') excluirCobrancaDoHistorico(id);
        else if (acao === 'toggle') alternarStatusNoHistorico(id);
    });

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', mount);
    } else {
        mount();
    }
    setTimeout(mount, 100);
    setTimeout(mount, 500);
})();


/* ==========================================================================
   MOTOR DE AJUDA & DEFINIÇÕES CLÍNICAS (EF_HELP_SYSTEM)
   ========================================================================== */
window.EF_HELP_DEFINICOES = {"nome": {"title": "Nome Completo", "desc": "Nome completo do aluno ou paciente para identificação clínica e geração de relatórios oficiais."}, "email": {"title": "E-mail de Contato", "desc": "Endereço eletrônico utilizado para arquivamento, envio de relatórios e correspondência clínica."}, "whatsapp": {"title": "WhatsApp / Telefone", "desc": "Número com DDD para contato direto, envio de laudos em PDF e acompanhamento da evolução."}, "sexo": {"title": "Sexo Biológico", "desc": "Essencial para a seleção das equações preditivas de densidade corporal (Pollock), fórmulas de TMB e índices de saúde."}, "idade": {"title": "Idade Cronológica", "desc": "Idade em anos completos. Fator determinante no cálculo da densidade corporal (Jackson & Pollock), faixas de normalidade e TMB."}, "altura": {"title": "Estatura / Altura (cm)", "desc": "Medida em centímetros (ex: 175). Utilizada para o cálculo de IMC, Relação Cintura-Estatura (RCE), BRI e estimativa de massa magra."}, "data_avaliacao": {"title": "Data da Avaliação", "desc": "Data em que a coleta dos dados físicos foi realizada. Fundamental para a linha do tempo e cálculo de taxas semanais."}, "data_proxima_avaliacao": {"title": "Próxima Avaliação (Retorno)", "desc": "Data estipulada para a reavaliação física e fechamento do ciclo de treino/periodização (geralmente entre 30 e 60 dias)."}, "checkin_semana": {"title": "Check-in / Período", "desc": "Identificador da semana ou fase do acompanhamento (ex: Inicial / Avaliação 1, Semana 4, etc.)."}, "fase": {"title": "Fase no Programa", "desc": "Objetivo atual do ciclo: Emagrecimento, Hipertrofia, Manutenção, Recomposição Corporal ou Transição."}, "avaliador_clinica": {"title": "Clínica / Consultório", "desc": "Nome do estabelecimento, assessoria ou estúdio que constará no cabeçalho dos laudos em PDF."}, "avaliador_nome": {"title": "Profissional Avaliador", "desc": "Nome do profissional de Educação Física, Nutricionista ou Médico responsável pela coleta e parecer técnico."}, "avaliador_registro": {"title": "Registro Profissional", "desc": "Número de registro no conselho de classe profissional (CREF, CRN ou CRM) para validação legal do laudo emitido."}, "peso": {"title": "Peso Corporal Total (kg)", "desc": "Massa corporal total aferida em balança calibrada, com o indivíduo descalço e com vestimentas leves."}, "peri_pescoco": {"title": "Perímetro do Pescoço (cm)", "desc": "Medido logo abaixo da proeminência laríngea (pomo de Adão), perpendicular ao eixo do pescoço. Padrão da Marinha Americana."}, "peri_ombros": {"title": "Perímetro dos Ombros (cm)", "desc": "Circunferência máxima ao nível dos deltoides, na porção média mais proeminente, com braços relaxados ao lado do corpo."}, "peri_abdomen": {"title": "Perímetro Abdominal (cm)", "desc": "Medido exatamente sobre a cicatriz umbilical (nível do umbigo), em posição ortostática ao final de uma expiração normal."}, "cintura": {"title": "Perímetro da Cintura (cm)", "desc": "Medida na menor curvatura do tronco (entre a última costela e a crista ilíaca), ao final de expiração normal. Utilizada na RCQ e RCE."}, "quadril": {"title": "Perímetro do Quadril (cm)", "desc": "Circunferência no ponto de maior protuberância glútea. Essencial para avaliar distribuição ginoide/androide e o índice RCQ."}, "braco_esq": {"title": "Braço Esquerdo (cm)", "desc": "Perímetro do braço relaxado no ponto médio entre o acrômio da escápula e o olécrano da ulna."}, "braco_dir": {"title": "Braço Direito (cm)", "desc": "Perímetro do braço relaxado no ponto médio entre o acrômio e o olécrano. Útil para verificar simetrias bilaterais."}, "coxa_esq": {"title": "Coxa Esquerda (cm)", "desc": "Medida no ponto médio entre a prega inguinal e a borda superior da patela, com o peso distribuído uniformemente nas duas pernas."}, "coxa_dir": {"title": "Coxa Direita (cm)", "desc": "Medida no ponto médio entre a linha inguinal e o polo superior da patela. Avalia desenvolvimento muscular e assimetrias."}, "panturrilha": {"title": "Panturrilha / Perna (cm)", "desc": "Circunferência máxima da perna no plano horizontal, com o avaliado em pé e peso distribuído. Indicador de massa muscular periférica."}, "dobra_triceps": {"title": "Dobra Cutânea Tricipital (mm)", "desc": "Dobra vertical na face posterior do braço, no ponto médio entre o processo acromial e o olécrano. Braço solto e relaxado."}, "dobra_subescapular": {"title": "Dobra Cutânea Subescapular (mm)", "desc": "Dobra oblíqua a 45 graus, localizada 1 a 2 cm abaixo do ângulo inferior da escápula, acompanhando as linhas naturais de clivagem."}, "dobra_suprailiaca": {"title": "Dobra Cutânea Supra-ilíaca (mm)", "desc": "Dobra diagonal na linha axilar anterior, imediatamente acima da crista ilíaca. Marcador sensível de adiposidade abdominal."}, "dobra_peitoral": {"title": "Dobra Cutânea Peitoral / Torácica (mm)", "desc": "Homens: metade da distância entre a linha axilar anterior e o mamilo (diagonal). Mulheres: 1/3 da distância a partir da axila."}, "dobra_axilar": {"title": "Dobra Cutânea Axilar Média (mm)", "desc": "Dobra vertical ou ligeiramente oblíqua na linha axilar média, no nível da junção xifosternal do esterno."}, "dobra_abdominal": {"title": "Dobra Cutânea Abdominal (mm)", "desc": "Dobra vertical localizada a cerca de 2 cm à direita da cicatriz umbilical. Avalia o acúmulo de gordura subcutânea no abdômen."}, "dobra_coxa": {"title": "Dobra Cutânea da Coxa (mm)", "desc": "Dobra vertical na face anterior da coxa, no ponto médio entre o ligamento inguinal e a borda superior da patela. Perna sem carga."}, "bia_peso": {"title": "Peso na Balança de BIA (kg)", "desc": "Peso aferido no momento exato do exame de bioimpedância para calibrar a resistência e reatância dos tecidos corporais."}, "bia_pgordura": {"title": "Percentual de Gordura BIA (%)", "desc": "Proporção de gordura em relação ao peso corporal total, estimada pela impedância tecidual e condutividade da água corporal."}, "bia_pmusculo": {"title": "Percentual de Músculo Esquelético (%)", "desc": "Porcentagem de massa muscular ativa voluntária responsável pela força física, postura e taxa de metabolismo em repouso."}, "bia_imc": {"title": "Índice de Massa Corporal (kg/m²)", "desc": "Relação entre o peso e o quadrado da estatura (kg/m²). Classifica estado nutricional conforme parâmetros da OMS."}, "bia_gordura_kg": {"title": "Massa Gorda Absoluta (kg)", "desc": "Quantidade total em quilogramas de tecido adiposo corporal (gordura essencial + gordura de reserva armazenada)."}, "bia_mme": {"title": "Massa Muscular Esquelética (kg)", "desc": "Massa absoluta em kg composta apenas pelos músculos esqueléticos, sendo o principal tecido metabólico treinável."}, "bia_tmb": {"title": "Taxa Metabólica Basal - BIA (kcal)", "desc": "Energia mínima calórica diária necessária para manter as funções vitais em repouso absoluto calculada pelo aparelho."}, "bia_visceral": {"title": "Nível de Gordura Visceral", "desc": "Classificação da gordura profunda que envolve órgãos abdominais. Níveis até 9 = saudável; 10 a 14 = elevado; 15+ = crítico."}, "bia_idade_corporal": {"title": "Idade Biológica / Corporal (anos)", "desc": "Estimativa algorítmica da idade metabólica comparando a composição corporal do avaliado com as médias da população saudável."}, "bia_rcq": {"title": "Relação Cintura / Quadril (RCQ)", "desc": "Razão cintura / quadril calculada pelo equipamento. Importante indicador de risco cardiovascular e padrão de distribuição de gordura."}, "bia_risco": {"title": "Classificação de Risco Cardiovascular", "desc": "Estratificação do risco de desfechos metabólicos adversos baseada nos valores combinados de RCQ, gordura visceral e percentual de gordura."}, "bia_analise_texto": {"title": "Análise Clínica da Bioimpedância", "desc": "Campo livre para observações do avaliador sobre o estado de hidratação, protocolo pré-exame (jejum, cafeína) e interpretação do laudo."}, "foto_frente": {"title": "Foto Anterior (Frente)", "desc": "Registro fotográfico frontal, braços levemente afastados, postura natural e luz uniforme para análise de simetria e definição."}, "foto_perfil_direito": {"title": "Foto em Perfil Direito", "desc": "Registro lateral direito, braços posicionados sem obstruir a linha da cintura e abdômen, avaliando curvaturas posturais e projeção."}, "foto_perfil_esquerdo": {"title": "Foto em Perfil Esquerdo", "desc": "Registro lateral esquerdo para comparação e validação do alinhamento da pelve, coluna e tônus muscular."}, "foto_costas": {"title": "Foto Posterior (Costas)", "desc": "Registro dorsal, demonstrando desenvolvimento de grande dorsal, trapézio, eretores da espinha, glúteos e posterior de coxas."}, "foto_extra": {"title": "Foto Livre / Detalhe / Postural", "desc": "Foto opcional para registrar poses específicas de fisiculturismo, detalhes de desvios posturais ou áreas específicas de evolução."}, "energia": {"title": "Nível de Energia e Disposição (1 a 5)", "desc": "Autoavaliação do nível de vitalidade e disposição física geral para os treinos e rotina diária no último período."}, "aderencia_treino": {"title": "Aderência ao Treino Planejado", "desc": "Grau de cumprimento das sessões de treino prescritas: 100% (todos os treinos), 80-99% (quase todos), 50-79% ou <50%."}, "aderencia_dieta": {"title": "Aderência ao Plano Nutricional", "desc": "Nível de fidelidade à rotina alimentar e hídrica estipulada durante o período de acompanhamento."}, "ef6_sono": {"title": "Qualidade do Sono (1 a 5)", "desc": "Avaliação subjetiva da qualidade do sono, sensação de descanso matinal e recuperação neuromuscular (escala 1 a 5)."}, "ef6_estresse": {"title": "Nível de Estresse (1 a 5)", "desc": "Impacto de fatores psicossociais, ansiedade e sobrecarga de trabalho sobre a recuperação e regulação hormonal (escala 1 a 5)."}, "ef6_dor": {"title": "Dor ou Desconforto Relatado", "desc": "Identificação de queixas articulares ou musculares (ex: joelhos, ombros, lombar) que exijam modulação de volume ou intensidade."}, "ef6_meta_pg": {"title": "Meta Alvo de % de Gordura", "desc": "Percentual de gordura corporal almejado para o próximo ciclo de reavaliação ou fim da temporada."}, "ef6_meta_peso": {"title": "Meta Alvo de Peso (kg)", "desc": "Peso corporal total pretendido pelo aluno/paciente em consenso com o avaliador."}, "ef6_meta_prazo": {"title": "Prazo Estipulado para a Meta", "desc": "Data limite planejada para o alcance dos objetivos estabelecidos de peso e composição corporal."}, "ef6_status": {"title": "Status Geral do Check-in", "desc": "Classificação global do progresso: Excelente evolução, Em evolução satisfatória, Atenção necessária ou Estagnado."}, "ef6_fortes": {"title": "Pontos Fortes da Evolução", "desc": "Destaque das maiores conquistas do aluno no período (ex: ganho de força, consistência nos treinos, redução de circunferência abdominal)."}, "ef6_atencao": {"title": "Pontos de Atenção", "desc": "Fatores de risco ou desvios que demandam intervenção (ex: ingestão de água insuficiente, queixas de fadiga, fins de semana)."}, "ef6_treino": {"title": "Ajustes no Treinamento", "desc": "Modificações necessárias na periodização, como progressão de carga, volume semanal por grupo muscular ou densidade das sessões."}, "ef6_dieta": {"title": "Ajustes na Dieta / Estilo de Vida", "desc": "Orientações comportamentais e de estilo de vida para suporte à recuperação energética e recomposição corporal."}, "ef6_proximos": {"title": "Próximos Passos até a Reavaliação", "desc": "Metas práticas de curto prazo a serem executadas rigorosamente pelo aluno até a próxima data de retorno."}, "observacoes": {"title": "Feedback e Relato do Aluno", "desc": "Comentários pessoais do próprio aluno sobre como se sentiu durante o processo, dificuldades e motivações."}, "parecer_profissional": {"title": "Parecer Técnico do Avaliador", "desc": "Síntese técnica conclusiva emitida pelo profissional responsável. Este texto é impresso em destaque na página principal do relatório em PDF."}, "compare-client-select": {"title": "Filtrar Aluno / Paciente", "desc": "Selecione o aluno cadastrado para visualizar seu histórico completo e comparar duas avaliações distintas lado a lado."}, "compare-baseline-select": {"title": "Avaliação 1 (Base / Anterior)", "desc": "Ponto de partida temporal utilizado como referência inicial para calcular o saldo de recomposição corporal ."}, "compare-current-select": {"title": "Avaliação 2 (Atual / Recente)", "desc": "Avaliação mais recente a ser confrontada com a avaliação base para medir variações de massa magra, gordura e medidas."}, "cob_select_aluno1": {"title": "Aluno 1 (Titular / Responsável)", "desc": "Vincule o aluno principal do sistema para preenchimento automático de dados e vinculação direta ao histórico financeiro."}, "cob_nome1": {"title": "Nome do Aluno 1", "desc": "Nome do pagador ou primeiro integrante avaliado na sessão."}, "cob_select_aluno2": {"title": "2º Aluno (Parceiro / Dupla)", "desc": "Selecione o segundo aluno caso a cobrança seja para atendimento em casal, amigos ou dupla com valor compartilhado."}, "cob_nome2": {"title": "Nome do 2º Aluno", "desc": "Nome do parceiro ou segundo aluno que participa da modalidade em dupla."}, "cob_servico_select": {"title": "Tipo de Serviço / Pacote", "desc": "Pacote clínico selecionado: Avaliação Física Completa (Dobras + BIA), Consulta Nutricional, Consultoria Esportiva ou Personalizado."}, "cob_servico_nome_custom": {"title": "Descrição do Serviço Personalizado", "desc": "Discriminação detalhada do serviço quando for selecionada a opção 'Outro Serviço / Personalizado'."}, "cob_valor_base": {"title": "Valor Unitário por Pessoa (R$)", "desc": "Preço tabelado por pessoa antes dos descontos. Na modalidade em dupla, o valor base será multiplicado por 2."}, "cob_data": {"title": "Data da Avaliação / Cobrança", "desc": "Data em que o serviço foi prestado ou em que o pagamento foi registrado."}, "cob_desconto_input": {"title": "Percentual de Desconto (%)", "desc": "Desconto comercial aplicado sobre o valor bruto (ex: 5% à vista, 10% estudante, 15% pacote trimestral ou 20% promoção dupla)."}, "cob_desconto_motivo": {"title": "Motivo do Desconto", "desc": "Justificativa comercial do benefício concedido (ex: Pagamento à vista em dinheiro, Parceria com academia, Familiar)."}, "cob_select_parcelas": {"title": "Número de Parcelas (Cartão de Crédito)", "desc": "Quantidade de parcelas no cartão (de 1x à vista até 12x). O sistema calcula o valor de cada parcela automaticamente."}, "cob_dinheiro_recebido": {"title": "Valor em Dinheiro Entregue", "desc": "Montante em notas entregue pelo cliente. O sistema calcula imediatamente o valor exato do troco a ser devolvido."}, "cfg_pro_nome": {"title": "Nome do Profissional Responsável", "desc": "Nome do avaliador que será salvo como padrão nas próximas avaliações e no rodapé/cabeçalho dos documentos."}, "cfg_pro_cref": {"title": "Registro Profissional Padrão", "desc": "Seu número no conselho (CREF, CRN ou CRM) com a sigla do estado (ex: CREF 012345-G/PR)."}, "cfg_pro_clinica": {"title": "Nome do Consultório / Estúdio", "desc": "Nome da marca, academia, clínica ou estúdio de personal que aparecerá impresso nos laudos."}, "ef77-src": {"title": "Fonte dos Dados do Lab", "desc": "Escolha se deseja importar os dados diretamente de uma avaliação do cadastro ou preencher manualmente para simulações."}, "ef77-sexo": {"title": "Sexo Biológico (Fórmulas)", "desc": "Determina as constantes biológicas aplicadas nas equações de TMB (Harris-Benedict, Mifflin) e composição corporal."}, "ef77-idade": {"title": "Idade (Simulação Lab)", "desc": "Idade cronológica em anos para cálculo da Taxa Metabólica Basal e faixas de frequência cardíaca de treino."}, "ef77-altura": {"title": "Altura em Centímetros", "desc": "Estatura utilizada no cálculo de TMB, RCE, BRI (Índice de Redondeza Corporal) e ABSI (Índice de Forma Corporal)."}, "ef77-peso": {"title": "Peso Atual (kg)", "desc": "Peso corporal total utilizado como base para o dispêndio energético e particionamento de tecidos."}, "ef77-pescoco": {"title": "Circunferência do Pescoço (cm)", "desc": "Utilizado na equação da Marinha dos EUA para estimativa complementar de percentual de gordura sem adipômetro."}, "ef77-cintura": {"title": "Circunferência da Cintura (cm)", "desc": "Utilizada nos cálculos de RCE (relação cintura-estatura), RCQ e índice de adiposidade central."}, "ef77-quadril": {"title": "Circunferência do Quadril (cm)", "desc": "Utilizada para determinar a relação cintura-quadril e distribuição de gordura ginoide versus androide."}, "ef77-pollock": {"title": "% Gordura Pollock (7 Dobras)", "desc": "Percentual de gordura subcutânea aferido pelo protocolo de 7 dobras de Jackson & Pollock."}, "ef77-bia": {"title": "% Gordura Bioimpedância", "desc": "Percentual de gordura aferido por bioimpedância elétrica para comparação direta com o método de dobras."}, "ef77-fcrep": {"title": "Frequência Cardíaca de Repouso (bpm)", "desc": "Batimentos por minuto em repouso. Utilizada na fórmula de Karvonen para prescrição de zonas alvo de treinamento aeróbico."}, "ef77-fator": {"title": "Nível de Atividade Física (Fator PAL)", "desc": "Multiplicador do gasto calórico diário: Sedentário (1.2), Leve (1.375), Moderado (1.55), Intenso (1.725) ou Muito Intenso (1.9)."}, "ef77-obj": {"title": "Objetivo Energético", "desc": "Ajuste sobre o gasto calórico total (GET): Manutenção (0%), Déficit Calórico (-20% para emagrecimento) ou Superávit (+10% para hipertrofia)."}, "ef77-formula": {"title": "Equação Preditiva de TMB", "desc": "Selecione a fórmula: Harris-Benedict (1984 atualizada), Mifflin-St Jeor (padrão-ouro em indivíduos eutróficos), Katch-McArdle (baseada em massa magra) ou Harris-Benedict (1919 clássica)."}, "ef77-alvo": {"title": "Meta Alvo de % Gordura", "desc": "Percentual de gordura desejado para calcular a quantidade exata de massa gorda a eliminar mantendo a massa magra preservada."}, "desafio_transformacao": {"title": "Desafio de Transformação", "desc": "Identifica se o aluno está inscrito em desafios sazonais de transformação corporal (ex: 60 ou 90 dias) para relatórios específicos."}, "cob_modalidade": {"title": "Modalidade do Atendimento", "desc": "Selecione se o atendimento é Individual (1 pessoa) ou em Dupla / Casal (2 pessoas com rateio de valor e comprovante conjunto)."}, "cob_desconto_modalidade": {"title": "Modalidade do Desconto", "desc": "Escolha se o desconto concedido será calculado como porcentagem (%) sobre o valor total ou como valor fixo em reais (R$)."}, "cob_forma_pagamento": {"title": "Forma de Pagamento", "desc": "Opções comerciais disponíveis: Pix (com QR Code copia e cola), Cartão de Crédito (com parcelas), Cartão de Débito ou Dinheiro em espécie."}, "cob_status": {"title": "Status do Pagamento", "desc": "Situação financeira do serviço: 'Pago' (liquidado na hora), 'Pendente' (a receber) ou 'Cortesia / Isento'."}, "bkp_tipo": {"title": "Tipo de Backup dos Dados", "desc": "Backup Completo (com todas as fotos e históricos), Backup Leve (somente métricas e textos, <100KB) ou Backup Filtrado por Aluno."}, "bkp_restaurar": {"title": "Método de Restauração", "desc": "Mesclar e Atualizar (adiciona novos e preserva existentes), Apenas Novos (não toca nos atuais) ou Substituição Completa."}};

window.EF_HelpSystem = (function() {
    var popover = null;
    var activeBtn = null;
    var hideTimeout = null;

    function init() {
        createPopoverElement();
        injectButtons();
        setupObserver();
        setupGlobalEvents();
    }

    function createPopoverElement() {
        if (document.getElementById('ef-help-popover')) return;
        popover = document.createElement('div');
        popover.id = 'ef-help-popover';
        popover.innerHTML = '<div class="popover-header"><span class="popover-title">ℹ️ Ajuda</span><button type="button" class="popover-close" aria-label="Fechar">&times;</button></div><div class="popover-body"></div>';
        document.body.appendChild(popover);

        popover.querySelector('.popover-close').addEventListener('click', function(e) {
            e.stopPropagation();
            hide();
        });

        popover.addEventListener('mouseenter', function() {
            if (hideTimeout) clearTimeout(hideTimeout);
        });
        popover.addEventListener('mouseleave', function() {
            hide();
        });
    }

    function getDefinition(key, labelText) {
        if (window.EF_HELP_DEFINICOES[key]) {
            return window.EF_HELP_DEFINICOES[key];
        }
        // Normalização de chaves para buscar equivalência
        var cleanKey = (key || '').toLowerCase().replace(/^(ef77-|cob_|peri_|bia_|ef6_|dobra_)/, '');
        for (var k in window.EF_HELP_DEFINICOES) {
            var cK = k.toLowerCase().replace(/^(ef77-|cob_|peri_|bia_|ef6_|dobra_)/, '');
            if (cK && cK === cleanKey) {
                return window.EF_HELP_DEFINICOES[k];
            }
        }

        // Busca por similaridade no texto do label
        if (labelText) {
            var lt = labelText.toLowerCase();
            if (lt.indexOf('pescoço') >= 0) return window.EF_HELP_DEFINICOES['peri_pescoco'];
            if (lt.indexOf('ombro') >= 0) return window.EF_HELP_DEFINICOES['peri_ombros'];
            if (lt.indexOf('abdômen') >= 0 || lt.indexOf('abdomen') >= 0) return window.EF_HELP_DEFINICOES['peri_abdomen'];
            if (lt.indexOf('cintura') >= 0) return window.EF_HELP_DEFINICOES['cintura'];
            if (lt.indexOf('quadril') >= 0) return window.EF_HELP_DEFINICOES['quadril'];
            if (lt.indexOf('braço') >= 0 || lt.indexOf('braco') >= 0) return window.EF_HELP_DEFINICOES['braco_dir'];
            if (lt.indexOf('coxa') >= 0 && lt.indexOf('dobra') >= 0) return window.EF_HELP_DEFINICOES['dobra_coxa'];
            if (lt.indexOf('coxa') >= 0) return window.EF_HELP_DEFINICOES['coxa_dir'];
            if (lt.indexOf('panturrilha') >= 0) return window.EF_HELP_DEFINICOES['panturrilha'];
            if (lt.indexOf('tríceps') >= 0 || lt.indexOf('tricipital') >= 0) return window.EF_HELP_DEFINICOES['dobra_triceps'];
            if (lt.indexOf('subescapular') >= 0) return window.EF_HELP_DEFINICOES['dobra_subescapular'];
            if (lt.indexOf('supra') >= 0) return window.EF_HELP_DEFINICOES['dobra_suprailiaca'];
            if (lt.indexOf('peitoral') >= 0) return window.EF_HELP_DEFINICOES['dobra_peitoral'];
            if (lt.indexOf('axilar') >= 0) return window.EF_HELP_DEFINICOES['dobra_axilar'];
            if (lt.indexOf('visceral') >= 0) return window.EF_HELP_DEFINICOES['bia_visceral'];
            if (lt.indexOf('metabolismo') >= 0 || lt.indexOf('tmb') >= 0) return window.EF_HELP_DEFINICOES['bia_tmb'];
            if (lt.indexOf('músculo') >= 0 || lt.indexOf('musculo') >= 0 || lt.indexOf('mme') >= 0) return window.EF_HELP_DEFINICOES['bia_mme'];
            if (lt.indexOf('frequência cardíaca') >= 0 || lt.indexOf('fc repouso') >= 0) return window.EF_HELP_DEFINICOES['ef77-fcrep'];
            if (lt.indexOf('atividade') >= 0) return window.EF_HELP_DEFINICOES['ef77-fator'];
            if (lt.indexOf('objetivo') >= 0) return window.EF_HELP_DEFINICOES['ef77-obj'];
            if (lt.indexOf('fórmula') >= 0) return window.EF_HELP_DEFINICOES['ef77-formula'];
            if (lt.indexOf('desafio') >= 0) return window.EF_HELP_DEFINICOES['desafio_transformacao'];
            if (lt.indexOf('serviço') >= 0 || lt.indexOf('servico') >= 0) return window.EF_HELP_DEFINICOES['cob_servico_select'];
            if (lt.indexOf('desconto') >= 0) return window.EF_HELP_DEFINICOES['cob_desconto_input'];
            if (lt.indexOf('pagamento') >= 0) return window.EF_HELP_DEFINICOES['cob_forma_pagamento'];
            if (lt.indexOf('parcela') >= 0) return window.EF_HELP_DEFINICOES['cob_select_parcelas'];
            if (lt.indexOf('backup') >= 0) return window.EF_HELP_DEFINICOES['bkp_tipo'];
            if (lt.indexOf('restaurar') >= 0) return window.EF_HELP_DEFINICOES['bkp_restaurar'];
        }

        return {
            title: labelText ? labelText.replace(/[*:]/g, '').trim() : "Ajuda do Campo",
            desc: "Preencha este campo de acordo com os dados coletados na avaliação ou protocolo clínico."
        };
    }

    function injectButtons() {
        var labels = document.querySelectorAll('label');
        labels.forEach(function(lbl) {
            if (lbl.querySelector('.ef-help-btn')) return;
            var forAttr = lbl.getAttribute('for');
            var rawText = lbl.textContent.replace(/[*:]/g, '').trim();

            // Evitar botões em labels simples de checkbox/radio como "Sim" ou "Não"
            if (rawText === 'Sim' || rawText === 'Não') return;
            if (lbl.closest('.ef-help-btn')) return;

            var key = forAttr || '';
            // Se forAttr não existe, tentar encontrar input interno
            if (!key) {
                var inp = lbl.querySelector('input, select, textarea');
                if (inp && inp.id) key = inp.id;
            }

            var info = getDefinition(key, rawText);
            if (!info) return;

            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'ef-help-btn';
            btn.setAttribute('aria-label', 'Ajuda sobre ' + info.title);
            btn.title = info.title + ': ' + info.desc;
            btn.textContent = '?';
            btn.dataset.helpTitle = info.title;
            btn.dataset.helpDesc = info.desc;

            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                toggle(btn, info);
            });

            btn.addEventListener('mouseenter', function() {
                if (window.innerWidth > 600) {
                    show(btn, info);
                }
            });

            btn.addEventListener('mouseleave', function() {
                if (window.innerWidth > 600) {
                    hideTimeout = setTimeout(hide, 250);
                }
            });

            lbl.appendChild(btn);
        });
    }

    function show(btn, info) {
        if (!popover) createPopoverElement();
        if (hideTimeout) clearTimeout(hideTimeout);
        activeBtn = btn;

        popover.querySelector('.popover-title').innerHTML = 'ℹ️ ' + (info.title || btn.dataset.helpTitle || 'Ajuda');
        popover.querySelector('.popover-body').textContent = info.desc || btn.dataset.helpDesc || '';

        popover.classList.add('active');

        if (window.innerWidth > 600) {
            var rect = btn.getBoundingClientRect();
            var popRect = popover.getBoundingClientRect();
            var top = rect.bottom + window.scrollY + 6;
            var left = rect.left + window.scrollX - 20;

            // Previne overflow à direita
            if (left + 330 > window.innerWidth) {
                left = window.innerWidth - 340;
            }
            if (left < 10) left = 10;

            // Se estourar a parte inferior da janela, abre para cima
            if (rect.bottom + popRect.height + 20 > window.innerHeight) {
                top = rect.top + window.scrollY - popRect.height - 6;
            }

            popover.style.top = top + 'px';
            popover.style.left = left + 'px';
        }
    }

    function hide() {
        if (popover) {
            popover.classList.remove('active');
        }
        activeBtn = null;
    }

    function toggle(btn, info) {
        if (activeBtn === btn && popover && popover.classList.contains('active')) {
            hide();
        } else {
            show(btn, info);
        }
    }

    function setupObserver() {
        // Observa mutações para injetar em novos elementos inseridos dinamicamente (como na aba Lab ou novos modais)
        var observer = new MutationObserver(function(mutations) {
            var shouldReinject = false;
            mutations.forEach(function(m) {
                if (m.addedNodes.length > 0) shouldReinject = true;
            });
            if (shouldReinject) {
                injectButtons();
            }
        });
        observer.observe(document.body, { childList: true, subtree: true });
    }

    function setupGlobalEvents() {
        document.addEventListener('click', function(e) {
            if (popover && popover.classList.contains('active')) {
                if (!popover.contains(e.target) && !e.target.classList.contains('ef-help-btn')) {
                    hide();
                }
            }
        });

        window.addEventListener('resize', function() {
            if (popover && popover.classList.contains('active')) hide();
        });
        window.addEventListener('scroll', function() {
            if (window.innerWidth > 600 && popover && popover.classList.contains('active')) hide();
        }, { passive: true });
    }

    return {
        init: init,
        reinject: injectButtons,
        show: show,
        hide: hide
    };
})();

document.addEventListener('DOMContentLoaded', function() {
    window.EF_HelpSystem.init();
});
if (document.readyState === 'complete' || document.readyState === 'interactive') {
    window.EF_HelpSystem.init();
}
</script>
<script id="ef-billing-monthly-script">
/* EvoluFísico2 1.0.30 Pré-Beta — Caixa mensal e relatórios financeiros.
   Não cria uma segunda base: lê apenas os registros do EFCobranca existente.
   Caixa = recebido na data efetiva de pagamento; pendências = vencimento da cobrança.
*/
(function () {
  'use strict';
  const $ = id => document.getElementById(id);
  const localToday = () => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; };
  const iso = value => { const v=String(value||''); return /^\d{4}-\d{2}-\d{2}(?:$|T)/.test(v) ? v.slice(0,10) : ''; };
  const month = value => iso(value).slice(0,7);
  const currentMonth = () => localToday().slice(0,7);
  const validMonth = value => /^\d{4}-(0[1-9]|1[0-2])$/.test(value);
  const money = x => (Number(x)||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
  const safe = x => String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const monthName = x => validMonth(x) ? new Intl.DateTimeFormat('pt-BR',{month:'long',year:'numeric'}).format(new Date(Number(x.slice(0,4)),Number(x.slice(5))-1,1)).replace(/^./,c=>c.toUpperCase()) : 'Período inválido';
  const displayDate = x => iso(x) ? iso(x).split('-').reverse().join('/') : '—';
  const receivedDate = c => iso(c.recebidoEm || c.data || c.createdAt);
  const dueDate = c => iso(c.vencimento || c.data || c.createdAt);
  const valueOf = c => Math.max(0, Number(c.valorTotal)||0);
  const isPaid = c => c.status === 'pago';
  const recordNames = c => [c.aluno1?.nome,c.aluno2?.nome].filter(Boolean).join(' e ') || 'Não informado';
  let selected=currentMonth(),lastMonth='',rows=[],seq=0,ready=false,locked=false;

  function summary(list, ym) {
    const paid=list.filter(c=>isPaid(c)&&month(receivedDate(c))===ym);
    const pending=list.filter(c=>!isPaid(c)&&month(dueDate(c))===ym);
    return {month:ym,paid,pending,paidTotal:paid.reduce((n,c)=>n+valueOf(c),0),pendingTotal:pending.reduce((n,c)=>n+valueOf(c),0)};
  }
  function byMonth(list) {
    const set = new Set([currentMonth()]);
    list.forEach(c=>{let k=isPaid(c)?month(receivedDate(c)):month(dueDate(c));if(validMonth(k))set.add(k)});
    return [...set].sort().reverse().map(k=>summary(list,k));
  }
  function totals(list) {
    const paid = list.filter(isPaid), pending = list.filter(c=>!isPaid(c));
    return {paidTotal:paid.reduce((n,c)=>n+valueOf(c),0),pendingTotal:pending.reduce((n,c)=>n+valueOf(c),0),paidCount:paid.length,pendingCount:pending.length};
  }
  async function read() {
    if(!window.EFCobranca?.exportData)throw Error('O módulo Cobranças ainda não foi carregado.');
    if(window.EF_Security?.isConfigured?.() && !window.EF_Security.key) throw Error('Desbloqueie o cofre em Configurações para visualizar os lançamentos financeiros.');
    const result=await window.EFCobranca.exportData();
    if(!Array.isArray(result))throw Error('Não foi possível ler o histórico financeiro.');
    return result;
  }
  function renderTable(items, paid) {
    if(!items.length)return '<p class="ef-fin-empty">Nenhum lançamento neste período.</p>';
    const sorted=[...items].sort((a,b)=>String(paid?receivedDate(b):dueDate(b)).localeCompare(String(paid?receivedDate(a):dueDate(a))));
    return `<div class="ef-fin-table-wrap"><table class="ef-fin-table"><thead><tr><th>${paid?'Recebido em':'Vencimento'}</th><th>Cliente</th><th>Serviço</th><th>Forma</th><th class="ef-fin-num">Valor</th></tr></thead><tbody>${sorted.map(c=>`<tr><td>${displayDate(paid?receivedDate(c):dueDate(c))}</td><td>${safe(recordNames(c))}</td><td>${safe(c.servicoNome||'Serviço')}</td><td>${safe(({'pix':'Pix','credito':'Crédito','debito':'Débito','dinheiro':'Dinheiro'})[c.formaPagamento]||'—')}</td><td class="ef-fin-num">${money(valueOf(c))}</td></tr>`).join('')}</tbody></table></div>`;
  }
  function render(rowsList) {
    const r=summary(rowsList,selected), t=totals(rowsList);
    $('ef-fin-period-label').textContent=monthName(selected);
    $('ef-fin-recebido').textContent=money(r.paidTotal);
    $('ef-fin-pendente').textContent=money(r.pendingTotal);
    $('ef-fin-recebido-count').textContent=`${r.paid.length} recebimento(s)`;
    $('ef-fin-pendente-count').textContent=`${r.pending.length} cobrança(s) a receber`;
    $('ef-fin-geral').textContent=money(t.pendingTotal);
    $('ef-fin-current').textContent=monthName(currentMonth());
    $('ef-fin-month').value=selected;
    $('ef-fin-paid-table').innerHTML=renderTable(r.paid,true);
    $('ef-fin-pending-table').innerHTML=renderTable(r.pending,false);
    const months=byMonth(rowsList);
    if(!months.some(m=>m.month===selected))months.push(r);
    months.sort((a,b)=>b.month.localeCompare(a.month));
    $('ef-fin-months').innerHTML=months.map(m=>`<button class="ef-fin-monthrow ${m.month===selected?'is-active':''}" type="button" data-month="${m.month}" aria-label="Ver ${safe(monthName(m.month))}"><span>${safe(monthName(m.month))}</span><strong>${money(m.paidTotal)}</strong><span>${money(m.pendingTotal)}</span><small>${m.paid.length+m.pending.length} registro(s)</small></button>`).join('');
    // No dia 1º, o caixa atual começa em zero, enquanto os períodos anteriores são preservados.
    const active=summary(rowsList,currentMonth());
    const set=(id,v)=>{const el=$(id);if(el)el.textContent=v;};
    set('cob-kpi-faturado-mes',money(active.paidTotal));
    set('cob-kpi-faturado-qtd',`${active.paid.length} recebimento(s) neste mês`);
    set('cob-kpi-pendente-mes',money(active.pendingTotal));
    set('cob-kpi-pendente-qtd',`${active.pending.length} vencimento(s) neste mês`);
  }
  async function refresh() {
    if(!$('ef-fin-panel'))return;
    const run=++seq;
    try {
      const data=await read();if(run!==seq)return;
      locked=false;rows=data;
      $('ef-fin-security').hidden=true;
      render(data);lastMonth=currentMonth();
    } catch(e) {
      if(run!==seq)return;
      rows=[];locked=true;
      $('ef-fin-security').textContent=e.message;
      $('ef-fin-security').hidden=false;
      ['ef-fin-recebido','ef-fin-pendente','ef-fin-geral'].forEach(id=>{if($(id))$(id).textContent='—'});
      ['ef-fin-paid-table','ef-fin-pending-table','ef-fin-months'].forEach(id=>{if($(id))$(id).textContent='Dados protegidos ou indisponíveis.'});
    }
  }
  function setMonth(x) { if(!validMonth(x))return;selected=x;if(!locked)render(rows); }
  function shiftMonth(n) {let y=Number(selected.slice(0,4)),m=Number(selected.slice(5));const d=new Date(y,m-1+n,1);setMonth(`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`);}
  function printTables(r) {
    const tr=(records,paid)=>records.map(c=>`<tr><td>${safe(displayDate(paid?receivedDate(c):dueDate(c)))}</td><td>${safe(recordNames(c))}</td><td>${safe(c.servicoNome||'Serviço')}</td><td>${safe(({'pix':'Pix','credito':'Crédito','debito':'Débito','dinheiro':'Dinheiro'})[c.formaPagamento]||'—')}</td><td class="right">${safe(money(valueOf(c)))}</td></tr>`).join('');
    return `<section class="period"><h2>${safe(monthName(r.month))}</h2><div class="stats"><div><b>Recebido</b><strong>${money(r.paidTotal)}</strong><small>${r.paid.length} lançamentos</small></div><div><b>A receber</b><strong>${money(r.pendingTotal)}</strong><small>${r.pending.length} pendências</small></div></div>${[['Recebimentos','Recebido em',r.paid,true],['A receber','Vencimento',r.pending,false]].map(([label,dt,items,paid])=>`<h3>${label}</h3><table><thead><tr><th>${dt}</th><th>Cliente</th><th>Serviço</th><th>Pagamento</th><th class="right">Valor</th></tr></thead><tbody>${items.length?tr(items,paid):'<tr><td colspan="5">Sem lançamentos no período.</td></tr>'}</tbody></table>`).join('')}</section>`;
  }
  function printHtml(list, all) {
    const title=all?'Histórico financeiro completo':`Histórico financeiro — ${monthName(selected)}`;
    const periods=all?byMonth(list):[summary(list,selected)];
    const allTotals=totals(list);
    const nome=localStorage.getItem('evolufisico_pro_nome')||'Profissional não informado';
    const cref=localStorage.getItem('evolufisico_pro_cref')||'';
    const clinica=localStorage.getItem('evolufisico_pro_clinica')||'';
    return `<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${safe(title)}</title><style>
    *{box-sizing:border-box}html,body{margin:0;font:13px/1.45 system-ui,Arial,sans-serif;color:#152d25;background:#eef4f0} .toolbar{position:sticky;top:0;display:flex;gap:12px;align-items:center;justify-content:space-between;padding:13px 20px;background:#10382c;color:white;z-index:10}.toolbar span{font-weight:650}.buttons{display:flex;gap:9px;flex-wrap:wrap}.toolbar button{padding:10px 15px;border:1px solid #c9e8d8;border-radius:9px;font-weight:750;cursor:pointer;background:transparent;color:white}.toolbar button.primary{background:#b8eed0;color:#143e2c}.sheet{max-width:210mm;margin:22px auto;padding:20mm 14mm;background:#fff;box-shadow:0 8px 28px #163b2b22}h1{font-size:23px;margin:0 0 6px;color:#0b4b36}h2{font-size:18px;margin:22px 0 10px;color:#0c5742}h3{font-size:13px;margin:14px 0 5px}p{margin:4px 0;color:#53675d}.stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:12px 0}.stats div{padding:13px;border:1px solid #bfdccb;border-radius:9px}.stats b,.stats strong,.stats small{display:block}.stats strong{font-size:20px;margin:4px 0}.stats small{color:#678477}.summary{padding:10px;border:1px solid #b6d4c5;border-radius:9px;background:#f3faf6}.summary b{display:inline-block;margin-right:20px}table{width:100%;border-collapse:collapse;font-size:11px;table-layout:fixed}th,td{padding:8px 5px;text-align:left;border-bottom:1px solid #d8e4dd;overflow-wrap:anywhere}th{background:#edf7f0;color:#194b34}.right{text-align:right}.period{break-inside:auto}thead{display:table-header-group}tr{break-inside:avoid}.notice{font-size:10px;line-height:1.45;color:#617568;margin-top:22px}
    @media(max-width:620px){.toolbar{flex-wrap:wrap;padding:10px}.buttons{width:100%}.buttons button{flex:1}.sheet{margin:0;padding:18px 12px;box-shadow:none}.stats{grid-template-columns:1fr 1fr}table{font-size:10px}th,td{padding:6px 3px}}
    @media print{@page{size:A4;margin:12mm}html,body{background:white}.toolbar{display:none!important}.sheet{max-width:none;box-shadow:none;margin:0;padding:0}.period{break-before:auto}h2,h3{break-after:avoid}.notice{color:#515c54}}
    </style></head><body><main class="sheet"><header><h1>EvoluFísico · Cobranças</h1><p><strong>${safe(title)}</strong></p><p>Profissional: ${safe(nome)}${cref?' · '+safe(cref):''}${clinica?' · '+safe(clinica):''}</p><p>Emitido em ${displayDate(localToday())}</p></header>${all?`<div class="summary"><b>Recebido no histórico: ${money(allTotals.paidTotal)}</b><b>A receber: ${money(allTotals.pendingTotal)}</b><b>Registros: ${list.length}</b></div>`:''}${periods.map(printTables).join('')}<p class="notice">Caixa mensal: valores pagos agrupados pela data do recebimento; valores a receber agrupados pelo vencimento. As cobranças antigas sem data própria de pagamento usam a data do lançamento como referência. Documento gerencial baseado nos registros do aplicativo; não equivale a extrato bancário ou documento fiscal.</p></main>
</body></html>`;
  }
  async function generatePDF(all) {
    // Imprimir diretamente sem abrir uma aba de prévia. Dados cifrados continuam
    // sujeitos às mesmas validações de acesso existentes no módulo financeiro.
    const alertBox=$('ef-fin-security');
    try {
      const list=await read();
      const html=printHtml(list,all);
      const frame=document.createElement('iframe');
      frame.title='Impressão financeira direta';
      frame.setAttribute('aria-hidden','true');
      frame.style.cssText='position:fixed;left:0;top:0;width:1px;height:1px;border:0;opacity:0;pointer-events:none;z-index:-1';
      let loaded=false,removed=false;
      const cleanup=()=>{if(removed)return;removed=true;window.setTimeout(()=>frame.remove(),700)};
      frame.addEventListener('load',()=>{
        if(loaded)return;loaded=true;
        try {
          const printWindow=frame.contentWindow;
          printWindow.addEventListener('afterprint',cleanup,{once:true});
          printWindow.focus();
          printWindow.print();
        } catch(e) {
          cleanup();
          if(alertBox){alertBox.textContent='Não foi possível abrir a impressão diretamente neste navegador. Tente abrir o HTML pelo Chrome ou Edge: '+(e?.message||e);alertBox.hidden=false;}
        }
      },{once:true});
      frame.srcdoc=html;
      document.body.append(frame);
      // Alguns navegadores não disparam afterprint quando o usuário cancela.
      window.setTimeout(()=>{if(frame.isConnected)frame.remove()},65000);
      if(alertBox)alertBox.hidden=true;
    } catch(e) {
      if(alertBox){alertBox.textContent=e?.message||'Erro ao preparar relatório.';alertBox.hidden=false;}
    }
  }
  function init() {
    if(ready||!$('ef-fin-panel'))return;ready=true;
    $('ef-fin-month').addEventListener('change',e=>setMonth(e.target.value));
    $('ef-fin-prev').addEventListener('click',()=>shiftMonth(-1));
    $('ef-fin-next').addEventListener('click',()=>shiftMonth(1));
    $('ef-fin-today').addEventListener('click',()=>setMonth(currentMonth()));
    $('ef-fin-pdf-month').addEventListener('click',()=>generatePDF(false));
    $('ef-fin-pdf-total').addEventListener('click',()=>generatePDF(true));
    $('ef-fin-months').addEventListener('click',e=>{const x=e.target.closest('[data-month]');if(x)setMonth(x.dataset.month)});
    document.addEventListener('visibilitychange',()=>{if(!document.hidden){if(currentMonth()!==lastMonth)selected=currentMonth();refresh()}});
    refresh();
    // Troca de competência automaticamente à meia-noite, inclusive com a aba aberta.
    window.setInterval(()=>{if(!document.hidden && currentMonth()!==lastMonth){selected=currentMonth();refresh()}},60000);
  }
  window.EFBillingMonthly={init,refresh,setMonth,generatePDF,utils:{summary,byMonth,totals,receivedDate,dueDate,localToday,month}};
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();

</script>
<style>/* 17-styles.css */
/* Correção estrutural: layout, navegação, painel e tema escuro */
html { color-scheme: light; }
html.ef-dark-mode { color-scheme: dark; }
body { width:100%; max-width:100%; overflow-x:hidden; }
.top-navbar { min-width:0; }
.brand-wrapper, .nav-actions, .nav-tabs { min-width:0; }
.nav-actions { flex-wrap:wrap !important; }
.nav-tabs { max-width:100%; }
.main-wrapper, .form-container, .tab-panel, .cob-container { min-width:0; }
.tab-panel { display:none; }
.tab-panel.active { display:block !important; opacity:1; filter:none; }
.dashboard-kpi-grid, .form-grid, .photo-studio-grid {
  min-width:0; grid-template-columns:repeat(auto-fit,minmax(min(220px,100%),1fr));
}
.dashboard-kpi-grid > *, .kpi-card, .history-card { min-width:0; }
img, video, canvas, svg { max-width:100%; }
button, input, select, textarea { max-width:100%; }
@media (max-width: 900px) {
  .top-navbar { align-items:flex-start !important; }
  .nav-tabs { order:3; width:100%; }
  .nav-actions { margin-left:auto; }
}
@media (max-width: 600px) {
  .top-navbar { padding:.6rem .75rem !important; }
  .brand-title { font-size:1rem !important; }
  .main-wrapper { padding-left:.75rem !important; padding-right:.75rem !important; }
  .dashboard-kpi-grid { grid-template-columns:repeat(2,minmax(0,1fr)) !important; gap:.65rem !important; }
  .cob-workspace-grid { grid-template-columns:minmax(0,1fr) !important; }
  .cob-hero-card { position:static !important; }
}
/* Tema escuro redesenhado a partir do padrão visual do módulo Lab (ef77):
   superfícies sólidas, bordas discretas, texto de alto contraste e azul de destaque.
   Sem inversão global de cores/filtros, para preservar gráficos, fotos e componentes. */
html.ef-dark-mode {
  color-scheme: dark;
  --bg-color:#111827;
  --surface-color:#1b2432;
  --surface-secondary:#202c3d;
  --surface-card:#1b2432;
  --bg-card:#1b2432;
  --border-color:#344256;
  --text-main:#f3f6fb;
  --text-muted:#a8b4c5;
  --text-light:#8796aa;
  --slate-50:#1b2432;
  --slate-100:#202c3d;
  --slate-200:#344256;
  --slate-300:#46566d;
  --slate-600:#b9c5d5;
  --slate-700:#d0d9e5;
  --slate-800:#e2e9f2;
  --slate-900:#f3f6fb;
  background:#111827 !important;
  color:#f3f6fb;
}
html.ef-dark-mode body {
  background:#111827 !important;
  color:#f3f6fb !important;
}
html.ef-dark-mode .top-navbar {
  background:rgba(17,24,39,.96) !important;
  border-bottom-color:#344256 !important;
  color:#f3f6fb !important;
}
html.ef-dark-mode .nav-tabs {
  background:#1b2432 !important;
  border-color:#344256 !important;
}
html.ef-dark-mode .nav-tab-btn { color:#b9c5d5 !important; }
