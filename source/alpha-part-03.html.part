    max-width: 100% !important;
    overflow-wrap: anywhere !important;
    text-align: center !important;
  }
  body.ef-simple-ui .ef55-row { min-width: 0; }
  body.ef-simple-ui .ef55-row > .t { overflow-wrap: anywhere; }
  body.ef-simple-ui .step-indicator:focus,
  body.ef-simple-ui .step-indicator:focus-visible,
  body.ef-simple-ui .step-indicator.active:focus .step-dot,
