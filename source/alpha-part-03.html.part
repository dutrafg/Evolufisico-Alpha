<style>/* 13-styles.css */
.ef70-card{margin-top:14px;border:1px solid var(--border-color,#e2e8f0);border-radius:16px;background:var(--card-bg,#fff);box-shadow:0 4px 18px rgba(15,23,42,.06);overflow:hidden}
.ef70-head{display:flex;justify-content:space-between;gap:16px;padding:18px 20px;border-bottom:1px solid var(--border-color,#e2e8f0)}
.ef70-head h3{margin:0;font-size:1.05rem}.ef70-head p{margin:5px 0 0;color:var(--text-muted,#64748b);font-size:.82rem}.ef70-badge{display:flex;align-items:center;gap:7px;white-space:nowrap;font-size:.76rem;font-weight:700;padding:7px 10px;border-radius:999px;background:#f1f5f9;color:#334155}
.ef70-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;padding:14px 20px}.ef70-stat{padding:13px;border:1px solid #e2e8f0;border-radius:12px;background:#f8fafc}.ef70-stat small{display:block;color:#64748b;font-size:.72rem}.ef70-stat strong{display:block;font-size:1.35rem;margin-top:4px}.ef70-stat span{font-size:.72rem;color:#64748b}
.ef70-body{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(260px,.65fr);gap:14px;padding:0 20px 20px}.ef70-section{border:1px solid #e2e8f0;border-radius:12px;padding:14px}.ef70-section h4{margin:0 0 10px;font-size:.86rem}.ef70-row{display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-bottom:1px solid #eef2f7}.ef70-row:last-child{border-bottom:0}.ef70-icon{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:#f1f5f9;font-weight:800;flex:none}.ef70-main{min-width:0;flex:1}.ef70-main b{font-size:.82rem}.ef70-main p{margin:3px 0 0;font-size:.76rem;color:#64748b;line-height:1.4}.ef70-pill{display:inline-block;margin-left:6px;padding:2px 6px;border-radius:999px;background:#f1f5f9;color:#475569;font-size:.66rem}.ef70-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}.ef70-action{font-size:.74rem;padding:7px 9px;border-radius:8px;background:#f8fafc;border:1px solid #e2e8f0}.ef70-foot{padding:10px 20px;border-top:1px solid #eef2f7;color:#94a3b8;font-size:.68rem;text-align:right}
@media(max-width:800px){.ef70-body{grid-template-columns:1fr}.ef70-head{flex-direction:column}.ef70-badge{width:max-content}}
</style>
<script>/* 13-runtime.js */
