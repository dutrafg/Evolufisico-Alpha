  }
  body.ef-simple-ui :is(.ef-help-btn, #comp-period-badge, .history-badge, .ef70-badge, .ef-nav-count) {
    background: var(--ef-soft) !important;
  }
  body.ef-simple-ui :is(.cob-chip.active, .ef77-btn.pri, #ef77-csv) {
    background: var(--ef-primary-bg) !important;
    border-color: var(--ef-primary-bg) !important;
