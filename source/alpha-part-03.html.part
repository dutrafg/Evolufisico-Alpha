  }
  html.ef-dark-mode body.ef-simple-ui :is(#tab-comparison, #tab-cobranca, #tab-historico, #tab-novo-checkin, #tab-lab77) :is(input, select, textarea):not([type=checkbox]):not([type=radio]):not([type=range]):not([type=file]) {
