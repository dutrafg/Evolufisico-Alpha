  body.ef-simple-ui .ef55-av { width: 36px; height: 36px; }
}

/* ---------- Escuro: ajustes finos ---------- */
html.ef-dark-mode body.ef-simple-ui .top-navbar > .nav-tabs,
body.ef-simple-ui.dark-mode .top-navbar > .nav-tabs {
  --ef-nav-shadow: rgba(0, 0, 0, .6);
}
