<style id="ef-125-essential-macos-feedback" media="screen">
/* Essencial: hierarquia por contorno, área clicável e tipografia, sem sombra 3D. */
body.ef-simple-ui[data-efx-visual="essential"]{
 --ef-essential-hairline:color-mix(in srgb,var(--ef-theme-main,#3478c3) 22%,var(--ef-line,#dae4e6));
 --ef-essential-active:color-mix(in srgb,var(--ef-theme-main,#3478c3) 12%,var(--ef-surface,#fff));
}
body.ef-simple-ui[data-efx-visual="essential"] :is(
 .efh-stat,.efh-panel,.efh-card,.efh-strategy-kpi,.eforg-card,.eforg-stat,
 .ef-settings-card,.ef-proto-card,.history-card,.ef-history-folder,.ef55-card,
 .cob-card,.cob-kpi-card,#ef-fin-panel,.ef-fin-block
){box-shadow:none!important;filter:none!important;transform:none!important;
 border:1px solid var(--ef-essential-hairline)!important;
 border-radius:12px!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important;
 transition:border-color .16s ease,background-color .16s ease!important;
}
body.ef-simple-ui[data-efx-visual="essential"] :is(
 .efh-stat,.efh-panel,.eforg-card,.ef-settings-card,.cob-card,.history-card
):hover{transform:none!important;box-shadow:none!important;border-color:color-mix(in srgb,var(--ef-theme-main) 40%,var(--ef-line))!important}
body.ef-simple-ui[data-efx-visual="essential"] :is(.btn,.efh-btn,.eforg-button,.ef-settings-action,.ef-fin-btn,.efm-item){
 transform:none!important;box-shadow:none!important;filter:none!important;
 transition:background-color .14s ease,border-color .14s ease,color .14s ease!important;
}
body.ef-simple-ui[data-efx-visual="essential"] :is(
 .eforg-tab[aria-selected="true"],.eforg-filter[aria-pressed="true"],
 #tab-settings .efs-tabs button[aria-pressed="true"],.efl-choice[aria-pressed="true"],
 #efx-appearance-controls .efx-option[aria-pressed="true"]
){background:var(--ef-essential-active)!important;border-color:var(--ef-theme-main)!important;box-shadow:none!important}
body.ef-simple-ui[data-efx-visual="essential"] :is(input,select,textarea):not([type=checkbox]):not([type=radio]):not([type=range]){
 border-radius:10px!important;box-shadow:none!important;transition:border-color .16s ease!important;
}
body.ef-simple-ui[data-efx-visual="essential"] :is(button,input,select,textarea):focus-visible{
 outline:2px solid var(--ef-theme-main)!important;outline-offset:2px!important;
}
body.ef-simple-ui[data-efx-visual="essential"] :is(#tab-settings .efs-section-title h3,.efh-section-top h2,.eforg-section-title,.cob-card-title){
 letter-spacing:-.015em!important;font-weight:750!important;
}
body.ef-simple-ui[data-efx-visual="essential"] :is(.top-navbar,.efm-panel,.efm-trigger,#ef-workspace-heading,.efg-dialog){
 backdrop-filter:none!important;-webkit-backdrop-filter:none!important;
}
/* macOS-inspired in-app feedback: opaque enough for legibility in both themes. */
body.ef-simple-ui #ef55-toasts,#ef55-toasts{
 position:fixed!important;top:calc(17px + env(safe-area-inset-top,0px))!important;right:18px!important;
 bottom:auto!important;left:auto!important;transform:none!important;
 width:min(360px,calc(100vw - 36px))!important;max-width:min(360px,calc(100vw - 36px))!important;
 display:flex!important;flex-direction:column!important;align-items:stretch!important;
 gap:10px!important;z-index:2147480000!important;padding:0!important;
 pointer-events:none!important;
}
#ef55-toasts .ef55-toast.efmac-toast,body.ef-simple-ui #ef55-toasts .ef55-toast.efmac-toast{
 --efmac-bg:color-mix(in srgb,var(--ef-surface,#fff) 97%,#edf1f6);
 --efmac-stroke:color-mix(in srgb,var(--ef-theme-main,#3578be) 18%,#ccd5dd);
 --efmac-fg:var(--ef-ink,#152336);--efmac-desc:var(--ef-muted,#4f6072);
 --efmac-accent:var(--ef-theme-deep,#2d619c);
 display:grid!important;grid-template-columns:40px minmax(0,1fr) 24px!important;gap:11px!important;
 align-items:start!important;position:relative!important;box-sizing:border-box!important;
 width:100%!important;max-width:100%!important;min-width:0!important;
 padding:13px 12px 13px 13px!important;border-radius:16px!important;
 background:var(--efmac-bg)!important;color:var(--efmac-fg)!important;
 border:1px solid var(--efmac-stroke)!important;
 box-shadow:0 7px 24px rgba(15,30,50,.13),0 1px 2px rgba(15,30,50,.08)!important;
 font:inherit!important;text-align:left!important;cursor:default!important;
 backdrop-filter:none!important;-webkit-backdrop-filter:none!important;
 user-select:text!important;-webkit-user-select:text!important;
 pointer-events:auto!important;overflow:hidden!important;overflow-wrap:anywhere!important;
 animation:efmac-enter .22s ease-out both!important;transition:opacity .18s ease,transform .18s ease!important;
}
:is(html.ef-dark-mode body.ef-simple-ui,body.ef-simple-ui.dark-mode) #ef55-toasts .ef55-toast.efmac-toast,
html.ef-dark-mode #ef55-toasts .ef55-toast.efmac-toast{
 --efmac-bg:color-mix(in srgb,var(--ef-theme-main,#284b73) 9%,#1b2532);
 --efmac-stroke:color-mix(in srgb,var(--ef-theme-main,#466f9f) 23%,#445263);
 --efmac-fg:#f0f4fa;--efmac-desc:#c2cbd8;--efmac-accent:color-mix(in srgb,var(--ef-theme-main,#6aa1e9) 65%,#e8f2ff);
 box-shadow:0 7px 24px rgba(0,0,0,.24),0 1px 3px rgba(0,0,0,.18)!important;
}
#ef55-toasts .efmac-icon{
 width:38px;height:38px;display:grid;place-items:center;border-radius:11px;
 background:color-mix(in srgb,var(--efmac-accent) 11%,var(--efmac-bg));color:var(--efmac-accent);
 border:1px solid color-mix(in srgb,var(--efmac-accent) 16%,transparent);flex:none;
}
#ef55-toasts .efmac-icon svg{width:21px;height:21px}
#ef55-toasts .efmac-warning{--efmac-accent:#b66a0a!important}
#ef55-toasts .efmac-error{--efmac-accent:#c13d42!important}
#ef55-toasts .efmac-success{--efmac-accent:#128056!important}
:is(html.ef-dark-mode body.ef-simple-ui,body.ef-simple-ui.dark-mode) #ef55-toasts .efmac-warning{--efmac-accent:#ffcd80!important}
:is(html.ef-dark-mode body.ef-simple-ui,body.ef-simple-ui.dark-mode) #ef55-toasts .efmac-error{--efmac-accent:#ff9a9e!important}
:is(html.ef-dark-mode body.ef-simple-ui,body.ef-simple-ui.dark-mode) #ef55-toasts .efmac-success{--efmac-accent:#83deae!important}
#ef55-toasts .efmac-copy{display:flex;flex-direction:column;min-width:0;gap:3px;padding-top:2px}
#ef55-toasts .efmac-title{color:var(--efmac-fg)!important;display:block;font-size:13px;font-weight:750;line-height:1.3;letter-spacing:-.008em}
#ef55-toasts .efmac-message{color:var(--efmac-desc)!important;display:block;font-size:12px;line-height:1.5;margin:0!important;max-height:min(18vh,150px);overflow:auto;overflow-wrap:anywhere}
#ef55-toasts .efmac-close{
 appearance:none;display:grid;place-items:center;min-width:24px;width:24px;height:26px;
 padding:0!important;border:0!important;border-radius:7px;
 background:transparent!important;color:var(--efmac-desc)!important;font:400 22px/1 system-ui,sans-serif!important;
 cursor:pointer!important;box-shadow:none!important;
}
#ef55-toasts .efmac-close:hover{background:color-mix(in srgb,var(--efmac-accent) 12%,transparent)!important;color:var(--efmac-fg)!important}
#ef55-toasts .efmac-close:focus-visible{outline:2px solid var(--efmac-accent)!important;outline-offset:2px!important}
#ef55-toasts .efmac-toast.out{opacity:0!important;transform:translateY(-8px)!important;pointer-events:none!important}
@keyframes efmac-enter{from{opacity:0;transform:translateY(-9px)}to{opacity:1;transform:translateY(0)}}
@media(max-width:600px){
 body.ef-simple-ui #ef55-toasts,#ef55-toasts{
 top:calc(70px + env(safe-area-inset-top,0px))!important;left:12px!important;right:12px!important;
 width:auto!important;max-width:none!important;
 }
 #ef55-toasts .ef55-toast.efmac-toast{padding:11px 11px 11px 12px!important;gap:9px!important;grid-template-columns:36px minmax(0,1fr) 24px!important}
 #ef55-toasts .efmac-icon{width:34px;height:34px;border-radius:10px}
}
@media(prefers-reduced-motion:reduce){
 #ef55-toasts .ef55-toast.efmac-toast{animation:none!important;transition:none!important}
 body.ef-simple-ui[data-efx-visual="essential"] *{scroll-behavior:auto!important}
}
@media print{#ef55-toasts,.efmac-toast{display:none!important}}
</style>

<style id="ef-126-general-preferences-css" media="screen">
html.efg-no-splash #ef-splash{display:none!important}
/* Controles nativos, sólidos e adaptados ao tema, sem modificar a paleta. */
body.ef-simple-ui #ef-general-behavior,body.ef-simple-ui #ef-general-accessibility{min-width:0}
body.ef-simple-ui .efg-general-list{width:100%;display:grid;gap:0;align-content:start}
body.ef-simple-ui .efg-general-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center;min-width:0;padding:15px 0;border-top:1px solid var(--ef-line,#d9e1e6)}
body.ef-simple-ui .efg-general-row:first-child{padding-top:0;border-top:0}
body.ef-simple-ui .efg-general-copy{min-width:0;display:flex;flex-direction:column;gap:4px}
/* O gerador genérico de ajuda clínica adiciona '?' a labels; os controles de Geral já trazem ajuda específica. */
body.ef-simple-ui .efg-general-row>.ef-help-btn{display:none!important}
body.ef-simple-ui .efg-general-copy b{font-size:13px;line-height:1.4;font-weight:740;color:var(--ef-ink,#19342e)}
body.ef-simple-ui .efg-general-copy small{font-size:11px;line-height:1.5;margin:0;color:var(--ef-muted,#687b74)}
body.ef-simple-ui .efg-general-list select{font:inherit;font-size:12px;font-weight:680;min-height:42px;max-width:168px;width:100%;border-radius:10px;padding:8px 26px 8px 10px;border:1px solid var(--ef-line,#bdc8c6);background:var(--ef-surface,#fff);color:var(--ef-ink,#152e25);color-scheme:normal;cursor:pointer}
html.ef-dark-mode body.ef-simple-ui .efg-general-list select,body.ef-simple-ui.dark-mode .efg-general-list select{color-scheme:dark}
body.ef-simple-ui .efg-general-list input[type=checkbox]{appearance:none;width:45px;height:26px;min-width:45px;margin:0;border-radius:99px;background:var(--ef-line,#d8e0e3);border:1px solid var(--ef-line,#bdcbd0);position:relative;cursor:pointer;transition:background-color .16s,border-color .16s}
body.ef-simple-ui .efg-general-list input[type=checkbox]::after{content:'';position:absolute;width:20px;height:20px;left:2px;top:2px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.2);transition:transform .16s}
body.ef-simple-ui .efg-general-list input[type=checkbox]:checked{background:var(--ef-theme-main,var(--ef-accent,#217957));border-color:var(--ef-theme-main,var(--ef-accent,#217957))}
body.ef-simple-ui .efg-general-list input[type=checkbox]:checked::after{transform:translateX(19px)}
body.ef-simple-ui .efg-general-list :is(input,select,button):focus-visible{outline:2px solid var(--ef-accent,#26765a);outline-offset:3px}
body.ef-simple-ui .efg-general-footer{width:100%;display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:12px;border-top:1px solid var(--ef-line,#dbe2df);padding-top:15px}
body.ef-simple-ui .efg-general-reset{background:var(--ef-soft,#eef5f1);border:1px solid var(--ef-line,#d7e2de);color:var(--ef-ink,#16382e);padding:10px 14px;min-height:42px;border-radius:10px;font:inherit;font-size:12px;font-weight:740;cursor:pointer}
body.ef-simple-ui .efg-general-reset:hover{border-color:var(--ef-accent,#167653)}
body.ef-simple-ui .efg-general-note{font-size:11px;color:var(--ef-muted);line-height:1.45}
/* Apenas leitura em tela: não oculta fontes de dados, exportação ou impressão. */
body.efg-general-mask-finance #tab-cobranca :is(
 .cob-kpi-val,.ef-fin-kpi strong,.ef-fin-num,.ef-fin-monthrow strong,.ef-fin-monthrow>span:nth-child(3),
 #cob-hero-valor-total,#cob-hero-valor-parcela,.cob-table td.cob-valor,#cob-history-total-value
),body.efg-general-mask-finance #tab-painel :is(#efh-finance-kpi,.efh-finance-row>b){
 filter:blur(7px)!important;user-select:none!important;-webkit-user-select:none!important;
}
html.efg-general-large-type{font-size:112%!important}
body.efg-general-low-motion *,body.efg-general-low-motion *::before,body.efg-general-low-motion *::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
@media(max-width:520px){body.ef-simple-ui .efg-general-row{gap:9px}body.ef-simple-ui .efg-general-list select{max-width:134px}body.ef-simple-ui .efg-general-copy b{font-size:12px}body.ef-simple-ui .efg-general-copy small{font-size:11px}}
@media print{html.efg-general-large-type{font-size:100%!important}body.efg-general-mask-finance :is(.cob-kpi-val,.ef-fin-kpi strong){filter:none!important}}
</style>

<script id="ef-126-general-preferences-script">
(function(){
'use strict';
const KEY={startup:'ef_general_startup_v1',splash:'ef_general_splash_v1',confirm:'ef_general_confirm_reset_v1',mask:'ef_general_mask_finance_v1',font:'ef_general_font_v1',motion:'ef_general_motion_v1'};
const DEFAULT={startup:'home',splash:'1',confirm:'1',mask:'0',font:'standard',motion:'0'};
const allowedModules=new Set(['tab-painel','tab-organizacao','tab-historico','tab-comparison','tab-lab77','tab-ef-forms','tab-analises','tab-cobranca','tab-settings','tab-novo-checkin']);
const $=id=>document.getElementById(id);
function get(k){let v=null;try{v=localStorage.getItem(KEY[k])}catch(_){};if(v===null)return DEFAULT[k];if(k==='startup')return ['home','last'].includes(v)?v:DEFAULT[k];if(k==='font')return ['standard','large'].includes(v)?v:DEFAULT[k];return v==='0'||v==='1'?v:DEFAULT[k]}
function store(k,v){try{localStorage.setItem(KEY[k],v)}catch(e){console.warn('Preferência temporária',k,e)}apply()}
function apply(){
 document.documentElement.classList.toggle('efg-no-splash',get('splash')==='0');
 document.documentElement.classList.toggle('efg-general-large-type',get('font')==='large');
 if(document.body){document.body.classList.toggle('efg-general-low-motion',get('motion')==='1');document.body.classList.toggle('efg-general-mask-finance',get('mask')==='1')}
 Object.keys(KEY).forEach(k=>{const el=$('ef-general-'+k);if(el){if(el.type==='checkbox')el.checked=get(k)==='1';else el.value=get(k)}});
}
function mount(){
 const grid=document.querySelector('#tab-settings .efs-subpage[data-efs-panel="geral"] > .ef-settings-grid');
 if(!grid||$('ef-general-behavior'))return;
 const behavior=document.createElement('article');behavior.id='ef-general-behavior';behavior.className='ef-settings-card';
 behavior.innerHTML=`<div class="ef-settings-card-icon" aria-hidden="true">⚙</div><h3>Funcionamento do Aplicativo</h3><p>Ajuste a abertura, a confirmação de ações e a exposição visual de valores.</p>
 <div class="efg-general-list">
 <label class="efg-general-row" for="ef-general-startup"><span class="efg-general-copy"><b>Ao iniciar o aplicativo</b><small>Abra no Início ou continue no último módulo utilizado.</small></span><select id="ef-general-startup"><option value="home">Abrir Início</option><option value="last">Último módulo</option></select></label>
 <label class="efg-general-row" for="ef-general-splash"><span class="efg-general-copy"><b>Tela de abertura</b><small>Exibir a apresentação inicial ao abrir o aplicativo.</small></span><input id="ef-general-splash" type="checkbox" role="switch"></label>
 <label class="efg-general-row" for="ef-general-confirm"><span class="efg-general-copy"><b>Confirmar limpeza em Cobranças</b><small>Pedir confirmação antes de usar “Limpar / Novo Atendimento”.</small></span><input id="ef-general-confirm" type="checkbox" role="switch"></label>
 <label class="efg-general-row" for="ef-general-mask"><span class="efg-general-copy"><b>Ocultar valores financeiros</b><small>Desfoca alguns totais na tela; não criptografa nem altera os registros.</small></span><input id="ef-general-mask" type="checkbox" role="switch"></label>
 </div>`;
 const comfort=document.createElement('article');comfort.id='ef-general-accessibility';comfort.className='ef-settings-card';
 comfort.innerHTML=`<div class="ef-settings-card-icon" aria-hidden="true">Aa</div><h3>Acessibilidade e Conforto</h3><p>Preferências de leitura e movimento para utilização prolongada.</p>
 <div class="efg-general-list">
 <label class="efg-general-row" for="ef-general-font"><span class="efg-general-copy"><b>Tamanho da fonte</b><small>Amplia textos baseados em unidades adaptativas, sem alterar os PDFs.</small></span><select id="ef-general-font"><option value="standard">Padrão</option><option value="large">Ampliado</option></select></label>
 <label class="efg-general-row" for="ef-general-motion"><span class="efg-general-copy"><b>Reduzir movimentos</b><small>Minimiza animações e transições, inclusive no efeito Avançada.</small></span><input id="ef-general-motion" type="checkbox" role="switch"></label>
 </div><div class="efg-general-footer"><button type="button" class="efg-general-reset" id="ef-general-reset">Restaurar estas preferências</button><span class="efg-general-note">Não apaga avaliações, cobranças ou backups.</span></div>`;
 grid.append(behavior,comfort);
 Object.keys(KEY).forEach(k=>{const el=$('ef-general-'+k);if(el)el.addEventListener('change',()=>{store(k,el.type==='checkbox'?(el.checked?'1':'0'):el.value);if(k==='startup'&&el.value==='last'){try{localStorage.setItem('ef_general_last_module_v1',document.querySelector('.tab-panel.active')?.id||'tab-painel')}catch(_){}}})});
 $('ef-general-reset')?.addEventListener('click',()=>{for(const k of Object.keys(KEY)){try{localStorage.removeItem(KEY[k])}catch(_){}}apply();window.efToast?.('Preferências gerais restauradas.','success')});
 apply();
}
function trackNavigation(){if(window.__efGeneralTracked)return;const previous=window.switchTab;if(typeof previous!=='function')return;window.__efGeneralTracked=true;
 window.switchTab=function(id){const result=previous.apply(this,arguments);if(allowedModules.has(id)){try{localStorage.setItem('ef_general_last_module_v1',id)}catch(_){}}return result};
}
function hookReset(){
 document.addEventListener('click',function(e){const btn=e.target.closest?.('#tab-cobranca .cob-btn-reset-hero');if(!btn||get('confirm')!=='1')return;
 e.preventDefault();e.stopImmediatePropagation();
 if(window.confirm('Limpar os campos do atendimento atual? Os pagamentos já salvos no histórico não serão removidos.')){
  if(window.EFCobranca&&typeof window.EFCobranca.resetarFormulario==='function')window.EFCobranca.resetarFormulario();
 }
 },true);
}
function restoreModule(){if(get('startup')!=='last')return;let last=null;try{last=localStorage.getItem('ef_general_last_module_v1')}catch(_){};
 if(!allowedModules.has(last)||!$(last)||typeof window.switchTab!=='function')return;
 // Only restore after the existing modules have mounted; never overwrite saved form fields.
 window.switchTab(last);
}
function initialize(){mount();apply();trackNavigation();hookReset();setTimeout(restoreModule,500)}
window.EFGeneralPreferences={get,apply,mount,version:'1.0.30 Pré-Beta'};
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initialize,{once:true});else initialize();
})();
</script>
<style id="ef127-tablet-navigation-polish" media="screen">
/* Corrige a sobreposição da barra de rolagem com o item ativo no layout Estendido.
   Separação geométrica: linha de botões (60px) + indicador independente (6px).
   Sem mudanças em cores/funcionalidades; controles de rolagem originais preservados. */
@media (min-width:601px){
 body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs{
  width:min(760px,calc(100vw - 28px))!important;
  max-width:min(760px,calc(100vw - 28px))!important;
  box-sizing:border-box!important;
  height:94px!important;
  min-height:94px!important;
  max-height:94px!important;
  padding:10px 10px 24px!important;
  align-items:flex-start!important;
  gap:6px!important;
  overflow-x:auto!important;
  overflow-y:hidden!important;
  scroll-padding-inline:12px;
  scroll-snap-type:none!important;
  touch-action:pan-x!important;
  border-radius:20px!important;
 }
 body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs > .nav-tab-btn{
  box-sizing:border-box!important;
  display:flex!important;
  position:relative!important;
  flex:0 0 110px!important;
  width:110px!important;
  min-width:110px!important;
  max-width:110px!important;
  min-height:60px!important;
  height:60px!important;
  max-height:60px!important;
  flex-direction:column!important;
  justify-content:center!important;
  align-items:center!important;
  gap:4px!important;
  margin:0!important;
  padding:6px 8px 8px!important;
  overflow:hidden!important;
  white-space:nowrap!important;
  border-radius:12px!important;
  line-height:1.12!important;
  text-align:center!important;
  scroll-snap-align:center!important;
 }
 body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs > .nav-tab-btn > span:not(.ef-nav-count){
  display:block!important;
  max-width:100%!important;
  overflow:hidden!important;
  white-space:nowrap!important;
  text-overflow:ellipsis!important;
  line-height:1.2!important;
 }
 body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs > .nav-tab-btn > .ef-nav-count{
  display:inline-flex!important;
  position:absolute!important;
  top:3px!important;
  right:4px!important;
  bottom:auto!important;
  left:auto!important;
  z-index:2!important;
  box-sizing:border-box!important;
  min-width:17px!important;
  width:auto!important;
  height:17px!important;
  min-height:17px!important;
  margin:0!important;
  padding:0 4px!important;
  align-items:center!important;
  justify-content:center!important;
  line-height:1!important;
  font-size:10px!important;
  border-radius:99px!important;
  pointer-events:none!important;
 }
 body.ef-simple-ui[data-ef-layout="extended"] #ef111-scrollbar{
  width:min(714px,calc(100vw - 72px))!important;
  height:14px!important;
  bottom:calc(18px + env(safe-area-inset-bottom,0px))!important;
  z-index:1502!important;
 }
 body.ef-simple-ui[data-ef-layout="extended"] #ef111-scrollbar::before,
 body.ef-simple-ui[data-ef-layout="extended"] #ef111-scrollbar-thumb{
  top:5px!important;
  height:5px!important;
 }
}
@media (min-width:601px) and (max-width:760px){
 body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs > .nav-tab-btn{
  flex-basis:104px!important;width:104px!important;min-width:104px!important;max-width:104px!important;
 }
}
@media (prefers-reduced-motion:reduce){
 body.ef-simple-ui[data-ef-layout="extended"] .top-navbar > nav.nav-tabs {scroll-behavior:auto!important;}
}
</style>
<style id="ef-icons-css">.efi{display:inline-block;width:1.1em;height:1.1em;vertical-align:-.18em;flex:none;line-height:1}.efi svg{display:block;width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}</style>
