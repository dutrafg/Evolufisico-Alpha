 box-shadow:8px 0 27px -16px var(--ef-3d-key),3px 0 11px -8px var(--ef-3d-ambient)!important;
}
body.ef-simple-ui[data-ef-palette][data-efx-visual="advanced"] :is(
 .btn-primary,.efh-btn:not(.efh-btn-ghost),.eforg-button-primary,.ef-fin-btn.primary,.efx-edit-button
 ){
 box-shadow:0 8px 17px -9px var(--ef-3d-key),0 3px 8px -5px var(--ef-3d-ambient),inset 0 1px 0 rgba(255,255,255,.25)!important;
}
@media(hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference){
 body.ef-simple-ui[data-efx-visual="advanced"] :is(.efh-stat,.efh-panel,.eforg-card,.ef-settings-card,.cob-card,.cob-kpi-card,.ef-proto-card):hover{
   transform:translate3d(0,-4px,0)!important;
