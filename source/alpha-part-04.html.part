function svg(n){var s=document.createElement('span');s.className='efi';s.setAttribute('role','img');s.setAttribute('aria-label',LABEL[n]||'Ícone');s.innerHTML='<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">'+P[n]+'</svg>';return s}
function conv(tn){var s=tn.nodeValue;RX.lastIndex=0;if(!s||!RX.test(s))return;
 var p=tn.parentElement;if(!p||p.closest(SKIP))return;
