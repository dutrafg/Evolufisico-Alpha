<style id="efup-version-card-styles" media="screen">
#tab-settings .efup-card{position:relative;overflow:hidden;display:flex;flex-direction:column;gap:17px;border:1px solid var(--ef-line,#c6dcd0);background:var(--ef-surface,#fff);box-shadow:0 9px 30px rgba(12,39,27,.065);}
#tab-settings .efup-card::before{content:"";position:absolute;inset:0 0 auto 0;height:3px;background:var(--ef-accent,var(--primary,#167a56));opacity:.88;pointer-events:none}
#tab-settings .efup-heading{display:flex;align-items:flex-start;gap:14px;width:100%;flex-wrap:wrap;}
#tab-settings .efup-symbol{flex:0 0 50px;width:50px;height:50px;border-radius:14px;background:var(--ef-soft,#e7f5ed);color:var(--ef-accent,var(--primary,#176647));display:grid;place-items:center;border:1px solid var(--ef-line,#d1e2da);}
#tab-settings .efup-headlines{flex:1 1 225px;min-width:0}
#tab-settings .efup-eyebrow{font-size:10px;font-weight:800;letter-spacing:.12em;color:var(--ef-accent,var(--primary,#176647));display:block;margin:2px 0 5px}
#tab-settings .efup-card h3{font-size:19px;margin:0 0 5px;color:var(--ef-ink,#172d26)}
#tab-settings .efup-card .efup-headlines p{margin:0;font-size:13px;line-height:1.5;color:var(--ef-muted,#63766e);max-width:590px}
#tab-settings .efup-state{display:inline-flex;align-items:center;gap:7px;padding:7px 11px;border:1px solid var(--ef-line,#c8ded1);border-radius:999px;font-size:11px;font-weight:750;color:var(--ef-ink,#17382b);background:var(--ef-soft,#e7f5ed)}
#tab-settings .efup-state::before{content:"";width:7px;height:7px;background:var(--ef-muted,#789088);border-radius:50%}
#tab-settings .efup-state[data-state="ok"]::before{background:#15966b}
#tab-settings .efup-state[data-state="new"]::before{background:#d28a12}
#tab-settings .efup-state[data-state="error"]::before{background:#b87943}
#tab-settings .efup-metrics{width:100%;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}
#tab-settings .efup-metrics>div{padding:14px;border:1px solid var(--ef-line,#d9e5dd);border-radius:12px;background:var(--ef-soft,#eff7f2);min-width:0}
#tab-settings .efup-metrics span{display:block;font-size:10px;letter-spacing:.065em;color:var(--ef-muted,#62796f);font-weight:750}
#tab-settings .efup-metrics strong{font-size:17px;font-weight:800;color:var(--ef-ink,#17372a);display:block;margin:7px 0 5px;overflow-wrap:anywhere}
#tab-settings .efup-metrics small{font-size:11px;color:var(--ef-muted,#62796f);display:block;margin:0}
#tab-settings .efup-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap;width:100%}
#tab-settings .efup-button{display:inline-flex;gap:8px;align-items:center;justify-content:center;cursor:pointer;border-radius:10px;border:1px solid var(--ef-accent,var(--primary,#177b58));background:var(--ef-accent,var(--primary,#177b58));color:white;font:inherit;font-weight:750;font-size:13px;min-height:43px;padding:9px 15px;}
#tab-settings .efup-button:disabled{opacity:.7;cursor:wait}
#tab-settings #efup-open:not([hidden]){display:inline-flex;padding:9px 14px;min-height:43px;align-items:center;border:1px solid var(--ef-line,#cfdfd6);border-radius:10px;color:var(--ef-ink,#17372a);font-weight:700;font-size:13px;text-decoration:none;background:var(--ef-surface,#fff)}
#tab-settings .efup-card .efup-message{max-width:100%;font-size:12px;margin:0;color:var(--ef-muted,#62766c);line-height:1.55}
#tab-settings .efup-card .efup-button:focus-visible,#tab-settings .efup-card a:focus-visible{outline:3px solid var(--ef-accent,#147c5c);outline-offset:3px}
@media(max-width:520px){#tab-settings .efup-heading{gap:12px}#tab-settings .efup-state{order:3}#tab-settings .efup-metrics{grid-template-columns:1fr}#tab-settings .efup-actions>*{width:100%;justify-content:center}}
@media(prefers-reduced-motion:reduce){#tab-settings .efup-card *{transition:none!important;animation:none!important}}
@media print{#efup-card{display:none!important}}
</style>
<script id="efup-version-checker">
(function(){'use strict';
 const INSTALLED='1.0.30', LABEL='1.0.30 Pré-Beta';
 // Repositório privado: o manifesto é disponibilizado pela implantação da branch main.
 // Nenhuma credencial GitHub é entregue ao browser.
 const ENDPOINT='https://evolufisico2.vercel.app/version.json';
 const INTERVAL_MS=60*60*1000, WAKE_MS=15*60*1000;
 let pending=false,lastFetchAt=0,interval;
 const el=id=>document.getElementById(id);
 function parse(v){const m=String(v||'').trim().match(/^(\d+)\.(\d+)\.(\d+)$/);return m?m.slice(1).map(Number):null;}
 function compare(a,b){const x=parse(a),y=parse(b);if(!x||!y)return null;for(let i=0;i<3;i++){if(x[i]!==y[i])return x[i]>y[i]?1:-1}return 0;}
 function show(state,label,message){const b=el('efup-state');if(b){b.dataset.state=state;b.textContent=label}const m=el('efup-message');if(m)m.textContent=message}
 async function check(manual){if(pending||!el('efup-card'))return;pending=true;lastFetchAt=Date.now();const button=el('efup-check');if(button)button.disabled=true;show('waiting','Verificando','Consultando a versão mais recente publicada pela branch main…');
  const ctrl=new AbortController(),timeout=setTimeout(()=>ctrl.abort(),12000);
  try{
    const response=await fetch(ENDPOINT+'?t='+Date.now(),{cache:'no-store',mode:'cors',credentials:'omit',signal:ctrl.signal});
    if(!response.ok)throw new Error('HTTP '+response.status);
    const data=await response.json();
    if(!data||typeof data.version!=='string'||!parse(data.version))throw new Error('Manifesto inválido');
    const diff=compare(data.version,INSTALLED);const open=el('efup-open');
    if(open)open.hidden=!(diff===1);
    if(diff===1){show('new','Atualização disponível','Nova versão '+data.version+' disponível. Abra o site oficial para atualizar; seus dados locais não são apagados por esta verificação.');}
    else if(diff===0){show('ok','Atualizado','Versão mais recente disponível neste canal. Fonte: publicação da branch main no site oficial.');}
    else{show('ok','Versão local recente','A instalação local ('+INSTALLED+') é mais recente que a versão pública ('+data.version+').');}
    const last=el('efup-last-check');if(last)last.textContent=new Intl.DateTimeFormat('pt-BR',{dateStyle:'short',timeStyle:'short'}).format(new Date());
  }catch(error){if(el('efup-open'))el('efup-open').hidden=true;show('error','Sem confirmação',navigator.onLine===false?'Você está offline. A consulta será repetida ao reconectar.':'Não foi possível verificar agora. Confira sua conexão e use “Verificar agora”.');}
  finally{clearTimeout(timeout);pending=false;if(button)button.disabled=false}
 }
 function init(){const host=el('efup-card');if(!host)return;const installed=el('efup-installed');if(installed)installed.textContent=LABEL;el('efup-check')?.addEventListener('click',()=>check(true));check(false);
 interval=setInterval(()=>{if(document.visibilityState==='visible')check(false)},INTERVAL_MS);
 document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible'&&Date.now()-lastFetchAt>WAKE_MS)check(false)});
 window.addEventListener('online',()=>{if(Date.now()-lastFetchAt>30000)check(false)});
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
 window.EFUpdateChecker={check:()=>check(true),version:INSTALLED,endpoint:ENDPOINT};
})();
</script>
<style id="efm-homologacao-css">
/* EvoluFisico2 · homologação local do Modo Moderno.
   Todo o escopo visual de substituição depende de body.efm-on. */
#efm-setting-card{border:1px solid var(--ef-line,#d6e5dc);border-radius:16px;padding:20px;background:var(--ef-surface,#fff);margin:18px 0;display:block;}
#efm-setting-card h3{font-size:18px;margin:0 0 6px;color:var(--ef-ink,#173e31)}
#efm-setting-card p{font-size:13px;margin:0 0 16px;color:var(--ef-muted,#647d71)}
#efm-setting-card .efm-settings-modes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
#efm-setting-card .efm-choice{border:1px solid #cfded7;padding:16px 14px;text-align:left;border-radius:14px;background:var(--ef-surface,#fff);color:var(--ef-ink,#18392f);cursor:pointer;font-weight:750;display:grid;gap:6px}
#efm-setting-card .efm-choice small{font-weight:450;line-height:1.5;color:var(--ef-muted,#61766c)}
#efm-setting-card .efm-choice[aria-pressed="true"]{background:#e2f4e9;border-color:#0c865e;box-shadow:inset 0 0 0 1px #0c865e;color:#075a40}
#efm-setting-card .efm-setting-extra{margin-top:17px;padding-top:15px;border-top:1px solid #e1e8e4;display:grid;gap:12px}
#efm-setting-card label{font-size:13px;font-weight:650;color:var(--ef-ink,#1b3c32)}
#efm-setting-card select,#efm-setting-card input[type="range"]{max-width:100%;accent-color:#12885d}
#efm-setting-card select{border:1px solid #ccdad1;background:white;padding:10px 12px;border-radius:9px;margin-left:12px;min-width:170px}
body.efm-on{--efm-green:#127a5b;--efm-ink:#193a2d;--efm-line:#d9e7de;--efm-white:#fff;background:#edf3ef!important;}
body.efm-on .top-navbar,body.efm-on #ef-workspace-heading,body.efm-on #efm-float-nav,body.efm-on #ef-104-nav,body.efm-on .ef-mob-nav,body.efm-on #ef-bottom-nav{display:none!important}
body.efm-on .app-container{margin:0!important;max-width:none!important;width:100%!important;min-height:100vh!important;padding:24px 25px 155px 254px!important;box-sizing:border-box!important}
body.efm-on.efm-extended .app-container{padding-left:28px!important;padding-bottom:150px!important}
body.efm-on #tab-painel{width:100%!important;max-width:none!important;padding:0!important;margin:0!important;min-height:calc(100vh - 160px)!important}
body.efm-on #tab-painel>#ef55-painel{display:none!important}
body.efm-on .tab-panel:not(#tab-painel){max-width:none!important;margin:0!important}
body.efm-on #efmroot{display:block!important}
#efmroot{display:none;position:relative;width:100%;font-family:inherit;color:#19392f;max-width:1700px;margin:0 auto;box-sizing:border-box}
#efmroot *,#efmroot *:before,#efmroot *:after{box-sizing:border-box}
#efmroot button,#efm-nav button,#efm-dock button,#efm-store button{font:inherit;cursor:pointer}
#efmroot .efm-title-eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.13em;color:#3a8063;font-weight:800;margin:0 0 12px}
#efmroot .efm-titleline{display:flex;align-items:end;gap:20px;justify-content:space-between;flex-wrap:wrap;margin-bottom:20px}
#efmroot h1{font-size:clamp(25px,3.4vw,38px);line-height:1.18;letter-spacing:-.05em;color:#173e31;margin:0 0 7px}
#efmroot .efm-subtitle{margin:0;color:#6b8175;font-size:14px}
#efmroot .efm-toolbar{display:flex;flex-wrap:wrap;gap:8px}
#efmroot .efm-ui-btn,#efm-store .efm-ui-btn{border:1px solid #cadbd0;background:#fff;color:#214d38;font-weight:700;border-radius:11px;padding:10px 13px;font-size:12px;min-height:39px}
#efmroot .efm-ui-btn.primary,#efm-store .efm-ui-btn.primary{background:#117c5a;color:white;border-color:#117c5a}
#efmroot .efm-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;align-items:stretch}
#efmroot .efm-unit{min-width:0;position:relative;transition:transform .18s}
#efmroot .efm-unit.wide{grid-column:span 2}
#efmroot .efm-unit.quad{grid-column:span 2;grid-row:span 2}
#efmroot .efm-card{height:100%;min-height:190px;border:1px solid #dce7df;background:#fff;border-radius:22px;padding:21px 20px;box-shadow:0 10px 30px rgba(25,67,46,.055);position:relative;overflow:hidden}
#efmroot .efm-cardheader{display:flex;gap:10px;align-items:center;margin-bottom:15px;justify-content:space-between}
#efmroot .efm-cardlabel{font-weight:800;font-size:13px;display:flex;align-items:center;gap:9px;color:#234c38}
#efmroot .efm-cardlabel svg{width:20px;height:20px}
#efmroot .efm-cardmeta{font-size:10px;border-radius:7px;background:#edf4ef;padding:5px 7px;color:#5e8170;font-weight:800;text-transform:uppercase}
#efmroot .efm-cardvalue{font-size:35px;font-weight:830;letter-spacing:-.06em;color:#0e754e;line-height:1.15}
#efmroot .efm-carddesc{color:#72877b;font-size:12px;line-height:1.5;margin:10px 0}
#efmroot .efm-cardfoot{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:14px}
#efmroot .efm-link{border:none;background:#ebf4ef;color:#126d4e;border-radius:9px;padding:9px 11px;font-size:12px;font-weight:800;text-align:left}
#efmroot .efm-mini{font-size:11px;color:#718378}
#efmroot textarea,#efmroot input{font:inherit;max-width:100%}
#efmroot .efm-textarea{background:#f5f9f6;border:1px solid #d7e7dd;border-radius:10px;padding:10px;width:100%;min-height:90px;font-size:13px;color:#27463b;resize:vertical}
#efmroot .efm-textfield{background:#f8faf8;border:1px solid #d1e2d7;border-radius:9px;padding:9px;font-size:13px;width:100%}
#efmroot .efm-task{display:flex;gap:8px;align-items:center;margin:7px 0;font-size:12px}
#efmroot .efm-task span{text-overflow:ellipsis;overflow:hidden;flex:1}
#efmroot .efm-chart{width:100%;height:82px;display:block;overflow:visible}
#efmroot .efm-empty{font-size:13px;line-height:1.55;color:#74877b;padding:8px 0}
#efmroot .efm-edittools{position:absolute;top:10px;right:10px;z-index:7;display:none;gap:3px;background:#fff;border:1px solid #dee9e1;border-radius:10px;padding:4px;box-shadow:0 4px 12px #0a332014}
#efmroot.efm-editing .efm-edittools{display:flex}
#efmroot .efm-edittools button{border:0;background:#eef5ef;color:#235d41;font-size:12px;width:27px;height:27px;border-radius:7px;font-weight:bold}
#efmroot.efm-editing .efm-unit{outline:1px dashed #7dbb9e;outline-offset:3px;border-radius:22px}
#efmroot .efm-stack{position:relative;padding:0 13px;margin:0 -13px;isolation:isolate}
#efmroot .efm-stack:before,#efmroot .efm-stack:after{content:"";position:absolute;z-index:-1;top:21px;bottom:21px;border:1px solid #cfded4;border-radius:17px;background:#f4f8f5;box-shadow:0 5px 15px #1233220c;pointer-events:none}
#efmroot .efm-stack:before{left:0;right:0;transform:translateX(-10px) scale(.95)}
#efmroot .efm-stack:after{left:0;right:0;transform:translateX(10px) scale(.95)}
#efmroot .efm-stack .efm-card{box-shadow:0 9px 24px #19402a19;min-height:205px}
#efmroot .efm-stack-arrows{display:flex;gap:5px}
#efmroot .efm-stack-arrows button{background:#e8f4ed;color:#127750;border:0;padding:5px 10px;border-radius:8px;font-weight:800}
#efmroot .efm-stack-pages{font-size:10px;letter-spacing:.1em;color:#719080;font-weight:bold}
#efmroot .efm-stack-picker{display:flex;flex-wrap:wrap;gap:5px;padding-top:11px}
#efmroot .efm-stack-picker button{font-size:10px;border:1px solid #bcd4c4;background:#f6fbf7;color:#27664a;border-radius:8px;padding:6px 9px}
#efmroot .efm-stack-picker button[aria-selected=true]{background:#137e5c;color:#fff;border-color:#137e5c}
#efmroot .efm-message{margin-top:18px;font-size:12px;color:#577669}
#efm-nav{position:fixed;z-index:1093;left:16px;top:16px;bottom:18px;width:218px;border-radius:21px;padding:17px 12px;background:#fff;box-shadow:0 11px 43px #153a2a13;display:none;color:#285342;overflow:auto}
body.efm-on:not(.efm-extended) #efm-nav{display:block}
#efm-nav .efm-brand{display:flex;gap:10px;align-items:center;padding:9px 9px 19px;border-bottom:1px solid #e7eee9;margin-bottom:18px;font-weight:900}
#efm-nav .efm-brand-emblem{width:39px;height:39px;border-radius:13px;display:grid;place-items:center;background:#11825e;color:#fff}
#efm-nav .efm-navlink{display:flex;gap:11px;align-items:center;width:100%;border:0;background:transparent;border-radius:12px;padding:13px 12px;color:#496859;text-align:left;font-size:13px;font-weight:650;min-height:45px}
#efm-nav .efm-navlink[aria-current=page]{background:#e2f2e8;color:#0b7751}
#efm-nav .efm-navlink svg{width:18px;height:18px;flex:none}
#efm-nav .efm-navheading{padding:4px 11px 12px;color:#839a8b;font-weight:900;font-size:10px;letter-spacing:.12em;text-transform:uppercase}
#efm-dock{position:fixed;z-index:1095;bottom:15px;left:50%;transform:translateX(-50%);padding:9px 10px 5px;max-width:calc(100vw - 16px);width:max-content;min-height:76px;border:1px solid #ffffffb5;background:#ffffffdb;backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);box-shadow:0 16px 38px #173e3028;border-radius:22px;display:none;align-items:end;gap:5px;overflow:visible;isolation:isolate}
body.efm-on #efm-dock{display:flex}
#efm-dock .efm-dock-link{position:relative;width:49px;min-width:39px;display:grid;justify-items:center;gap:4px;flex:none;border:0;background:transparent;padding:0 2px 3px;transform-origin:50% 100%;transition:transform .17s,margin .17s;will-change:transform;color:#304a3d}
#efm-dock .efm-dock-icon{width:43px;height:43px;border-radius:13px;display:grid;place-items:center;color:#fff;box-shadow:inset 0 1px 3px #fff4,0 4px 10px #16342d24;transition:box-shadow .17s}
#efm-dock .efm-dock-icon svg{width:23px;height:23px;stroke-width:1.9}
#efm-dock .efm-dock-link .efm-dot{width:4px;height:4px;border-radius:5px;background:#147d5a;visibility:hidden}
#efm-dock .efm-dock-link[aria-current=page] .efm-dot{visibility:visible}
#efm-dock .efm-dock-label{font-size:9px;font-weight:700;white-space:nowrap;max-width:78px;text-overflow:ellipsis;overflow:hidden;color:#496457}
#efm-dock[data-style="advanced"] .efm-dock-label{position:absolute;top:-35px;padding:7px 9px;border-radius:8px;background:#263a2f;color:#fff;opacity:0;pointer-events:none;transition:opacity .18s}
#efm-dock[data-style="advanced"] .efm-dock-link:is(:hover,:focus-visible) .efm-dock-label{opacity:1}
#efm-store{position:fixed;inset:0;z-index:1125;display:none;background:#0b281c65;font-family:inherit}
#efm-store[aria-hidden="false"]{display:block}
#efm-store .efm-store-pane{height:100%;width:min(550px,100%);margin-left:auto;background:#f7faf8;display:flex;flex-direction:column;box-shadow:-10px 0 35px #08261725}
#efm-store .efm-store-head{display:flex;justify-content:space-between;gap:14px;align-items:center;padding:24px;border-bottom:1px solid #dae7de}
#efm-store .efm-store-head h2{font-size:23px;margin:0;color:#123c2d}
#efm-store .efm-store-search{border:1px solid #cbded2;border-radius:13px;padding:11px 13px;font-size:14px;width:calc(100% - 48px);margin:15px 24px 8px}
#efm-store .efm-store-tabs{display:flex;gap:7px;padding:8px 24px;overflow:auto}
#efm-store .efm-store-tabs button{background:#e9f2eb;border:1px solid #d7e6db;padding:8px 10px;border-radius:9px;font-size:11px;color:#426754;white-space:nowrap}
#efm-store .efm-store-tabs button[aria-selected=true]{background:#127b5a;border-color:#127b5a;color:white}
#efm-store .efm-store-list{overflow:auto;flex:1;padding:12px 24px 28px}
#efm-store .efm-store-item{background:#fff;border:1px solid #dce8df;border-radius:14px;margin-bottom:9px;padding:15px;display:flex;align-items:center;gap:9px;justify-content:space-between}
#efm-store .efm-store-item h3{font-size:14px;color:#1a4e35;margin:0 0 5px}
#efm-store .efm-store-item p{font-size:12px;color:#748b79;margin:0}
#efm-store .efm-store-item .efm-ui-btn{flex:none;padding:8px 9px;font-size:11px}
#efm-store .efm-store-item .efm-store-actions{display:flex;gap:5px;align-items:center}
#efm-store .efm-close{border:0;border-radius:10px;background:#e6efe8;color:#24593c;font-size:20px;width:37px;height:37px}
body.efm-on.efm-extended #efm-dock{gap:7px}
@media (max-width:1250px){#efmroot .efm-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:900px){body.efm-on #efm-nav{display:none!important}body.efm-on .app-container{padding:22px 17px 130px!important}#efmroot .efm-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:570px){#efm-setting-card .efm-settings-modes{grid-template-columns:1fr}#efm-setting-card select{display:block;margin:10px 0 0;width:100%}body.efm-on .app-container{padding:14px 12px 120px!important}#efmroot .efm-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}#efmroot .efm-unit.wide,#efmroot .efm-unit.quad{grid-column:span 2;grid-row:auto}#efmroot .efm-card{padding:14px 12px;min-height:177px;border-radius:17px}#efmroot .efm-cardvalue{font-size:27px}#efmroot .efm-cardlabel{font-size:11px}#efmroot .efm-titleline{align-items:start}#efmroot .efm-ui-btn{padding:9px}#efm-dock{bottom:5px;max-width:calc(100vw - 10px);width:calc(100vw - 10px);gap:1px;justify-content:space-around;border-radius:19px;padding:8px 4px 5px;min-height:61px}#efm-dock .efm-dock-link{width:auto;min-width:0;flex:1;padding:0;max-width:46px}#efm-dock .efm-dock-icon{width:clamp(27px,8vw,36px);height:clamp(27px,8vw,36px);border-radius:10px}#efm-dock .efm-dock-icon svg{width:19px;height:19px}#efm-dock .efm-dock-label{font-size:7px;max-width:38px}#efm-dock[data-style=advanced] .efm-dock-label{max-width:none}#efmroot .efm-subtitle{font-size:12px}}
@media (prefers-reduced-motion:reduce){#efm-dock *{transition:none!important}#efmroot .efm-unit{transition:none}}
@media print{#efm-nav,#efm-dock,#efm-store,#efm-setting-card{display:none!important}}

/* Isolamento do Dashboard em relação à renderização dinâmica do Início original. */
body.ef-simple-ui.efm-on .top-navbar{display:none!important}
body.ef-simple-ui.efm-on.efm-dashboard-active .app-container{display:none!important}
body.efm-on #efmroot{display:none!important}
body.efm-on.efm-dashboard-active #efmroot{display:block!important;padding:30px 25px 145px 254px!important;max-width:none!important;min-height:100vh}
body.efm-on.efm-extended.efm-dashboard-active #efmroot{padding-left:30px!important}
@media(max-width:900px){body.efm-on.efm-dashboard-active #efmroot{padding:23px 19px 125px!important}}
@media(max-width:570px){body.efm-on.efm-dashboard-active #efmroot{padding:17px 12px 116px!important}}
/* Navegação flutuante legada: só o Moderno substitui pelo Dock de nove módulos. */
html body.ef-simple-ui.efm-on #efm-float-nav,
html body.ef-simple-ui.efm-on #efm-float-nav[data-efm-phone="true"]{display:none!important;visibility:hidden!important;pointer-events:none!important}
html body.ef-simple-ui.efm-on #efm-dock{display:flex!important;z-index:2147482000!important}


/* Homologação: o Moderno adota exclusivamente a barra inferior Estendida. */
html body.efm-on #efm-nav{display:none!important;visibility:hidden!important;pointer-events:none!important}
html body.efm-on .app-container{padding-left:28px!important}
html body.efm-on.efm-dashboard-active #efmroot{padding-left:30px!important}
html body.efm-on #ef-layout-card{display:none!important}
#efm-setting-card .efm-locked-layout{display:grid;gap:5px;border:1px solid #a9d2ba;background:#eaf7ef;color:#145941;border-radius:12px;padding:13px 15px}
#efm-setting-card .efm-locked-layout small{color:#436b58;font-size:12px;font-weight:450}
@media(max-width:900px){html body.efm-on .app-container{padding-left:17px!important}html body.efm-on.efm-dashboard-active #efmroot{padding-left:19px!important}}
@media(max-width:570px){html body.efm-on .app-container{padding-left:12px!important}html body.efm-on.efm-dashboard-active #efmroot{padding-left:12px!important}}
/* Temas claros/escuros do Moderno seguem o mesmo estado do aplicativo original:
   html.ef-dark-mode e o controle já existente em Configurações > Aparência. */
html.ef-dark-mode body.efm-on{color-scheme:dark;--efm-green:#55d5a1;--efm-ink:#e4f2e9;--efm-line:#344d43;--efm-white:#17271f;background:#0d1713!important;color:#dfebe2}
html.ef-dark-mode body.efm-on #efmroot{color:#e4f0e8}
html.ef-dark-mode body.efm-on #efmroot h1{color:#f3fff8}
html.ef-dark-mode body.efm-on #efmroot .efm-title-eyebrow{color:#87d4ae}
html.ef-dark-mode body.efm-on #efmroot .efm-subtitle,
html.ef-dark-mode body.efm-on #efmroot .efm-message{color:#aec8b8}
html.ef-dark-mode body.efm-on #efmroot .efm-card{background:#192b23!important;border-color:#3b5447!important;box-shadow:0 8px 30px #0004!important;color:#ebf3ee}
html.ef-dark-mode body.efm-on #efmroot .efm-cardlabel{color:#dbf1e1}
html.ef-dark-mode body.efm-on #efmroot .efm-cardvalue{color:#67ddb1}
html.ef-dark-mode body.efm-on #efmroot .efm-carddesc,
html.ef-dark-mode body.efm-on #efmroot .efm-mini,
html.ef-dark-mode body.efm-on #efmroot .efm-empty{color:#b6cbbd}
html.ef-dark-mode body.efm-on #efmroot .efm-cardmeta{background:#294337;color:#b9e1c8}
html.ef-dark-mode body.efm-on #efmroot .efm-link{background:#284b3b;color:#e1ffe9}
html.ef-dark-mode body.efm-on #efmroot .efm-ui-btn,
html.ef-dark-mode body.efm-on #efm-store .efm-ui-btn{background:#263c30;color:#e2f5e8;border-color:#466555}
html.ef-dark-mode body.efm-on #efmroot .efm-ui-btn.primary,
html.ef-dark-mode body.efm-on #efm-store .efm-ui-btn.primary{background:#198b65;color:white;border-color:#25a778}
html.ef-dark-mode body.efm-on #efmroot .efm-textarea,
html.ef-dark-mode body.efm-on #efmroot .efm-textfield{background:#10241b;color:#edf8f0;border-color:#3a5b47}
html.ef-dark-mode body.efm-on #efmroot :is(input,textarea)::placeholder{color:#a5b9ad}
html.ef-dark-mode body.efm-on #efmroot .efm-edittools{background:#20362a;border-color:#486052}
html.ef-dark-mode body.efm-on #efmroot .efm-edittools button{background:#355442;color:#e5f6e8}
html.ef-dark-mode body.efm-on #efmroot .efm-stack:before,
html.ef-dark-mode body.efm-on #efmroot .efm-stack:after{background:#24392b;border-color:#436253;box-shadow:0 5px 15px #0004}
html.ef-dark-mode body.efm-on #efmroot .efm-stack-arrows button{background:#2d4f3e;color:#d5ffdf}
html.ef-dark-mode body.efm-on #efmroot .efm-stack-pages{color:#bad6c5}
html.ef-dark-mode body.efm-on #efmroot .efm-stack-picker button{background:#254236;color:#e0f6e5;border-color:#4a6b56}
html.ef-dark-mode body.efm-on #efmroot .efm-stack-picker button[aria-selected=true]{background:#148a61;color:white}
html.ef-dark-mode body.efm-on #efm-dock{background:#203229ee;border-color:#54685c;box-shadow:0 16px 50px #0008}
html.ef-dark-mode body.efm-on #efm-dock .efm-dock-link{color:#e8f6ec}
html.ef-dark-mode body.efm-on #efm-dock .efm-dock-label{color:#e2f1e6}
html.ef-dark-mode body.efm-on #efm-dock .efm-dock-link[aria-current=page] .efm-dot{background:#6febb4}
html.ef-dark-mode body.efm-on #efm-store{background:#020b08b8;color:#e7f6eb}
html.ef-dark-mode body.efm-on #efm-store .efm-store-pane{background:#101c16}
html.ef-dark-mode body.efm-on #efm-store .efm-store-head{border-color:#345340}
html.ef-dark-mode body.efm-on #efm-store .efm-store-head h2,
html.ef-dark-mode body.efm-on #efm-store .efm-store-item h3{color:#ebfff1}
html.ef-dark-mode body.efm-on #efm-store .efm-store-search{background:#203529;color:#e6f6eb;border-color:#4c6956}
html.ef-dark-mode body.efm-on #efm-store .efm-store-tabs button{background:#243c30;border-color:#43604c;color:#d6ebdc}
html.ef-dark-mode body.efm-on #efm-store .efm-store-tabs button[aria-selected=true]{background:#198e67;border-color:#30a87c;color:white}
html.ef-dark-mode body.efm-on #efm-store .efm-store-item{background:#1c2e24;border-color:#385645}
html.ef-dark-mode body.efm-on #efm-store .efm-store-item p{color:#b5cdbe}
html.ef-dark-mode body.efm-on #efm-store .efm-close{background:#294637;color:#e5f5e9}
/* O cartão de seleção de modo também precisa acompanhar o tema no Pro. */
html.ef-dark-mode #efm-setting-card{background:#17271f!important;border-color:#415849!important;color:#e5f4e9}
html.ef-dark-mode #efm-setting-card h3,
html.ef-dark-mode #efm-setting-card label{color:#e9f9ed}
html.ef-dark-mode #efm-setting-card p,
html.ef-dark-mode #efm-setting-card .efm-choice small{color:#b7cdbd}
html.ef-dark-mode #efm-setting-card .efm-choice{background:#203429;border-color:#4b6455;color:#effbf1}
html.ef-dark-mode #efm-setting-card .efm-choice[aria-pressed=true]{background:#174c38;border-color:#65c99b;color:#e4fff0;box-shadow:inset 0 0 0 1px #65c99b}
html.ef-dark-mode #efm-setting-card .efm-setting-extra{border-color:#405949}
html.ef-dark-mode #efm-setting-card .efm-locked-layout{background:#224533;border-color:#49765a;color:#e5fff0}
html.ef-dark-mode #efm-setting-card .efm-locked-layout small{color:#c0e5ce}
/* Contraste do cartão Modo de Interface em telas de Configurações. */
html.ef-dark-mode body.efm-on #tab-settings #efm-setting-card{background:#17271f!important;border-color:#415849!important}
html.ef-dark-mode body.efm-on #tab-settings #efm-setting-card p,
html.ef-dark-mode body.efm-on #tab-settings #efm-setting-card .efm-choice small{color:#c3ddcc!important}
html.ef-dark-mode body.efm-on #tab-settings #efm-setting-card .efm-locked-layout small{color:#d2f0dd!important}
@media print{html body.efm-on #efm-dock{display:none!important}}

/* Alpha: a Dock só aparece depois da abertura original */
body.efm-on:not(.efm-splash-complete) #efm-dock{display:none!important}
</style>
<script id="efm-homologacao-js">
/* EvoluFisico2 Modo Moderno - camada isolada. Nenhum módulo ou regra do modo Pro é reimplementado. Navegação Moderno fixa em Estendido. */
(()=>{'use strict';
const KEY='ef_alpha_moderno_workspace_v1';
const $=(q,root=document)=>root.querySelector(q),$$=(q,root=document)=>[...root.querySelectorAll(q)];
const esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const ROUTES=[
 ['inicio','Início','tab-painel','#168966','<path d="M3 10 12 3l9 7v10h-7v-6h-4v6H3z"/>'],
 ['organizacao','Organização','tab-organizacao','#4189b5','<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/>'],
 ['avaliacoes','Avaliações','tab-historico','#7775c5','<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 7h6M9 12h6M9 17h4"/>'],
 ['evolucao','Evolução','tab-comparison','#289b83','<path d="M3 18 9 12l4 3 8-10M3 21h18"/>'],
 ['calculadora','Calculadora','tab-lab77','#6588b6','<rect x="6" y="2" width="12" height="20" rx="2"/><path d="M9 6h6M9 11h1m4 0h1M9 15h1m4 0h1M9 19h1m4 0h1"/>'],
 ['formularios','Formulários','tab-ef-forms','#bb8352','<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/>'],
 ['analises','Análises','tab-analises','#8573bf','<circle cx="12" cy="12" r="9"/><path d="M12 3v9l7 5M12 12 6 18"/>'],
 ['cobrancas','Cobranças','tab-cobranca','#27957c','<rect x="3" y="6" width="18" height="13" rx="3"/><path d="M3 10h18M7 15h4"/>'],
 ['configuracoes','Configurações','tab-settings','#668491','<path d="M4 7h16M4 17h16"/><circle cx="9" cy="7" r="2.5" fill="#fff"/><circle cx="15" cy="17" r="2.5" fill="#fff"/>']
];
const icons={calendar:'<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/>',notes:'<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h6"/>',clock:'<circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/>',trend:'<path d="M3 18 9 12l4 3 8-10M3 21h18"/>',chart:'<path d="M3 21h18M6 17V9M12 17V4M18 17v-6"/>',tasks:'<rect x="3" y="4" width="18" height="16" rx="3"/><path d="m7 12 3 3 6-7"/>',calc:'<rect x="5" y="2" width="14" height="20" rx="3"/><path d="M8 7h8M9 12h1m4 0h1m-6 4h1m4 0h1"/>',copy:'<rect x="5" y="5" width="14" height="16" rx="2"/><path d="M8 2h11v14"/>',spark:'<path d="m12 2 2.7 7.3L22 12l-7.3 2.7L12 22l-2.7-7.3L2 12l7.3-2.7z"/>'};
const svg=path=>'<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">'+path+'</svg>';
const catalog=[
 ['resumo','Resumo das avaliações','Avaliações','avaliacoes','Quantidade real de avaliações cadastradas','counter'],
 ['atalhos','Acesso rápido','Início','inicio','Abra módulos com um toque','links'],
 ['tarefas','Tarefas do dia','Organização','organizacao','Lista pessoal de tarefas salva neste navegador','tasks'],
 ['notas','Notas rápidas','Organização','organizacao','Anotações locais do profissional','notes'],
 ['relogio','Relógio e data','Início','inicio','Horário e calendário atualizados','clock'],
 ['usomodulos','Atividade dos módulos','Início','inicio','Gráfico dos acessos realizados no Modo Moderno','chart'],
 ['agenda','Agenda e organização','Organização','organizacao','Ir para a agenda do aplicativo','route'],
 ['retornos','Reavaliações','Organização','organizacao','Acessar a organização e os retornos','route'],
 ['novaavaliacao','Nova Avaliação','Avaliações','avaliacoes','Abrir o formulário real de avaliação','new'],
 ['historico','Histórico de Avaliações','Avaliações','avaliacoes','Consultar avaliações reais salvas','route'],
 ['medidas','Medidas Corporais','Avaliações','avaliacoes','Acessar os dados antropométricos','new'],
 ['fotos','Fotos de Avaliação','Avaliações','avaliacoes','Acessar o preenchimento da avaliação','new'],
 ['composicao','Composição Corporal','Avaliações','avaliacoes','Abrir ferramentas de composição corporal','new'],
 ['comparacao','Comparação Física','Evolução','evolucao','Abrir comparação de avaliações','route'],
 ['graficoevolucao','Gráficos de Evolução','Evolução','evolucao','Abrir gráficos do módulo Evolução','route'],
 ['relatorioevolucao','Relatório de Evolução','Evolução','evolucao','Acessar emissão de relatórios','route'],
 ['imc','Calculadora de IMC','Calculadora','calculadora','Calcular IMC diretamente no Dashboard','imc'],
 ['calcgeral','Calculadoras','Calculadora','calculadora','Abrir todas as calculadoras do aplicativo','route'],
 ['gordura','Gordura Corporal','Calculadora','calculadora','Abrir calculadoras e protocolos disponíveis','route'],
 ['calorias','Metabolismo e Calorias','Calculadora','calculadora','Acessar ferramentas metabólicas','route'],
 ['anamnese','Anamnese','Formulários','formularios','Abrir formulários completos','route'],
 ['forminiciante','Formulários para Iniciantes','Formulários','formularios','Acessar formulários de entrada','route'],
 ['formintermediario','Formulários Intermediários','Formulários','formularios','Acessar formulários por nível','route'],
 ['formavancado','Formulários Avançados','Formulários','formularios','Acessar formulários por nível','route'],
 ['analisegeral','Painel de Análises','Análises','analises','Abrir as análises do aplicativo','route'],
 ['riscos','Indicadores e Riscos','Análises','analises','Abrir os indicadores disponíveis','route'],
 ['tendencias','Tendências','Análises','analises','Abrir análise de tendências','route'],
 ['mensalidades','Mensalidades','Cobranças','cobrancas','Abrir gestão financeira','route'],
 ['recebimentos','Recebimentos','Cobranças','cobrancas','Abrir recebimentos de alunos','route'],
 ['pendencias','Pendências Financeiras','Cobranças','cobrancas','Consultar cobranças pendentes','route'],
 ['servicos','Serviços','Cobranças','cobrancas','Consultar serviços oferecidos','route'],
 ['pdfs','Relatórios e PDF','Avaliações','avaliacoes','Abrir avaliações para gerar relatórios','route'],
 ['backup','Backup e Restauração','Configurações','configuracoes','Acessar backup do aplicativo','route'],
 ['aparencia','Aparência','Configurações','configuracoes','Personalize cor e aparência','appearance'],
 ['atualizacoes','Verificar Atualizações','Configurações','configuracoes','Abrir ferramentas de manutenção','maintenance'],
 ['seguranca','Dados e Privacidade','Configurações','configuracoes','Abrir controles de dados','route'],
 ['preferencias','Personalização','Configurações','configuracoes','Editar preferências de interface','appearance']
].map(x=>({id:x[0],name:x[1],category:x[2],route:x[3],desc:x[4],kind:x[5]}));
const known=new Set(catalog.map(x=>x.id));
const defaults={interface:'pro',nav:'advanced',extendedZoom:28,advancedZoom:42,order:['resumo','atalhos','agenda','novaavaliacao','comparacao','calcgeral','anamnese','analisegeral','mensalidades','preferencias'],sizes:{resumo:'wide',atalhos:'wide',agenda:'wide',comparacao:'wide'},stack:[],stackIndex:0,notes:'',tasks:[],usage:{},editing:false};
let state={...defaults},tab='inicio',homeIntent=false,category='Todos',search='',drawerOpen=false,stackOpen=false,timerSec=0,timerRunning=false,timerMark=0,timerInterval=null;
try{const saved=JSON.parse(localStorage.getItem(KEY)||'null');if(saved&&typeof saved==='object'){
 const allowed=['interface','nav','extendedZoom','advancedZoom','order','sizes','stack','stackIndex','notes','tasks','usage'];for(const k of allowed)if(Object.hasOwn(saved,k))state[k]=saved[k];
}}catch(_){}
state.interface=state.interface==='modern'?'modern':'pro';state.nav='extended'; // O Moderno usa obrigatoriamente a barra Estendida, inclusive ao restaurar preferências antigas.
state.order=Array.isArray(state.order)?[...new Set(state.order.filter(id=>known.has(id)))].slice(0,60):[...defaults.order];
state.stack=Array.isArray(state.stack)?[...new Set(state.stack.filter(id=>known.has(id)))].slice(0,20):[...defaults.stack];
state.stackIndex=Math.max(0,Math.min(state.stack.length-1,Number(state.stackIndex)||0));
state.tasks=Array.isArray(state.tasks)?state.tasks.filter(x=>typeof x==='string').slice(0,80):[];
state.usage=state.usage&&typeof state.usage==='object'&&!Array.isArray(state.usage)?state.usage:{};
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(Object.fromEntries(Object.keys(defaults).filter(k=>k!=='editing').map(k=>[k,state[k]]))))}catch(_){}};
function count(){const raw=$('#history-counter')?.textContent||'0';const n=parseInt(raw.replace(/\D/g,''),10);return Number.isFinite(n)?n:0}
const colors=ROUTES.map(x=>x[3]);
const locate=id=>ROUTES.find(x=>x[0]===id)||ROUTES[0];
const iconFor=r=>{const b=$('#'+({'inicio':'tab-btn-painel','organizacao':'tab-btn-organizacao','avaliacoes':'tab-btn-history','evolucao':'tab-btn-compare','calculadora':'tab-btn-lab77','formularios':'tab-btn-ef-forms','analises':'tab-btn-analises','cobrancas':'tab-btn-cobranca','configuracoes':'tab-btn-settings'}[r[0]]||''));const existing=b?.querySelector('svg');return existing?existing.outerHTML:svg(r[4])};
function openRoute(route){homeIntent=route==='inicio';const r=locate(route);if(typeof window.switchTab==='function'){window.switchTab(r[2]);if(route==='inicio'){const target=$('#tab-painel');if(target&&!target.classList.contains('active'))$$('.tab-panel').forEach(el=>el.classList.toggle('active',el===target))}tab=r[0];state.usage[route]=Math.max(0,Number(state.usage[route])||0)+1;save();syncNav(); if(route==='inicio')renderBoard();window.scrollTo({top:0,behavior:'instant'});}else alert('Módulo original ainda não foi inicializado.');}
function openNew(){homeIntent=false;if(typeof window.switchTab==='function'){window.switchTab('tab-novo-checkin');tab='avaliacoes';syncNav();window.scrollTo(0,0)}}
function openSettingSection(name){openRoute('configuracoes');setTimeout(()=>{const selector=$('[data-efs-section="'+name+'"]');if(selector)selector.click()},70)}
function syncNav(){const active=$('.tab-panel.active')?.id;document.body.classList.toggle('efm-dashboard-active',(homeIntent&&state.interface==='modern')||active==='tab-painel');const r=ROUTES.find(x=>x[2]===active);if(homeIntent&&state.interface==='modern')tab='inicio';else if(r)tab=r[0];else if(active==='tab-novo-checkin')tab='avaliacoes';$$('[data-efm-route]').forEach(b=>{const on=b.dataset.efmRoute===tab;b.setAttribute('aria-current',on?'page':'false')})}
function applyMode(mode,goHome){state.interface=mode==='modern'?'modern':'pro';if(state.interface==='modern')state.nav='extended';if(state.interface==='pro')homeIntent=false;const header=$('.top-navbar');if(header){if(state.interface==='modern')header.style.setProperty('display','none','important');else header.style.removeProperty('display')};document.body.classList.toggle('efm-on',state.interface==='modern');document.body.classList.toggle('efm-extended',state.interface==='modern'&&state.nav==='extended');renderSettings();applyDockStyle();syncNav();save();if(goHome&&state.interface==='modern')openRoute('inicio');}
function applyDockStyle(){const dock=$('#efm-dock');if(!dock)return;state.nav='extended';dock.dataset.style='extended';document.body.classList.toggle('efm-extended',state.interface==='modern'&&state.nav==='extended');$('[data-efm-modern-extra]')?.toggleAttribute('hidden',state.interface!=='modern');$$('[data-efm-nav-choice]').forEach(x=>x.value=state.nav);$$('[data-efm-zoom]').forEach(x=>x.value=x.dataset.efmZoom==='extended'?state.extendedZoom:state.advancedZoom)}
function renderSettings(){const card=$('#efm-setting-card');if(!card)return;$$('[data-efm-mode]',card).forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.efmMode===state.interface)));const extra=$('[data-efm-modern-extra]',card);if(extra)extra.hidden=state.interface!=='modern';}
function mountSettings(){if($('#efm-setting-card'))return;const target=$('.efs-subpage[data-efs-panel="personalizacao"]');if(!target)return;
 const card=document.createElement('article');card.id='efm-setting-card';card.className='ef-settings-card ef-settings-card-wide';card.innerHTML=`<h3>Modo de Interface</h3><p>Escolha a experiência do EvoluFísico2. O modo Pro preserva integralmente a interface e todas as funcionalidades originais.</p><div class="efm-settings-modes"><button type="button" class="efm-choice" data-efm-mode="pro"><span>▦ &nbsp; Pro</span><small>Interface original, com os mesmos módulos, formulários, dados e menus.</small></button><button type="button" class="efm-choice" data-efm-mode="modern"><span>◈ &nbsp; Moderno</span><small>Dashboard com widgets, pilhas e Dock de módulos originais.</small></button></div><div class="efm-setting-extra" data-efm-modern-extra hidden><div class="efm-locked-layout" role="status"><strong>Navegação: Estendido</strong><small>Fixa no modo Moderno, sem painel lateral. Para usar outros layouts, selecione Pro.</small></div><label>Ampliação da barra Estendida: <output id="efm-zoom-extended-label">${state.extendedZoom}%</output><input aria-label="Ampliação da barra Estendida" type="range" min="0" max="65" step="5" data-efm-zoom="extended" value="${state.extendedZoom}"></label><p>A barra Estendida mantém a ampliação dos ícones. Os módulos originais e seus registros permanecem inalterados.</p></div>`;
 const layout=$('#ef-layout-card');if(layout&&layout.parentElement===target)target.insertBefore(card,layout);else target.prepend(card);
 card.addEventListener('click',e=>{const btn=e.target.closest('[data-efm-mode]');if(btn)applyMode(btn.dataset.efmMode,btn.dataset.efmMode==='modern')});
 // Não oferecer alternância de layout enquanto o modo Moderno estiver ativo.
 card.addEventListener('input',e=>{if(e.target.matches('[data-efm-zoom]')){const k=e.target.dataset.efmZoom+'Zoom';state[k]=Number(e.target.value);$('#efm-zoom-'+e.target.dataset.efmZoom+'-label').textContent=e.target.value+'%';save()}});
 renderSettings();
}
function mount(){if($('#efmroot'))return;
 const panel=$('#tab-painel');if(!panel){return}
 const root=document.createElement('div');root.id='efmroot';root.innerHTML=`<div class="efm-titleline"><div><p class="efm-title-eyebrow">EVOLUFÍSICO · ÁREA DE TRABALHO</p><h1>Dashboard</h1><p class="efm-subtitle">Seu espaço de trabalho. Organize os widgets e acesse seus módulos.</p></div><div class="efm-toolbar"><button type="button" class="efm-ui-btn" data-efm-click="edit">Editar widgets</button><button type="button" class="efm-ui-btn primary" data-efm-click="store">+ Biblioteca de Widgets</button></div></div><div id="efm-grid" class="efm-grid"></div><p class="efm-message">Os dados clínicos e financeiros permanecem nos módulos originais. Preferências de widgets ficam salvas neste navegador.</p>`;document.body.append(root);
 const nav=document.createElement('aside');nav.id='efm-nav';nav.setAttribute('aria-label','Módulos do Modo Moderno');nav.innerHTML=`<div class="efm-brand"><span class="efm-brand-emblem">EF</span><div>EvoluFísico <small style="display:block;font-size:10px;font-weight:500">Área de trabalho</small></div></div><p class="efm-navheading">Módulos originais</p>`+ROUTES.map(r=>`<button class="efm-navlink" type="button" data-efm-route="${r[0]}">${iconFor(r)}<span>${r[1]}</span></button>`).join('');document.body.append(nav);
 const dock=document.createElement('nav');dock.id='efm-dock';dock.setAttribute('aria-label','Dock de módulos originais');dock.innerHTML=ROUTES.map(r=>`<button class="efm-dock-link" type="button" title="${r[1]}" data-efm-route="${r[0]}"><span class="efm-dock-icon" style="background:linear-gradient(140deg,${r[3]},${r[3]}dc)">${iconFor(r)}</span><span class="efm-dock-label">${r[1]}</span><span class="efm-dot"></span></button>`).join('');document.body.append(dock);
 const store=document.createElement('div');store.id='efm-store';store.setAttribute('role','dialog');store.setAttribute('aria-label','Biblioteca de Widgets');store.setAttribute('aria-modal','true');store.setAttribute('aria-hidden','true');store.innerHTML=`<div class="efm-store-pane"><div class="efm-store-head"><div><h2>Biblioteca de Widgets</h2><small style="color:#738878">Instale e organize widgets sem alterar os módulos.</small></div><button class="efm-close" type="button" data-efm-click="close" aria-label="Fechar">×</button></div><input class="efm-store-search" id="efm-search" placeholder="Pesquisar widgets e ferramentas…" aria-label="Pesquisar widgets"><div class="efm-store-tabs" id="efm-store-tabs"></div><div class="efm-store-list" id="efm-store-list"></div></div>`;document.body.append(store);
 document.addEventListener('click',e=>{const r=e.target.closest('[data-efm-route]');if(r){openRoute(r.dataset.efmRoute);return}const action=e.target.closest('[data-efm-click]');if(action){const val=action.dataset.efmClick;if(val==='store')setDrawer(true);if(val==='close')setDrawer(false);if(val==='edit'){state.editing=!state.editing;renderBoard()}if(val==='reset'){state.order=[...defaults.order];state.stack=[...defaults.stack];state.stackIndex=0;state.sizes={...defaults.sizes};save();renderBoard()}return}const a=e.target.closest('[data-efm-action]');if(a)handleAction(a.dataset.efmAction,a.dataset.id,e)});
 store.addEventListener('click',e=>{if(e.target===store)setDrawer(false)});
 store.querySelector('#efm-search').addEventListener('input',e=>{search=e.target.value.toLocaleLowerCase('pt-BR');renderStore()});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&drawerOpen)setDrawer(false)});
 document.addEventListener('input',e=>{if(e.target.id==='efm-note'){state.notes=e.target.value;save()}});
 let dockRaf=0;dock.addEventListener('pointermove',e=>{if(e.pointerType==='touch'||matchMedia('(prefers-reduced-motion: reduce)').matches)return;cancelAnimationFrame(dockRaf);dockRaf=requestAnimationFrame(()=>{const a=$$('.efm-dock-link',dock);for(const el of a){const rc=el.getBoundingClientRect(),d=Math.abs(e.clientX-(rc.left+rc.width/2)),strength=Number(state.nav==='extended'?state.extendedZoom:state.advancedZoom)/100,scale=1+strength*Math.max(0,1-d/120);el.style.transform=`translateY(${-(scale-1)*10}px) scale(${scale})`;}})});dock.addEventListener('pointerleave',()=>{$$('.efm-dock-link',dock).forEach(e=>e.style.transform='')});
 let start=0;root.addEventListener('touchstart',e=>{if(e.target.closest('.efm-stack'))start=e.touches[0].clientX},{passive:true});root.addEventListener('touchend',e=>{if(start){const diff=e.changedTouches[0].clientX-start;start=0;if(Math.abs(diff)>45)cycleStack(diff<0?1:-1)}},{passive:true});
 const grid=$('#efm-grid');grid.addEventListener('dragstart',e=>{const parent=e.target.closest('.efm-unit[draggable=true]');if(parent){e.dataTransfer.setData('text/plain',parent.dataset.id)}});grid.addEventListener('dragover',e=>{if(e.target.closest('.efm-unit'))e.preventDefault()});grid.addEventListener('drop',e=>{const onto=e.target.closest('.efm-unit');if(!onto)return;e.preventDefault();move(state.order.indexOf(e.dataTransfer.getData('text/plain')),state.order.indexOf(onto.dataset.id))});
 applyMode(state.interface,false);renderBoard();syncNav();
 const observer=new MutationObserver(()=>syncNav());$$('.tab-panel').forEach(el=>observer.observe(el,{attributes:true,attributeFilter:['class']}));
 window.EFModernPreview={mode:mode=>applyMode(mode,true),open:openRoute,library:()=>setDrawer(true),state:()=>({...state})};
}
function setDrawer(open){drawerOpen=!!open;$('#efm-store')?.setAttribute('aria-hidden',String(!open));if(open){category='Todos';search='';$('#efm-search').value='';renderStore();setTimeout(()=>$('#efm-search')?.focus(),20)}}
function renderStore(){const tabs=$('#efm-store-tabs'),list=$('#efm-store-list');if(!list)return;
 const cats=['Todos',...new Set(catalog.map(x=>x.category))];tabs.innerHTML=cats.map(c=>`<button type="button" data-efm-action="category" data-id="${c}" aria-selected="${c===category}">${esc(c)}</button>`).join('');
 list.innerHTML=catalog.filter(x=>(category==='Todos'||x.category===category)&&((x.name+' '+x.desc+' '+x.category).toLocaleLowerCase('pt-BR').includes(search))).map(x=>{const installed=state.order.includes(x.id),stacked=state.stack.includes(x.id);return `<div class="efm-store-item"><div><h3>${esc(x.name)}</h3><p>${esc(x.category)} · ${esc(x.desc)}</p></div><div class="efm-store-actions"><button class="efm-ui-btn" type="button" data-efm-action="${stacked?'unstack':'stack'}" data-id="${x.id}" title="${stacked?'Retirar da pilha':'Adicionar à pilha'}">${stacked?'Na pilha':'+ Pilha'}</button><button class="efm-ui-btn ${installed?'':'primary'}" type="button" data-efm-action="${installed?'remove':'install'}" data-id="${x.id}">${installed?'Remover':'Instalar'}</button></div></div>`}).join('')||'<p>Nenhum widget encontrado.</p>';
}
function cardInner(x){const route=locate(x.route);const header=`<div class="efm-cardheader"><span class="efm-cardlabel">${svg(icons[x.kind]||route[4])}${esc(x.name)}</span><span class="efm-cardmeta">${esc(x.category)}</span></div>`;
 let body='';const k=x.kind;
 if(k==='counter')body=`<div class="efm-cardvalue">${count()}</div><p class="efm-carddesc">Avaliações cadastradas no aplicativo real.</p>`;
 else if(k==='clock')body=`<div class="efm-cardvalue" id="efm-clock">${new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})}</div><p class="efm-carddesc" id="efm-date">${new Date().toLocaleDateString('pt-BR',{weekday:'long',day:'2-digit',month:'long'})}</p>`;
 else if(k==='notes')body=`<textarea class="efm-textarea" id="efm-note" maxlength="2500" aria-label="Notas rápidas" placeholder="Escreva suas notas aqui…">${esc(state.notes)}</textarea><p class="efm-mini">Salvo automaticamente no navegador.</p>`;
 else if(k==='tasks')body=`<div style="display:flex;gap:7px"><input class="efm-textfield" placeholder="Adicionar tarefa…" id="efm-task-input" aria-label="Nova tarefa"><button type="button" class="efm-link" data-efm-action="addtask">+</button></div><div>${state.tasks.map((task,i)=>`<label class="efm-task"><input data-efm-action="taskdone" data-id="${i}" type="checkbox"><span>${esc(task)}</span><button type="button" class="efm-link" data-efm-action="deltask" data-id="${i}" aria-label="Excluir tarefa">×</button></label>`).join('')||'<p class="efm-carddesc">Nenhuma tarefa neste navegador.</p>'}</div>`;
 else if(k==='chart'){const vals=ROUTES.map(r=>Math.max(0,Number(state.usage[r[0]])||0));const max=Math.max(1,...vals);const bars=vals.map((v,i)=>`<rect x="${i*27+9}" y="${75-v/max*62}" width="16" height="${Math.max(1,v/max*62)}" rx="5" fill="${colors[i]}"/>`).join('');body=`<svg class="efm-chart" viewBox="0 0 252 82" preserveAspectRatio="none" role="img" aria-label="Gráfico de acessos por módulo">${bars}<path d="M0 79h252" stroke="#e5eee7"/></svg><p class="efm-carddesc">${vals.reduce((a,b)=>a+b,0)} acessos registrados neste navegador.</p>`;}
 else if(k==='imc')body=`<div style="display:flex;gap:7px"><input class="efm-textfield" type="number" inputmode="decimal" id="efm-weight" aria-label="Peso em quilogramas" placeholder="Peso kg" min="1" max="600" step="0.1"><input class="efm-textfield" type="number" inputmode="decimal" id="efm-height" aria-label="Altura em metros" placeholder="Altura m" min="0.4" max="2.7" step="0.01"></div><div class="efm-cardfoot"><button type="button" class="efm-link" data-efm-action="imc">Calcular</button><span id="efm-imc-result" class="efm-mini" aria-live="polite">Preencha peso e altura</span></div>`;
 else if(k==='links')body='<div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px">'+['avaliacoes','evolucao','cobrancas','configuracoes'].map(z=>`<button type="button" data-efm-route="${z}" class="efm-link">${esc(locate(z)[1])} ↗</button>`).join('')+'</div>';
 else body=`<p class="efm-carddesc">${esc(x.desc)}</p><div class="efm-cardfoot"><button type="button" class="efm-link" data-efm-action="${k==='new'?'new':k==='appearance'?'appearance':k==='maintenance'?'maintenance':'route'}" data-id="${x.id}">Abrir ${k==='new'?'avaliação':'módulo'} ↗</button></div>`;
 return header+body;
}
function unit(x,size){return `<div class="efm-unit ${size||''}" data-id="${x.id}" ${state.editing?'draggable="true"':''}><div class="efm-card">${cardInner(x)}</div><div class="efm-edittools"><button type="button" data-efm-action="left" data-id="${x.id}" title="Mover para trás">←</button><button type="button" data-efm-action="right" data-id="${x.id}" title="Mover para frente">→</button><button type="button" data-efm-action="resize" data-id="${x.id}" title="Alterar tamanho">⤢</button><button type="button" data-efm-action="remove" data-id="${x.id}" title="Remover widget">×</button></div></div>`}
function stackHTML(){if(!state.stack.length)return '';
 state.stackIndex=(state.stackIndex+state.stack.length)%state.stack.length;const x=catalog.find(x=>x.id===state.stack[state.stackIndex]);if(!x)return '';
 return `<div class="efm-unit wide" data-id="stack"><div class="efm-stack"><div class="efm-card"><div class="efm-cardheader"><span class="efm-cardlabel">${svg(icons.copy)} Pilha de Widgets</span><span class="efm-stack-pages">${state.stackIndex+1} / ${state.stack.length}</span></div><div class="efm-cardheader"><span class="efm-cardlabel">${esc(x.name)}</span><div class="efm-stack-arrows"><button type="button" data-efm-action="prevstack" aria-label="Widget anterior">‹</button><button type="button" data-efm-action="nextstack" aria-label="Próximo widget">›</button></div></div>${x.kind==='imc'||x.kind==='notes'||x.kind==='tasks'?`<p class="efm-carddesc">${esc(x.desc)}</p>`:cardInner(x).replace(/^<div class="efm-cardheader">[\s\S]*?<\/div>/,'')}<div class="efm-cardfoot"><button type="button" class="efm-link" data-efm-action="stackpicker">${stackOpen?'Recolher pilha':'Abrir pilha'}</button><span class="efm-mini">Deslize para alternar</span></div>${stackOpen?'<div class="efm-stack-picker">'+state.stack.map((id,i)=>`<button type="button" aria-selected="${i===state.stackIndex}" data-efm-action="setstack" data-id="${i}">${esc(catalog.find(x=>x.id===id)?.name||id)}</button>`).join('')+'</div>':''}</div></div></div>`;
}
function renderBoard(){const g=$('#efm-grid'),root=$('#efmroot');if(!g)return;root.classList.toggle('efm-editing',!!state.editing);$('[data-efm-click="edit"]',root).textContent=state.editing?'Concluir edição':'Editar widgets';let html=stackHTML();for(const id of state.order){const x=catalog.find(x=>x.id===id);if(x)html+=unit(x,state.sizes[id]||'')};g.innerHTML=html||'<p class="efm-empty">O Dashboard está vazio. Use Biblioteca de Widgets para instalar.</p>';}
function cycleStack(dx){if(!state.stack.length)return;state.stackIndex=(state.stackIndex+dx+state.stack.length)%state.stack.length;save();renderBoard()}
function move(a,b){if(a<0||b<0||a===b)return;const x=state.order.splice(a,1)[0];state.order.splice(b,0,x);save();renderBoard()}
function handleAction(action,id,e){if(action==='category'){category=id;renderStore();return}
 if(action==='install'){state.order.push(id)}
 else if(action==='remove'){state.order=state.order.filter(x=>x!==id)}
 else if(action==='stack'){state.stack=state.stack.filter(x=>x!==id);state.stack.push(id);state.stackIndex=state.stack.length-1}
 else if(action==='unstack'){state.stack=state.stack.filter(x=>x!==id);state.stackIndex=0}
 else if(action==='prevstack'){cycleStack(-1);return}
 else if(action==='nextstack'){cycleStack(1);return}
 else if(action==='setstack'){state.stackIndex=Number(id)||0}
 else if(action==='stackpicker'){stackOpen=!stackOpen}
 else if(action==='left'){move(state.order.indexOf(id),state.order.indexOf(id)-1);return}
 else if(action==='right'){move(state.order.indexOf(id),state.order.indexOf(id)+1);return}
 else if(action==='resize'){state.sizes[id]=state.sizes[id]==='wide'?'':'wide'}
 else if(action==='route'){const x=catalog.find(x=>x.id===id);if(x)openRoute(x.route);return}
 else if(action==='new'){openNew();return}
 else if(action==='appearance'){openSettingSection('personalizacao');return}
 else if(action==='maintenance'){openSettingSection('manutencao');return}
 else if(action==='imc'){const w=Number($('#efm-weight')?.value),h=Number($('#efm-height')?.value),v=$('#efm-imc-result');if(v)v.textContent=w>0&&h>=.4&&h<=2.7&&(w/h**2)<150?'IMC '+(w/(h*h)).toFixed(1).replace('.',',')+' kg/m²':'Informe valores válidos';return}
 else if(action==='addtask'){const e=$('#efm-task-input'),t=e?.value.trim();if(t&&state.tasks.length<80){state.tasks.push(t.slice(0,150))}else return}
 else if(action==='deltask'||action==='taskdone'){const n=Number(id);if(Number.isInteger(n)&&n>=0&&n<state.tasks.length)state.tasks.splice(n,1)}
 save();renderBoard();if(drawerOpen)renderStore();}

 function initSplashDockGate(){
  const markReady=()=>document.body?.classList.add('efm-splash-complete');
  const gate=()=>{
   const splash=document.getElementById('ef-splash');
   const skipped=document.documentElement.classList.contains('efg-no-splash');
   if(!splash||skipped||getComputedStyle(splash).display==='none'){markReady();return}
   if(!splash.classList.contains('dismissed'))document.body?.classList.remove('efm-splash-complete');
  };
  window.addEventListener('ef-splash-finished',markReady);
  gate();
  const splash=document.getElementById('ef-splash');
  if(splash){new MutationObserver(gate).observe(splash,{attributes:true,attributeFilter:['class','style']})}  new MutationObserver(gate).observe(document.documentElement,{attributes:true,attributeFilter:['class']});
 }
function initialize(){if(window.__EFModernIntegrated)return;window.__EFModernIntegrated=true;initSplashDockGate();let tries=0;function boot(){tries++;mountSettings();if($('#tab-painel')&&$('.efs-subpage[data-efs-panel="personalizacao"]')){mount();return}if(tries<45)setTimeout(boot,220)}boot();setInterval(()=>{const clock=$('#efm-clock'),date=$('#efm-date');if(clock)clock.textContent=new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});if(date)date.textContent=new Date().toLocaleDateString('pt-BR',{weekday:'long',day:'2-digit',month:'long'});const cnt=$('#history-counter')?.textContent;if(cnt!==window.__efmLastCount){window.__efmLastCount=cnt;const el=$('.efm-cardvalue');if(el?.closest('[data-id=resumo]'))el.textContent=count()}},8000)}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initialize,{once:true});else initialize();
})();

</script>
</body>
</html>