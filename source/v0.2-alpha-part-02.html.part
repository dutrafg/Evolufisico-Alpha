<script>/* 02-runtime.js */
// @ts-check
/**
 * @file EFU.ts (Compiled / Inlined)
 * @description Módulo de utilitários e tema para runtime browser.
 * @package EvoluFísico v8.9.1 Teste (Clinical Suite)
 */

/* ===== Módulo Global de Tema Escuro / Claro ===== */
function atualizarBotoesTema(isDark) {
    const navIcon = document.getElementById('nav-theme-icon');
    const navText = document.getElementById('nav-theme-text');
    const navBtn = document.getElementById('btn-theme-toggle');
    if (navIcon) navIcon.textContent = isDark ? '☀️' : '🌙';
    if (navText) navText.textContent = isDark ? 'Claro' : 'Escuro';
    if (navBtn) {
        navBtn.title = isDark ? 'Mudar para Modo Claro' : 'Mudar para Modo Escuro';
        navBtn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
    }
}

function aplicarTemaGlobal(on) {
    document.documentElement.classList.toggle('ef-dark-mode', !!on);
    try {
        localStorage.setItem('evolufisico_dark_mode', on ? '1' : '0');
    } catch(e) {}
    atualizarBotoesTema(!!on);
}

function alternarModoEscuroGlobal() {
    const isDark = document.documentElement.classList.contains('ef-dark-mode');
    const novoEstado = !isDark;
    aplicarTemaGlobal(novoEstado);
    if (window.efToast) efToast(novoEstado ? '🌙 Modo escuro ativado' : '☀️ Modo claro ativado');
}

window.alternarModoEscuroGlobal = alternarModoEscuroGlobal;
window.aplicarTemaGlobal = aplicarTemaGlobal;
window.atualizarBotoesTema = atualizarBotoesTema;

(function() {
    try {
        const darkSalvo = localStorage.getItem('evolufisico_dark_mode') === '1';
        if (darkSalvo) {
            document.documentElement.classList.add('ef-dark-mode');
        }
    } catch(e) {}
})();

window.addEventListener('DOMContentLoaded', () => {
    const isDark = document.documentElement.classList.contains('ef-dark-mode');
    atualizarBotoesTema(isDark);
});

window.EFU=(function(){
  function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
  function num(v){var x=parseFloat(String(v==null?'':v).replace(',','.'));return isFinite(x)?x:null}
  function norm(v){return String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim()}
  return Object.freeze({version:'8.9',esc:esc,num:num,norm:norm});
})();
</script>
<script id="ef-data-integrity">(function(){
'use strict';
const norm=v=>String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase();
const records=()=>window.avaliacoes||[];
const contact=a=>a.email?'email:'+String(a.email).trim().toLowerCase():String(a.whatsapp||'').replace(/\D/g,'').length>=10?'phone:'+String(a.whatsapp).replace(/\D/g,''):null;
const fresh=()=> (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') ? 'client_' + crypto.randomUUID() : 'client_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 8);
function ensure(a,list=records()){
 if(a.cliente_id)return a.cliente_id;
 const existing=list.find(x=>x!==a&&String(x.id)===String(a.id));
 if(existing&&existing.cliente_id)return a.cliente_id=existing.cliente_id;
 const c=contact(a),matches=c?list.filter(x=>x!==a&&contact(x)===c):[];
 const ids=[...new Set(matches.map(x=>x.cliente_id).filter(Boolean))];
 a.cliente_id=ids.length===1?ids[0]:fresh();
 return a.cliente_id;
}
function key(a){return a&&typeof a==='object'?ensure(a):resolve(a)}
function resolve(v){const str=String(v||'');const list=records();if(list.some(a=>a.cliente_id===str))return str;
 const ids=[...new Set(list.filter(a=>norm(a.nome)===norm(str)||String(a.id)===str).map(a=>ensure(a,list)))];
 return ids.length===1?ids[0]:'unresolved:'+str;
}
window.EFIdentity={ensure,key,resolve,same:(a,b)=>key(a)===key(b),contact};
window.EFMeasures={lean:a=>{const x=a&&a.dobras_resultado&&a.dobras_resultado.massaMagra;return x!==''&&x!=null&&Number.isFinite(Number(x))?Number(x):null},muscle:a=>{const x=a&&a.bioimpedancia&&a.bioimpedancia.mme;return x!==''&&x!=null&&Number.isFinite(Number(x))?Number(x):null}};
function clientPicker(){
 const input=document.querySelector('[name="nome"]');if(!input||document.getElementById('ef-client-identity'))return;
 const wrap=document.createElement('div');wrap.className='input-group';
 const label=document.createElement('label');label.htmlFor='ef-client-identity';label.textContent='Vincular avaliação a um cliente';
 const select=document.createElement('select');select.id='ef-client-identity';select.className='form-control';
 select.onchange=()=>select.dataset.changed='1';
 function fill(){const value=select.value||'auto';select.replaceChildren();for(const [v,t] of [['auto','Automático por contato ou avaliação em edição'],['new','Novo cliente (mesmo que tenha nome igual)']]){const o=new Option(t,v);select.add(o)}const seen=new Set();records().forEach(a=>{const k=key(a);if(seen.has(k))return;seen.add(k);select.add(new Option((a.nome||'Sem nome')+' · '+(a.email||a.whatsapp||k.slice(-12)),k))});select.value=value;}
 fill();wrap.append(label,select);(input.closest('.input-group')||input).before(wrap);
 input.form?.addEventListener('reset',()=>{select.dataset.changed='0';select.value='auto'});
 window.addEventListener('ef-records-changed',fill);
}
function banner(){if(!window.EF_TEMPORARY_STORAGE)return;const b=document.createElement('div');b.id='ef-storage-warning';b.setAttribute('role','alert');b.style.cssText='position:sticky;top:0;z-index:99999;padding:12px;background:#713f12;color:white;text-align:center';b.textContent='Armazenamento temporário: exporte um backup antes de fechar ou recarregar. Dados e senha guardados apenas em memória serão perdidos.';const btn=document.createElement('button');btn.type='button';btn.textContent='Exportar backup';btn.style.marginLeft='12px';btn.onclick=()=>window.exportarBackupJSON();b.append(btn);document.body.prepend(b)}
document.addEventListener('DOMContentLoaded',()=>{banner();clientPicker()});
})();
</script>
<script>/* 03-runtime.js */
// =========================================================================
        // MÓDULO CIENTÍFICO: SOMATOTIPO HEATH-CARTER & SOMATOCARTA SVG (V4.6)
        // =========================================================================
        const CalculadoraSomatotipo = {
            calcular: function(alturaCm, pesoKg, triceps, subescapular, suprailiaca, panturrilhaDobra, bracoContr, panturrilhaPerim) {
                const alt = parseFloat(alturaCm);
                const peso = parseFloat(pesoKg);
                const tri = parseFloat(triceps);
                const sub = parseFloat(subescapular);
                const sup = parseFloat(suprailiaca);
                const ptDobra = parseFloat(panturrilhaDobra) || 12.0;
                const braco = parseFloat(bracoContr);
                const pant = parseFloat(panturrilhaPerim);

                if (![alt, peso, tri, sub, sup, braco, pant].every(v => Number.isFinite(v) && v > 0)) {
                    return {
                        endomorfia: '--',
                        mesomorfia: '--',
                        ectomorfia: '--',
                        x: null,
                        y: null,
                        classificacao: 'Dados insuficientes',
                        insuficiente: true
                    };
                }

                // 1. Endomorfia (Carter 2002)
                const soma3 = (tri + sub + sup) * (170.18 / alt);
                let endo = -0.7182 + (0.1451 * soma3) - (0.00068 * Math.pow(soma3, 2)) + (0.0000014 * Math.pow(soma3, 3));
                endo = Math.max(0.1, parseFloat(endo.toFixed(1)));

                // 2. Ectomorfia
                const hwr = alt / Math.cbrt(peso);
                let ecto = 0.1;
                if (hwr >= 40.75) {
                    ecto = (hwr * 0.732) - 28.58;
                } else if (hwr >= 38.25) {
                    ecto = (hwr * 0.463) - 17.63;
                }
                ecto = Math.max(0.1, parseFloat(ecto.toFixed(1)));

                // 3. Mesomorfia (Carter 2002)
                const diamUmero = parseFloat((alt * 0.0393).toFixed(1));
                const diamFemur = parseFloat((alt * 0.0535).toFixed(1));
                const bracoCorrigido = braco - (tri / 10.0);
                const pantCorrigida = pant - (ptDobra / 10.0);

                let meso = (0.858 * diamUmero) + (0.601 * diamFemur) + (0.188 * bracoCorrigido) + (0.161 * pantCorrigida) - (0.131 * alt) + 4.5;
                meso = Math.max(0.1, parseFloat(meso.toFixed(1)));

                const x = parseFloat((ecto - endo).toFixed(1));
                const y = parseFloat(((2 * meso) - (endo + ecto)).toFixed(1));

                let classificacao = 'Central / Equilibrado';
                if (meso > endo && meso > ecto) {
                    if (endo > ecto + 0.5) classificacao = 'Meso-Endomorfo';
                    else if (ecto > endo + 0.5) classificacao = 'Ecto-Mesomorfo';
                    else classificacao = 'Mesomorfo Equilibrado';
                } else if (endo > meso && endo > ecto) {
                    if (meso > ecto + 0.5) classificacao = 'Endo-Mesomorfo';
                    else if (ecto > meso + 0.5) classificacao = 'Endo-Ectomorfo';
                    else classificacao = 'Endomorfo Equilibrado';
                } else if (ecto > endo && ecto > meso) {
                    if (meso > endo + 0.5) classificacao = 'Meso-Ectomorfo';
                    else classificacao = 'Ectomorfo Equilibrado';
                }

                return {
                    endomorfia: endo,
                    mesomorfia: meso,
                    ectomorfia: ecto,
                    x: x,
                    y: y,
                    classificacao: classificacao
                };
            },

            renderizarSomatocartaSvg: function(x, y) {
                if (typeof x !== 'number' || typeof y !== 'number' || !isFinite(x) || !isFinite(y)) {
                    return '<div style="text-align:center;font-size:0.75rem;color:#64748b;padding:1.5rem 0;">Somatocarta indisponível: faltam dobras (tríceps, subescapular, suprailíaca), braço ou panturrilha.</div>';
                }
                const svgW = 200, svgH = 170;
                const originX = 100, originY = 95;
                const scaleX = 8.5;
                const scaleY = 5.5;

                const posX = Math.max(10, Math.min(190, originX + (x * scaleX)));
                const posY = Math.max(10, Math.min(160, originY - (y * scaleY)));

                return `
                <svg width="${svgW}" height="${svgH}" viewBox="0 0 ${svgW} ${svgH}" style="margin: 0 auto; display: block; overflow: visible;">
                    <polygon points="100,20 20,150 180,150" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2"/>
                    <line x1="100" y1="20" x2="100" y2="150" stroke="#e2e8f0" stroke-dasharray="3,3"/>
                    <line x1="20" y1="150" x2="180" y2="150" stroke="#e2e8f0" stroke-dasharray="3,3"/>
                    <line x1="50" y1="95" x2="150" y2="95" stroke="#e2e8f0" stroke-dasharray="3,3"/>
                    <text x="100" y="14" font-size="8" font-weight="bold" fill="#0071e3" text-anchor="middle">MESOMORFIA (+Y)</text>
                    <text x="18" y="162" font-size="7.5" font-weight="bold" fill="#ff9500" text-anchor="start">ENDOMORFIA (-X)</text>
                    <text x="182" y="162" font-size="7.5" font-weight="bold" fill="#34c759" text-anchor="end">ECTOMORFIA (+X)</text>
                    <circle cx="${posX}" cy="${posY}" r="5" fill="#ff3b30" stroke="#ffffff" stroke-width="2"/>
                    <text x="${posX + 7}" y="${posY + 3}" font-size="8.5" font-weight="bold" fill="#ff3b30">(${x}, ${y})</text>
                </svg>
                `;
            }
        };
        CalculadoraSomatotipo.doRegistro = function(aval) {
            const d = (aval && aval.dobras) || {}, p = (aval && aval.perimetria) || {};
            const alt = parseFloat(aval && aval.altura), peso = parseFloat(aval && aval.peso);
            const tri = parseFloat(d.triceps), sub = parseFloat(d.subescapular), sup = parseFloat(d.suprailiaca);
            const braco = parseFloat(p.braco_dir || p.braco_esq || aval.braco_dir), pant = parseFloat(p.panturrilha || aval.panturrilha);
            const ok = [alt, peso, tri, sub, sup, braco, pant].every(v => Number.isFinite(v) && v > 0);
            if (!ok) {
                return { endomorfia: '--', mesomorfia: '--', ectomorfia: '--', x: null, y: null, classificacao: 'Dados insuficientes', insuficiente: true };
            }
            return CalculadoraSomatotipo.calcular(alt, peso, tri, sub, sup, parseFloat(d.panturrilha) || 12.0, braco, pant);
        };
        window.CalculadoraSomatotipo = CalculadoraSomatotipo;

        // Triagem PAR-Q+
        function atualizarStatusParQLive() {
            let simCount = 0;
            for (let i = 1; i <= 7; i++) {
                if (document.getElementById(`parq_q${i}`)?.checked) simCount++;
            }
            const badge = document.getElementById('parq-live-badge');
            if (badge) {
                if (simCount === 0) {
                    badge.textContent = '✅ Apto sem restrições';
                    badge.style.background = 'var(--apple-green-light)';
                    badge.style.color = '#1b7a36';
                } else {
                    badge.textContent = `⚠️ Necessita Liberação Médica (${simCount} alerta${simCount > 1 ? 's' : ''})`;
                    badge.style.background = 'var(--apple-orange-light)';
                    badge.style.color = '#944a00';
                }
            }
        }
        window.atualizarStatusParQLive = atualizarStatusParQLive;

