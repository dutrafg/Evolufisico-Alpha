        function obterDadosProfissionalPadrao() {
            return {
                nome: (localStorage.getItem('evolufisico_pro_nome') || document.getElementById('avaliador_nome')?.value || '').trim(),
                cref: (localStorage.getItem('evolufisico_pro_cref') || document.getElementById('avaliador_registro')?.value || '').trim(),
                clinica: (localStorage.getItem('evolufisico_pro_clinica') || document.getElementById('avaliador_clinica')?.value || '').trim()
            };
        }

        function abrirModalConfigProfissional() {
            const dados = obterDadosProfissionalPadrao();
            if (document.getElementById('cfg_pro_nome')) document.getElementById('cfg_pro_nome').value = dados.nome;
            if (document.getElementById('cfg_pro_cref')) document.getElementById('cfg_pro_cref').value = dados.cref;
            if (document.getElementById('cfg_pro_apelido')) document.getElementById('cfg_pro_apelido').value = localStorage.getItem('evolufisico_pro_apelido') || '';
            if (document.getElementById('cfg_pro_clinica')) document.getElementById('cfg_pro_clinica').value = dados.clinica;
            
            const modal = document.getElementById('modal-config-profissional');
            if (modal) modal.classList.remove('hidden');
        }

        function fecharModalConfigProfissional() {
            const modal = document.getElementById('modal-config-profissional');
            if (modal) modal.classList.add('hidden');
        }

        function salvarConfigProfissional() {
            const nomeInput = document.getElementById('cfg_pro_nome');
            const nome = (nomeInput?.value || '').trim();
            const apelido = (document.getElementById('cfg_pro_apelido')?.value || '').trim();
            const cref = (document.getElementById('cfg_pro_cref')?.value || '').trim();
            const clinica = (document.getElementById('cfg_pro_clinica')?.value || '').trim();
            if (!nome) {
                if (nomeInput) { nomeInput.setCustomValidity('Informe seu nome completo.'); nomeInput.reportValidity(); nomeInput.focus(); }
                return false;
            }
            if (nomeInput) nomeInput.setCustomValidity('');

            localStorage.setItem('evolufisico_pro_nome', nome);
            localStorage.setItem('evolufisico_pro_apelido', apelido);
            localStorage.setItem('evolufisico_pro_cref', cref);
            localStorage.setItem('evolufisico_pro_clinica', clinica);

            const elNome = document.getElementById('avaliador_nome');
            if (elNome && !elNome.value) elNome.value = nome;
            const elCref = document.getElementById('avaliador_registro');
            if (elCref && !elCref.value) elCref.value = cref;
            const elClinica = document.getElementById('avaliador_clinica');
            if (elClinica && !elClinica.value) elClinica.value = clinica;

            fecharModalConfigProfissional();
            window.EFHomeDashboard?.refresh?.();
            alert('Dados profissionais atualizados. Nome, CREF e local de trabalho poderão ser usados nos relatórios em PDF.');
        }

        window.abrirModalConfigProfissional = abrirModalConfigProfissional;
        window.fecharModalConfigProfissional = fecharModalConfigProfissional;
        window.salvarConfigProfissional = salvarConfigProfissional;

        function verificarRoteamentoHashLaudo() {
            if (window.location.hash && window.location.hash.includes('#laudo=')) {
                const id = window.location.hash.split('#laudo=')[1];
                if (id) {
                    setTimeout(() => {
                        abrirVisualizacaoPacienteWeb(id);
                    }, 250);
                }
            }
        }
        window.addEventListener('DOMContentLoaded', verificarRoteamentoHashLaudo);
        window.addEventListener('hashchange', verificarRoteamentoHashLaudo);

        document.addEventListener('DOMContentLoaded', () => {
            ['bia_imc', 'bia_gordura_kg', 'bia_mme'].forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el.addEventListener('input', ev => {
                        ev.target.dataset.manual = ev.target.value ? '1' : '';
                    });
                }
            });
        });

        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                if (typeof fecharModalDetalhes === 'function') fecharModalDetalhes();
                if (typeof fecharModalConfigProfissional === 'function') fecharModalConfigProfissional();
                if (typeof fecharModalLaudoWeb === 'function') fecharModalLaudoWeb();
                if (typeof fecharVisualizacaoPacienteWeb === 'function') fecharVisualizacaoPacienteWeb();
                if (typeof fecharConfiguracaoCriptografia === 'function') fecharConfiguracaoCriptografia();
                document.querySelectorAll('.modal-overlay:not(.hidden)').forEach(m => m.classList.add('hidden'));            }
        });
</script>
<script>/* 04-runtime.js */
(function(){'use strict';
var $=function(s){return document.querySelector(s)};
var esc=function(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})};
// Escapa separadamente o contexto JavaScript de handlers gerados no HTML.
var jsEsc=function(s){return esc(String(s==null?'':s).replace(/\\/g,'\\\\').replace(/'/g,"\\'").replace(/\r/g,'\\r').replace(/\n/g,'\\n'))};
var norm=function(s){return String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim()};
var pd=function(s){var m=/^(\d{4})-(\d{2})-(\d{2})/.exec(s||'');return m?new Date(+m[1],+m[2]-1,+m[3]):null};
var fd=function(d){return d?d.toLocaleDateString('pt-BR'):'—'};
var num=function(v){var n=parseFloat(String(v).replace(',','.'));return isFinite(n)?n:null};
var lista=function(){try{return Array.isArray(avaliacoes)?avaliacoes:[]}catch(e){return[]}};
var pg=function(a){var r=a.dobras_resultado&&num(a.dobras_resultado.percGordura);return r!=null?r:num(a.bioimpedancia&&a.bioimpedancia.pgordura)};
var mm=function(a){return EFMeasures.lean(a)};
var ini=function(n){var p=String(n||'?').trim().split(/\s+/).filter(Boolean);return p.length?(p[0][0]+(p.length>1?p[p.length-1][0]:'')):'?'};
var addDays=function(d,n){var x=new Date(d.getFullYear(),d.getMonth(),d.getDate());x.setDate(x.getDate()+n);return x};
var startOfWeek=function(d){var x=new Date(d.getFullYear(),d.getMonth(),d.getDate());var day=(x.getDay()+6)%7;x.setDate(x.getDate()-day);return x};
var sameDay=function(a,b){return a&&b&&a.getFullYear()===b.getFullYear()&&a.getMonth()===b.getMonth()&&a.getDate()===b.getDate()};
var toISO=function(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')};
var monthLabel=function(d){return d.toLocaleDateString('pt-BR',{month:'long',year:'numeric'})};
var STORAGE='ef90_home_agenda';
var LOCATION_FILTER_KEY='ef90_agenda_local_filtro';
var SELDAY='ef90_home_selected_day';
var MONTHOFF='ef90_home_month_offset';
var today=function(){var d=new Date();return new Date(d.getFullYear(),d.getMonth(),d.getDate())};

/* Feedback interno unificado: banners compactos, padrão desktop/macOS. */
var efToastRecent={};
function toast(msg,tipo){
 var raw=String(msg==null?'':msg).trim();if(!raw)return;
 var kind=String(tipo||'info').toLowerCase();
 if(kind==='ok'||kind==='success'||kind==='sucesso')kind='success';
 else if(kind==='warn'||kind==='warning'||kind==='aviso')kind='warning';
 else if(kind==='error'||kind==='danger'||kind==='fail'||kind==='erro')kind='error';
 else kind='info';
 var key=kind+'|'+raw,now=Date.now();
 if(efToastRecent[key]&&now-efToastRecent[key]<1600)return;
 efToastRecent[key]=now;
 var c=$('#ef55-toasts');if(!c){c=document.createElement('div');c.id='ef55-toasts';c.className='no-print';c.setAttribute('aria-label','Notificações do aplicativo');document.body.appendChild(c)}
 var labels={success:'Concluído',warning:'Atenção',error:'Não foi possível concluir',info:'EvoluFísico2'};
 var paths={
  success:'<path d="M5 12.5l4.3 4.3L19 7"/>',
  warning:'<path d="M12 3l9 16H3z"/><path d="M12 9v4"/><path d="M12 16.7h.01"/>',
  error:'<circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/>',
  info:'<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.5h.01"/>'
 };
 var el=document.createElement('section');el.className='ef55-toast efmac-toast efmac-'+kind;
 el.dataset.kind=kind;el.setAttribute('role',kind==='error'?'alert':'status');
 var ic=document.createElement('span');ic.className='efmac-icon';ic.setAttribute('aria-hidden','true');
 ic.innerHTML='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">'+paths[kind]+'</svg>';
 var copy=document.createElement('div');copy.className='efmac-copy';
 var title=document.createElement('strong');title.className='efmac-title';title.textContent=labels[kind];
 var description=document.createElement('p');description.className='efmac-message';description.textContent=raw;
 copy.append(title,description);
 var close=document.createElement('button');close.className='efmac-close';close.type='button';close.setAttribute('aria-label','Dispensar notificação');close.title='Fechar notificação';close.textContent='×';
 el.append(ic,copy,close);
 var total=kind==='error'?10000:kind==='warning'?8500:6200,remaining=total,started=0,timer=null,removing=false;
 function stop(){if(timer!==null){clearTimeout(timer);timer=null;if(started)remaining=Math.max(0,remaining-(Date.now()-started));}}
 function remove(){if(removing)return;removing=true;stop();el.classList.add('out');
   var delay=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches?0:180;
   setTimeout(function(){el.remove();if(!c.children.length)c.remove()},delay);
 }
 function resume(){if(removing||timer!==null)return;started=Date.now();timer=setTimeout(remove,remaining)}
 close.addEventListener('click',remove);
 el.addEventListener('mouseenter',stop);el.addEventListener('mouseleave',resume);
 el.addEventListener('focusin',stop);el.addEventListener('focusout',function(){setTimeout(function(){if(!el.contains(document.activeElement))resume()},0)});
 c.prepend(el);
 while(c.children.length>3){var last=c.lastElementChild;if(last===el)break;last.remove()}
 resume();return el;
}
window.efToast=toast;

function alunos(){var m={};lista().forEach(function(a){var k=EFIdentity.key(a);if(k)(m[k]=m[k]||[]).push(a)});
return Object.keys(m).map(function(k){var l=m[k].sort(function(x,y){return(x.data_avaliacao||'').localeCompare(y.data_avaliacao||'')});return{nome:l[l.length-1].nome,list:l,first:l[0],last:l[l.length-1]}})}

function abrir(id){var fn=['abrirModalDetalhes','verDetalhesAvaliacao','visualizarAvaliacao','abrirDetalhesAvaliacao','verAvaliacao'].filter(function(n){return typeof window[n]==='function'})[0];
if(fn)window[fn](id);else window.switchTab('tab-historico')}
window.ef55Abrir=abrir;
window.ef55Zap=function(ev,id){ev.stopPropagation();var a=lista().filter(function(x){return x.id===id})[0];if(!a)return;
var d=String(a.whatsapp||'').replace(/\D/g,'');if(!d){toast('Aluno sem WhatsApp cadastrado.','warn');return}
var msg='Olá, '+String(a.nome).split(' ')[0]+'! Sua reavaliação física está prevista para '+fd(pd(a.data_proxima_avaliacao))+'. Vamos agendar o melhor horário?';
window.open('https://api.whatsapp.com/send?phone='+(d.length<=11?'55':'')+d+'&text='+encodeURIComponent(msg),'_blank','noopener,noreferrer')};

function chip(v,un,bomSeNeg){if(v==null||isNaN(v))return'';var cls=Math.abs(v)<0.05?'':((v<0)===bomSeNeg?'ok':'bad');
return'<span class="ef55-pill '+cls+'">'+(v>0?'+':'')+v.toFixed(1)+un+'</span>'}
function rows(arr,fn,empty){return arr.length?arr.map(fn).join(''):'<div class="ef55-empty">'+(empty||'Nada por aqui ainda.')+'</div>'}
function kpi(icon,t,v,s){return '<div class="ef90-kpi"><div class="ef90-kpi-icon">'+icon+'</div><div><small>'+t+'</small><strong>'+v+'</strong><span>'+s+'</span></div></div>'}
function pill(cls,txt){return '<span class="ef90-chip '+cls+'">'+esc(txt)+'</span>'}
function storageGet(k,fb){try{var v=localStorage.getItem(k);return v==null?fb:v}catch(e){return fb}}
function storageSet(k,v){try{localStorage.setItem(k,v)}catch(e){}}
function loadAgenda(){try{var raw=JSON.parse(storageGet(STORAGE,'[]'));return Array.isArray(raw)?raw.filter(Boolean):[]}catch(e){return[]}}
function saveAgenda(list){storageSet(STORAGE,JSON.stringify(list||[]))}
function localNormalizado(valor){return String(valor||'').trim().replace(/\s+/g,' ')}
function locaisConhecidos(agenda){
 var vistos={};return (agenda||[]).slice().reverse().map(function(a){return localNormalizado(a.local)}).filter(function(n){
 if(!n)return false;var k=norm(n);if(vistos[k])return false;vistos[k]=true;return true
 }).slice(0,50).sort(function(a,b){return a.localeCompare(b,'pt-BR')})
}
function filtroLocalSelecionado(locais){var v=storageGet(LOCATION_FILTER_KEY,'__todos__');
 if(v==='__todos__'||v==='__sem__')return v;
 return locais.some(function(nome){return norm(nome)===norm(v)})?v:'__todos__'
}
function eventoDoLocal(e,local){
 if(local==='__todos__')return true;
 if(local==='__sem__')return !localNormalizado(e.local);
 return norm(e.local)===norm(local)
}
window.ef90FiltrarLocal=function(local){storageSet(LOCATION_FILTER_KEY,local||'__todos__');render()};
function selectedDay(){var iso=storageGet(SELDAY,toISO(today()));return /^\d{4}-\d{2}-\d{2}$/.test(iso)?iso:toISO(today())}
function setSelectedDay(iso){storageSet(SELDAY,iso)}
function monthOffset(){var v=parseInt(storageGet(MONTHOFF,'0'),10);return isFinite(v)?v:0}
function setMonthOffset(v){storageSet(MONTHOFF,String(v))}
function agendaStats(agenda, base){var s0=startOfWeek(base), s7=addDays(s0,7), t1=addDays(base,1);var todayCount=agenda.filter(function(a){return a.date===toISO(base)}).length;var weekCount=agenda.filter(function(a){var d=pd(a.date);return d&&d>=s0&&d<s7}).length;var pend=agenda.filter(function(a){return a.status!=='concluido'&&pd(a.date)&&pd(a.date)<t1}).length;return {today:todayCount,week:weekCount,pending:pend}}
function buildReturnEvents(alunosList, base){return alunosList.map(function(x){var d=pd(x.last.data_proxima_avaliacao);return d?{id:'ret-'+x.last.id,date:toISO(d),time:'',type:'reavaliacao',student:x.nome,status:(d<base?'atrasado':sameDay(d,base)?'hoje':'agendado'),note:'Retorno automático pela próxima avaliação',source:'return',refId:x.last.id,whatsapp:x.last.whatsapp||''}:null}).filter(Boolean)}
function buildAttention(alunosList, agenda, base){var next30=addDays(base,30);var items=[];
var overdue=alunosList.map(function(x){var d=pd(x.last.data_proxima_avaliacao);return d?{student:x.nome,date:d,refId:x.last.id}:null}).filter(Boolean).filter(function(x){return x.date<base}).sort(function(a,b){return a.date-b.date}).slice(0,4);
overdue.forEach(function(x){var days=Math.round((base-x.date)/864e5);items.push({kind:'warn',title:'Reavaliação em atraso',text:x.student+' está com retorno atrasado há '+days+' dia(s).',refId:x.refId})});
var noNext=alunosList.filter(function(x){return !x.last.data_proxima_avaliacao}).slice(0,3);noNext.forEach(function(x){items.push({kind:'neutral',title:'Definir próximo retorno',text:x.nome+' ainda não tem uma nova data de avaliação definida.',refId:x.last.id})});
var lateAgenda=agenda.filter(function(a){var d=pd(a.date);return a.status!=='concluido'&&d&&d<base}).slice(0,4);lateAgenda.forEach(function(a){items.push({kind:'warn',title:'Atendimento pendente na agenda',text:(a.student||'Compromisso')+' ficou pendente desde '+fd(pd(a.date))+' às '+(a.time||'—')+'.'})});
return items.slice(0,8)}
function calendarGrid(events, monthDate, selISO){var first=new Date(monthDate.getFullYear(),monthDate.getMonth(),1);var start=new Date(first);start.setDate(first.getDate()-((first.getDay()+6)%7));var names=['Seg','Ter','Qua','Qui','Sex','Sáb','Dom'];
var buckets={};events.forEach(function(e){(buckets[e.date]=buckets[e.date]||[]).push(e)});
var head=names.map(function(n){return '<div class="ef90-cal-head">'+n+'</div>'}).join('');
var cells='';
for(var i=0;i<42;i++){
  var d=addDays(start,i), iso=toISO(d), sameMonth=d.getMonth()===monthDate.getMonth(), list=buckets[iso]||[];
  var cls='ef90-cal-day'+(sameMonth?'':' muted')+(iso===selISO?' selected':'')+(iso===toISO(today())?' today':'')+(list.length?' has-events':'');
  cells+='<button type="button" class="'+cls+'" onclick="ef90PickDay(\''+iso+'\')"><span class="num">'+d.getDate()+'</span><span class="dots">'+(list.slice(0,3).map(function(e){return '<i class="'+(e.source==='return'?'ret':'agd')+'"></i>'}).join('')||'')+'</span><small>'+(list.length?list.length+' item(ns)':'')+'</small></button>';
 }
 return '<div class="ef90-calendar-grid">'+head+cells+'</div>';
}
function dayEvents(iso, allEvents){return allEvents.filter(function(e){return e.date===iso}).sort(function(a,b){return String(a.time||'').localeCompare(String(b.time||''))})}
function openWhats(student, phone, date){var d=String(phone||'').replace(/\D/g,'');if(!d){toast('Aluno sem WhatsApp cadastrado.','warn');return}
var msg='Olá, '+String(student||'').split(' ')[0]+'! Estou entrando em contato para alinhar sua avaliação do dia '+fd(pd(date))+'.';
window.open('https://api.whatsapp.com/send?phone='+(d.length<=11?'55':'')+d+'&text='+encodeURIComponent(msg),'_blank','noopener,noreferrer')}
window.ef90OpenWhatsapp=openWhats;
window.ef90PickDay=function(iso){setSelectedDay(iso);render()};
window.ef90ShiftMonth=function(delta){setMonthOffset(monthOffset()+delta);render()};
window.ef90JumpToday=function(){
 setMonthOffset(0);setSelectedDay(toISO(today()));render();
 toast('Calendário atualizado para hoje: '+fd(today())+'.');
 requestAnimationFrame(function(){requestAnimationFrame(function(){
  var card=document.querySelector('[data-ef-proto-card="calendario"]')||document.querySelector('.ef90-calendar-nav')?.closest('.ef90-card');
  if(!card)return;
  card.classList.add('ef-today-highlight');
  if(typeof card.scrollIntoView==='function')card.scrollIntoView({behavior:'smooth',block:'start'});
  setTimeout(function(){card.classList.remove('ef-today-highlight')},2000)
 })});
};
window.ef90RemoveAgenda=function(id){var items=loadAgenda().filter(function(x){return x.id!==id});saveAgenda(items);if(editingAgendaId===id)editingAgendaId=null;toast('Compromisso removido.');render()};
window.ef90ToggleAgenda=function(id){var items=loadAgenda();items=items.map(function(x){if(x.id===id)x.status=x.status==='concluido'?'agendado':'concluido';return x});saveAgenda(items);render()};
var editingAgendaId=null;
function alunoCorrespondente(nome){return alunos().find(function(x){return norm(x.nome)===norm(nome)})||null}
function intervalo(a){var parts=String(a.time||'09:00').split(':');var start=(parseInt(parts[0],10)||0)*60+(parseInt(parts[1],10)||0);var duration=Number(a.duration)||60;return {start:start,end:start+duration}}
function conflitante(lista,date,time,duration,exclude){var current=intervalo({time:time,duration:duration});return lista.some(function(x){if(x.id===exclude||x.date!==date||x.status==='cancelado')return false;var prior=intervalo(x);return current.start<prior.end&&prior.start<current.end})}
window.ef90SetStatus=function(id,status){var allowed=['agendado','confirmado','concluido','faltou','cancelado'];if(allowed.indexOf(status)<0)return;var items=loadAgenda();items.forEach(function(a){if(a.id===id)a.status=status});saveAgenda(items);render()};
window.ef90EditAgenda=function(id){var a=loadAgenda().find(function(x){return x.id===id});if(!a)return;editingAgendaId=id;setSelectedDay(a.date);setMonthOffset((pd(a.date).getFullYear()-today().getFullYear())*12+pd(a.date).getMonth()-today().getMonth());render();[['ef90-date',a.date],['ef90-time',a.time],['ef90-duration',a.duration||60],['ef90-type',a.type],['ef90-student',a.student],['ef90-location',a.local||''],['ef90-note',a.note]].forEach(function(x){var el=document.getElementById(x[0]);if(el)el.value=x[1]||''});var btn=$('#ef90-save-button');if(btn)btn.textContent='Salvar alteração';var f=$('#ef90-date');if(f)f.focus()};
window.ef90CancelEdit=function(){editingAgendaId=null;render()};
window.ef90ExportAgenda=function(){var data={tipo:'agenda-evolufisico',versao:1,exportadoEm:new Date().toISOString(),compromissos:loadAgenda(),tarefas:getTasks()};var blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='evolufisico-agenda-tarefas.json';document.body.appendChild(a);a.click();a.remove();setTimeout(function(){URL.revokeObjectURL(url)},1000)};

window.ef90SaveAgenda=function(ev){if(ev&&ev.preventDefault)ev.preventDefault();var date=$('#ef90-date'),time=$('#ef90-time'),type=$('#ef90-type'),student=$('#ef90-student'),note=$('#ef90-note'),durationEl=$('#ef90-duration'),localEl=$('#ef90-location');
if(!date||!date.value){toast('Escolha a data do compromisso.','warn');return false}
var nome=(student&&student.value||'').trim(),horario=(time&&time.value)||'09:00';
if(!nome){toast('Informe o nome do aluno ou do compromisso.','warn');return false}
var duracao=Number(durationEl&&durationEl.value)||60;var items=loadAgenda();if(conflitante(items,date.value,horario,duracao,editingAgendaId)){toast('O horário escolhido se sobrepõe a outro atendimento. Selecione outro intervalo.','warn');return false}
var correspondente=alunoCorrespondente(nome);
var item={id:editingAgendaId||'ag-'+Date.now(),date:date.value,time:horario,duration:duracao,type:(type&&type.value)||'avaliacao',student:nome,local:localNormalizado(localEl&&localEl.value),refId:correspondente?correspondente.last.id:null,note:(note&&note.value||'').trim(),status:editingAgendaId?(items.find(function(x){return x.id===editingAgendaId})||{}).status||'agendado':'agendado',source:'agenda'};
if(editingAgendaId)items=items.filter(function(x){return x.id!==editingAgendaId});items.push(item);items.sort(function(a,b){return (a.date+' '+a.time).localeCompare(b.date+' '+b.time)});saveAgenda(items);toast(editingAgendaId?'Compromisso reagendado.':'Compromisso adicionado à agenda.');editingAgendaId=null;setSelectedDay(item.date);render();return false};

var TASKKEY='ef90_tasks_v2', FILTERKEY='ef90_filter_v2';
function getTasks(){try{var x=JSON.parse(storageGet(TASKKEY,'[]'));return Array.isArray(x)?x:[]}catch(e){return[]}}
function putTasks(x){storageSet(TASKKEY,JSON.stringify(x))}
window.ef90NewTask=function(){var input=$('#ef90-task-input');var name=input&&input.value.trim();if(!name){toast('Escreva a tarefa.','warn');return}var a=getTasks();a.push({id:'task-'+Date.now(),name:name,done:false,date:selectedDay()});putTasks(a);render()};
window.ef90TaskDone=function(id){putTasks(getTasks().map(function(x){if(x.id===id)x.done=!x.done;return x}));render()};
window.ef90TaskDelete=function(id){putTasks(getTasks().filter(function(x){return x.id!==id}));render()};
window.ef90Filter=function(mode){storageSet(FILTERKEY,mode);render()};
window.ef90QuickSchedule=function(iso){setSelectedDay(iso);setMonthOffset((pd(iso).getFullYear()-today().getFullYear())*12+pd(iso).getMonth()-today().getMonth());render();var f=$('#ef90-student');if(f)f.focus()};
function filteredAgenda(events,iso,mode){if(mode==='semana'){var st=startOfWeek(pd(iso)),end=addDays(st,7);return events.filter(function(x){var d=pd(x.date);return d&&d>=st&&d<end})}if(mode==='mes'){var dt=pd(iso);return events.filter(function(x){var d=pd(x.date);return d&&d.getMonth()===dt.getMonth()&&d.getFullYear()===dt.getFullYear()})}return events.filter(function(x){return x.date===iso})}
function reminderBox(agenda,returns,base){var tomorrow=addDays(base,1),tomorrowISO=toISO(tomorrow),todayISO=toISO(base);
var due=agenda.filter(function(x){return x.status!=='concluido'&&(x.date===todayISO||x.date===tomorrowISO)});
var overdue=returns.filter(function(x){return pd(x.date)<base}).length;
return '<div class="ef90-alert-strip" role="status"><span class="ef90-alert-icon">!</span><div><b>Lembretes da agenda</b><p>'+due.length+' compromisso(s) hoje ou amanhã · '+overdue+' retorno(s) em atraso. Os avisos são mostrados enquanto o aplicativo estiver aberto; não são notificações externas.</p></div></div>'}

function render(){var box=$('#ef55-painel');if(!box)return;
// Mantém análises já montadas ao atualizar o dia, sem destruir listeners e componentes.
var persistedAnalyses=[].slice.call(box.querySelectorAll('#ef-home-insights,#ef-home-deep'));
persistedAnalyses.forEach(function(el){el.remove()});
var al=alunos(),av=lista(),base=today(),agenda=loadAgenda(),retornos=buildReturnEvents(al,base),allEvents=agenda.concat(retornos).concat(window.EFOrganisation?window.EFOrganisation.calendarItems():[]);
var mes=av.filter(function(a){var d=pd(a.data_avaliacao);return d&&d.getMonth()===base.getMonth()&&d.getFullYear()===base.getFullYear()}).length;
var gs=al.map(function(x){return pg(x.last)}).filter(function(v){return v!=null});
var media=gs.length?(gs.reduce(function(s,v){return s+v},0)/gs.length).toFixed(1)+'%':'--';
var ret=al.map(function(x){var d=pd(x.last.data_proxima_avaliacao);return d?{x:x,dias:Math.round((d-base)/864e5)}:null}).filter(function(r){return r&&r.dias<=14}).sort(function(a,b){return a.dias-b.dias});
var atr=ret.filter(function(r){return r.dias<0}).length;
var agendaS=agendaStats(agenda,base);
var monthDate=new Date(base.getFullYear(),base.getMonth()+monthOffset(),1);
var selISO=selectedDay();
var mode=storageGet(FILTERKEY,'dia');if(['dia','semana','mes'].indexOf(mode)<0)mode='dia';
var locais=locaisConhecidos(agenda),localFiltro=filtroLocalSelecionado(locais);
var eventosDoLocal=allEvents.filter(function(e){return eventoDoLocal(e,localFiltro)});
var dayList=filteredAgenda(eventosDoLocal,selISO,mode).sort(function(a,b){return (a.date+' '+a.time).localeCompare(b.date+' '+b.time)});
var attentions=buildAttention(al,agenda,base);
var evo=al.filter(function(x){return x.list.length>1}).sort(function(a,b){return(b.last.data_avaliacao||'').localeCompare(a.last.data_avaliacao||'')}).slice(0,5);
var rec=av.slice().sort(function(a,b){return(b.data_avaliacao||'').localeCompare(a.data_avaliacao||'')}).slice(0,5);
var dayHuman=fd(pd(selISO));
var weekEnd=addDays(startOfWeek(base),6);
box.innerHTML=''
+'<section class="ef90-home ef90-compact">'
+'<div class="ef90-simple-head"><div><h1>Agenda</h1><p>Organize suas avaliações, atendimentos e tarefas em um só lugar.</p></div><div class="ef90-hero-actions"><button type="button" class="btn btn-secondary btn-sm" onclick="ef90JumpToday()">Hoje</button></div></div>'
+'<div class="ef90-simple-stats"><span><strong>'+agendaS.today+'</strong> compromisso(s) hoje</span><span><strong>'+agendaS.week+'</strong> na semana</span><span><strong>'+atr+'</strong> retorno(s) atrasado(s)</span></div>'
+'<div class="ef90-main-grid ef90-simple-grid">'
+'<div class="ef90-left-stack">'
+'<section class="ef55-card ef90-card"><div class="ef90-section-head"><div><h3>Agenda rápida</h3><p>Agende avaliações, reavaliações, retornos e acompanhamentos na Organização.</p></div>'+'<button type="button" class="ef90-inline-btn" onclick="ef90ExportAgenda()">Exportar agenda e tarefas</button>'+'</div><form class="ef90-form" onsubmit="return ef90SaveAgenda(event)"><input id="ef90-date" aria-label="Data do compromisso" type="date" value="'+esc(selISO)+'"><input id="ef90-time" aria-label="Horário do compromisso" type="time" value="09:00"><select id="ef90-duration" title="Duração do atendimento"><option value="30">30 minutos</option><option value="45">45 minutos</option><option value="60" selected>1 hora</option><option value="90">1h30</option><option value="120">2 horas</option></select><select id="ef90-type" aria-label="Tipo do compromisso"><option value="avaliacao">Avaliação</option><option value="reavaliacao">Reavaliação</option><option value="retorno">Retorno</option><option value="followup">Acompanhamento</option></select><input id="ef90-student" aria-label="Aluno ou descrição do compromisso" type="text" list="ef90-student-list" placeholder="Nome do aluno ou compromisso"><datalist id="ef90-student-list">'+al.map(function(x){return '<option value="'+esc(x.nome)+'"></option>'}).join('')+'</datalist><label class="ef90-location-field" for="ef90-location"><span>Local do atendimento</span><input id="ef90-location" type="text" list="ef90-location-list" autocomplete="off" placeholder="Ex.: Academia Centro ou Studio A" maxlength="100"><datalist id="ef90-location-list">'+locais.map(function(nome){return '<option value="'+esc(nome)+'"></option>'}).join('')+'</datalist></label><input id="ef90-note" aria-label="Observação do compromisso" type="text" placeholder="Observação rápida"><button id="ef90-save-button" class="btn btn-primary btn-sm" type="submit">Adicionar</button><button type="button" class="ef90-inline-btn" onclick="ef90CancelEdit()">Cancelar edição</button></form></section>'
+'<section class="ef55-card ef90-card"><div class="ef90-section-head"><div><h3>Calendário e agenda integrados</h3><p>Visualização mensal de atendimentos, tarefas, metas, notas com lembretes e retornos das avaliações.</p></div><div class="ef90-calendar-nav"><button type="button" class="btn btn-secondary btn-sm" onclick="ef90ShiftMonth(-1)">◀</button><strong>'+esc(monthLabel(monthDate))+'</strong><button type="button" class="btn btn-secondary btn-sm" onclick="ef90ShiftMonth(1)">▶</button></div></div>'+calendarGrid(eventosDoLocal,monthDate,selISO)+'<div class="ef90-day-panel"><div class="ef90-day-head"><h4>'+esc(dayHuman)+'</h4><div class="ef90-filter-wrap"><label for="ef90-filter-local">Local</label><select id="ef90-filter-local" onchange="ef90FiltrarLocal(this.value)" aria-label="Filtrar agenda por local de atendimento"><option value="__todos__"'+(localFiltro==='__todos__'?' selected':'')+'>Todos os locais</option><option value="__sem__"'+(localFiltro==='__sem__'?' selected':'')+'>Sem local informado</option>'+locais.map(function(nome){return '<option value="'+esc(nome)+'"'+(localFiltro===nome?' selected':'')+'>'+esc(nome)+'</option>'}).join('')+'</select><label for="ef90-filter">Ver</label><select id="ef90-filter" onchange="ef90Filter(this.value)"><option value="dia"'+(mode==='dia'?' selected':'')+'>Dia</option><option value="semana"'+(mode==='semana'?' selected':'')+'>Semana</option><option value="mes"'+(mode==='mes'?' selected':'')+'>Mês</option></select><button type="button" class="ef90-inline-btn" onclick="ef90QuickSchedule(\''+selISO+'\')">Agendar neste dia</button><span>'+dayList.length+' compromisso(s)</span></div></div>'+rows(dayList,function(e){var typeLabel={avaliacao:'Avaliação',reavaliacao:'Reavaliação',retorno:'Retorno',followup:'Acompanhamento',tarefa:'Tarefa',meta:'Meta',nota:'Nota'}[e.type]||'Compromisso';var action=(e.source||'').indexOf('orga-')===0?'<button type="button" class="ef90-inline-btn" onclick="EFOrganisation.openFromCalendar(\''+jsEsc(e.source)+'\',\''+jsEsc(e.id)+'\')">Abrir</button>':e.source==='return'?'<button class="ef55-wa" onclick="ef90OpenWhatsapp(\''+jsEsc(e.student||'')+'\',\''+jsEsc(e.whatsapp||'')+'\',\''+jsEsc(e.date)+'\')">WhatsApp</button>':'<div class="ef90-row-actions"><button type="button" class="ef90-inline-btn" onclick="ef90EditAgenda(\''+jsEsc(e.id)+'\')">Reagendar</button><select class="ef90-status-select" aria-label="Situação do atendimento" onchange="ef90SetStatus(\''+jsEsc(e.id)+'\',this.value)">'+[['agendado','Agendado'],['confirmado','Confirmado'],['concluido','Concluído'],['faltou','Não compareceu'],['cancelado','Cancelado']].map(function(pair){return '<option value="'+pair[0]+'"'+((e.status||'agendado')===pair[0]?' selected':'')+'>'+pair[1]+'</option>'}).join('')+'</select><button type="button" class="ef90-inline-btn danger" onclick="ef90RemoveAgenda(\''+jsEsc(e.id)+'\')">Excluir</button></div>';return '<div class="ef90-day-item"><div class="ef90-day-time">'+esc(e.time||'—')+(e.source==='agenda'?' · '+esc(String(e.duration||60))+' min':'')+'</div><div class="ef90-day-body"><div><b>'+esc(e.student||typeLabel)+'</b>'+pill(e.source==='return'?'warn':'ok',typeLabel)+'</div><p>'+esc(e.note||'Sem observações.')+'</p><small>'+(e.local?'<span class="ef90-place-label">📍 '+esc(e.local)+'</span> · ':'')+(e.source==='return'?'Gerado automaticamente a partir da próxima avaliação':(String(e.source||'').indexOf('orga-')===0?(e.status==='concluido'?'Concluído':'Pendente'):(({agendado:'Agendado',confirmado:'Presença confirmada',concluido:'Atendimento concluído',faltou:'Não compareceu',cancelado:'Cancelado'})[e.status]||'Agendado')))+'</small></div>'+action+'</div>'},'Nenhum compromisso neste dia.')+'</div></section>'
+'</div>'
+'<div class="ef90-right-stack">'
+'<section class="ef55-card ef90-card"><div class="ef90-section-head"><div><h3>Tarefas do dia</h3><p>Lista de tarefas para documentos, contatos e acompanhamentos.</p></div>'+pill('soft','lista de tarefas')+'</div><form class="ef90-task-form" onsubmit="event.preventDefault();ef90NewTask()"><input id="ef90-task-input" aria-label="Descrição da tarefa" placeholder="Ex.: Confirmar avaliação de amanhã"><button type="submit" class="btn btn-primary btn-sm">Adicionar</button></form>'+rows(getTasks().filter(function(x){return x.date===selISO}),function(x){return '<div class="ef90-task-item"><input type="checkbox" '+(x.done?'checked ':'')+'onchange="ef90TaskDone(\''+jsEsc(x.id)+'\')"><span class="'+(x.done?'done':'')+'">'+esc(x.name)+'</span><button class="ef90-inline-btn danger" type="button" onclick="ef90TaskDelete(\''+jsEsc(x.id)+'\')">Excluir</button></div>'},'Nenhuma tarefa anotada para esta data.')+'</section>'
+'<section class="ef55-card ef90-card"><div class="ef90-section-head"><div><h3>Reavaliações próximas</h3><p>Retornos automáticos vindos do cadastro das avaliações.</p></div></div>'+rows(ret,function(r){var a=r.x.last,c=r.dias<0?'bad':r.dias<=3?'warn':'ok',tx=r.dias<0?'Atrasado '+(-r.dias)+'d':r.dias===0?'Hoje':'em '+r.dias+'d';return '<div class="ef55-row" onclick="ef55Abrir(\''+jsEsc(a.id)+'\')"><div class="ef55-av">'+esc(ini(a.nome))+'</div><div class="t"><b>'+esc(a.nome)+'</b><span>'+fd(pd(a.data_proxima_avaliacao))+'</span></div><span class="ef55-pill '+c+'">'+tx+'</span><button class="ef55-wa" onclick="ef55Zap(event,\''+jsEsc(a.id)+'\')">WhatsApp</button></div>'},'Nenhuma reavaliação próxima.')+'</section>'
+'</div>'
+'</div>'
+'</section>';
if(persistedAnalyses.length){
 var holder=document.createElement('section');holder.id='ef-home-analysis';holder.className='ef-analysis-pair';
 persistedAnalyses.forEach(function(el){holder.appendChild(el)});
 box.appendChild(holder);
}
}

var nav=$('.nav-tabs');
if(nav){nav.insertAdjacentHTML('afterbegin','<button class="nav-tab-btn" id="tab-btn-painel" onclick="switchTab(\'tab-painel\')"><span>📊</span> <span>Painel</span></button>')}
var first=$('#tab-novo-checkin');
if(first)first.insertAdjacentHTML('beforebegin','<section id="tab-painel" class="tab-panel"><div id="ef55-painel"></div></section>');
var _sw=window.switchTab;
window.switchTab=function(id){_sw(id);if(id==='tab-painel'){document.querySelectorAll('.nav-tab-btn').forEach(function(b){b.classList.remove('active')});$('#tab-btn-painel').classList.add('active');render()}};

var pal=document.createElement('div');pal.id='ef55-pal';pal.className='no-print';
pal.innerHTML='<div class="box"><input id="ef55-q" placeholder="Buscar aluno ou ação…" autocomplete="off"><ul id="ef55-l"></ul><div class="foot">↑↓ navegar · Enter abrir · Esc fechar</div></div>';document.body.appendChild(pal);
var acoes=[['✨ Rever Abertura','Alt+0',function(){reabrirAbertura()}],['📊 Painel','Alt+1',function(){window.switchTab('tab-painel')}],['📝 Nova Avaliação','Alt+2',function(){window.switchTab('tab-novo-checkin')}],['📋 Histórico de Avaliações','Alt+3',function(){window.switchTab('tab-historico')}],['⚖️ Comparar Evolução','Alt+4',function(){window.switchTab('tab-comparison')}],
['🗓️ Ir para hoje','',function(){window.switchTab('tab-painel');window.ef90JumpToday()}],['⬇️ Fazer Backup (JSON)','',function(){if(window.abrirModalCentralBackup)window.abrirModalCentralBackup('exportar');else window.exportarBackupJSON()}],['⬆️ Importar Backup','',function(){if(window.abrirModalCentralBackup)window.abrirModalCentralBackup('importar');else{var i=$('#import-file-input');if(i)i.click()}}],['🛡️ Central de Backup','',function(){if(window.abrirModalCentralBackup)window.abrirModalCentralBackup('exportar');else window.exportarBackupJSON()}],['🔐 Segurança / Chave Mestra','',function(){abrirConfiguracaoCriptografia()}],['👨‍⚕️ Dados do Profissional / CREF','',function(){if(window.abrirModalConfigProfissional)window.abrirModalConfigProfissional()}]];
var itens=[],sel=0;
function lerPal(){var q=norm($('#ef55-q').value);
itens=acoes.filter(function(a){return!q||norm(a[0]).indexOf(q)>-1}).map(function(a){return{t:a[0],k:a[1],f:a[2]}});
if(q)alunos().filter(function(x){return norm(x.nome).indexOf(q)>-1}).slice(0,8).forEach(function(x){itens.push({t:'👤 '+x.nome,k:x.list.length+' aval.',f:function(){abrir(x.last.id)}})});
sel=0;pintar()}
function pintar(){$('#ef55-l').innerHTML=itens.length?itens.map(function(i,n){return'<li data-n="'+n+'" class="'+(n===sel?'sel':'')+'">'+esc(i.t)+'<small>'+esc(i.k)+'</small></li>'}).join(''):'<li>Nenhum resultado</li>'}
function abrirPal(){pal.classList.add('open');$('#ef55-q').value='';lerPal();$('#ef55-q').focus()}
function fecharPal(){pal.classList.remove('open')}
function exec(n){var i=itens[n];if(!i)return;fecharPal();i.f()}
$('#ef55-q').addEventListener('input',lerPal);
$('#ef55-l').addEventListener('click',function(e){var li=e.target.closest('li[data-n]');if(li)exec(+li.dataset.n)});
pal.addEventListener('mousedown',function(e){if(e.target===pal)fecharPal()});
document.addEventListener('keydown',function(e){
if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();pal.classList.contains('open')?fecharPal():abrirPal();return}
if(pal.classList.contains('open')){if(e.key==='Escape')fecharPal();else if(e.key==='ArrowDown'){e.preventDefault();sel=Math.min(itens.length-1,sel+1);pintar()}else if(e.key==='ArrowUp'){e.preventDefault();sel=Math.max(0,sel-1);pintar()}else if(e.key==='Enter'){e.preventDefault();exec(sel)}return}
if(e.altKey&&!e.ctrlKey&&!e.metaKey){var m={'1':'tab-painel','2':'tab-novo-checkin','3':'tab-historico','4':'tab-comparison'}[e.key];if(m){e.preventDefault();window.switchTab(m)}}});

var _bk=window.exportarBackupJSON;
if(typeof _bk==='function'&&!_bk.__ef55Wrapped){
    var wrapped=function(){
        try{localStorage.setItem('ef55_last_backup',String(Date.now()))}catch(e){}
        return _bk.apply(this,arguments);
    };
    wrapped.__ef55Wrapped=true;
    window.exportarBackupJSON=wrapped;
}
setTimeout(function(){try{if(!lista().length)return;var t=+localStorage.getItem('ef55_last_backup')||0;
if(Date.now()-t>7*864e5)toast(window.innerWidth<=768 ? 'Faz mais de 7 dias sem backup. Acesse Ferramentas › Backup.' : 'Faz mais de 7 dias sem backup. Use Ctrl+K › Fazer Backup.','warn')}catch(e){}},2500);
})();
</script>
<script>/* 05-runtime.js */
/* ===== EvoluFísico v6.0 — Parecer Inteligente ===== */
(function(){'use strict';
var $=function(s){return document.querySelector(s)};
var esc=function(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})};
var jsEsc=function(s){return esc(String(s==null?'':s).replace(/\\/g,'\\\\').replace(/'/g,"\\'").replace(/\r/g,'\\r').replace(/\n/g,'\\n'))};
var norm=function(s){return String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim()};
var num=function(v){var n=parseFloat(String(v==null?'':v).replace(',','.'));return isFinite(n)?n:null};
var val=function(id){var e=document.getElementById(id);return e?e.value:''};
var setv=function(id,v){var e=document.getElementById(id);if(e)e.value=v};
var fdata=function(s){var m=/^(\d{4})-(\d{2})-(\d{2})/.exec(s||'');return m?m[3]+'/'+m[2]+'/'+m[1]:'—'};
var fmt=function(v,u){return(v>0.049?'+':v<-0.049?'−':'')+Math.abs(v).toFixed(1)+u};
var TAGS=['Evolução consistente','Platô','Perda de gordura','Ganho de massa magra','Boa recuperação','Fadiga acumulada','Sono insuficiente','Hidratação baixa','Dor / desconforto','Ajustar carga','Ajustar calorias','Reavaliar em 15 dias'];
var FRASES=[['Manter plano','Manter o plano atual de treino e dieta até a próxima reavaliação.'],['Progressão de carga','Aplicar progressão de carga nos exercícios principais nas próximas semanas.'],['Reforçar aderência','Reforçar a regularidade nos treinos e o cumprimento do plano alimentar.'],['Sono e recuperação','Priorizar sono e recuperação para sustentar o desempenho.'],['Revisar dieta','Revisar o plano alimentar com o profissional responsável.'],['Encaminhar saúde','Recomenda-se avaliação com profissional de saúde para investigar o desconforto relatado.']];
var T={'100% no plano':100,'Faltei 1-2x':75,'Faltei 3x ou mais':40,'Não treinei':0};
var D={'100% no plano':100,'95% no plano':95,'Pequenos furos':75,'Muitos furos':40,'Fora do plano':10};
var COR={'Excelente':['#dcfce7','#166534'],'Bom':['#dbeafe','#1e40af'],'Regular':['#fef9c3','#854d0e'],'Atenção':['#fee2e2','#991b1b'],'Não avaliável':['#e2e8f0','#334155']};

function scoreDe(o){var treinoNA=o.treino==='Nunca treinou',dietaNA=o.dieta==='Nunca fez dieta';if(treinoNA&&dietaNA)return null;var t=T[o.treino];if(t==null)t=70;var d=D[o.dieta];if(d==null)d=70;var bs=[],e=num(o.energia),s=num(o.sono),st=num(o.estresse);
if(e!=null){var ec=Math.max(1,Math.min(5,e));bs.push((ec-1)/4*100);}
if(s!=null){var sc=Math.max(1,Math.min(5,s));bs.push((sc-1)/4*100);}
if(st!=null){var stc=Math.max(1,Math.min(5,st));bs.push((5-stc)/4*100);}
var b=bs.length?bs.reduce(function(a,c){return a+c},0)/bs.length:70;
var tw=treinoNA?0:.4,dw=dietaNA?0:.35,ad=(tw*t+dw*d)/(tw+dw);return Math.max(0,Math.min(100,Math.round(.75*ad+.25*b)));}
function rotulo(sc){return sc==null?'Não avaliável':sc>=85?'Excelente':sc>=70?'Bom':sc>=50?'Regular':'Atenção'}
function lista(){try{return Array.isArray(avaliacoes)?avaliacoes:[]}catch(e){return[]}}
function doAluno(nome){var k=EFIdentity.key(nome);return lista().filter(function(a){return EFIdentity.key(a)===k}).sort(function(x,y){return String(x.data_avaliacao||'').localeCompare(String(y.data_avaliacao||''))||String(x.timestamp||'').localeCompare(String(y.timestamp||''))})}
function pgDe(a){var r=a&&a.dobras_resultado&&num(a.dobras_resultado.percGordura);return r!=null?r:num(a&&a.bioimpedancia&&a.bioimpedancia.pgordura)}
function mmDe(a){return EFMeasures.lean(a)}
function cinDe(a){return num(a&&((a.perimetria&&a.perimetria.cintura)||a.cintura))}
function scoreAval(a){var p=a&&a.parecer_v6;if(p&&p.score!=null&&a.aderencia_treino!=='Nunca treinou'&&a.aderencia_dieta!=='Nunca fez dieta')return p.score;return scoreDe({treino:a.aderencia_treino,dieta:a.aderencia_dieta,energia:a.energia,sono:p&&p.sono,estresse:p&&p.estresse})}

function atualForm(){var sexo=val('sexo')||'M',idade=num(val('idade'))||0,peso=num(val('peso'))||num(val('bia_peso'))||0,d={};
['triceps','subescapular','peitoral','axilar','suprailiaca','abdominal','coxa'].forEach(function(k){d[k]=num(val('dobra_'+k))||0});
var r=null;try{r=calcularPollock7(sexo,idade,peso,d)}catch(e){}
return{nome:val('nome'),data:val('data_avaliacao'),id:val('avaliacao_id'),peso:peso||null,pg:r?num(r.percGordura):num(val('bia_pgordura')),mm:r?num(r.massaMagra):null,cintura:num(val('cintura')),soma:r?num(r.soma):null,fase:val('fase'),semana:val('checkin_semana'),treino:val('aderencia_treino'),dieta:val('aderencia_dieta'),energia:val('energia'),sono:val('ef6_sono'),estresse:val('ef6_estresse'),dor:val('ef6_dor'),metaPg:num(val('ef6_meta_pg')),metaPeso:num(val('ef6_meta_peso')),metaPrazo:val('ef6_meta_prazo')}}
function referencias(f){var l=doAluno(f.nome).filter(function(a){return a.id!==f.id&&(!f.data||String(a.data_avaliacao||'')<=f.data)});return{ant:l.length?l[l.length-1]:null,prim:l.length?l[0]:null,n:l.length}}
function prog(base,atual,meta){if(base==null||atual==null||meta==null)return null;var tot=base-meta;if(Math.abs(tot)<.05)return Math.abs(atual-meta)<.05?100:0;return Math.max(0,Math.min(100,Math.round((base-atual)/tot*100)))}
function barra(p){return'<div class="ef6-bar"><i style="width:'+p+'%"></i></div>'}
function metaHTML(f,ref){var h='';
if(f.metaPg!=null&&f.pg!=null){var base=ref.prim&&pgDe(ref.prim)!=null?pgDe(ref.prim):f.pg,p=prog(base,f.pg,f.metaPg);h+='<div class="ef6-meta">🎯 Meta de gordura: <b>'+f.metaPg.toFixed(1)+'%</b> — atual '+f.pg.toFixed(1)+'% · '+(Math.abs(f.pg-f.metaPg)<.05?'meta atingida':'faltam '+Math.abs(f.pg-f.metaPg).toFixed(1)+' p.p.')+' ('+p+'%)'+barra(p)+'</div>'}
if(f.metaPeso!=null&&f.peso!=null){var b2=ref.prim&&num(ref.prim.peso)!=null?num(ref.prim.peso):f.peso,p2=prog(b2,f.peso,f.metaPeso);h+='<div class="ef6-meta">⚖️ Meta de peso: <b>'+f.metaPeso.toFixed(1)+' kg</b> — atual '+f.peso.toFixed(1)+' kg · '+(Math.abs(f.peso-f.metaPeso)<.05?'meta atingida':'faltam '+Math.abs(f.peso-f.metaPeso).toFixed(1)+' kg')+' ('+p2+'%)'+barra(p2)+'</div>'}
if(f.metaPrazo){var dias=Math.round((new Date(f.metaPrazo+'T00:00:00')-new Date(new Date().getFullYear(),new Date().getMonth(),new Date().getDate()))/864e5);if(isFinite(dias))h+='<div class="ef6-sub">Prazo: '+fdata(f.metaPrazo)+(dias>=0?' (em '+dias+' dias)':' (vencido há '+(-dias)+' dias)')+'</div>'}
return h}
function renderResumo(){var box=window.__ef6ResumoBox||(window.__ef6ResumoBox=$('#ef6-resumo'));if(!box)return;var f=atualForm(),ref=referencias(f),sc=scoreDe(f),rt=rotulo(sc),c=COR[rt],ant=ref.ant;
function kv(t,a,b,u,bom){if(a==null)return'';var h='<div class="ef6-kv"><small>'+t+'</small><b>'+a.toFixed(1)+u+'</b>';
if(ant&&b!=null){var d=a-b,cl=Math.abs(d)<.05?'':((d<0)===bom?'ok':'bad');h+='<span class="ef6-d '+cl+'">'+fmt(d,u)+' vs anterior</span>'}else h+='<span class="ef6-d">sem referência</span>';return h+'</div>'}
box.innerHTML='<div class="ef6-resumo-h"><b>📊 Resumo automático do check-in</b><span class="ef6-badge" style="background:'+c[0]+';color:'+c[1]+'">Aderência '+(sc==null?'não avaliável':sc+'/100 · '+rt)+'</span></div><div class="ef6-kvs">'+
kv('% Gordura',f.pg,ant?pgDe(ant):null,'%',true)+kv('Peso',f.peso,ant?num(ant.peso):null,' kg',true)+kv('Massa magra',f.mm,ant?mmDe(ant):null,' kg',false)+kv('Cintura',f.cintura,ant?cinDe(ant):null,' cm',true)+'</div>'+
(ant?'<div class="ef6-sub">Comparado com a avaliação de '+fdata(ant.data_avaliacao)+' ('+ref.n+' avaliação(ões) anterior(es) deste aluno).</div>':'<div class="ef6-sub">'+(f.nome?'Primeira avaliação deste aluno: ela será a base de comparação.':'Informe o nome do aluno na etapa 1 para comparar com avaliações anteriores.')+'</div>')+metaHTML(f,ref);
var sel=$('#ef6_status');if(sel){var o=sel.options[0];if(o)o.textContent='Automático (sugerido: '+rt+')'}}

function rascunho(){var f=atualForm(),ref=referencias(f),ant=ref.ant,L=[],sc=scoreDe(f),rt=rotulo(sc);
L.push((f.semana?f.semana+' — ':'')+'check-in'+(f.fase?' na fase de '+String(f.fase).toLowerCase():'')+'.');
if(ant){var p=[],pa=pgDe(ant),ma=mmDe(ant),ca=cinDe(ant),wa=num(ant.peso),d;
if(f.pg!=null&&pa!=null){d=f.pg-pa;p.push('o percentual de gordura '+(Math.abs(d)<.05?'se manteve estável':(d<0?'reduziu ':'aumentou ')+Math.abs(d).toFixed(1)+' p.p.')+' ('+pa.toFixed(1)+'% → '+f.pg.toFixed(1)+'%)')}
if(f.mm!=null&&ma!=null){d=f.mm-ma;p.push('a massa magra variou '+fmt(d,' kg'))}
if(f.peso!=null&&wa!=null){d=f.peso-wa;p.push('o peso variou '+fmt(d,' kg'))}
if(f.cintura!=null&&ca!=null){d=f.cintura-ca;p.push('a cintura variou '+fmt(d,' cm'))}
if(p.length)L.push('Em relação à avaliação de '+fdata(ant.data_avaliacao)+': '+p.join('; ')+'.')}
else{var b=[];if(f.pg!=null)b.push('gordura corporal de '+f.pg.toFixed(1)+'%');if(f.mm!=null)b.push('massa magra de '+f.mm.toFixed(1)+' kg');if(f.soma!=null)b.push('soma de 7 dobras de '+f.soma.toFixed(1)+' mm');
L.push('Avaliação-base do aluno'+(b.length?': '+b.join(', ')+'.':'.'))}
var ad='Aderência ao treino: '+(f.treino||'—')+'; à dieta: '+(f.dieta||'—')+'. Disposição '+f.energia+'/5, sono '+f.sono+'/5, estresse '+f.estresse+'/5. Score de aderência: '+(sc==null?'não avaliável (treino e dieta ainda não iniciados)':sc+'/100 ('+rt+')')+'.';L.push(ad);
if(sc!=null&&sc>=85)L.push('Excelente comprometimento; manter o plano atual.');else if(sc!=null&&sc<70)L.push('A aderência abaixo do ideal pode limitar os resultados; vale reforçar a rotina e identificar as barreiras (agenda, planejamento das refeições).');
if(f.dor&&f.dor!=='Nenhuma')L.push('Relato de dor/desconforto '+f.dor.toLowerCase()+': avaliar ajustes nos exercícios e, se persistir, encaminhar a um profissional de saúde.');
if(f.metaPg!=null&&f.pg!=null)L.push('Meta de gordura: '+f.metaPg.toFixed(1)+'% ('+(Math.abs(f.pg-f.metaPg)<.05?'atingida':'faltam '+Math.abs(f.pg-f.metaPg).toFixed(1)+' p.p.')+').');
return L.join(' ')}
function gerarRascunho(){var ta=document.getElementById('parecer_profissional');if(!ta)return;var t=rascunho();ta.value=ta.value.trim()?ta.value.replace(/\s+$/,'')+'\n\n'+t:t;ta.dispatchEvent(new Event('input',{bubbles:true}));if(window.efToast)efToast('Rascunho gerado. Revise e ajuste antes de salvar.')}
function resumoTexto(){var f=atualForm(),ref=referencias(f),ant=ref.ant,sc=scoreDe(f),st=val('ef6_status')||rotulo(sc),L=[];
L.push('*Resumo da avaliação — '+(f.nome||'Aluno')+'* ('+fdata(f.data)+')');L.push('Status: '+st+' · Aderência '+(sc==null?'não avaliável':sc+'/100'));
var m=[];if(f.pg!=null)m.push('%G '+f.pg.toFixed(1)+'%'+(ant&&pgDe(ant)!=null?' ('+fmt(f.pg-pgDe(ant),'')+')':''));if(f.mm!=null)m.push('Massa magra '+f.mm.toFixed(1)+' kg'+(ant&&mmDe(ant)!=null?' ('+fmt(f.mm-mmDe(ant),'')+')':''));if(f.cintura!=null)m.push('Cintura '+f.cintura.toFixed(1)+' cm');
if(m.length)L.push(m.join(' · '));
[['ef6_fortes','Pontos fortes'],['ef6_atencao','Atenção'],['ef6_treino','Treino'],['ef6_dieta','Dieta'],['ef6_proximos','Próximos passos']].forEach(function(x){var v=val(x[0]).trim();if(v)L.push(x[1]+': '+v)});
var pr=val('parecer_profissional').trim();if(pr)L.push('Parecer: '+pr.slice(0,500)+(pr.length>500?'…':''));
return L.join('\n')}
function copiarResumo(){var t=resumoTexto();
function ok(){if(window.efToast)efToast('Resumo copiado ✓')}
function fb(){var ta=document.createElement('textarea');ta.value=t;ta.style.position='fixed';ta.style.opacity='0';document.body.appendChild(ta);ta.select();try{document.execCommand('copy');ok()}catch(e){alert(t)}ta.remove()}
if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(t).then(ok,fb)}else fb()}

function sincronizar(){var sel=(val('ef6_tags')||'').split(',').filter(Boolean);document.querySelectorAll('#ef6-tags .ef6-chip').forEach(function(c){c.classList.toggle('on',sel.indexOf(c.dataset.t)>-1)})}
function montarChips(){var tg=$('#ef6-tags'),fr=$('#ef6-frases');if(!tg||!fr||tg.children.length)return;
TAGS.forEach(function(t){var b=document.createElement('button');b.type='button';b.className='ef6-chip';b.dataset.t=t;b.textContent=t;b.addEventListener('click',function(){var s=(val('ef6_tags')||'').split(',').filter(Boolean),i=s.indexOf(t);if(i>-1)s.splice(i,1);else s.push(t);setv('ef6_tags',s.join(','));sincronizar();$('#checkin-form').dispatchEvent(new Event('input',{bubbles:true}))});tg.appendChild(b)});
FRASES.forEach(function(x){var b=document.createElement('button');b.type='button';b.className='ef6-chip frase';b.textContent=x[0];b.addEventListener('click',function(){var ta=document.getElementById('parecer_profissional');ta.value=(ta.value.trim()?ta.value.replace(/\s+$/,'')+' ':'')+x[1];ta.dispatchEvent(new Event('input',{bubbles:true}))});fr.appendChild(b)})}

function coletar(fd){var f=atualForm(),sc=scoreDe(f),g=function(k){return(fd.get(k)||'').toString().trim()};
return{status:sc==null?'Não avaliável':(g('ef6_status')||rotulo(sc)),status_manual:sc!=null&&!!g('ef6_status'),score:sc,tags:g('ef6_tags'),sono:num(g('ef6_sono')),estresse:num(g('ef6_estresse')),dor:g('ef6_dor')||'Nenhuma',meta_pgordura:num(g('ef6_meta_pg')),meta_peso:num(g('ef6_meta_peso')),meta_prazo:g('ef6_meta_prazo'),pontos_fortes:g('ef6_fortes'),pontos_atencao:g('ef6_atencao'),ajuste_treino:g('ef6_treino'),ajuste_dieta:g('ef6_dieta'),proximos_passos:g('ef6_proximos')}}
function carregar(a){var p=(a&&a.parecer_v6)||{};setv('ef6_sono',p.sono||3);setv('ef6_estresse',p.estresse||3);setv('ef6_dor',p.dor||'Nenhuma');setv('ef6_meta_pg',p.meta_pgordura==null?'':p.meta_pgordura);setv('ef6_meta_peso',p.meta_peso==null?'':p.meta_peso);setv('ef6_meta_prazo',p.meta_prazo||'');
setv('ef6_status',p.status_manual&&['Excelente','Bom','Regular','Atenção'].indexOf(p.status)>-1?p.status:'');setv('ef6_tags',p.tags||'');setv('ef6_fortes',p.pontos_fortes||'');setv('ef6_atencao',p.pontos_atencao||'');setv('ef6_treino',p.ajuste_treino||'');setv('ef6_dieta',p.ajuste_dieta||'');setv('ef6_proximos',p.proximos_passos||'');sincronizar();renderResumo()}
function limpar(){setv('ef6_tags','');sincronizar();renderResumo()}

function conquistas(a){var l=doAluno(a),prim=l[0],out=[];
if(prim&&prim.id!==a.id){var d=pgDe(a)-pgDe(prim);if(isFinite(d)&&d<=-1)out.push('🔥 '+fmt(d,' p.p.')+' de gordura');
var m=mmDe(a)-mmDe(prim);if(isFinite(m)&&m>=0.3)out.push('💪 '+fmt(m,' kg')+' de massa magra');
var c=cinDe(a)-cinDe(prim);if(isFinite(c)&&c<=-1)out.push('📏 '+fmt(c,' cm')+' de cintura')}
if(scoreAval(a)!=null&&scoreAval(a)>=90)out.push('🎯 Aderência exemplar');
var p=a.parecer_v6;if(p&&p.meta_pgordura!=null&&pgDe(a)!=null&&pgDe(a)<=p.meta_pgordura+.05)out.push('🏆 Meta de gordura atingida');
if(l.length>=3)out.push('📈 '+l.length+' avaliações realizadas');return out}
function html(a,modo){if(!a)return'';var pr=modo==='print',fs=pr?'0.72rem':'0.84rem',p=a.parecer_v6||{},sc=scoreAval(a),st=p.status||rotulo(sc),c=COR[st]||COR['Bom'];
var h='<div class="ef6-laudo" style="margin-top:10px;border:1px solid #cbd5e1;border-radius:8px;padding:10px;background:#fff;font-size:'+fs+';line-height:1.5;color:#334155">';
h+='<div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap"><strong style="color:#0f172a">🧭 Síntese do check-in</strong><span style="background:'+c[0]+';color:'+c[1]+';font-weight:800;padding:2px 10px;border-radius:99px;-webkit-print-color-adjust:exact;print-color-adjust:exact">'+esc(st)+' · Aderência '+(sc==null?'não avaliável':sc+'/100')+'</span></div>';
if(sc!=null)h+='<div style="height:7px;background:#e2e8f0;border-radius:99px;overflow:hidden;margin:6px 0;-webkit-print-color-adjust:exact;print-color-adjust:exact"><div style="width:'+Math.max(0,Math.min(100,sc))+'%;height:100%;background:'+c[1]+'"></div></div>';
var tg=(p.tags||'').split(',').filter(Boolean);if(tg.length)h+='<div style="margin:4px 0">'+tg.map(function(t){return'<span style="display:inline-block;border:1px solid #cbd5e1;border-radius:99px;padding:1px 8px;margin:1px 3px 1px 0;font-size:.9em">'+esc(t)+'</span>'}).join('')+'</div>';
[['✅ Pontos fortes',p.pontos_fortes],['⚠️ Pontos de atenção',p.pontos_atencao],['🏋️ Ajustes no treino',p.ajuste_treino],['🥗 Ajustes na dieta',p.ajuste_dieta],['🚀 Próximos passos',p.proximos_passos]].forEach(function(x){if(x[1])h+='<div style="margin-top:4px"><strong>'+x[0]+':</strong> '+esc(x[1])+'</div>'});
var l=doAluno(a),prim=l[0]||a,pg=pgDe(a),ml='';
if(p.meta_pgordura!=null&&pg!=null){var pp=prog(pgDe(prim)!=null?pgDe(prim):pg,pg,p.meta_pgordura);ml+='<div>🎯 Meta de gordura '+Number(p.meta_pgordura).toFixed(1)+'% — progresso '+pp+'%'+(pr?'':barra(pp))+'</div>'}
if(p.meta_peso!=null&&num(a.peso)!=null){var p3=prog(num(prim.peso)!=null?num(prim.peso):num(a.peso),num(a.peso),p.meta_peso);ml+='<div>⚖️ Meta de peso '+Number(p.meta_peso).toFixed(1)+' kg — progresso '+p3+'%</div>'}
if(p.meta_prazo)ml+='<div>Prazo da meta: '+fdata(p.meta_prazo)+'</div>';if(ml)h+='<div style="margin-top:6px;border-top:1px dashed #cbd5e1;padding-top:4px">'+ml+'</div>';
var cq=conquistas(a);if(cq.length)h+='<div style="margin-top:6px;border-top:1px dashed #cbd5e1;padding-top:4px"><strong>Conquistas:</strong> '+cq.map(esc).join(' &nbsp;·&nbsp; ')+'</div>';
return h+'</div>'}

function init(){montarChips();var form=$('#checkin-form');if(!form)return;var t=null;
form.addEventListener('input',function(){clearTimeout(t);t=setTimeout(renderResumo,220)});form.addEventListener('change',renderResumo);
var s5=document.querySelector('.step[data-step="5"]');if(s5)new MutationObserver(function(){if(s5.classList.contains('active'))renderResumo()}).observe(s5,{attributes:true,attributeFilter:['class']});
var b1=$('#ef6-btn-rascunho'),b2=$('#ef6-btn-copiar');if(b1)b1.addEventListener('click',gerarRascunho);if(b2)b2.addEventListener('click',copiarResumo);
renderResumo();
try{if(!localStorage.getItem('ef6_novidades')){localStorage.setItem('ef6_novidades','1');setTimeout(function(){if(window.efToast)efToast('Novidades: score e tendências por aluno, parecer inteligente e rascunho automático (etapa 5).')},1800)}}catch(e){}}

var _sw=window.switchTab;
window.switchTab=function(id){var r=_sw.apply(this,arguments);if(id==='tab-painel'){try{painel()}catch(e){console.error(e)}}return r};
function painel(){var cols=$('.ef55-cols');if(!cols)return;var old=$('#ef6-pn');if(old)old.remove();var m={};
lista().forEach(function(a){var k=EFIdentity.key(a);if(k&&(!m[k]||String(a.data_avaliacao||'')>=String(m[k].data_avaliacao||'')))m[k]=a});
var ar=Object.keys(m).map(function(k){return{a:m[k],s:scoreAval(m[k])}}).filter(function(x){return x.s!=null&&x.s<70}).sort(function(x,y){return x.s-y.s}).slice(0,6);
var card=document.createElement('div');card.className='ef55-card';card.id='ef6-pn';
card.innerHTML='<h3>Atenção à aderência<em>'+ar.length+'</em></h3>'+(ar.length?ar.map(function(x){var cl=x.s<50?'bad':'warn';return'<div class="ef55-row" onclick="ef55Abrir(\''+jsEsc(x.a.id)+'\')"><div class="ef55-av">'+esc((x.a.nome||'?').trim().split(/\s+/).map(function(w,i,arr){return(i===0||i===arr.length-1)?w[0]:''}).join('').toUpperCase())+'</div><div class="t"><b>'+esc(x.a.nome)+'</b><span>'+fdata(x.a.data_avaliacao)+'</span></div><span class="ef55-pill '+cl+'">Score '+x.s+'</span></div>'}).join(''):'<div class="ef55-empty">Todos os alunos com boa aderência 🎉</div>');
cols.appendChild(card)}

window.EF6={html:html,coletar:coletar,carregar:carregar,limpar:limpar,sincronizar:sincronizar,scoreDe:scoreDe,scoreAval:scoreAval,rotulo:rotulo,rascunho:rascunho,gerarRascunho:gerarRascunho,resumoTexto:resumoTexto,renderResumo:renderResumo,copiarResumo:copiarResumo,conquistas:conquistas};
init();
})();
</script>
<script>/* 06-runtime.js */
(function(){'use strict';
var $=function(s){return document.querySelector(s)};
var norm=function(s){return String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim()};
var num=function(v){var n=parseFloat(String(v).replace(',','.'));return isFinite(n)?n:null};
var lista=function(){try{return Array.isArray(avaliacoes)?avaliacoes:[]}catch(e){return[]}};
var pg=function(a){var r=a.dobras_resultado&&num(a.dobras_resultado.percGordura);return r!=null?r:num(a.bioimpedancia&&a.bioimpedancia.pgordura)};
var mm=function(a){return EFMeasures.lean(a)};
var pe=function(a){return num(a.peso)};
var dm=function(s){var m=/^(\d{4})-(\d{2})-(\d{2})/.exec(s||'');return m?m[3]+'/'+m[2]:''};
var df=function(s){var m=/^(\d{4})-(\d{2})-(\d{2})/.exec(s||'');return m?m[3]+'/'+m[2]+'/'+m[1]:'—'};
var msg=function(t,k){(window.efToast||alert)(t,k)};
function atual(){try{if(avaliacaoLaudoWebAtiva)return avaliacaoLaudoWebAtiva}catch(e){}
try{return lista().filter(function(a){return a.id===avaliacaoEmVisualizacaoId})[0]||null}catch(e){return null}}
function historico(a){var k=EFIdentity.key(a);return lista().filter(function(x){return EFIdentity.key(x)===k}).sort(function(x,y){return(x.data_avaliacao||'').localeCompare(y.data_avaliacao||'')})}
function chart(tit,pts,cor,un){if(pts.length<2)return'';
var W=300,H=120,px=26,py=26,vs=pts.map(function(p){return p.v}),mn=Math.min.apply(null,vs),mx=Math.max.apply(null,vs),r=(mx-mn)||1;
var X=function(i){return px+i*(W-2*px)/(pts.length-1)},Y=function(v){return H-py-(v-mn)/r*(H-2*py)};
var ln=pts.map(function(p,i){return(i?'L':'M')+X(i).toFixed(1)+' '+Y(p.v).toFixed(1)}).join(' ');
var ar=ln+' L'+X(pts.length-1).toFixed(1)+' '+(H-py)+' L'+X(0).toFixed(1)+' '+(H-py)+' Z';
var dots=pts.map(function(p,i){return'<circle cx="'+X(i).toFixed(1)+'" cy="'+Y(p.v).toFixed(1)+'" r="3.5" fill="#fff" stroke="'+cor+'" stroke-width="2"/><text x="'+X(i).toFixed(1)+'" y="'+(Y(p.v)-8).toFixed(1)+'" text-anchor="middle" font-size="9.5" font-weight="700" fill="#1d1d1f">'+p.v.toFixed(1)+'</text><text x="'+X(i).toFixed(1)+'" y="'+(H-8)+'" text-anchor="middle" font-size="8.5" fill="#86868b">'+p.d+'</text>'}).join('');
var dl=pts[pts.length-1].v-pts[0].v;
return'<div style="background:#fff;border:1px solid #cbd5e1;border-radius:12px;padding:.8rem"><div style="display:flex;justify-content:space-between;font-size:.82rem;font-weight:800;margin-bottom:4px"><span>'+tit+'</span><span style="color:'+cor+'">'+(dl>0?'+':'')+dl.toFixed(1)+un+'</span></div><svg viewBox="0 0 '+W+' '+H+'" style="width:100%;height:auto"><path d="'+ar+'" fill="'+cor+'" opacity=".08"/><path d="'+ln+'" fill="none" stroke="'+cor+'" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"/>'+dots+'</svg></div>'}
function resumo(){var a=atual();if(!a)return'';var l=historico(a),f=l[0],g=pg(a),m=mm(a);
var t='*EvoluFísico* — Resultado de '+a.nome+'\n📅 Avaliação: '+df(a.data_avaliacao)+'\n⚖️ Peso: '+(pe(a)!=null?pe(a).toFixed(1):'-')+' kg\n🔥 % Gordura: '+(g!=null?g.toFixed(1)+'%':'-')+'\n💪 Massa magra: '+(m!=null?m.toFixed(1)+' kg':'-');
if(f&&f.id!==a.id){var sg=function(n1,n2,u){if(n1==null||n2==null||isNaN(n1)||isNaN(n2))return '—';var diff=n1-n2;return(diff>0?'+':'')+diff.toFixed(1)+u};
t+='\n\n📈 Desde '+df(f.data_avaliacao)+':\n• Gordura: '+sg(g,pg(f),'%')+'\n• Peso: '+sg(pe(a),pe(f),' kg')+'\n• Massa magra: '+sg(m,mm(f),' kg')}
if(a.data_proxima_avaliacao)t+='\n\n🔁 Próxima avaliação: '+df(a.data_proxima_avaliacao);return t}
window.ef56Copiar=function(){var t=resumo();if(!t)return;
(navigator.clipboard?navigator.clipboard.writeText(t):Promise.reject()).then(function(){msg('Resumo copiado ✓')},function(){msg('Não foi possível copiar.','warn')})};
window.ef56Zap=function(){var a=atual();if(!a)return;var d=String(a.whatsapp||'').replace(/\D/g,'');
if(!d){msg('Aluno sem WhatsApp cadastrado.','warn');return}
window.open('https://api.whatsapp.com/send?phone='+(d.length<=11?'55':'')+d+'&text='+encodeURIComponent(resumo()),'_blank','noopener,noreferrer')};
function extra(box){if(box.querySelector('#ef56-extra'))return;var a=atual();if(!a)return;var l=historico(a);
var s=function(fn){return l.map(function(x){var v=fn(x);return v==null?null:{v:v,d:dm(x.data_avaliacao)}}).filter(Boolean)};
var h='<div id="ef56-extra" class="no-print" style="margin:1.5rem 0 .5rem">';
if(l.length>1)h+='<h3 style="font-size:1.05rem;font-weight:700;margin-bottom:.75rem">📈 Evolução do Aluno ('+l.length+' avaliações)</h3><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:10px">'+chart('% Gordura',s(pg),'#dc2626','%')+chart('Peso (kg)',s(pe),'#2563eb',' kg')+chart('Massa Magra (kg)',s(mm),'#16a34a',' kg')+'</div>';
h+='<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:1rem"><button type="button" class="btn btn-secondary btn-sm" onclick="ef56Copiar()">📋 Copiar resumo</button><button type="button" class="btn btn-primary btn-sm" onclick="ef56Zap()">💬 Enviar resumo por WhatsApp</button></div></div>';
box.insertAdjacentHTML('beforeend',h)}
var box=$('#patient-view-content');
if(box)new MutationObserver(function(){if(box.children.length&&!box.querySelector('#ef56-extra'))extra(box)}).observe(box,{childList:true});
})();
</script>
<script>/* 07-runtime.js */
